{
  "Audits": {
    "FilterMinimumYear": 2024,
    "FilterMaximumYear": 2030
  },
  "Documents": {
    "MaximumFileSizeInBytes": 15728640
  },
  "Jwt": {
    "SecretKey": "SMLP_SuperSecret_JWT_Key_2025_CoffeeShopLoyalty_MinLength32Chars",
    "Issuer": "SMLP",
    "Audience": "SMLP_Client",
    "ExpiryInMinutes": 480,
    "RefreshExpiryInDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:44992",
      "https://localhost:5001",
      "http://localhost:5000"
    ]
  },
  "BackEnd": {
    "BasePath": "/smlp_api"
  },
  "Caching": {
    "Provider": "InMemory",
    "Redis": {
      "ConnectionString": "localhost:6379,abortConnect=false",
      "InstanceName": "smlp:",
      "DefaultExpirationMinutes": 10
    }
  },
  "BackgroundJob": {
    "Provider": "Hangfire",
    "Hangfire": {
      "WorkerCount": 2,
      "IsJobRun": false,
      "Storage": {
        "Provider": "SqlServer",
        "SqlServer": {
          "ConnectionString": ""
        }
      },
      "Dashboard": {
        "Url": "/jobs",
        "Username": "admin",
        "Password": "admin"
      }
    }
  },
  "Documentation": {
    "Provider": "Swagger",
    "Swagger": {
      "SwaggerPrefix": "swagger",
      "JsonEndpoint": "/swagger/$version$/swagger.json",
      "Description": "Back-End Services for SMLP - Sistem Manajemen Loyalitas Pelanggan",
      "DescriptionMarkdownFile": "description.md",
      "ApiVersions": [
        "1.0"
      ],
      "Contact": {
        "Name": "SMLP Support",
        "Email": "support@smlp.local",
        "Url": "https://localhost:5001"
      },
      "License": {
        "Name": "Proprietary",
        "Url": "https://localhost:5001"
      },
      "Logo": {
        "Url": "https://localhost:5001/favicon.png",
        "Text": "logo-smlp"
      },
      "TermsOfServiceUrl": "https://localhost:5001"
    }
  },
  "HealthCheck": {
    "Endpoint": "/healthcheck",
    "UI": {
      "Enabled": true,
      "Storage": {
        "Provider": "SqlServer",
        "SqlServer": {
          "ConnectionString": ""
        }
      }
    }
  },
  "Logging": {
    "Provider": "None",
    "None": {
      "LogLevel": {
        "Default": "Debug",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Persistence": {
    "Provider": "SqlServer",
    "EnableSeeding": true,
    "SqlServer": {
      "ConnectionString": ""
    }
  },
  "Storage": {
    "Provider": "LocalFolder",
    "LocalFolder": {
      "FolderPath": "C:\\storages\\SMLP",
      "User": {
        "UserProfile": "\\User\\Profile"
      }
    }
  },
  "Telemetry": {
    "Provider": "None"
  }
