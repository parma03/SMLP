{
  "Audits": {
    "FilterMinimumYear": 2024,
    "FilterMaximumYear": 2030
  },
  "Documents": {
    "MaximumFileSizeInBytes": 15728640
  },
  "Jwt": {
    "SecretKey": "SMLP_SuperSecret_JWT_Key_2025_CoffeeShopLoyalty_MinLength32Chars",
    "Issuer": "SMLP",
    "Audience": "SMLP_Client",
    "ExpiryInMinutes": 480,
    "RefreshExpiryInDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:44992",
      "https://localhost:5001",
      "http://localhost:5000"
    ]
  },
  "BackEnd": {
    "BasePath": "/smlp_api"
  },
  "BackgroundJob": {
    "Provider": "Hangfire",
    "Hangfire": {
      "WorkerCount": 2,
      "IsJobRun": false,
      "Storage": {
        "Provider": "SqlServer",
        "SqlServer": {
          "ConnectionString": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=DB_SMLP;User ID=sa;Password=yourpassword;Pooling=False;Encrypt=True;Trust Server Certificate=True"
        }
      },
      "Dashboard": {
        "Url": "/jobs",
        "Username": "admin",
        "Password": "admin"
      }
    }
  },
  "Documentation": {
    "Provider": "Swagger",
    "Swagger": {
      "SwaggerPrefix": "swagger",
      "JsonEndpoint": "/swagger/$version$/swagger.json",
      "Description": "Back-End Services for SMLP - Sistem Manajemen Loyalitas Pelanggan",
      "DescriptionMarkdownFile": "description.md",
      "ApiVersions": [
        "1.0"
      ]
    }
  },
  "HealthCheck": {
    "Endpoint": "/healthcheck",
    "UI": {
      "Enabled": true,
      "Storage": {
        "Provider": "SqlServer",
        "SqlServer": {
          "ConnectionString": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=DB_SMLP;User ID=sa;Password=yourpassword;Pooling=False;Encrypt=True;Trust Server Certificate=True"
        }
      }
    }
  },
  "Logging": {
    "Provider": "None",
    "None": {
      "LogLevel": {
        "Default": "Debug",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Persistence": {
    "Provider": "SqlServer",
    "EnableSeeding": true,
    "SqlServer": {
      "ConnectionString": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=DB_SMLP;User ID=sa;Password=yourpassword;Pooling=False;Encrypt=True;Trust Server Certificate=True"
    }
  },
  "Storage": {
    "Provider": "LocalFolder",
    "LocalFolder": {
      "FolderPath": "C:\\storages\\SMLP",
      "User": {
        "UserProfile": "\\User\\Profile"
      }
    }
  },
  "Telemetry": {
    "Provider": "None"
  }
