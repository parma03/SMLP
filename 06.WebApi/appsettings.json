{
  "AppInfo": {
    "FullName": "Sistem Manajemen Loyalitas Pelanggan API",
    "ShortName": "SMLP API",
    "Description": "Coffee Shop Customer Loyalty Management System",
    "Version": "1.0.0"
  },
  "Jwt": {
    "SecretKey": "SMLP-SuperSecret-Key-ChangeInProduction-2025-Min32Chars!",
    "Issuer": "smlp-api",
    "Audience": "smlp-client",
    "ExpiryInMinutes": 480
  },
  "Authentication": {
    "Provider": "Jwt"
  },
  "Authorization": {
    "Provider": "None"
  },
  "Storage": {
    "Provider": "LocalFolder"
  },
  "LocalFolderStorage": {
    "FolderPath": "uploads"
  },
  "Email": {
    "Provider": "None",
    "Comment": "Ganti Provider ke 'Gmail' atau 'Smtp' dan isi Username+Password untuk mengaktifkan email",
    "Gmail": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Username": "",
      "Password": "",
      "DisplayName": "SMLP Coffee Loyalty",
      "UseStartTls": true,
      "UseSsl": false
    },
    "Smtp": {
      "Host": "mail.example.com",
      "Port": 587,
      "Username": "",
      "Password": "",
      "DisplayName": "SMLP Coffee Loyalty",
      "UseStartTls": true,
      "UseSsl": false
    }
  },
  "WhatsApp": {
    "Provider": "None",
    "Comment": "Ganti Provider ke 'Fonnte' dan isi ApiToken dari https://fonnte.com untuk mengaktifkan WhatsApp",
    "Fonnte": {
      "ApiToken": "",
      "DeviceId": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:44992",
      "https://localhost:5001",
      "http://localhost:5000"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SmlpDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "SqlServer": {
    "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=SmlpDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Persistence": {
    "Provider": "SqlServer"
  },
  "BackgroundJob": {
    "Provider": "None"
  },
  "HealthCheck": {
    "Endpoint": "/healthz",
    "UI": {
      "Enabled": true,
      "_comment": "Set Enabled=true dan isi Storage.SqlServer.ConnectionString untuk aktifkan Health Check UI",
      "AbsoluteUri": "http://localhost:5000",
      "Endpoints": {
        "UI": "/healthchecks-ui",
        "Api": "/healthchecks-api"
      },
      "Storage": {
        "Provider": "SqlServer"
      }
    }
  },
  "Logging": {
    "Provider": "None",
    "_comment_Provider": "Ganti 'None' ke 'Serilog' untuk aktifkan Serilog logging",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Serilog": {
      "Using": [
        "Serilog.Sinks.Console",
        "Serilog.Sinks.File"
      ],
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft": "Warning",
          "Microsoft.AspNetCore": "Warning",
          "Microsoft.EntityFrameworkCore": "Warning",
          "System": "Warning"
        }
      },
      "WriteTo": [
        {
          "Name": "Console",
          "Args": {
            "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
            "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {ApplicationName} {Message:lj}{NewLine}{Exception}"
          }
        },
        {
          "Name": "File",
          "Args": {
            "path": "logs/smlp-.log",
            "rollingInterval": "Day",
            "retainedFileCountLimit": 30,
            "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{ApplicationName}] {Message:lj}{NewLine}{Exception}"
          }
        }
      ],
      "Enrich": [
        "FromLogContext",
        "WithMachineName",
        "WithThreadId"
      ]
    }
  },
  "AllowedHosts": "*"
}
