{
  "Logging": {
    "Provider": "Serilog",
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    },
    "Serilog": {
      "Using": [
        "Serilog.Sinks.Console",
        "Serilog.Sinks.File"
      ],
      "MinimumLevel": {
        "Default": "Debug",
        "Override": {
          "Microsoft": "Information",
          "Microsoft.AspNetCore": "Warning",
          "Microsoft.EntityFrameworkCore": "Information",
          "System": "Information"
        }
      },
      "WriteTo": [
        {
          "Name": "Console",
          "Args": {
            "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
            "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {ApplicationName} {Message:lj}{NewLine}{Exception}"
          }
        },
        {
          "Name": "File",
          "Args": {
            "path": "logs/smlp-dev-.log",
            "rollingInterval": "Day",
            "retainedFileCountLimit": 7,
            "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
          }
        }
      ],
      "Enrich": [
        "FromLogContext",
        "WithMachineName",
        "WithThreadId"
      ]
    }
  },
  "Documentation": {
    "Provider": "Swagger",
    "Swagger": {
      "SwaggerPrefix": "swagger",
      "JsonEndpoint": "/swagger/$version$/swagger.json",
      "Description": "Back-End Services for SMLP - Sistem Manajemen Loyalitas Pelanggan (Development)",
      "DescriptionMarkdownFile": "description.md",
      "ApiVersions": [
        "1.0"
      ],
      "Contact": {
        "Name": "SMLP Support",
        "Email": "support@smlp.local",
        "Url": "https://localhost:5001"
      },
      "License": {
        "Name": "Proprietary",
        "Url": "https://localhost:5001"
      },
      "Logo": {
        "Url": "https://localhost:5001/favicon.png",
        "Text": "logo-smlp"
      },
      "TermsOfServiceUrl": "https://localhost:5001"
    }
  },
  "Logging_Service": {
    "Provider": "None"
  }
}