{
  "AppInfo": {
    "FullName": "Sistem Manajemen Loyalitas Pelanggan",
    "ShortName": "SMLP",
    "Description": "Platform CRM & Loyalty Management untuk Coffee Shop",
    "Version": "1.0.0"
  },
  "Documents": {
    "MaximumFileSizeInBytes": 5242880
  },
  "BackEnd": {
    "BaseUrl": "https://localhost:44991",
    "HealthCheck": {
      "Endpoint": "/healthcheck",
      "UI": {
        "Enabled": true,
        "Endpoint": "/healthcheck-ui"
      }
    }
  },
  "Authentication": {
    "RefreshRateInSeconds": 3500,
    "AllowGuest": true,
    "Provider": "None"
  },
  "Authorization": {
    "Provider": "None"
  },
  "External": {
    "Location": {
      "BaseUrl": "https://nominatim.openstreetmap.org",
      "EndpointPattern": "reverse?format=json&lat=[lat]&lon=[lon]"
    }
  },
  "FrontEnd": {
    "BasePath": "",
    "DisplayTechnicalInformation": true
  },
  "Geolocation": {
    "Enabled": false
  },
  "Logging": {
    "Provider": "None",
    "None": {
      "LogLevel": {
        "Default": "Debug",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Telemetry": {
    "Provider": "None"
  },
  "DetailedErrors": true
}
