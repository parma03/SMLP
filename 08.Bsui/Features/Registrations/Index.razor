@page "/ApplicantRegistration"

<BrowserTabTitle>@DisplayTextFor.Registration</BrowserTabTitle>
<PageHeader Title="@DisplayTextFor.Registration" />
<Loading IsVisible="@_isLoading" />

@if (!_isLoading)
{
    @if (_scholarships.Count > 0)
    {
        @foreach (var scholarship in _scholarships)
        {
            <MudCard Class="mt-2" Elevation="2">
                <MudCardContent>
                    <MudGrid Spacing="2">
                        <MudItem xs="10">
                            <MudText Typo="Typo.h5" Color="Color.Primary"><b>@scholarship.TitleBatch</b></MudText>
                            <MudText>Application Duedate: @scholarship.DueDate.ToString("dd MMM yyyy")</MudText>
                            <SfButton IsPrimary="true" CssClass="e-outline mt-4" Content="Details" OnClick="(() => OnClickDetail(scholarship))"></SfButton>
                        </MudItem>

                        <MudItem xs="2" Class="d-flex justify-end">
                            <MudImage Src="./img/logo.png" Width="180" Height="42" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudCollapse Expanded="@scholarship.Expanded">
                                <MudCard Elevation="4">
                                    <MudCardContent>
                                        <MudText Typo="Typo.h6" Color="Color.Info">@scholarship.Description</MudText>
                                    </MudCardContent>
                                    <MudCardActions Class="d-flex justify-end">
                                        <SfButton Content="Submit" IsPrimary="true" CssClass="mt-4" IconCss="e-icons e-changes-accept" OnClick="OnClickSubmit"></SfButton>
                                    </MudCardActions>
                                </MudCard>
                            </MudCollapse>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        }
    }
    else
    {
        <MudText Typo="Typo.h5">No scholarship posted</MudText>
    }
}

<DialogConfirmation Visibility="@_isVisiblePopup" IsProgressButton="true" Duration="1500"
                    Title="Submit Registration" Content="@_contentPopup"
                    DialogOpen="@DialogOpen" DialogClose="@DialogClose"
                    OnClickNo="@ClickedNo" OnClickYes="ClickedYes" />
