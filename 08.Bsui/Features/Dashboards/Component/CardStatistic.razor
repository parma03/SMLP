<MudCard Elevation="0" Class="kpi-card" Style="border:1px solid rgba(111,78,55,0.10); border-radius:12px;">
    <MudCardHeader>
        <CardHeaderAvatar>
            <MudAvatar Color="Color.Info">
                <MudIcon Icon="@Icons.Material.Rounded.People"></MudIcon>
            </MudAvatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Style="color:#8A7A6B; font-size:0.82rem;">@Judul</MudText>
            <MudText Typo="Typo.h5" Style="font-weight:800; color:#2E2019;">@Count</MudText>
        </CardHeaderContent>
    </MudCardHeader>
</MudCard>
