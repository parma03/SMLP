<MudCard Elevation="1">
    <MudCardHeader>
        <CardHeaderAvatar>
            <MudAvatar Color="Color.Info">
                <MudIcon Icon="@Icons.Material.Rounded.Message"></MudIcon>
            </MudAvatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudGrid>
                <MudItem>
                    <MudText Typo="Typo.h6" Class="mr-2">@JudulTask</MudText>
                </MudItem>
                <MudItem Class="pt-4">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mr-2">@DateTask</MudText>
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.body2">@ValueTask</MudText>
        </CardHeaderContent>
    </MudCardHeader>
</MudCard>
