@attribute [Authorize(Roles = "Admin,Owner")]
@page "/PointRules"

<BrowserTabTitle>Aturan Poin</BrowserTabTitle>
<PageHeader Title="Aturan Poin" Icon="@Icons.Material.Filled.Rule" />

<MudGrid>
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4 rounded-lg" Elevation="2">
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.subtitle1" Style="color:#6F4E37; font-weight:700;">Aturan Poin Aktif</MudText>
                <MudButton Variant="Variant.Filled" Style="background:#6F4E37; color:white;"
                           Size="Size.Small" StartIcon="@Icons.Material.Filled.Add">
                    Tambah Aturan
                </MudButton>
            </div>
            <MudTable Dense="true" Hover="true" Elevation="0" Items="@_empty">
                <HeaderContent>
                    <MudTh>Nama Aturan</MudTh>
                    <MudTh Style="text-align:right">Belanja (Rp)</MudTh>
                    <MudTh Style="text-align:right">Poin</MudTh>
                    <MudTh>Berlaku</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Aksi</MudTh>
                </HeaderContent>
                <NoRecordsContent>
                    <MudText Class="pa-4 text-center" Color="Color.Secondary">
                        Belum ada aturan poin. Klik "Tambah Aturan" untuk memulai.
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4 rounded-lg" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:#6F4E37; font-weight:700;">
                💡 Cara Kerja Poin
            </MudText>
            <MudList Dense="true">
                <MudListItem Icon="@Icons.Material.Filled.Circle">
                    Sistem menghitung poin berdasarkan total belanja
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Circle">
                    Contoh: Rp 10.000 = 1 poin
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Circle">
                    Member Gold mendapat 1.5× multiplier
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Circle">
                    Member Platinum mendapat 2× multiplier
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Circle">
                    Aturan bonus bisa ditambahkan untuk event khusus
                </MudListItem>
            </MudList>
        </MudPaper>
    </MudItem>
</MudGrid>
