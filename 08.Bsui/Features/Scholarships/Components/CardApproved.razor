<MudItem xs="12" Class="d-flex align-center">
	<MudCard Elevation="0" Class="flex-grow-1">
		<MudCardHeader>
        <CardHeaderAvatar>
            <MudAvatar Color="Color.Success">
                <MudIcon Icon="@Icons.Material.Filled.Check"></MudIcon>
            </MudAvatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText>Approved</MudText>
            <MudText Typo="Typo.h5">@Summary</MudText>
            </CardHeaderContent>
        </MudCardHeader>
    </MudCard>
	@if (!IsLast)
	{
		<MudHidden Breakpoint="Breakpoint.SmAndDown">
			<MudDivider Vertical="true" Class="mx-2" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
		</MudHidden>
	}
</MudItem>

@code {
    [Parameter]
    public string Summary { get; set; } = default!;
	[Parameter]
	public bool IsLast { get; set; } = false;
}
