@page "/Scholarships/ScholarshipPlan/Draft"

<BrowserTabTitle>@DisplayTextFor.DraftScholarshipPlan</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    @if (IsAllowScholarshipPlanCrud)
    {
        <MudTabPanel Text="@DisplayTextFor.DraftingScholarshipPlan">
            <Smlp.Bsui.Features.Scholarships.ScholarshipPlan.Draft.Components.DraftScholarshipPlan></Smlp.Bsui.Features.Scholarships.ScholarshipPlan.Draft.Components.DraftScholarshipPlan>
        </MudTabPanel>
        <MudTabPanel Text="@DisplayTextFor.FinalScholarshipPlan">
            <Smlp.Bsui.Features.Scholarships.ScholarshipPlan.Draft.Components.FinalScholarshipPlan></Smlp.Bsui.Features.Scholarships.ScholarshipPlan.Draft.Components.FinalScholarshipPlan>
        </MudTabPanel>
    }    
</MudTabs>

<MudGrid Class="mt-2">
    <MudItem xs="12" Style="text-align: left;">
        <SfButton OnClick="OnClickBack" Content="Back" IconCss="e-icons e-arrow-left" CssClass="e-outline e-danger"></SfButton>
    </MudItem>
</MudGrid>

<style>
    .mud-tabs-panels {
        min-height: 500px;
    }
</style>
