@page "/Scholarships"

<BrowserTabTitle>@DisplayTextFor.ScholarshipPlan</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    @if (IsShowScholarshipPlan)
    {
        <MudTabPanel Text="@DisplayTextFor.ScholarshipPlan">
            <Psmp.Bsui.Features.Scholarships.ScholarshipPlan.Index></Psmp.Bsui.Features.Scholarships.ScholarshipPlan.Index>
        </MudTabPanel>
    }
    @if (IsShowScholarshipPosting)
    {
        <MudTabPanel Text="@DisplayTextFor.ScholarshipPosting">
            <Psmp.Bsui.Features.Scholarships.SholarshipPosting.Index></Psmp.Bsui.Features.Scholarships.SholarshipPosting.Index>
        </MudTabPanel>
    }
</MudTabs>

<style>
    .mud-tabs-panels {
        min-height: 500px;
    }
</style>
