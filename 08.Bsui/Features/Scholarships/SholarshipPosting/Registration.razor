@page "/Scholarships/SholarshipPosting/Registration/{IsCreated:bool}"
@page "/Scholarships/SholarshipPosting/Registration/{IsCreated:bool}/{RegistrationId:guid}"
@using Smlp.Shared.Scholarships.ScholarshipPlan.Queries

<ErrorViewer Error="_error" />
<BrowserTabTitle>@DisplayTextFor.ScholarshipPosting</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>
@if (_isLoading)
{
    <Loading IsVisible="_isLoading" />
}
else
{
    <MudGrid Spacing="2">
        <MudItem xs="12">
            <MudCard>
                <MudCardContent Class="px-16">
                    <MudItem xs="12" Class="mb-4">
                        <MudText Typo="Typo.h6">Specific Requirement</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Scholarship Code</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfTextBox ID="txtCode" Placeholder="Input Code" @bind-Value="UpdateDataScholarshipPosting.Code" Enabled="false"></SfTextBox>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Holding/ Sub Holding/ AP Services & Portfolio</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfDropDownList ID="ddlCompanyGroup" TValue="int" Enabled="false" TItem="GetCompanyGroupQueryResponse" DataSource="@_companyGroups" @bind-Value="UpdateDataScholarshipPosting.CompanyGroupId"
                                                AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" Placeholder="Select Company Group">
                                    <DropDownListEvents TItem="GetCompanyGroupQueryResponse" TValue="int" ValueChange="@OnChangeCompanyGroupAsync"></DropDownListEvents>
                                    <DropDownListFieldSettings Text="Name" Value="Id"></DropDownListFieldSettings>
                                </SfDropDownList>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Company Name</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfDropDownList ID="ddlCompany" TValue="string" TItem="GetCompanyQueryResponse" Enabled="false" DataSource="@_companies" @bind-Value="UpdateDataScholarshipPosting.CompanyCode"
                                                AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" Placeholder="Select Company">
                                    <DropDownListEvents TItem="GetCompanyQueryResponse" TValue="string" ValueChange="@OnChangeCompanyAsync"></DropDownListEvents>
                                    <DropDownListFieldSettings Text="Name" Value="Code" />
                                </SfDropDownList>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Directorate</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfDropDownList ID="ddlDirectorate" TValue="int" TItem="GetDirectorateQueryResponse" Enabled="false" DataSource="@_directorates" @bind-Value="UpdateDataScholarshipPosting.DirectorateId"
                                                AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" Placeholder="Select Directorate">
                                    <DropDownListEvents TItem="GetDirectorateQueryResponse" TValue="int" ValueChange="@OnChangeDirectorateAsync"></DropDownListEvents>
                                    <DropDownListFieldSettings Text="Name" Value="Id" />
                                </SfDropDownList>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Function <span style="color:red;">*</span></MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfDropDownList ID="ddlFunction" TValue="int" TItem="GetFungsiResponse" Enabled="IsAllowEdit" DataSource="@_fungsis" @bind-Value="UpdateDataScholarshipPosting.FungsiId"
                                                AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" Placeholder="Select Directorate">
                                    <DropDownListEvents TItem="GetFungsiResponse" TValue="int" ValueChange="@OnChangeFungsiAsync"></DropDownListEvents>
                                    <DropDownListFieldSettings Text="Name" Value="Id" />
                                </SfDropDownList>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Division</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfDropDownList ID="ddlDivision" TValue="int" TItem="GetDivisionQueryResponse" Enabled="false" DataSource="@_divisions" @bind-Value="UpdateDataScholarshipPosting.DivisionId"
                                                AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" Placeholder="Select Division">
                                    <DropDownListFieldSettings Text="Name" Value="Id" />
                                </SfDropDownList>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Business Issues</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfTextArea ID="txtBusinessIssues" Placeholder="Standarisasi proses safety and asset integrity di seluruh wilayah kerja Pertamina" RowCount="2" ColumnCount="500"
                                            Disabled="true" @bind-Value="UpdateDataScholarshipPosting.BusinessIssue"></SfTextArea>
                                @* Disabled="@(IsAllowEdit == false)" pakai ini untuk disable SfTextArea*@
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>References of Business Issues</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfTextArea ID="txtBusinessIssueReferences" Placeholder="RJPP&#10;Proses Bisnis Pertamina" RowCount="2" ColumnCount="500"
                                            Disabled="true" @bind-Value="UpdateDataScholarshipPosting.BusinessIssueReferences"></SfTextArea>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Performance Issues</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfTextArea ID="txtPerformanceIssue" Placeholder="Prequent proses safety incident occurance, high depedence on external consultant expertise on process safety issues, low ESG score (Prevention of Major Accident Aspect) " RowCount="2" ColumnCount="500"
                                            Disabled="true" @bind-Value="UpdateDataScholarshipPosting.PerformanceIssue"></SfTextArea>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Competency Issues</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfTextArea ID="txtCompetencyIssue" Placeholder="Strategic Management" RowCount="2" ColumnCount="500"
                                            Disabled="true" @bind-Value="UpdateDataScholarshipPosting.CompetencyIssue"></SfTextArea>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Project Innovation</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfTextArea ID="txtProjectInnovation" Placeholder="Project Innovation" RowCount="2" ColumnCount="500"
                                            Disabled="true" @bind-Value="UpdateDataScholarshipPosting.ProjectInovation"></SfTextArea>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Degree</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfDropDownList ID="ddlDegree" TValue="int" TItem="GetDegreeQueryResponse" DataSource="@_degrees" Enabled="false" @bind-Value="UpdateDataScholarshipPosting.DegreeId"
                                                AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" Placeholder="Select Degree">
                                    <DropDownListFieldSettings Text="Name" Value="Id" />
                                </SfDropDownList>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Faculty</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfTextArea ID="txtFaculty" RowCount="2" ColumnCount="500" Placeholder="Input Faculty" @bind-Value="UpdateDataScholarshipPosting.Faculty" Disabled="true"></SfTextArea>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Major</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfTextArea ID="txtMajor" RowCount="2" ColumnCount="500" Placeholder="Input Major" @bind-Value="UpdateDataScholarshipPosting.Major" Disabled="true"></SfTextArea>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>University Reference</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfTextBox ID="txtUniversityReference" Placeholder="Input University Reference" Enabled="false" @bind-Value="UpdateDataScholarshipPosting.UniversityReference"></SfTextBox>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>University Location</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfDropDownList ID="ddlUniversityLocation" TValue="int" TItem="DropdownItemResponse" Enabled="false" DataSource="@_locations" @bind-Value="UpdateDataScholarshipPosting.UniversityLocation"
                                                Placeholder="Select University Location">
                                    <DropDownListFieldSettings Text="Description" Value="Id" />
                                </SfDropDownList>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Latest Education Background (Level & Major)</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfTextBox ID="txtLatestEducation" Placeholder="Input Latest Education Background" Enabled="false" @bind-Value="UpdateDataScholarshipPosting.LatestEducation"></SfTextBox>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Minimum Working Experience (Years & Field)</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfTextBox ID="txtWorkingExperience" Placeholder="Input Working Experience" Enabled="false" @bind-Value="UpdateDataScholarshipPosting.WorkingExperience"></SfTextBox>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Scope</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfDropDownList ID="ddlScope" TValue="int" TItem="DropdownItemResponse" DataSource="@_scopes" Enabled="false" @bind-Value="UpdateDataScholarshipPosting.Scope"
                                                Placeholder="Select Scope">
                                    <DropDownListFieldSettings Text="Description" Value="Id" />
                                </SfDropDownList>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Awardee Quota</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfNumericTextBox ID="txtAwardeeQuota" Min="0" Max="_maxQuota" @bind-Value="UpdateDataScholarshipPosting.AwardeeQuota"></SfNumericTextBox>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Batch</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfNumericTextBox ID="txtBatch" Min="1" Max="15" @bind-Value="UpdateDataScholarshipPosting.Batch" Enabled="false"></SfNumericTextBox>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Selection Category</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfDropDownList ID="ddlSelectionType" TValue="int" TItem="DropdownItemResponse" Enabled="IsCreated" DataSource="@_selectionTypes" @bind-Value="UpdateDataScholarshipPosting.SelectionType"
                                                Placeholder="Select Selection category">
                                    <DropDownListFieldSettings Text="Description" Value="Id" />
                                </SfDropDownList>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Application Due Date <span style="color:red;">*</span></MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfDatePicker ID="txtBatch" @ref="@DatePickerObj" @bind-Value="UpdateDataScholarshipPosting.DueDate" Enabled="true" Format="dd.MM.yyyy">
                                    <DatePickerEvents TValue="DateTimeOffset?" OnRenderDayCell="@DisableDate"></DatePickerEvents>
                                </SfDatePicker>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Posting Year</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfNumericTextBox ID="txtPostingYear" Min="0" Max="2050" @bind-Value="UpdateDataScholarshipPosting.PostingYear" Format="###.##" FloatLabelType="@FloatLabelType.Always" Enabled="true"></SfNumericTextBox>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>TOEFL Score<span style="color:red;">*</span></MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfNumericTextBox ID="txtTOEFLScore" Placeholder="TOEFL Score" @bind-Value="UpdateDataScholarshipPosting.TOEFLScore" Enabled="false"></SfNumericTextBox>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                </MudCardContent>
            </MudCard>

            <br />

            <MudCard>
                <MudCardContent Class="px-16">
                    <MudItem xs="12">
                        <MudText Typo="Typo.h6">Administrative Selection Criteria</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Minimum PRL Individu/BS</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfNumericTextBox ID="txtMinPrl" Min="10" Max="30" @bind-Value="UpdateDataScholarshipPosting.MinimumPrl" Enabled="false"></SfNumericTextBox>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Maximum Age</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfNumericTextBox ID="txtMaxAge" Min="18" Max=60 @bind-Value="UpdateDataScholarshipPosting.MaximumAge" Enabled="false"></SfNumericTextBox>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Minimum Work Period</MudText>
                            </MudItem>
                            <MudItem xs="6">
                                <SfNumericTextBox ID="txtMinWorkPeriod" Min="0" Max="40" @bind-Value="UpdateDataScholarshipPosting.MinimumWorkPeriod" Enabled="false"></SfNumericTextBox>
                            </MudItem>
                            <MudItem xs="2">
                                <b>Years</b>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Average Performance Rating Last 3 Years</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfTextBox ID="txtPerformanceRating" @bind-Value="UpdateDataScholarshipPosting.PerformanceRating" Enabled="false"></SfTextBox>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Indiciplinary Record Last 3 Years (SAP Based)</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfDropDownList ID="ddlIndiciplinaryStatus" TValue="int" Enabled="false" TItem="DropdownItemResponse" DataSource="@_indiciplinaries" @bind-Value="UpdateDataScholarshipPosting.IndiciplinaryStatus"
                                                Placeholder="Select Indiciplinary Status">
                                    <DropDownListFieldSettings Text="Description" Value="Id" />
                                </SfDropDownList>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>MCU Status</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfDropDownList ID="ddlMcuStatus" TValue="int" TItem="DropdownItemResponse" Enabled="false" DataSource="@_mcu" @bind-Value="UpdateDataScholarshipPosting.McuStatus"
                                                Placeholder="Select MCU Status">
                                    <DropDownListFieldSettings Text="Description" Value="Id" />
                                </SfDropDownList>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="4">
                                <MudText>Posting Date</MudText>
                            </MudItem>
                            <MudItem xs="8">
                                <SfDatePicker ID="PostingDate" @ref="@DatePickerObj" @bind-Value="UpdateDataScholarshipPosting.PostingDate" Enabled="true" Format="dd.MM.yyyy">
                                    <DatePickerEvents TValue="DateTimeOffset?" OnRenderDayCell="@DisableDate"></DatePickerEvents>
                                </SfDatePicker>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                </MudCardContent>
            </MudCard>
            <br />

            <MudItem xs="12" Class="mt-4">
                <MudGrid>
                    <MudItem xs="4">
                        <SfButton OnClick="OnClickCancelAsync" Content="Back" IconCss="e-icons e-arrow-left" CssClass="e-outline e-danger"></SfButton>
                    </MudItem>
                    <MudItem xs="8">
                        <MudGrid xs="12">
                            @if (IsAllowEdit)
                            {
                                <MudItem xs="2">
                                    <SfProgressButton Content="@(IsCreated ? "RePosting" : "Save")" CssClass="e-primary" EnableProgress="true" IconCss="e-icons e-save-as"
                                                      Disabled="@VisibleSave" OnClick="OnClickSave" Duration="3000">
                                        <ProgressButtonSpinSettings Position="SpinPosition.Center"></ProgressButtonSpinSettings>
                                        <ProgressButtonAnimationSettings Effect="Syncfusion.Blazor.SplitButtons.AnimationEffect.SlideRight"></ProgressButtonAnimationSettings>
                                    </SfProgressButton>
                                </MudItem>
                            }

                            @if (UpdateDataScholarshipPosting.Status == ScholarshipPostingStatus.Closed)
                            {
                                <MudItem xs="2">
                                    <SfProgressButton Content="Complete" CssClass="e-info" EnableProgress="true" IconCss="e-icons e-save"
                                                      Disabled="@VisibleSave" OnClick="OnClickSave" Duration="3000">
                                        <ProgressButtonSpinSettings Position="SpinPosition.Center"></ProgressButtonSpinSettings>
                                        <ProgressButtonAnimationSettings Effect="Syncfusion.Blazor.SplitButtons.AnimationEffect.SlideRight"></ProgressButtonAnimationSettings>
                                    </SfProgressButton>
                                </MudItem>
                            }

                            @if (UpdateDataScholarshipPosting.Status == ScholarshipPostingStatus.WaitingForApproval)
                            {
                                <MudItem xs="2">
                                    <SfProgressButton Content="Publish" CssClass="e-success" EnableProgress="true" IconCss="e-icons e-rephrase"
                                                      Disabled="@VisibleSave" OnClick="@(e => OnClickPublish(UpdateDataScholarshipPosting.Id))" Duration="3000">
                                        <ProgressButtonSpinSettings Position="SpinPosition.Center"></ProgressButtonSpinSettings>
                                        <ProgressButtonAnimationSettings Effect="Syncfusion.Blazor.SplitButtons.AnimationEffect.SlideRight"></ProgressButtonAnimationSettings>
                                    </SfProgressButton>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudItem>
                </MudGrid>
            </MudItem>

        </MudItem>
    </MudGrid>

    <DialogConfirmation Visibility="VisiblePopup"
                        Title="@DisplayTextFor.ScholarshipPlan"
                        Content="Are you sure want to close this page?"
                        DialogOpen="DialogOpen" DialogClose="DialogClose"
                        OnClickNo="ClickedNo" OnClickYes="ClickedYes"></DialogConfirmation>
}

