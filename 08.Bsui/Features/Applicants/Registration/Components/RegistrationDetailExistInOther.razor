<style>
    .dialog-header-red {
        background-color: #f44336; /* merah */
        color: white;
        padding: 12px 16px;
        font-weight: bold;
        border-top-left-radius: 4px;
        border-top-right-radius: 4px;
    }
</style>

<MudDialog>
    <TitleContent>
        <div class="dialog-header-red">
            Application Status
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="2" Class="d-flex align-center justify-center mud-width-full">
                <MudIcon Icon="@Icons.Material.Rounded.Cancel" Color="Color.Error" Size="Size.Large" />
            </MudItem>
            <MudItem xs="10">
                For information, you <b>have been registered</b> to participate in other Scholarship Program.<br />
                Code  : <b>@Code</b><br />
                Stage : <b>@SelectionStage!.GetDescription()</b>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <SfButton Content="Close" CssClass="e-outline e-primary"
                  OnClick="OnClickClose"></SfButton>
    </DialogActions>
</MudDialog>
