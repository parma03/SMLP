<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Content.CompanyGroupName @Content.PostingYear @Content.DegreeName @Content.Faculty @Content.Major @Content.Code</MudText>
        <MudText>Application Due Date: @Content.DueDate?.ToString("dd MMM yyyy")</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.h6">Details</MudText>
        <MudGrid Spacing="0">
            <MudItem xs="3">
                <MudText Class="pt-6">Company Name</MudText>
            </MudItem>
            <MudItem xs="1" />
            <MudItem xs="8">
                <MudTextField T="string" Text="@Content.CompanyName" ReadOnly />
            </MudItem>
            <MudItem xs="3">
                <MudText Class="pt-6">Directorate</MudText>
            </MudItem>
            <MudItem xs="1" />
            <MudItem xs="8">
                <MudTextField T="string" Text="@Content.DirectorateName" ReadOnly />
            </MudItem>
            <MudItem xs="3">
                <MudText Class="pt-6">Division</MudText>
            </MudItem>
            <MudItem xs="1" />
            <MudItem xs="8">
                <MudTextField T="string" Text="@Content.DivisionName" ReadOnly />
            </MudItem>
            <MudItem xs="3">
                <MudText Class="pt-6">Business Issue</MudText>
            </MudItem>
            <MudItem xs="1" />
            <MudItem xs="8">
                <MudTextField T="string" Text="@Content.BusinessIssue" AutoGrow ReadOnly />
            </MudItem>
            <MudItem xs="3">
                <MudText Class="pt-6">References of Business Issues</MudText>
            </MudItem>
            <MudItem xs="1" />
            <MudItem xs="8">
                <MudTextField T="string" Text="@Content.BusinessIssueReferences" AutoGrow ReadOnly />
            </MudItem>
            <MudItem xs="3">
                <MudText Class="pt-6">Performance Issue</MudText>
            </MudItem>
            <MudItem xs="1" />
            <MudItem xs="8">
                <MudTextField T="string" Text="@Content.PerformanceIssue" AutoGrow ReadOnly />
            </MudItem>
            <MudItem xs="3">
                <MudText Class="pt-6">Competency Issue</MudText>
            </MudItem>
            <MudItem xs="1" />
            <MudItem xs="8">
                <MudTextField T="string" Text="@Content.CompetencyIssue" AutoGrow ReadOnly />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <SfButton Content="Cancel" CssClass="e-outline e-danger"
                  OnClick="OnClickCancel"></SfButton>
        <SfProgressButton IsPrimary="true" Content="Apply" CssClass="e-primary" EnableProgress="true" Duration="2400"
                          OnClick="OnClickApply">
            <ProgressButtonSpinSettings Position="SpinPosition.Center"></ProgressButtonSpinSettings>
            <ProgressButtonAnimationSettings Effect="Syncfusion.Blazor.SplitButtons.AnimationEffect.SlideRight"></ProgressButtonAnimationSettings>
        </SfProgressButton>
    </DialogActions>
</MudDialog>
