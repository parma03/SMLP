@page "/ProjectApplicant"

@using Smlp.Bsui.Features.Applicants.Projects.Components
@using Smlp.Shared.Projects.Constants

@inject IWebHostEnvironment _webHostEnvironment
@inject IOptions<HrisOptions> _hrisOptions

<BrowserTabTitle>@DisplayTextFor.InnovationProject</BrowserTabTitle>
<PageHeader Title="@DisplayTextFor.InnovationProject" />
@* <MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs> *@

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" ActivePanelIndex="@_activeTabIndex" ActivePanelIndexChanged="@(e => OnTabChanged(e))">
    <MudTabPanel Text="@DisplayTextFor.ProjectPlan">
        <ProjectPlan/>
    </MudTabPanel>
	<MudTabPanel Text="@DisplayTextFor.ProjectMonitoring">
        <ProjectMentoring/>
	</MudTabPanel>
	@if (_statusProjectPlan)
	{
		<MudTabPanel Text="@DisplayTextFor.ProjectCharterPlan">
			<ProjectCharterPlan />
		</MudTabPanel>
	}

	@if (_statusProjectCharterPlan && _statusProjectPlan)
	{
		<MudTabPanel Text="@DisplayTextFor.ProjectCharterReal">
			<ProjectCharterRealisation />
		</MudTabPanel>
	}
	
</MudTabs>

<style>
    .mud-tabs-panels {
        min-height: 500px;
    }
</style>
