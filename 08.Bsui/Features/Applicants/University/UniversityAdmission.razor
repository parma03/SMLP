@inject IWebHostEnvironment _webHostEnvironment
@inject IOptions<HrisOptions> _hrisOptions

@using Smlp.Base.Universities.Enums
@using Smlp.Shared.Universities.Constants

<style>
	.text-center {
	text-align: center;
	}

	.border-item {
	border: 1px solid;
	border-radius: 6px;
	}

	.text-item {
	font-size: 14px !important;
	}
</style>
<BrowserTabTitle>@DisplayTextFor.University</BrowserTabTitle>
<ErrorViewer Error="@Error" />
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>

@if (_isLoading)
{
	<Loading IsVisible="_isLoading" />
}
else
{
	@if (_isCanView)
	{
		<MudGrid Spacing="2">
			<MudGrid>
				@* <MudItem xs="12">
					<MudText Typo="Typo.body1" HtmlTag="h3">
						Hello <b>@_displayName</b>, Welcome to university registration page.<br />
						Please submit your study preparation, thank you!
					</MudText>
				</MudItem> *@
				<MudItem xs="12">
					<MudGrid>
						@* <MudItem xs="1" Class="justify-end">
                            <SfButton OnClick="OnClickAddAsync" Content="Add University" IconCss="e-icons e-circle-add" CssClass="e-info"></SfButton>
                        </MudItem> *@
						<MudItem xs="1" Class="justify-end">
							@if (_isButtonVisible)
							{
								<SfButton OnClick="OnClickAddAsync" Content="Add University" IconCss="e-icons e-circle-add" CssClass="e-info"></SfButton>
							}
						</MudItem>
					</MudGrid>
				</MudItem>
				@foreach (var item in _dataGrid)
				{
					<MudItem xs="12" Class="mt-3">
						<MudCard Class="pa-4" Elevation="2">
							<MudCardContent>
								<MudGrid>
                                    <MudItem xs="12">
                                        <MudText Typo="Typo.body1" HtmlTag="h3">
                                            Hello <b>@_displayName</b>, welcome to project page.<br />
                                            Please submit your project plan, thank you
                                        </MudText>
                                    </MudItem>
                                    <MudDivider Class="mb-2" />
									<MudItem xs="8">
										<MudGrid>
											<MudItem xs="12">
												<p style="font-size: 30px">@item.University</p>
												<SfChip>
													<ChipItems>
														<ChipItem Text="@item.Country" CssClass="text-item" TrailingIconCss="e-icons e-location"></ChipItem>
														@if (item.Status == AdmissionStatus.Completed)
														{
															<ChipItem Text="Completed" CssClass="e-success text-item"></ChipItem>
														}
														else if (item.Status == AdmissionStatus.WaitingApproval)
														{
															<ChipItem Text="Waiting for Approval" CssClass="e-info text-item"></ChipItem>
														}
														else if (item.Status == AdmissionStatus.Approved)
														{
															<ChipItem Text="Approved" CssClass="e-warning text-item"></ChipItem>
														}
														else if (item.Status == AdmissionStatus.Submitted)
														{
															<ChipItem Text="Submitted" CssClass="text-item"></ChipItem>
														}
														else if (item.Status == AdmissionStatus.Rejected)
														{
															<ChipItem Text="Rejected" CssClass="e-danger text-item"></ChipItem>
														}
													</ChipItems>
												</SfChip>
											</MudItem>
											@*  <MudItem xs="12">
                                                <MudGrid>
                                                    <MudItem xs="3" Class="text-center border-item">
                                                        <MudGrid>
                                                            <MudItem xs="12">
                                                                <MudText Class="ms-0"><h3>@DisplayTextFor.ApplicationDeadline</h3></MudText>
                                                                <MudText Class="ms-0 mt-1"><h4>@item.Dateline.ToString("dd.MM.yyyy")</h4></MudText>
                                                                <MudText Class="ms-0 mt-1" Style="font-weight: bold; font-size: 20px;">@((Convert.ToDateTime(item.Dateline.ToString()) - DateTime.Now).Days) Days left</MudText>
                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudItem>
                                                </MudGrid>

                                            </MudItem> *@
										</MudGrid>
									</MudItem>
									<MudItem xs="4">
										<MudItem xs="12" Style="min-height: 175px;">
											<img src="img/univ.png" alt="icon scholarship" width="180" />
										</MudItem>
										<MudItem xs="12" Style="text-align: right;">
											<SfButton OnClick="@(e => OnClickDetail(item.Id))" Content="Details" CssClass="e-info"></SfButton>
										</MudItem>
									</MudItem>
								</MudGrid>
							</MudCardContent>
                            <MudDivider />
                            <MudCardContent>
                                <MudGrid>
                                    <MudItem xs="12">
                                        @if (!_isButtonVisible)
                                        {
                                            <MudGrid Class="mb-2">
                                                <Smlp.Bsui.Features.Universities.AdmissionDetail.Components.FinalLetter IsRead="true" Id="@(_dataGrid.FirstOrDefault()!.AdmissionId)"></Smlp.Bsui.Features.Universities.AdmissionDetail.Components.FinalLetter>
                                            </MudGrid>
                                        }
                                    </MudItem>
                                </MudGrid>
                            </MudCardContent>
						</MudCard>
					</MudItem>
				}
			</MudGrid>
		</MudGrid>

		<Smlp.Bsui.Features.Applicants.University.Components.DialogAddUniversityAdmission Visibility="VisiblePopup"
																						  Title="@TitlePopup"
																						  IsEnabled="@IsEnabled"
																						  DialogOpen="DialogOpen"
																						  DialogClose="DialogClose"
																						  OnClickNo="ClickedNo"
																						  OnClickYes="ClickedYes"
																						  listUniversities="_dropdownUnivesity"
																						  listStudyTimes="_dropdownStudyTime"
																						  request="_createAdmissionSuperiorLetterRequest"
																						  OnRemoveUploaderLoA="OnRemoveUploaderLoA"
																						  ValueChangeUploaderLoA="ValueChangeUploaderLoA"
																						  OnRemoveUploaderSuperiorApproval="OnRemoveUploaderSuperiorApproval"
																						  ValueChangeUploaderSuperiorApproval="ValueChangeUploaderSuperiorApproval"
																						  MaxFileSize="_maximumFileSizeInBytes">
        </Smlp.Bsui.Features.Applicants.University.Components.DialogAddUniversityAdmission>
	}
	else
	{
		<br />
		<MudText Typo="Typo.h4">Not available @DisplayTextFor.UniversityAdmission</MudText>
	}
}
