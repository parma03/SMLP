@page "/ApplicantUniversity"
@page "/ApplicantUniversity/{TabIndex:int}"

@inject IWebHostEnvironment _webHostEnvironment
@inject IOptions<HrisOptions> _hrisOptions

@using Psmp.Shared.Universities.Constants

<BrowserTabTitle>@DisplayTextFor.University</BrowserTabTitle>
<PageHeader Title="@DisplayTextFor.University" />

@if (_isCanView)
{
    <MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>
    <ErrorViewer Error="@Error" />
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" ActivePanelIndex="@_activeTabIndex" ActivePanelIndexChanged="@(e => OnTabChanged(e))">
        @if (IsShowUniversityRecommendation)
        {
            <MudTabPanel Text="@DisplayTextFor.UniversityRecommendation">
                <UniversityRecommendation>

                </UniversityRecommendation>
            </MudTabPanel>
        }
        @if (IsShowUniversityAdmission)
        {
            <MudTabPanel Text="@DisplayTextFor.UniversityAdmission">
                <UniversityAdmission>

                </UniversityAdmission>
            </MudTabPanel>
        }
    </MudTabs>
}
else
{
    <br />
    <MudText Typo="Typo.h4">Not available @DisplayTextFor.University</MudText>    
}

<style>
    .mud-tabs-panels {
        min-height: 500px;
    }
</style>
