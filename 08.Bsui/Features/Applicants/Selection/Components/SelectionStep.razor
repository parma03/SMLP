@using Syncfusion.Blazor.Layouts

<div class="col-lg-12 control-section">
    <div class="default-timeline-section">
        <SfTimeline ID="default" Orientation="Syncfusion.Blazor.Layouts.TimelineOrientation.Horizontal">
            <TimelineItems>
                @foreach (var item in StepperSource)
                {
                    @if (!string.IsNullOrEmpty(item.ApplicantStatusText))
                    {
                        <TimelineItem DotCss="@item.DotCss" CssClass="@item.ClassCss">
                            <OppositeContent>
                                <div class="@item.DotCss" style="padding: 8px 12px;">
                                    <b>@item.ApplicantStatusText</b>
                                </div>
                            </OppositeContent>
                            <Content>
                                @if ((item.ApplicantStatus == Base.Selections.Enums.ApplicantStatus.InProgress
                             || item.ApplicantStatus == Base.Selections.Enums.ApplicantStatus.Passed)
                             && (item.SelectionStage == Base.Selections.Enums.SelectionStage.TOEFL
                             || item.SelectionStage == Base.Selections.Enums.SelectionStage.Psychotest))
                                {
                                    <SfTooltip Content="Click here to see detail." Position="Syncfusion.Blazor.Popups.Position.TopLeft">
                                        <SfButton CssClass="e-flat e-info" Content="@item.SelectionStageText"
                                        @onclick="@(() => OnClickStep(item.SelectionStage, ApplicantId, ScholarshipId, item.SelectionStageText))"></SfButton>
                                    </SfTooltip>
                                }
                                else if (item.SelectionStage == Base.Selections.Enums.SelectionStage.TalentReview
                                || item.SelectionStage == Base.Selections.Enums.SelectionStage.TalentReview_2
                                || item.SelectionStage == Base.Selections.Enums.SelectionStage.Decree)
                                {
                                    if (item.ApplicantStatus == Base.Selections.Enums.ApplicantStatus.Failed)
                                    {
                                        @item.SelectionStageText
                                    }
                                    else
                                    {
                                        <SfTooltip Content="Click here to see detail." Position="Syncfusion.Blazor.Popups.Position.TopLeft">
                                            <SfButton CssClass="e-flat e-info" Content="@item.SelectionStageText"
                                                      @onclick="@(() => OnClickStep(item.SelectionStage, ApplicantId, ScholarshipId, item.SelectionStageText))"></SfButton>
                                        </SfTooltip>
                                    }                        
                                }
                                else
                                {
                                    @item.SelectionStageText
                                }
                            </Content>
                        </TimelineItem>
                    }
                    else
                    {
                        <TimelineItem>
                            <OppositeContent><b>@item.ApplicantStatusText</b></OppositeContent>
                            <Content>@item.SelectionStageText</Content>
                        </TimelineItem>
                    }
                }
            </TimelineItems>
        </SfTimeline>
    </div>
</div>

<style>
    .e-btn {
        height: 32px;
    }

    /* Customized dot color */
    .default-timeline-section .state-progress {
        outline-color: #007bff;
        background-color: #007bff;
        --dot-size: 25px;
    }

    .default-timeline-section .state-success {
        outline-color: #28a745;
        background-color: #28a745;
    }

    .default-timeline-section .state-failed {
        outline-color: #d13438;
        background-color: #d13438;
    }

    /* Customized connector color */
    .default-timeline-section .completed.e-connector::after {
        border-color: #28a745;
    }

    .default-timeline-section .intermediate.e-connector::after {
        border-style: dashed;
    }

    .default-timeline-section {
        height: 350px;
        /* width: 520px; margin: 30px auto 30px calc(50% - 350px); */
    }

    .state-success {
        background-color: #28a745;
        border-color: #28a745;
        border-radius: 4px;
        color: white;
    }

    .state-progress {
        background-color: #ffa500;
        border-color: #ffa500;
        border-radius: 4px;
        color: white;
    }

    .state-failed {
        background-color: #d13438;
        border-color: #d13438;
        border-radius: 4px;
        color: white;
    }
</style>
