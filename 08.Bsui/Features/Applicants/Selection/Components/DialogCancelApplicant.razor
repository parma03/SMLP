<MudDialog>
    <TitleContent>
        <h3>
            Cancel Applicant
        </h3>
    </TitleContent>
    <DialogContent>
        <SfTextArea ID="txtReason" Placeholder="Input Reason (Minimum 10 Characters)" RowCount="2"
                    ColumnCount="@CommonMaximumLengthFor.LargeText"
                    @bind-Value="Reason"></SfTextArea>
    </DialogContent>
    <DialogActions>
        <SfButton Content="Close" CssClass="e-info e-outline" OnClick="OnClickClose"></SfButton>
        <SfProgressButton Content="Yes" CssClass="e-danger" EnableProgress="true"
                          OnClick="OnClickYesAsync">
            <ProgressButtonSpinSettings Position="SpinPosition.Center"></ProgressButtonSpinSettings>
            <ProgressButtonAnimationSettings Effect="Syncfusion.Blazor.SplitButtons.AnimationEffect.ZoomOut"></ProgressButtonAnimationSettings>
        </SfProgressButton>
    </DialogActions>
</MudDialog>
