@using Psmp.Base.Selections.Enums

<MudDialog>
    <TitleContent>
        <h3>
            @SelectionStageText
        </h3>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_scheduleTest))
        {
            <div>
                <h4>Schedule Test</h4>
                <MudGrid Class="mt-2">
                    <MudItem xs="6" sm="4" Class="pa-0">
                        Schedule Date
                    </MudItem>
                    <MudItem xs="6" sm="8" Class="pa-0">
                        : @_scheduleTest
                    </MudItem>
                    <MudItem xs="6" sm="4" Class="pa-0">
                        Schedule Time
                    </MudItem>
                    <MudItem xs="6" sm="8" Class="pa-0">
                        : @_scheduleTime
                    </MudItem>
                    <MudItem xs="6" sm="4" Class="pa-0">
                        Location
                    </MudItem>
                    <MudItem xs="6" sm="8" Class="pa-0">
                        : @_scheduleLocation
                    </MudItem>
                </MudGrid>
            </div>
        }

        @if (!string.IsNullOrEmpty(_testResult) && !string.IsNullOrEmpty(_testScore))
        {
            <div class="mt-6">
                <h4>Test Result</h4>
                <MudGrid Class="mt-2">
                    <MudItem xs="6" sm="4" Class="pa-0">
                        Status
                    </MudItem>
                    <MudItem xs="6" sm="8" Class="pa-0">
                        : @_testResult
                    </MudItem>

                    @if (SelectionStage == SelectionStage.TOEFL)
                    {
                        <MudItem xs="6" sm="4" Class="pa-0">
                            Score
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="6" sm="4" Class="pa-0">
                            Result
                        </MudItem>
                    }

                    <MudItem xs="6" sm="8" Class="pa-0">
                        : @_testScore
                    </MudItem>

                </MudGrid>
            </div>

            @if (Error is not null)
            {
                <div>
                    <ErrorViewer Error="@Error" />
                </div>
            }
        }

        @if (SelectionStage == SelectionStage.TalentReview || SelectionStage == SelectionStage.TalentReview_2 || SelectionStage == SelectionStage.Decree)
        {
            @if (_documentSkId != Guid.Empty || _documentSpId != Guid.Empty)
            {
                <MudGrid Class="mt-2">
                    @if (_documentSkId != Guid.Empty)
                    {
                        <MudItem xs="12" sm="12" Class="pa-0">
                            Surat Keputusan - Peserta Tugas Belajar
                        </MudItem>
                        <MudItem xs="12" sm="12" Class="pa-0">
                            <SfButton CssClass="e-flat e-success" IconCss="e-icons e-download" Content="Download SK" OnClick="OnClickDownloadSK"></SfButton>
                        </MudItem>
                    }

                    @if (_documentSpId != Guid.Empty)
                    {
                        <MudItem xs="12" sm="12" Class="pa-0 mt-2">
                            Surat Perintah - Peserta Tugas Belajar
                        </MudItem>
                        <MudItem xs="12" sm="12" Class="pa-0">
                            <SfButton CssClass="e-flat e-success" IconCss="e-icons e-download" Content="Download SP" OnClick="OnClickDownloadSP"></SfButton>
                        </MudItem>
                    }
                </MudGrid>
            }
            else
            {
                <MudGrid Class="mt-2">
                    No Data Found
                </MudGrid>
            }
        }
        
    </DialogContent>
    <DialogActions>
        @if (_documentId != Guid.Empty)
        {
            <SfButton CssClass="e-flat e-success" IconCss="e-icons e-download"
                      Content="Download Certificate" OnClick="OnClickDownloadCertificate"></SfButton>
        }
        <SfButton Content="Close" CssClass="e-info" IconCss="e-icons e-close" OnClick="OnClickClose"></SfButton>
    </DialogActions>
</MudDialog>

<style>
    .mud-grid-spacing-xs-3 {
        margin: 0;
    }
</style>
