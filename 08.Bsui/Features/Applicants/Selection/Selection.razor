@if (_isLoading)
{
    <Loading IsVisible="_isLoading" />
}
else
{
    <MudText Typo="Typo.h5">@_displayName</MudText>

    @if (SelectionTimelineModels != null && SelectionTimelineModels.Count > 0)
    {
        <MudText Typo="Typo.h6">@_displayTitle</MudText>
        <MudText>@_displayDueDate</MudText>
        <MudText Typo="Typo.h6">@_postingText</MudText>
        <br />
        <MudGrid>
            <MudItem xs="12" sm="6" Class="mt-4 d-flex justify-start">
                <SfButton OnClick="OnClickScheduleAsync" Content="Schedule Detail" IconCss="e-icons e-timeline-month" IconPosition=@IconPosition.Right CssClass="e-info mr-3"></SfButton>
                <SfButton OnClick="@(() => OnCommandClicked())" Content="Scholarship Information" IconCss="e-icons e-circle-info" IconPosition=@IconPosition.Right CssClass="e-primary"></SfButton>
            </MudItem>
            <MudItem xs="12" sm="6" Class="mt-4 d-flex justify-end">
                <SfButton Content="Cancel Application" CssClass="e-danger" IconCss="e-icons e-changes-reject" OnClick="OnClickCancelAsync" Disabled="@_isDisableCancel"></SfButton>
            </MudItem>
        </MudGrid>

        <SelectionStep StepperSource="@SelectionTimelineModels" ApplicantId="@ApplicantId" ScholarshipId="@ScholarshipId" />
    }
    else
    {
        <br />
        <MudText Typo="Typo.h4">Not available selection</MudText>
    }
}

<Psmp.Bsui.Features.Projects.Component.DialogViewScholarshipPlan 
    Visibility="VisiblePopup"
    Title="@TitlePopup"
    IdScholarshipPlan="@IdScholarshipPlan"
    DialogOpen="DialogOpen" 
    DialogClose="DialogClose"
    OnClickNo="ClickedNo" 
    IsEnabled="@IsEnabled">
</Psmp.Bsui.Features.Projects.Component.DialogViewScholarshipPlan>

