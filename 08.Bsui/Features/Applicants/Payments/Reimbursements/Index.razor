	@*  } *@
	<MudGrid Spacing="2">
		<MudGrid Class="mb-2">
			<MudItem xs="12">
				<MudCard Class="pa-4" Elevation="2">
					<MudCardContent>
						<MudItem xs="12">
                            <MudPaper Class="d-flex justify-start flex-grow-1 gap-1" Elevation="0">
                                <MudText Typo="Typo.h6" Class="ms-0">List of Reimbursement</MudText>
                                <Tooltips />
                            </MudPaper>
							@if (Action == null)
							{
								<MudItem xs="12">
									<MudGrid>
										<MudItem xs="4" Class="justify-end">
											<SfButton OnClick="OnClickAddAsync" Content="Request Payment" IconCss="e-icons e-circle-add" CssClass="e-info"></SfButton>
										</MudItem>
									</MudGrid>
								</MudItem>
							}
							<br />
							<SfGrid @ref="Grid" DataSource="@_filteredReimbursements" Toolbar="@(new List<string>() { "Search" })" AllowFiltering="true" AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true">
								<GridPageSettings PageCount="8" PageSize="8" PageSizes="@SyncfusionGridValue.PageSize"></GridPageSettings>
								<GridEvents RowDataBound="RowBound" CommandClicked="OnCommandClicked" TValue="GetApplicantReimbursementResponse"></GridEvents>
								<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
								<GridColumns>
									<GridColumn Field=@nameof(GetApplicantReimbursementResponse.RequestDate) HeaderText="Month" Width="150">
										<Template Context="data">
											@{
												var row = data as GetApplicantReimbursementResponse;
												var date = row?.RequestDate;
												var bulan = date?.ToString("MMMM", new System.Globalization.CultureInfo("id-ID"));
											}
											@bulan
										</Template>
									</GridColumn>
									<GridColumn Field=@nameof(GetApplicantReimbursementResponse.RequestDate) HeaderText="Request Date" Format="dd.MM.yyyy" Width="150"></GridColumn>
									@* <GridColumn Field=@nameof(GetApplicantReimbursementResponse.RequestId) HeaderText="Request Id" Width="150"></GridColumn>
                                    <GridColumn Field=@nameof(GetApplicantReimbursementResponse.PaymentDate) HeaderText="Payment Date" Format="dd.MM.yyyy" Width="150"></GridColumn> *@
									<GridColumn Field=@nameof(GetApplicantReimbursementResponse.Category) HeaderText="Category" Width="150">
									</GridColumn>
									<GridColumn Field=@nameof(GetApplicantReimbursementResponse.CurrencyType) HeaderText="Currency" Width="150">
										<Template>
											@{
												var data = (context as GetApplicantReimbursementResponse);
												@data!.CurrencyType.GetDescription().ToString()
											}
										</Template>
									</GridColumn>
                                    <GridColumn Field=@nameof(GetApplicantReimbursementResponse.Amount) HeaderText="Amount" Width="150">
										<Template>
											@{
												var data = (context as GetApplicantReimbursementResponse);
                                            }
                                            <div style="text-align:right;">
												@($"{data!.Amount.ToString("N2", new System.Globalization.CultureInfo("id-ID"))}")
											</div>
										</Template>
									</GridColumn>
									<GridColumn Field=@nameof(GetApplicantReimbursementResponse.WageType) HeaderText="Wage Type" Width="150"></GridColumn>
									<GridColumn Field=@nameof(GetApplicantReimbursementResponse.PaymentStatus) HeaderText="Payment Status" Width="200">
										<Template>
											@{
												var data = (context as GetApplicantReimbursementResponse);
												if (data!.PaymentStatus == PaymentStatus.Approved)
												{
                                                    <div style="display:flex; justify-content:center;">
													    <SfChip>
														    <ChipItems>
															    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-success"></ChipItem>
														    </ChipItems>
													    </SfChip>
                                                    </div>
												}
												else if (data!.PaymentStatus == PaymentStatus.Posted)
												{
                                                    <div style="display:flex; justify-content:center;">
													    <SfChip>
														    <ChipItems>
															    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-success"></ChipItem>
														    </ChipItems>
													    </SfChip>
                                                    </div>
												}
												else if (data!.PaymentStatus == PaymentStatus.Rejected)
												{
                                                    <div style="display:flex; justify-content:center;">
													    <SfChip>
														    <ChipItems>
															    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-danger"></ChipItem>
														    </ChipItems>
													    </SfChip>
                                                    </div>
												}
												else if (data!.PaymentStatus == PaymentStatus.WaitingApproval)
												{
                                                    <div style="display:flex; justify-content:center;">
													    <SfChip>
														    <ChipItems>
															    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-warning"></ChipItem>
														    </ChipItems>
													    </SfChip>
                                                    </div>
												}
												else if (data!.PaymentStatus == PaymentStatus.RequestPreparation)
												{
                                                    <div style="display:flex; justify-content:center;">
													    <SfChip>
														    <ChipItems>
															    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-info"></ChipItem>
														    </ChipItems>
													    </SfChip>
                                                    </div>
												}
												else if (data!.PaymentStatus == PaymentStatus.Pending)
												{
                                                    <div style="display:flex; justify-content:center;">
													    <SfChip>
														    <ChipItems>
																<ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="sf-default-mud"></ChipItem>
														    </ChipItems>
													    </SfChip>
                                                    </div>
												}
												else if (data!.PaymentStatus == PaymentStatus.NeedRevision)
												{
                                                    <div style="display:flex; justify-content:center;">
													    <SfChip>
														    <ChipItems>
															    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="sf-warning-mud"></ChipItem>
														    </ChipItems>
													    </SfChip>
                                                    </div>
                                                }
                                                else if (data!.PaymentStatus == PaymentStatus.Completed)
                                                {
                                                    <div style="display:flex; justify-content:center;">
                                                        <SfChip>
                                                            <ChipItems>
                                                                <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-success"></ChipItem>
                                                            </ChipItems>
                                                        </SfChip>
                                                    </div>
                                                }
                                                else
												{
                                                    <div style="display:flex; justify-content:center;">
													    <SfChip>
														    <ChipItems>
															    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-secondary"></ChipItem>
														    </ChipItems>
													    </SfChip>
                                                    </div>
												}
											}
										</Template>
									</GridColumn>
									<GridColumn HeaderText="Action" TextAlign="TextAlign.Center" Width="150">
										<GridCommandColumns>
											@{
												@if (Action != null)
												{
													<GridCommandColumn Title="View" Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-eye", CssClass = "e-flat" })"></GridCommandColumn>
													<GridCommandColumn Title="Edit" Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-edit", CssClass = "e-flat" })"></GridCommandColumn>
												}
												else
												{
													<GridCommandColumn Title="View" Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-eye", CssClass = "e-flat" })"></GridCommandColumn>
													<GridCommandColumn Title="Edit" Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-edit", CssClass = "e-flat" })"></GridCommandColumn>
												}
											}
										</GridCommandColumns>
									</GridColumn>
								</GridColumns>
							</SfGrid>
						</MudItem>
					</MudCardContent>
				</MudCard>
			</MudItem>
		</MudGrid>
	</MudGrid>
}

<DialogAddReimbursement Visibility="VisiblePopupReimbursement"
						Title="@TitlePopupReimbursement"
						DialogOpen="DialogReimbursementOpen" DialogClose="DialogReimbursementClose"
						OnClickNo="ClickedReimbursementNo" OnClickYes="ClickedReimbursementYes"
						OnClickReject="ClickedReimbursementReject" OnClickApprove="ClickedReimbursementApprove"
						Request="_requestReimbursement"
						Curency="_dropdownItemCurrencyType"
						Category="_dropdownItemCategorys"
						listDocument="_getListDocuments"
						ValueChangeReimbursement="ValueChangeUploaderReimbursement"
						OnRemoveReimbursement="OnRemoveUploaderReimbursement"
						OnCommandClicked="OnCommandClickedDocument"
						EmployeeNumber="@_employeeId"
						UserLogin="@_displayName"
						Name="@_username"
						ListPaymentComment="_listPaymentComment"
						Action="@Action"
						IsEnabled="IsEnabled"
						StepperData="_stepperData">
</DialogAddReimbursement>

<DialogConfirmation Visibility="VisiblePopupDelete"
					Title="Document Reimbursement"
					Content="Are you sure want to delete this data?"
					DialogOpen="DialogDeleteOpen" DialogClose="DialogDeleteClose"
					OnClickNo="ClickedNoDelete" OnClickYes="ClickedYesDelete"></DialogConfirmation>
