@page "/ApplicantPayment/DetailAcceptedPayment/{id:guid}/{applicantId:guid}"
@using Psmp.Shared.Payments.Contants;

<BrowserTabTitle>@DisplayTextFor.Payment</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" ActivePanelIndexChanged="@(e => OnTabChanged(e))">
    <MudTabPanel Text="@DisplayTextFor.DraftingBA">
		<DraftPayment Id="@Id" ApplicantId="@ApplicantId">

        </DraftPayment>
    </MudTabPanel>
    <MudTabPanel Text="@DisplayTextFor.FinalBA">
		<FinalPayment Id="@Id" ApplicantId="@ApplicantId">

        </FinalPayment>
    </MudTabPanel>
</MudTabs>
