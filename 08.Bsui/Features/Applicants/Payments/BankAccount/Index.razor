<DialogAddBankAccount DialogClose="DialogClose"
					  DialogOpen="DialogOpen"
					  OnClickNo="ClickedNo"
					  OnClickYes="ClickedYes"
					  OnRemove="OnRemove"
					  ValueChange="ValueChange"
					  Request="_request"
					  Visibility="_visible"
					  IsEnabled="_isEnabled"
					  CurrancyType="@_type"
					  Title="@_title">

</DialogAddBankAccount>
