@using Psmp.Base.Payments.Enums
@using Psmp.Bsui.Features.Applicants.Payments.Components
@using Psmp.Shared.Payments.Queries
@inject IWebHostEnvironment _webHostEnvironment
@inject IOptions<HrisOptions> _hrisOptions

<style>
	@@media (max-width: 768px) {
		.responsive-text {
			font-size: 1rem; /* Ukuran font lebih kecil */
		}
	}

	@@media (max-width: 480px) {
		.responsive-text {
			font-size: 0.875rem; /* Ukuran font lebih kecil lagi */
		}
	}

	.btn-outline-abu {
		border: 1px solid #E2E8F0 !important;
	}
</style>

<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>
<ErrorViewer Error="@Error" />

@if (_isLoading)
{
	<Loading IsVisible="_isLoading" />

}
