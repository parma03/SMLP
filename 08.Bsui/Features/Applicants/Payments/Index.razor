@page "/ApplicantPayment"
@page "/ApplicantPayment/{EmployeeNumber}/{Action}"
@using Smlp.Shared.Payments.Contants;
@using Smlp.Bsui.Features.Applicants.Payments.Components

<BrowserTabTitle>@DisplayTextFor.Payment</BrowserTabTitle>
<PageHeader Title="@DisplayTextFor.Payment" />
@* <MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs> *@

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
 @*    @if (Action == "BankAccount")
    {
       
    } *@
    @if (Action == "Reimbursement")
    {
        <MudTabPanel Text="@DisplayTextFor.Reimbursement">
            <Smlp.Bsui.Features.Applicants.Payments.Reimbursements.Index Action="@Action" EmployeeNumber="@EmployeeNumber"></Smlp.Bsui.Features.Applicants.Payments.Reimbursements.Index>
        </MudTabPanel>
	@* 	<MudTabPanel Text="@DisplayTextFor.BankAccount">
			<Smlp.Bsui.Features.Applicants.Payments.BankAccount.Index Action="@Action" EmployeeNumber="@EmployeeNumber"></Smlp.Bsui.Features.Applicants.Payments.BankAccount.Index>
		</MudTabPanel> *@
    }
    else if (Action == "Disbursement")
    {
        <MudTabPanel Text="@DisplayTextFor.Disbursement">
            <Smlp.Bsui.Features.Applicants.Payments.Dibursements.Index Action="@Action" EmployeeNumber="@EmployeeNumber"></Smlp.Bsui.Features.Applicants.Payments.Dibursements.Index>
        </MudTabPanel>
	@* 	<MudTabPanel Text="@DisplayTextFor.BankAccount">
			<Smlp.Bsui.Features.Applicants.Payments.BankAccount.Index Action="@Action" EmployeeNumber="@EmployeeNumber"></Smlp.Bsui.Features.Applicants.Payments.BankAccount.Index>
		</MudTabPanel> *@
    }
    else
    {
        <MudTabPanel Text="@DisplayTextFor.BankAccount">
            <Smlp.Bsui.Features.Applicants.Payments.BankAccount.Index Action="@Action" EmployeeNumber="@EmployeeNumber"></Smlp.Bsui.Features.Applicants.Payments.BankAccount.Index>
        </MudTabPanel>
        <MudTabPanel Text="@DisplayTextFor.Reimbursement">
            <Smlp.Bsui.Features.Applicants.Payments.Reimbursements.Index Action="@Action" EmployeeNumber="@EmployeeNumber"></Smlp.Bsui.Features.Applicants.Payments.Reimbursements.Index>
        </MudTabPanel>
        <MudTabPanel Text="@DisplayTextFor.Disbursement">
            <Smlp.Bsui.Features.Applicants.Payments.Dibursements.Index Action="@Action" EmployeeNumber="@EmployeeNumber"></Smlp.Bsui.Features.Applicants.Payments.Dibursements.Index>
        </MudTabPanel>
    }
    
</MudTabs>

<style>
    .mud-tabs-panels {
        min-height: 500px;
    }
</style>
