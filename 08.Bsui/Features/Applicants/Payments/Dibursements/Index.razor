                                            <!-- Card kedua -->
                                            <MudItem xs="5" md="3" Class="d-flex justify-start">
                                                <Smlp.Bsui.Features.Payments.Component.CardStatistic ImageSrc="img/dollars.png" AvatarColor="Color.Default" Judul="@($"{"Requested to BMC"} ({_count3})")" CountCurrency="@_countcurrency3"></Smlp.Bsui.Features.Payments.Component.CardStatistic>
                                            </MudItem>

                                            <!-- Divider Vertikal -->
                                            <MudItem xs="0" md="0" Class="d-flex justify-start">
                                                <MudHidden Breakpoint="Breakpoint.SmAndDown">
