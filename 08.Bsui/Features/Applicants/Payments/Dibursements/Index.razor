@using Smlp.Base.Payments.Enums
@using Smlp.Bsui.Features.Applicants.Payments.Components
@using Smlp.Shared.Payments.Queries
@inject IWebHostEnvironment _webHostEnvironment
@inject IOptions<HrisOptions> _hrisOptions

<style>
    .no-minheight-tabs .mud-tabs-panels {
        min-height: unset !important;
        height: auto !important;
        padding-bottom: 0 !important;
    }

	.e-chip.sf-warning-mud {
		background: var(--mud-palette-warning);
		color: var(--mud-palette-warning-text);
		pointer-events: none;
	}

	.e-chip.sf-default-mud {
		background: var(--mud-palette-secondary);
		color: var(--mud-palette-secondary-text);
		pointer-events: none;
	}
</style>

<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>
<ErrorViewer Error="@Error" />

