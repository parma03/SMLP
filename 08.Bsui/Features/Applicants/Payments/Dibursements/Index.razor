										<MudItem xs="12" sm="6" md="6" Class="d-flex justify-start">
												<Smlp.Bsui.Features.Payments.Component.CardStatistic ImageSrc="img/idr7.png" AvatarColor="Color.Info" Judul="@($"{"Preparation"} ({_count2})")" CountCurrency="@_countcurrency2" CurrencyType="@("Rp")" IsLast="true"></Smlp.Bsui.Features.Payments.Component.CardStatistic>
