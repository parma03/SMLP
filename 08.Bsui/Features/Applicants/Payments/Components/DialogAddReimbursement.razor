		color: #1E4EA2 !important;
	}

	div[id^="modal-dialog-"],
	div[id*="dialog-"],
	.e-dlg-container,
	.e-dialog,
	div.e-dialog {
		z-index: 10000 !important;
		max-z-index: 10000 !important;
	}

	.e-dlg-overlay {
		z-index: 9999 !important;
	}
</style>

<SfDialog Target="#targetReimbursement" IsModal="true" Width="820px" ShowCloseIcon="true" @bind-Visible=Visibility>
	<DialogTemplates>
		<Header>@Title</Header>
		<Content>
			<div class="row">
				<div class="col-md-12">
					<MudGrid Spacing="2">
						<MudItem xs="12">
							<MudCard>
								<MudCardContent>
									<MudItem xs="12">
										<MudGrid>
											<MudItem xs="4">
												<MudText>Employee Number</MudText>
											</MudItem>
											<MudItem xs="3">
												<SfTextBox ID="txtEmployeeNumber" Placeholder="EmployeeNumber" @bind-Value="EmployeeNumber" Enabled="false"></SfTextBox>
											</MudItem>
										</MudGrid>
									</MudItem>
									<MudItem xs="12">
										<MudGrid>
											<MudItem xs="4">
												<MudText>Name</MudText>
											</MudItem>
											<MudItem xs="3">
												<SfTextBox ID="txName" Placeholder="Name" @bind-Value="Name" Enabled="false"></SfTextBox>
											</MudItem>
										</MudGrid>
									</MudItem>
									<MudItem xs="12">
										<MudGrid>
											<MudItem xs="4">
												<MudText>Request Date</MudText>
											</MudItem>
											<MudItem xs="8">
												<SfDatePicker TValue="DateOnly?" Format="dd.MM.yyyy" Placeholder="Choose a Date" FullScreen="true" ShowClearButton="true" @bind-Value="Request!.RequestDate" Enabled="false"></SfDatePicker>
											</MudItem>
										</MudGrid>
									</MudItem>
									<MudItem xs="12">
										<MudGrid>
											<MudItem xs="4">
												<MudText>Category <span style="color:red;">*</span></MudText>
											</MudItem>
											<MudItem xs="8">
												<SfDropDownList ID="ddlCategory" TValue="int" TItem="DropdownItemResponse" Enabled="@IsEnabled" DataSource="@Category" @bind-Value="Request!.Category"
																Placeholder="Select category">
													<DropDownListEvents TItem="DropdownItemResponse" TValue="int" ValueChange="@OnChangeItemAsync"></DropDownListEvents>
													<DropDownListFieldSettings Text="Description" Value="Id" />
												</SfDropDownList>
											</MudItem>
										</MudGrid>
									</MudItem>
									<MudItem xs="12">
										<MudGrid>
											<MudItem xs="4">
												<MudText>Amount <span style="color:red;">*</span></MudText>
											</MudItem>
											<MudItem xs="3">
												<SfDropDownList ID="ddlCurency" TValue="int" TItem="DropdownItemResponse" Enabled="@IsEnabled" DataSource="@Curency" @bind-Value="Request!.CurrencyType"
																Placeholder="Select Currency">
													<DropDownListFieldSettings Text="Description" Value="Id" />
												</SfDropDownList>
											</MudItem>
											<MudItem xs="5">
												<SfNumericTextBox ID="txtAmount" Placeholder="Amount" Format="n2" @bind-Value="Request!.Amount" Enabled="@IsEnabled" Min="0"></SfNumericTextBox>
											</MudItem>
										</MudGrid>
									</MudItem>
									@if (_condition || Request!.Category == 14)
									{
										<MudItem xs="12">
											<MudGrid>
												<MudItem xs="4">
													<MudText>IBAN/SWIFT Code</MudText>
												</MudItem>
												<MudItem xs="8">
													<SfTextBox ID="txtIBAN" Placeholder="IBAN/SWIFT Code" @bind-Value="Request!.IBANCode" Enabled="@IsEnabled"></SfTextBox>
												</MudItem>
											</MudGrid>
										</MudItem>
										<MudItem xs="12">
											<MudGrid>
												<MudItem xs="4">
													<MudText>University Bank Name</MudText>
												</MudItem>
												<MudItem xs="8">
													<SfTextBox ID="txtIBAN" Placeholder="University Bank Name" @bind-Value="Request!.UniversityBank" Enabled="@IsEnabled"></SfTextBox>
												</MudItem>
											</MudGrid>
										</MudItem>
										<MudItem xs="12">
											<MudGrid>
												<MudItem xs="4">
													<MudText>University Bank Account</MudText>
												</MudItem>
												<MudItem xs="8">
													<SfTextBox ID="txtUniversityBankAccount" Placeholder="University Bank Account" @bind-Value="Request!.UniversityBankAccount" Enabled="@IsEnabled"></SfTextBox>
												</MudItem>
											</MudGrid>
										</MudItem>
										<MudItem xs="12">
											<MudGrid>
												<MudItem xs="4">
													<MudText>Due Date</MudText>
												</MudItem>
												<MudItem xs="8">
													<SfDatePicker TValue="DateOnly ?" Format="dd.MM.yyyy" Placeholder="Choose a Date" FullScreen="true" ShowClearButton="true" @bind-Value="Request!.DueDate" Enabled="@IsEnabled" Min="@DateTime.UtcNow"></SfDatePicker>
												</MudItem>
											</MudGrid>
										</MudItem>
									}
									<MudItem xs="12" Class="mb-2">
										<MudGrid>
											<MudItem xs="4">
												<MudText>Notes <span style="color:red;">*</span></MudText>
											</MudItem>
											<MudItem xs="8">
												<SfTextArea ID="txtNotes" RowCount="3" ColumnCount="1000" Placeholder="Input Notes" @bind-Value="Request!.Notes" Enabled="@IsEnabled" Readonly="@(!IsEnabled)"></SfTextArea>
											</MudItem>
										</MudGrid>
									</MudItem>
									<MudItem xs="12">
										<MudText>@(_category ?? "Payment Invoice Document (.pdf)") <span style="color: red;">*</span></MudText>
										<MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="font-style: italic; font-size: 0.8rem;">
											<b>(Maximum Size 5 Mb)</b>
										</MudText>
										<MudGrid Class="mt-1">
											<MudItem xs="12">
												<SfUploader ID="uploaderReimbursement" AutoUpload="true" SequentialUpload="false" AllowMultiple="false" Enabled="@IsEnabled"
															AllowedExtensions=".pdf">
													<UploaderEvents ValueChange="ValueChangeReimbursement" OnRemove="OnRemoveReimbursement"></UploaderEvents>
												</SfUploader>
											</MudItem>
										</MudGrid>
									</MudItem>
									<br />

									<MudDivider />

									@if (listDocument!.Count() > 0)
									{
										<MudItem xs="12">
											<SfGrid DataSource="@listDocument" AllowPaging="true" Width="100%" AllowResizing="true">
												<GridPageSettings PageCount="8" PageSize="8" PageSizes="@SyncfusionGridValue.PageSize"></GridPageSettings>
												<GridEvents CommandClicked="OnCommandClicked" TValue="GetDocumentsDocument"></GridEvents>
												<GridColumns>
													<GridColumn Field=@nameof(GetDocumentsDocument.FileName) HeaderText="Filename" TextAlign="TextAlign.Left" Width="80%"> </GridColumn>
													<GridColumn HeaderText="Action" Width="20%" TextAlign="TextAlign.Center">
														<GridCommandColumns>
															<GridCommandColumn ID="btnDownload" Title="Download" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-download", CssClass = "e-flat" })"> </GridCommandColumn>
															@* <GridCommandColumn ID="btnDelete" Title="Delete" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-delete", CssClass="e-flat" })"> </GridCommandColumn> *@
														</GridCommandColumns>
													</GridColumn>
												</GridColumns>
											</SfGrid>
										</MudItem>
									}

									<MudItem xs="12" Class="mb-2">
										<MudGrid>
											<MudItem xs="12">
												<Stepper StepperData="@StepperData" CurrentPaymentStatus="@(Request?.PaymentStatus is int v ? (PaymentStatus?)v : null)" />
											</MudItem>
										</MudGrid>
									</MudItem>
								</MudCardContent>
							</MudCard>
						</MudItem>
					</MudGrid>
					@if (IsEnabled == false)
					{
						<MudGrid Spacing="2">
							<MudItem xs="12">
								@{
									var position = "";
									@if (ListPaymentComment is not null)
									{
										<main class="msger-chat" style="height:200px;overflow: auto;">
											@foreach (var message in ListPaymentComment)
											{
												position = message.User == UserLogin ? "right-msg" : "left-msg";
												<div class="msg @position">
													<div class="msg-bubble">
														<div class="msg-info d-flex align-items-center gap-2">
															<div class="msg-info-name fw-bold">@message.User</div>
															@{
																var (statusText, cleanComment) = ExtractStatusFromComment(message.Comment);
																if (!string.IsNullOrEmpty(statusText))
																{
																	<MudChip T="string"
																			 Size="Size.Small"
																			 Color="@GetStatusColorFromText(statusText)"
																			 Variant="Variant.Filled"
																			 StartIcon="@GetStatusIconFromText(statusText)">
																		@FormatStatusText(statusText)
																	</MudChip>
																}
															}
														</div>

														<div class="msg-text mt-2 mb-1">
															@{
																var (_, displayComment) = ExtractStatusFromComment(message.Comment);
																@displayComment
															}
														</div>

														<div class="msg-info-time" style="font-size: 0.75em; color: @(position == "right-msg" ? "#fff" : "#666"); text-align: right;">
															@message.Date.ToString("dd.MM.yyyy HH:mm:ss")
														</div>
													</div>
												</div>
											}
										</main>
									}
								}
								<div class="msger-inputarea">
									<input type="text" class="msger-input" @bind-value="_message" placeholder="Enter your message...">
									<button @onclick="SubmitComment" class="msger-send-btn">Send</button>
								</div>
							</MudItem>
						</MudGrid>
					}
				</div>
			</div>
		</Content>
		<FooterTemplate>
			@if (Action is null)
			{
				<SfButton Content="Cancel" CssClass="e-outline e-danger" IconCss="e-icons e-close" OnClick="OnClickNo"></SfButton>
				@if (IsEnabled == true)
				{
					@* <SfButton Content="Save" CssClass="e-success" IconCss="e-icons e-circle-check" OnClick="OnClickYes"></SfButton> *@
					<SfButton Content="@(_isButtonLoading ? "Saving..." : "Save")"
							  CssClass="e-success"
							  IconCss="@(_isButtonLoading ? "e-icons e-spinner e-spin" : "e-icons e-circle-check")"
							  OnClick="HandleClickYes"
							  Disabled="@_isButtonLoading">
					</SfButton>
				}

			}
			else
			{
				if (Request!.PaymentStatus == 1)
				{
					<SfButton Content="@(Request!.PaymentStatus == 1 ? "Approve" : Request!.PaymentStatus == 11 ? "Paid" : "Cenceled")" CssClass="e-info" IconCss="e-icons e-circle-check" OnClick="OnClickApprove"></SfButton>
					<SfButton Content="Rejected" CssClass="e-danger" IconCss="e-icons e-close" OnClick="OnClickReject"></SfButton>
				}
			}
		</FooterTemplate>
	</DialogTemplates>
	<DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
	<DialogPositionData X="center" Y="center"></DialogPositionData>
	<DialogAnimationSettings Effect="DialogEffect.None"></DialogAnimationSettings>
</SfDialog>

@code {
	[Parameter]
	public bool Visibility { get; set; }
	[Parameter]
	public string? Title { get; set; }
	[Parameter]
	public string? Action { get; set; }
	[Parameter]
	public string? Name { get; set; }
	[Parameter]
	public string? UserLogin { get; set; }
	[Parameter]
	public string? EmployeeNumber { get; set; }
	[Parameter]
	public EventCallback DialogOpen { get; set; }
	[Parameter]
	public EventCallback DialogClose { get; set; }
	[Parameter
	]
	public EventCallback OnClickNo { get; set; }
	[Parameter]
	public EventCallback OnClickYes { get; set; }
	[Parameter]
	public EventCallback OnClickReject { get; set; }
	[Parameter]
	public EventCallback OnClickApprove { get; set; }
	[Parameter]
	public EventCallback<RemovingEventArgs> OnRemoveReimbursement { get; set; }
	[Parameter]
	public EventCallback<UploadChangeEventArgs> ValueChangeReimbursement { get; set; }
	[Parameter]
	public EventCallback<CommandClickEventArgs<GetDocumentsDocument>> OnCommandClicked { get; set; }
	[Parameter]
	public ReimbursementRequest? Request { get; set; }
	[Parameter]
	public bool IsEnabled { get; set; }
	[Parameter]
	public List<DropdownItemResponse>? Category { get; set; }
	[Parameter]
	public List<DropdownItemResponse>? Curency { get; set; }
	[Parameter]
	public List<GetDocumentsDocument>? listDocument { get; set; }
	[Parameter]
	public List<GetPaymentCommentResponse>? ListPaymentComment { get; set; }
	[Parameter]
	public List<GetStepperResponse>? StepperData { get; set; }

	protected override void OnInitialized()
	{
		base.OnInitialized();
	}

	private string? _category = default!;
	private string _message = default!;
	private bool _condition = false;

	private bool _isButtonLoading;

	private async Task HandleClickYes()
	{
		if (_isButtonLoading)
			return;

		_isButtonLoading = true;
		StateHasChanged();

		try
		{
			await Task.Delay(1000);
			await OnClickYes.InvokeAsync();
		}
		finally
		{
			_isButtonLoading = false;
			StateHasChanged();
		}
	}

	private async Task SubmitComment()
	{
		var request = new PaymentCommentRequest()
		{
			PaymentId = (Guid)Request.Id,
			Comment = _message,
			User = UserLogin
		};

		var response = await _paymentService.CreatePaymentCommentAsync(request);
		if (response.Error is null)
		{
			_message = default!;
			await LoadComment();
		}
	}
	private async Task LoadComment()
	{
		var request = new GetPaymentCommentRequest()
		{
			PaymentId = (Guid)Request.Id
		};

		var response = await _paymentService.GetPaymentCommentAsync(request);
		if (response.Error is null)
		{
			ListPaymentComment = response.Result!.Items.ToList();
		}
	}
	public async void OnChangeItemAsync(ChangeEventArgs<int, DropdownItemResponse> args)
	{
		_condition = false; // RESET DULU setiap kali category berubah

		if (args.ItemData != null)
		{
			_category = args.ItemData.Id switch
			{
				1 => "Invoice & IELTS Test Result (.pdf)",
				2 => "Invoice & TOEFL Test Result (.pdf)",
				3 => "Invoice & GRE Test Result (.pdf)",
				4 => "Invoice & GMAT Test Result (.pdf)",
				5 => "Invoice (.pdf)",
				6 => "Invoice (.pdf)",
				7 => "Invoice & Boarding Pass (.pdf)",
				8 => "Invoice (.pdf)",
				9 => "Hotel Invoice, Boarding Pass, Scan passport immigration stamp page (with family if bringing any) (.pdf)",
				10 => "Invoice (.pdf)",
				11 => "Invoice (.pdf)",
				12 => "Invoice (.pdf)",
				13 => "Invoice, Insurance Premium, Insurance Brochure, Medical Resume, Proof of Payment Confirmation (.pdf)",
				14 => "Invoice From Campus (.pdf)",
				15 => "Invoice, Proof of transfer (if by transfer) & Official confirmation of payment from the organizer (.pdf)",
				16 => "Invoice, Proof of transfer (if by transfer) & Official confirmation of payment from the organizer (.pdf)",
				17 => "Invoice, Proof of transfer (if by transfer) & Official confirmation of payment from the organizer (.pdf)",
				18 => "Invoice, Proof of transfer (if by transfer) & Official confirmation of payment from the organizer (.pdf)",
				_ => args.ItemData.Description
			};

			if (args.ItemData.Id == 14)
			{
				_condition = true;
			}
		}
		else
		{
			_category = null;
		}
	}

	private string FormatStatusText(string statusText)
	{
		if (string.IsNullOrEmpty(statusText))
			return statusText;

		// Ubah "Preparation" atau "Request Preparation" menjadi "Approved"
		if (statusText.ToUpper().Contains("PREPARATION"))
		{
			return "Approved";
		}

		// Ubah ke lowercase dan kapitalisasi huruf pertama setiap kata
		var words = statusText.ToLower().Split(' ');
		for (int i = 0; i < words.Length; i++)
		{
			if (!string.IsNullOrEmpty(words[i]))
			{
				words[i] = char.ToUpper(words[i][0]) + words[i].Substring(1);
			}
		}
		return string.Join(" ", words);
	}

	private (string Status, string Comment) ExtractStatusFromComment(string comment)
	{
		if (string.IsNullOrEmpty(comment))
			return (string.Empty, comment);

		var pattern = @"^\[([^\]]+)\]\s*(.*)$";
		var match = System.Text.RegularExpressions.Regex.Match(comment, pattern);

		if (match.Success)
		{
			return (match.Groups[1].Value.Trim(), match.Groups[2].Value.Trim());
		}

		return (string.Empty, comment);
	}

	private Color GetStatusColorFromText(string statusText)
	{
		var upperStatus = statusText.ToUpper();

		if (upperStatus.Contains("APPROVED") || upperStatus.Contains("PREPARATION"))
			return Color.Success;

		return upperStatus switch
		{
			"PENDING" => Color.Default,
			"NEED REVISION" => Color.Warning,
			"REJECTED" => Color.Error,
			_ => Color.Info
		};
	}

	private string GetStatusIconFromText(string statusText)
	{
		var upperStatus = statusText.ToUpper();

		if (upperStatus.Contains("APPROVED") || upperStatus.Contains("PREPARATION"))
			return Icons.Material.Filled.CheckCircle;

		return upperStatus switch
		{
			"PENDING" => Icons.Material.Filled.Schedule,
			"NEED REVISION" => Icons.Material.Filled.Warning,
			"REJECTED" => Icons.Material.Filled.Cancel,
			_ => Icons.Material.Filled.Info
		};
	}

}
