@using Smlp.Domain.Entities.Masters
@using Smlp.Shared.Common.Responses
@using Smlp.Shared.Masters.Queries
@using Smlp.Shared.Payments.Commands
@using Smlp.Shared.Documents.Queries.GetDocuments
@using System.Globalization
@inject IWebHostEnvironment _webHostEnvironment

<style>
	div[id^="modal-dialog-"],
	div[id*="dialog-"],
	.e-dlg-container,
	.e-dialog,
	div.e-dialog {
		z-index: 10000 !important;
		max-z-index: 10000 !important;
	}

	.e-dlg-overlay {
		z-index: 9999 !important;
	}
</style>

<SfDialog Target="#target" IsModal="true" Width="820px" ShowCloseIcon="true" @bind-Visible=Visibility>
    <DialogTemplates>
        <Header>@Title</Header>
        <Content>
            <div class="row">
                <div class="col-md-12">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudCard>
                                <MudCardContent>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="12" sm="6">
                                                <MudText>Name</MudText>
                                                <MudForm>
                                                    <SfTextBox ID="txName" @bind-Value="Name" Enabled="false"></SfTextBox>
                                                </MudForm>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudText>Employee Number</MudText>
                                                <MudForm>
                                                    <SfTextBox ID="txtEmployeeNumber" @bind-Value="EmployeeNumber" Enabled="false"></SfTextBox>
                                                </MudForm>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="12" sm="6">
                                                <MudText>Item</MudText>
                                                <MudForm>
                                                    <SfDropDownList ID="ddlItem" TValue="int" Enabled="IsEnabled" TItem="DropdownItemResponse" DataSource="@ItemDropdownList" @bind-Value="RequestData!.ItemId"
                                                                    AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" Placeholder="Select Item">
                                                        <DropDownListEvents TItem="DropdownItemResponse" TValue="int" ValueChange="@OnChangeItem" OnValueSelect="@SelectCountry"></DropDownListEvents>
                                                        <DropDownListFieldSettings Text="Description" Value="Id" />
                                                    </SfDropDownList>
                                                </MudForm>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudText>Payment Frequency</MudText>
                                                <MudForm>
                                                    <SfTextBox ID="txtFrequency" Placeholder="Payment Frequency" @bind-Value="Frequency" Enabled="false"></SfTextBox>
                                                </MudForm>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <MudText>Currency</MudText>
                                                <MudForm>
                                                    <SfDropDownList ID="ddlCurency" TValue="int" TItem="DropdownItemResponse" Enabled="@IsEnabled" DataSource="@Curency" @bind-Value="RequestData!.CurrencyType"
                                                                    Placeholder="Select Currency">
                                                        <DropDownListFieldSettings Text="Description" Value="Id" />
                                                    </SfDropDownList>
                                                </MudForm>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    @if (CountryDropdownList != null && CountryDropdownList.Count() > 0)
                                    {
                                        <MudItem xs="12">
                                            <MudGrid>
                                                <MudItem xs="12" sm="6">
                                                    <MudText>Country</MudText>
                                                    <MudForm>
                                                    <SfDropDownList ID="ddlCountry" TValue="string" Enabled="IsEnabled" TItem="DropdownItemStringResponse" DataSource="@CountryDropdownList" @bind-Value="RequestData!.Country"
                                                                        AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" Placeholder="Select Country">
                                                            <DropDownListEvents TItem="DropdownItemStringResponse" TValue="string" ValueChange="@OnChangeContryAsync"></DropDownListEvents>
                                                            <DropDownListFieldSettings Text="Description" Value="Id" />
                                                        </SfDropDownList>
                                                    </MudForm>
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudText>City</MudText>
                                                    <MudForm>
                                                        <SfDropDownList ID="ddlCty" TValue="string" Enabled="IsEnabled" TItem="DropdownItemStringResponse" DataSource="@CityDropdownList" @bind-Value="RequestData!.City"
                                                                        AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" Placeholder="Select City">
                                                            <DropDownListEvents TItem="DropdownItemStringResponse" TValue="string" ValueChange="@OnChangeCityAsync"></DropDownListEvents>
                                                            <DropDownListFieldSettings Text="Description" Value="Id" />
                                                        </SfDropDownList>
                                                    </MudForm>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    }
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <MudText>Amount</MudText>
                                                <MudForm>
                                                    <SfNumericTextBox ID="txtAmount" Placeholder="Amount" Format="n2" @bind-Value="RequestData!.Amount" Enabled="@IsEnabled" Min="0"></SfNumericTextBox>
                                                </MudForm>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <MudText>Notes</MudText>
                                                <MudForm>
                                                    <SfTextArea ID="txtNotes" RowCount="3" ColumnCount="1000" Placeholder="Input Notes" @bind-Value="RequestData!.Notes" Disabled="@(!IsEnabled)"></SfTextArea>
                                                </MudForm>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <MudText>Payment Proof</MudText>
                                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="font-style: italic; font-size: 0.8rem;">
                                                    <b>(Maximum Size 5 Mb)</b>
                                                </MudText>
                                                <MudForm Class="mt-1">
                                                    <SfUploader ID="uploaderReimbursement" AutoUpload="true" SequentialUpload="false" AllowMultiple="false" Enabled="@IsEnabled"
                                                                AllowedExtensions=".pdf">
                                                        <UploaderEvents ValueChange="ValueChangeDisbursement" OnRemove="OnRemoveDisbursement"></UploaderEvents>
                                                    </SfUploader>
                                                </MudForm>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <br />
                                    @if (listDocument!.Count() > 0)
                                    {
                                        <MudItem xs="12">
                                            <SfGrid DataSource="@listDocument" AllowPaging="true" Width="100%" AllowResizing="true">
                                                <GridPageSettings PageCount="8" PageSize="8" PageSizes="@SyncfusionGridValue.PageSize"></GridPageSettings>
                                                <GridEvents CommandClicked="OnCommandClicked" TValue="GetDocumentsDocument"></GridEvents>
                                                <GridColumns>
                                                    <GridColumn Field=@nameof(GetDocumentsDocument.FileName) HeaderText="Filename" TextAlign="TextAlign.Left" Width="80%"> </GridColumn>
                                                    <GridColumn HeaderText="Action" Width="20%" TextAlign="TextAlign.Center">
                                                        <GridCommandColumns>
                                                            <GridCommandColumn ID="btnDownload" Title="Download" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-download", CssClass="e-flat" })"> </GridCommandColumn>
                                                            @* <GridCommandColumn ID="btnDelete" Title="Delete" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-delete", CssClass="e-flat" })"> </GridCommandColumn> *@
                                                        </GridCommandColumns>
                                                    </GridColumn>
                                                </GridColumns>
                                            </SfGrid>
                                        </MudItem>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton Content="Cancel" CssClass="e-outline e-danger" IconCss="e-icons e-close" OnClick="OnClickNo"></SfButton>
            @if (IsEnabled == true)
            {
                <SfButton Content="Save" CssClass="e-success" IconCss="e-icons e-circle-check" OnClick="OnClickYes"></SfButton>
            }

        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
    <DialogPositionData X="center" Y="center"></DialogPositionData>
    <DialogAnimationSettings Effect="DialogEffect.None"></DialogAnimationSettings>
</SfDialog>


@code {
    [Parameter]
    public bool Visibility { get; set; }
    [Parameter]
    public string? Title { get; set; }
    [Parameter]
    public EventCallback DialogOpen { get; set; }
    [Parameter]
    public EventCallback DialogClose { get; set; }
    [Parameter]
    public EventCallback OnClickNo { get; set; }
    [Parameter]
    public EventCallback OnClickYes { get; set; }
    [Parameter]
    public string? Name { get; set; }
    [Parameter]
    public string? EmployeeNumber { get; set; }
    [Parameter]
    public bool IsEnabled { get; set; }
    [Parameter]
    public int ItemId { get; set; }
    [Parameter]
    public string? Country { get; set; }
    [Parameter]
    public string? City { get; set; }
    [Parameter]
    public float? Ammount { get; set; }
    [Parameter]
    public EventCallback<CommandClickEventArgs<GetDocumentsDocument>> OnCommandClicked { get; set; }
    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemoveDisbursement { get; set; }
    [Parameter]
    public List<GetDocumentsDocument>? listDocument { get; set; }
    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChangeDisbursement { get; set; }
    [Parameter]
    public List<DropdownItemResponse>? Curency { get; set; }
    [Parameter]
    public List<DropdownItemResponse> ItemDropdownList { get; set; }
    [Parameter]
    public List<DropdownItemStringResponse> CountryDropdownList { get; set; }
    [Parameter]
    public DisbursementRequest? RequestData { get; set; }
    [Parameter]
    public IEnumerable<GetItemStudyAssignmentResponse>? ItemListData { get; set; } = default!;
    [Parameter]
    public List<DropdownItemStringResponse>? CityDropdownList { get; set; }
    [Parameter]
    public string Frequency { get; set; }
	[Parameter] public EventCallback<ChangeEventArgs<int, DropdownItemResponse>> OnChangeItem { get; set; }
	[Parameter] public EventCallback<ChangeEventArgs<string, DropdownItemStringResponse>> OnChangeCountry { get; set; }
	[Parameter] public EventCallback<ChangeEventArgs<string, DropdownItemStringResponse>> OnChangeCity { get; set; }
    // public List<DropdownItemResponse>? CityDropdownList { get; set; }

    // public IEnumerable<StudyAssignmentFee> listFee = new List<StudyAssignmentFee>();
    // protected override void OnInitialized()
    // {
    //     if (RequestData!.Id != null)
    //     {
    //         var query = ItemListData.Where(x => x.Id == RequestData!.StudyAssignmentFeeId).SingleOrDefault();
    //         var result = query.StudyAssignmentFee.Select(x => x.Country).Distinct().ToList();
    //         _countryDropdownList = result.Select(x => new DropdownItemStringResponse { Id = x, Description = x }).Distinct().ToList();

    //         var resultCity = query.StudyAssignmentFee.Where(x => x.Country == RequestData!.Country).Select(x => x.City).Distinct().ToList();
    //         _cityDropdownList = resultCity.Select(x => new DropdownItemStringResponse { Id = x, Description = x }).Distinct().ToList();
    //     }
    // }

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    public async void OnChangeItemAsync(ChangeEventArgs<int, DropdownItemResponse> args)
    {
        var query = ItemListData.Where(x => x.Id == args.Value).SingleOrDefault();
        if (query == null) return;

        if (query.StudyAssignmentFee.FirstOrDefault()!.PeriodType == "Month")
        {
            Frequency = $"Period - {query.StudyAssignmentFee.FirstOrDefault()!.Perod} Month";
        }
        else if (query.StudyAssignmentFee.FirstOrDefault()!.PeriodType == "Times")
        {
            Frequency = $"Period - {query.StudyAssignmentFee.FirstOrDefault()!.Perod} Times";
        }
        if (query!.StudyAssignmentFee.Count() > 1)
        {
            var result = query.StudyAssignmentFee.Select(x => x.Country).Distinct().ToList();
            CountryDropdownList = result.Select(x => new DropdownItemStringResponse { Id = x, Description = x }).Distinct().ToList();

            CityDropdownList = new List<DropdownItemStringResponse>();
            RequestData!.Country = null;
            RequestData!.City = null;
        }
        else
        {
            RequestData!.Amount = query.StudyAssignmentFee.FirstOrDefault()!.Fee;
            RequestData!.StudyAssignmentFeeId = query.StudyAssignmentFee.Select(x => x.Id).First();
            CountryDropdownList = new List<DropdownItemStringResponse>();
            CityDropdownList = new List<DropdownItemStringResponse>();
            RequestData!.Country = null;
            RequestData!.City = null;
        }
    }
    private async Task OnChangeContryAsync(ChangeEventArgs<string, DropdownItemStringResponse> args)
    {
        var query = ItemListData.Where(x => x.Id == RequestData!.ItemId).SingleOrDefault();
        if (query!.StudyAssignmentFee.Count() > 1)
        {
            var result = query.StudyAssignmentFee.Where(x => x.Country == args.Value).Select(x => x.City).Distinct().ToList();
            CityDropdownList = result.Select(x => new DropdownItemStringResponse { Id = x, Description = x }).Distinct().ToList();

            RequestData!.City = null;
            
            StateHasChanged();
        }
    }
    private async Task OnChangeCityAsync(ChangeEventArgs<string, DropdownItemStringResponse> args)
    {
        var query = ItemListData.Where(x => x.Id == RequestData!.ItemId).SingleOrDefault();
        if (query!.StudyAssignmentFee.Count() > 1)
        {
            RequestData!.Amount = (decimal)query.StudyAssignmentFee.Where(x => x.City == args.Value).Select(x => x.Fee).First();
            RequestData!.StudyAssignmentFeeId = query.StudyAssignmentFee.Where(x => x.City == args.Value).Select(x => x.Id).First();

            StateHasChanged();
        }
    }
    public void SelectCountry()
    {
        Console.WriteLine("Select event has been triggered !!");
    }
