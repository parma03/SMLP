@using Psmp.Shared.Common.Responses
@using Psmp.Shared.Payments.Commands
@inject IJSRuntime JsRuntime

<SfDialog Target="#target" Width="820px" ShowCloseIcon="true" @bind-Visible=Visibility>
    <DialogTemplates>
        <Header>@Title</Header>
        <Content>
            <div class="row">
                <div class="col-md-12">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudCard>
                                <MudCardContent>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Phone Number Employee</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox ID="txtPhoneNumber" Placeholder="Phone Number Employee" @bind-Value="Request!.PhoneNumber" Enabled="@IsEnabled"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Bank Account</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox ID="txtAccountNumber" Placeholder="Account Number" @bind-Value="Request!.AccountNumber" Enabled="@IsEnabled"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Name of Bank</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox ID="txtName" Placeholder="Name of Bank" @bind-Value="Request!.BankName" Enabled="@IsEnabled"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Currency</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox ID="txtName" Placeholder="Name of Bank" @bind-Value="Request!.Currency" Enabled="@IsEnabled"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Bank Branch</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox ID="txtBranch" Placeholder="Bank Branch" @bind-Value="Request!.BankBranch" Enabled="@IsEnabled"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Bank City</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox ID="txtCity" Placeholder="Bank City" @bind-Value="Request!.BankCity" Enabled="@IsEnabled"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Bank Country</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox ID="txtCountry" Placeholder="Bank Country" @bind-Value="Request!.BankCountry" Enabled="@IsEnabled"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Account Holder</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox ID="txtHolder" Placeholder="Account Holder" @bind-Value="Request!.AccountHolder" Enabled="@IsEnabled"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                        <MudItem xs="12">
                                            <MudText>Screenshot of Account Number</MudText>
                                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="font-style: italic; font-size: 0.8rem;">
                                                <b>(Maximum Size 5 Mb)</b>
                                            </MudText>
                                            <MudGrid Class="mt-1">
                                                <MudItem xs="12">
                                                    <SfUploader @ref="_uploaderRef" ID="uploaderReimbursement" AutoUpload="true" SequentialUpload="false" AllowMultiple="false" Enabled="@IsEnabled"
                                                                AllowedExtensions=".pdf">
                                                        <UploaderEvents ValueChange="OnUploaderValueChange" OnRemove="OnUploaderRemove"></UploaderEvents>
                                                    </SfUploader>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    </MudItem>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton Content="Cancel" CssClass="e-outline e-danger" IconCss="e-icons e-close" OnClick="OnClickNo"></SfButton>
            @if (IsEnabled == true)
            {
                <SfButton Content="Save" CssClass="e-success" IconCss="e-icons e-circle-check" OnClick="OnClickYes"></SfButton>
            }

        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
    <DialogPositionData X="center" Y="top"></DialogPositionData>
    <DialogAnimationSettings Effect="DialogEffect.None"></DialogAnimationSettings>
</SfDialog>

<SfDialog @ref="_confirmDialog" Width="350px" IsModal="true" ShowCloseIcon="false" @bind-Visible="_confirmVisible">
    <DialogTemplates>
        <Header> Confirm File Update </Header>
        <Content>
            <MudText Class="ml-5 mb-6">Are you sure you want to replace this file?</MudText>
        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-danger" Content="No" OnClick="@OnCancelReplace"></SfButton>
            <SfButton CssClass="e-success" Content="Yes" OnClick="@OnConfirmReplace"></SfButton>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    private SfUploader? _uploaderRef;
    private SfDialog? _confirmDialog;
    private bool _confirmVisible;
    private UploadChangeEventArgs? _pendingArgs;

    [Parameter]
    public Guid? ExistingDocumentId { get; set; }

    [Parameter]
    public bool Visibility { get; set; }

    [Parameter]
    public string? Title { get; set; }
    [Parameter]
    public string? CurrancyType { get; set; }

    [Parameter]
    public EventCallback DialogOpen { get; set; }

    [Parameter]
    public EventCallback DialogClose { get; set; }

    [Parameter]
    public EventCallback OnClickNo { get; set; }

    [Parameter]
    public EventCallback OnClickYes { get; set; }

    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemove { get; set; }

    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChange { get; set; }

    [Parameter]
    public BankAccountRequest? Request { get; set; }

    [Parameter]
    public bool IsEnabled { get; set; }

    private async Task OnUploaderValueChange(UploadChangeEventArgs args)
    {
        if (args?.Files == null || !args.Files.Any())
            return;

        // cek file existing
        Guid? existing = ExistingDocumentId;
        if (!existing.HasValue && Request != null)
        {
            var prop = Request.GetType().GetProperty("DocumentId");
            if (prop != null)
            {
                var val = prop.GetValue(Request);
                if (val is Guid g)
                    existing = g;
                else if (val is Guid?)
                    existing = (Guid?)val;
            }
        }

        bool hasExisting = existing.HasValue && existing.Value != Guid.Empty;

        if (hasExisting)
        {
            // simpan args sementara dan tampilkan dialog konfirmasi
            _pendingArgs = args;
            _confirmVisible = true;
            return;
        }

        // Ada file existing, langsung proses
        if (ValueChange.HasDelegate)
            await ValueChange.InvokeAsync(args);
    }

    private async Task OnConfirmReplace()
    {
        _confirmVisible = false;

        if (_pendingArgs != null && ValueChange.HasDelegate)
            await ValueChange.InvokeAsync(_pendingArgs);

        _pendingArgs = null;
    }

    private async Task OnCancelReplace()
    {
        _confirmVisible = false;
        _pendingArgs = null;

        if (_uploaderRef is not null)
            await _uploaderRef.ClearAllAsync();
    }

    private async Task OnUploaderRemove(RemovingEventArgs args)
    {
        if (OnRemove.HasDelegate)
            await OnRemove.InvokeAsync(args);

        if (_uploaderRef is not null)
            await _uploaderRef.ClearAllAsync();
    }
}
