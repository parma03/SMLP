@using Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components

@inject IWebHostEnvironment _webHostEnvironment
@inject IOptions<HrisOptions> _hrisOptions
@inject IJSRuntime JSRuntime

<ErrorViewer Error="@Error" />
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>

@if (_isLoading)
{
    <Loading IsVisible="_isLoading" />
}
else
{
    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="12">
            <MudText Typo="Typo.body1" HtmlTag="h3">
                Hello <b>@_displayName</b>, welcome to study monitoring page.<br />
                Please submit your transcript, last exam schedule and graduation schedule.<br />
                Don't forget to fill out Feedback Form. thank you!
            </MudText>
        </MudItem>
    </MudGrid>
    <MudGrid Class="mb-2">
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudGrid AlignItems="center">
                    <MudItem xs="12">
                        <MudText Typo="Typo.h5" Color="Color.Primary" Class="ms-0">@_displayName</MudText>
                    </MudItem>
                </MudGrid>
                <MudGrid Spacing="2">
                    <MudItem xs="9" Class="d-flex align-center justify-start">
                        <MudText Typo="Typo.h5" Color="Color.Primary" Class="ms-0">@_universityName</MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-3">
        <MudItem xs="12">
            <MudCard Class="pa-4" Elevation="2">
                <MudGrid AlignItems="center">
                    <!-- Card Highest -->
                    <MudItem xs="5" md="4" Class="d-flex justify-center">
                        <Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatistic Icon="@Icons.Material.Rounded.TrendingUp" AvatarColor="Color.Success" Title="Highest GPA" Count="_gpaMaximum">
                        </Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatistic>
                    </MudItem>

                    <!-- Divider Vertikal -->
                    <MudItem xs="0" md="0" Class="d-flex justify-start">
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                        </MudHidden>
                    </MudItem>

                    <!-- Card Lower -->
                    <MudItem xs="5" md="4" Class="d-flex justify-center">
                        <Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatistic Icon="@Icons.Material.Rounded.TrendingDown" AvatarColor="Color.Warning" Title="Lowest GPA" Count="_gpaMinimum">
                        </Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatistic>
                    </MudItem>

                    <!-- Divider Vertikal -->
                    <MudItem xs="0" md="0" Class="d-flex justify-start">
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                        </MudHidden>
                    </MudItem>

                    <!-- Card Average -->
                    <MudItem xs="5" md="3" Class="d-flex justify-center">
                        <Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatistic Icon="@Icons.Material.Rounded.InsertChart" AvatarColor="Color.Primary" Title="GPA Average" Count="_gpaAverage">
                        </Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatistic>
                    </MudItem>
                </MudGrid>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-2">
        <MudItem xs="12">
            <MudItem xs="12" Class="mb-4">
                <MudGrid Class="d-flex flex-wrap justify-start align-center">
                    <MudItem Class="ml-1 pa-2 ma-0">
                        <SfButton OnClick="OnClickAddAsync" Content="Add File" IconCss="e-icons e-circle-add" CssClass="e-primary"></SfButton>
                    </MudItem>
                    <MudItem Class="ml-1 pa-2 ma-0">
                        <SfButton OnClick="@(async () => await JSRuntime.InvokeVoidAsync("open", "https://apps.pertamina.com/lms2/login/index.php", "_blank"))" Content="Feedback Form" IconCss="e-icons e-hyperlink-open" CssClass="e-primary"></SfButton>
                    </MudItem>
                </MudGrid>
            </MudItem>
            @* <MudItem xs="12" Class="mb-2">
                <SfButton OnClick="OnClickAddAsync" Content="Add File" IconCss="e-icons e-circle-add" CssClass="e-primary"></SfButton>
            </MudItem> *@
            @if (GraduateData!.LastExamDocumentId.HasValue)
            {
                <MudItem xs="12" Class="mb-2">
                    <MudText Typo="Typo.h6">Last Exam Schedule</MudText>
                    <MudCard Class="pa-4" Elevation="2">
                        <MudGrid>
                            <!-- Card Highest -->
                            <MudItem xs="6" Class="d-flex justify-left">
                                <Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardDocument Icon="@Icons.Material.Filled.PictureAsPdf" Title="Last Exam Schedule" SubTitle="Last Exam Schedule.pdf" OnClickDownload="OnClickDownloadLastExam">
                                </Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardDocument>
                            </MudItem>

                            <!-- Vertical Devider-->
                            <MudItem xs="2" Class="d-flex justify-center">
                                <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                            </MudItem>

                            <!-- Card Lower -->
                            <MudItem xs="4" Class="d-flex justify-left">
                                <Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatus Icon="@Icons.Material.Rounded.Check">
                                </Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatus>
                            </MudItem>
                        </MudGrid>
                    </MudCard>
                </MudItem>
            }

            @if (GraduateData!.GraduationDocumentId.HasValue)
            {
                <MudItem xs="12" Class="mb-2">
                    <MudText Typo="Typo.h6">Graduate Schedule</MudText>
                    <MudCard Class="pa-4" Elevation="2">
                        <MudGrid>
                            <!-- Card Highest -->
                            <MudItem xs="6" Class="d-flex justify-left">
                                <Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardDocument Icon="@Icons.Material.Filled.PictureAsPdf" Title="Graduate Schedule" SubTitle="Graduate Schedule.pdf" OnClickDownload="OnClickDownloadGraduate">
                                </Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardDocument>
                            </MudItem>

                            <!-- Vertical Devider-->
                            <MudItem xs="2" Class="d-flex justify-center">
                                <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                            </MudItem>

                            <!-- Card Lower -->
                            <MudItem xs="4" Class="d-flex justify-left">
                                <Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatus Icon="@Icons.Material.Rounded.Check">
                                </Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatus>
                            </MudItem>
                        </MudGrid>
                    </MudCard>
                </MudItem>
            }

            @if (GraduateData!.TranscriptDocumentId.HasValue)
            {
                <MudItem xs="12" Class="mb-2">
                    <MudText Typo="Typo.h6">Transcript</MudText>
                    <MudCard Class="pa-4" Elevation="2">
                        <MudGrid>
                            <!-- Card Highest -->
                            <MudItem xs="6" Class="d-flex justify-left">
                                <Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardDocument Icon="@Icons.Material.Filled.PictureAsPdf" Title="Transcript" SubTitle="Transcript.pdf" OnClickDownload="OnClickDownloadTranscript">
                                </Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardDocument>
                            </MudItem>

                            <!-- Vertical Devider-->
                            <MudItem xs="2" Class="d-flex justify-center">
                                <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                            </MudItem>

                            <!-- Card Lower -->
                            <MudItem xs="4" Class="d-flex justify-left">
                                <Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatus Icon="@Icons.Material.Rounded.Check">
                                </Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatus>
                            </MudItem>
                        </MudGrid>
                    </MudCard>
                </MudItem>
            }

            @if (GraduateData!.CompletionDocumentId.HasValue)
            {
                <MudItem xs="12" Class="mb-2">
                    <MudText Typo="Typo.h6">Certificate of Completion</MudText>
                    <MudCard Class="pa-4" Elevation="2">
                        <MudGrid>
                            <!-- Card Highest -->
                            <MudItem xs="6" Class="d-flex justify-left">
                                <Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardDocument Icon="@Icons.Material.Filled.PictureAsPdf" Title="Certificate of Completion" SubTitle="Certificate of Completion.pdf" OnClickDownload="OnClickDownloadCompletion">
                                </Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardDocument>
                            </MudItem>

                            <!-- Vertical Devider-->
                            <MudItem xs="2" Class="d-flex justify-center">
                                <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                            </MudItem>

                            <!-- Card Lower -->
                            <MudItem xs="4" Class="d-flex justify-left">
                                <Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatus Icon="@Icons.Material.Rounded.Check">
                                </Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatus>
                            </MudItem>
                        </MudGrid>
                    </MudCard>
                </MudItem>
            }

            @if (GraduateData!.CourseFinalDocumentId.HasValue)
            {
                <MudItem xs="12" Class="mb-2">
                    <MudText Typo="Typo.h6">Thesis/ Course Final Project/ Disertation</MudText>
                    <MudCard Class="pa-4" Elevation="2">
                        <MudGrid>
                            <!-- Card Highest -->
                            <MudItem xs="6" Class="d-flex justify-left">
                                <Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardDocument Icon="@Icons.Material.Filled.PictureAsPdf" Title="Course Final Project" SubTitle="Course Final Project.pdf" OnClickDownload="OnClickDownloadFinalProject">
                                </Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardDocument>
                            </MudItem>

                            <!-- Vertical Devider-->
                            <MudItem xs="2" Class="d-flex justify-center">
                                <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                            </MudItem>

                            <!-- Card Lower -->
                            <MudItem xs="4" Class="d-flex justify-left">
                                <Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatus Icon="@Icons.Material.Rounded.Check">
                                </Smlp.Bsui.Features.Applicants.Studies.Monitoring.Components.CardStatus>
                            </MudItem>
                        </MudGrid>
                    </MudCard>
                </MudItem>
            }
        </MudItem>
    </MudGrid>
}

<DialogAddGraduate Visibility="VisiblePopup"
                   DialogOpen="DialogOpen"
                   DialogClose="DialogClose"
                   OnClickNo="ClickedNo"
                   OnClickYes="ClickedYes"
                   ValueChangeLastExam="ValueChangeUploaderLastExam"
                   OnRemoveLastExam="OnRemoveUploaderLastExam"
                   ValueChangeGraduation="ValueChangeUploaderGraduate"
                   OnRemoveGraduation="OnRemoveUploaderGraduate"
                   ValueChangeTranscript="ValueChangeUploaderTranscript"
                   OnRemoveTranscript="OnRemoveUploaderTranscript"
                   ValueChangeCompletion="ValueChangeUploaderCompletion"
                   OnRemoveCompletion="OnRemoveUploaderCompletion"
                   ValueChangeFinalProject="ValueChangeUploaderFinalProject"
                   OnRemoveFinalProject="OnRemoveUploaderFinalProject"
                   MaxFileSize="_maximumFileSizeInBytes"
                   request="_requestGraduate" />
