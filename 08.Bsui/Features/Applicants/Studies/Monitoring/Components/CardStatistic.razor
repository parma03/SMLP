<MudCard Elevation="0" Class="ml-1">
    <MudCardHeader>
        <CardHeaderAvatar>
            <MudAvatar Color="@AvatarColor">
                <MudIcon Icon="@Icon"></MudIcon>
            </MudAvatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText>@Title</MudText>

            @if (!string.IsNullOrWhiteSpace(SubTitle))
            {
                <MudText Typo="Typo.h5">@SubTitle</MudText>
            }

            <MudText Typo="Typo.h5">@Count.ToString("N2")</MudText>
        </CardHeaderContent>
    </MudCardHeader>
</MudCard>
