@using Smlp.Shared.StudyMonitorings.StudyPeriod.Commands.Create

<SfDialog Target="#target" Width="620px" ShowCloseIcon="true" @bind-Visible=Visibility>
    <DialogTemplates>
        <Header>GPA</Header>
        <Content>
            <div class="row">
                <div class="col-md-12">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudCard Class="ml-2" Elevation="0">
                                <MudCardContent>
                                    <MudItem xs="12">
                                        <MudItem xs="12">
                                            <MudAlert Severity="Severity.Info" Dense="true" NoIcon="true">
                                                <MudText>
                                                    <span style="color:black">If your GPA range isn't 1-4, please convert your GPA using </span>
                                                    <MudLink Href="https://www.scholaro.com/gpa-calculator/" Target="_blank" Color="Color.Info" Style="font-size: 15px;">
                                                        this link
                                                    </MudLink>
                                                    <span style="color:black">before filling out this form</span>
                                                </MudText>
                                            </MudAlert>
                                        </MudItem>
                                        
                                        <MudItem xs="12" Class="mt-4">
                                            <MudText>Semester <span style="color:red;">*</span></MudText>
                                            <SfNumericTextBox TValue="int" Min="1" Max="10"
                                                              @bind-Value="request!.Semester"></SfNumericTextBox>
                                        </MudItem>

                                        <MudItem xs="12" Class="mt-4">
                                            <MudText>GPA Score <span style="color:red;">*</span></MudText>
                                            <SfNumericTextBox TValue="float" Min="0" Max="4" Decimals=2
                                                              @bind-Value="request!.GpaScore"></SfNumericTextBox>
                                        </MudItem>

                                        <MudItem xs="12" Class="mt-4">
                                            @* <MudText>Transcript (.pdf) (Max. 5 Mb) <span style="color:red;">*</span></MudText> *@
                                            <MudText>Transcript (.pdf) <span style="color:red;">*</span></MudText>
                                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="font-style: italic; font-size: 0.8rem;" Class="mb-2">
                                                <b>(Maximum Size 5 Mb)</b>
                                            </MudText>
                                            <SfUploader ID="uploaderTranscript" AutoUpload="true" SequentialUpload="false" AllowMultiple="false"
                                                        AllowedExtensions=".pdf" MaxFileSize="@MaxFileSize">
                                                <UploaderEvents ValueChange="ValueChangeTranscript" OnRemove="OnRemoveTranscript"></UploaderEvents>
                                            </SfUploader>
                                        </MudItem>
                                    </MudItem>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton Content="Cancel" CssClass="e-outline e-danger" IconCss="e-icons e-close" OnClick="OnClickNo"></SfButton>
            <SfButton Content="Save" CssClass="e-success" IconCss="e-icons e-circle-check" OnClick="OnClickYes"></SfButton>
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
    <DialogPositionData X="center" Y="center"></DialogPositionData>
    <DialogAnimationSettings Effect="DialogEffect.None"></DialogAnimationSettings>
</SfDialog>

@code {

    [Parameter]
    public bool Visibility { get; set; }

    [Parameter]
    public EventCallback DialogOpen { get; set; }

    [Parameter]
    public EventCallback DialogClose { get; set; }

    [Parameter]
    public EventCallback OnClickNo { get; set; }

    [Parameter]
    public EventCallback OnClickYes { get; set; }

    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChangeTranscript { get; set; }

    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemoveTranscript { get; set; }

    [Parameter]
    public CreateStudyPeriodRequest? request { get; set; }

    [Parameter]
    public long MaxFileSize { get; set; }
}
