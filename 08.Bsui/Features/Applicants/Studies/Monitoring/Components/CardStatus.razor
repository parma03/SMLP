@using Microsoft.AspNetCore.Components
@using MudBlazor

<MudCard Elevation="0">
    <MudCardHeader>
        <CardHeaderAvatar>
            <MudAvatar Color="Color.Tertiary">
                <MudIcon Icon="@Icon"></MudIcon>
            </MudAvatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText>Status</MudText>
            <MudText Typo="Typo.h5">Submitted</MudText>
        </CardHeaderContent>
    </MudCardHeader>
</MudCard>

@code {
    [Parameter]
    public string Icon { get; set; } = Icons.Material.Rounded.Summarize;
}
