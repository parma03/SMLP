@inject IWebHostEnvironment _webHostEnvironment
@inject IOptions<HrisOptions> _hrisOptions

@using Psmp.Bsui.Features.Applicants.Studies.Preparation.Components
@using Psmp.Shared.Applicants.Queries.GetApplicantStudyPreparation
@using Psmp.Shared.Studies.Constants

<BrowserTabTitle>@DisplayTextFor.StudyPreparation</BrowserTabTitle>
<ErrorViewer Error="@Error" />
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>

@if (_isLoading)
{
    <Loading IsVisible="_isLoading" />
}
else
{
    @if (_isCanView)
    {
        <MudGrid Spacing="2">
            <MudGrid Spacing="2" Class="mb-2">
                <MudItem xs="12">
                    <MudText Typo="Typo.body1" HtmlTag="h3">
                        Hello <b>@_displayName</b>, welcome to study preparation page. Please submit your study preparation, thank you!<br />
                        1x preparation class and max. 2x for each tests are allowed to be reimbursed.
                    </MudText>
                </MudItem>
            </MudGrid>

            <MudGrid Class="mb-2">
                <MudItem xs="12" Class="mt-2">
                    <MudGrid>
                        <MudItem xs="1" Class="justify-end">
                            <SfButton OnClick="OnClickAddAsync" Content="Add Category" IconCss="e-icons e-circle-add" CssClass="e-info"></SfButton>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <MudCard Class="pa-4" Elevation="2">
                        <MudCardContent>
                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle2" Class="ms-0">List of Study Preparation</MudText>
                                <MudDivider Style="border-width: 2px; margin-bottom: 16px;" />
                                <br />
                                <SfGrid DataSource="_dataGrid" Toolbar="@(new List<string>() { "Search" })" AllowFiltering="true" AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true">
                                    <GridPageSettings PageCount="5" PageSize="10" PageSizes="@(new string[] { "10", "15", "20", "All" })"></GridPageSettings>
                                    <GridEvents RowDataBound="RowBound" CommandClicked="OnCommandClicked" TValue="GetApplicantStudyPreparationByApplicantIdResponse"></GridEvents>
                                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                                    <GridColumns>
                                        <GridColumn Field=@nameof(GetApplicantStudyPreparationByApplicantIdResponse.Id) IsPrimaryKey="true" Visible="false"></GridColumn>
                                        <GridColumn Field=@nameof(GetApplicantStudyPreparationByApplicantIdResponse.CategoryName) HeaderText="Category" Width="250"></GridColumn>
                                        <GridColumn Field=@nameof(GetApplicantStudyPreparationByApplicantIdResponse.TestCenter) HeaderText="Test Center" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetApplicantStudyPreparationByApplicantIdResponse.TestLocation) HeaderText="Test Location" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetApplicantStudyPreparationByApplicantIdResponse.TestDate) HeaderText="Test Date" Format="dd.MM.yyyy" Type="ColumnType.Date" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetApplicantStudyPreparationByApplicantIdResponse.Score) HeaderText="Score" Width="100" Format="N2"></GridColumn>
                                        <GridColumn Field=@nameof(GetApplicantStudyPreparationByApplicantIdResponse.Status) HeaderText="Status" TextAlign="TextAlign.Center" Width="150">
                                            <Template Context="context">
                                                @{
                                                    var Status = ((GetApplicantStudyPreparationByApplicantIdResponse)context).Status;
                                                    var text = "";
                                                    var css = "";
                                                    switch(Status)
                                                    {
                                                        case "Completed":
                                                            text = "Completed";
                                                            css = "e-success";
                                                            break;
                                                        case "Submitted":
                                                            text = "Submitted";
                                                            css = "e-success";
                                                            break;
                                                        case "Approved":
                                                            text = "Approved";
                                                            css = "e-success";
                                                            break;
                                                        case "WaitingApproval":
                                                            text = "Waiting for Approval";
                                                            css = "e-warning";
                                                            break;
                                                        case "Accepted":
                                                            text = "Accepted";
                                                            css = "e-success";
                                                            break;
                                                        case "ProcessToPOffice":
                                                            text = "Process P-Office";
                                                            css = "e-info";
                                                            break;
                                                        case "ProcessSign":
                                                            text = "Process Sign";
                                                            css = "e-info";
                                                            break;
                                                        case "Draft":
                                                            text = "Draft";
                                                            css = "e-info";
                                                            break;
                                                        case "Rejected":
                                                            text = "Rejected";
                                                            css = "e-danger";
                                                            break;
                                                    }
                                                }
                                                <SfChip>
                                                    <ChipItems>
                                                        <ChipItem Text="@text" CssClass="@css"></ChipItem>
                                                    </ChipItems>
                                                </SfChip>
                                            </Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Action" TextAlign="TextAlign.Center" Width="150">
                                            <GridCommandColumns>
                                                <GridCommandColumn Title="View" Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-eye", CssClass="e-flat" })"></GridCommandColumn>
                                                <GridCommandColumn Title="Download Uploaded" Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-download", CssClass="e-flat" })"></GridCommandColumn>
                                                <GridCommandColumn Title="Download Approved" Type="CommandButtonType.Delete" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-download", CssClass="e-flat e-success" })"></GridCommandColumn>
                                            </GridCommandColumns>
                                        </GridColumn>
                                    </GridColumns>
                                </SfGrid>
                            </MudItem>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudGrid>

        <DialogUpsertApplicantStudyPreparation Visibility="VisiblePopup"
                                               Title="@TitlePopup"
                                               IsEnabled="@IsEnabled"
                                               IsDisabled="@IsDisabled"
                                               DialogOpen="DialogOpen"
                                               DialogClose="DialogClose"
                                               OnClickNo="ClickedNo"
                                               OnClickYes="ClickedYes"
                                               pathSupportingDoc="@_documentPathSupportingDoc"
                                               request="_createData"
                                               listCategories="_dropdownEnumCategories"
                                               listBringFamily="_listBringFamily"
                                               OnRemoveUploaderSupportDoc="OnRemoveUploaderSupportDoc"
                                               ValueChangeUploaderSupportDoc="ValueChangeUploaderSupportDoc"
                                               OnCommandClicked="OnCommandClickedDocument"
                                               MaxFileSize="_maximumFileSizeInBytes"
                                               listDocument="_getListDocuments">

        </DialogUpsertApplicantStudyPreparation>
    }
    else
    {
        <br />
        <MudText Typo="Typo.h4">Not available @DisplayTextFor.StudyPreparation</MudText>
    }
}

<style>
    .e-chip-list {
        display: inline !important
    }

    .e-removeDeletecommand .e-unboundcell .e-unboundcelldiv button.e-Deletebutton {
        display: none;
    }
</style>
