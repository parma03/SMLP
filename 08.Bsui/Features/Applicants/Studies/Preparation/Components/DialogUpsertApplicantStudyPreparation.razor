@using Psmp.Base.Studies.Enums
@using Psmp.Shared.Applicants.Commands.Create
@using Psmp.Shared.Common.Responses
@using Psmp.Shared.StudyPreparations.Ielts.Commands.Create
@using Syncfusion.Blazor.PdfViewerServer
@using Psmp.Shared.Documents.Queries.GetDocuments

<SfDialog Target="#target" Width="820px" ShowCloseIcon="true" AllowDragging="true" @bind-Visible=Visibility>
    <DialogTemplates>
        <Header>Study Preparation</Header>
        <Content>
            <div class="row">
                <div class="col-md-12">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudCard Elevation="0">
                                <MudCardContent>
                                    <MudItem xs="12">
                                        <MudText>Category</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfDropDownList ID="ddlCategory" TValue="StudyCategory" TItem="DropdownEnumResponse<StudyCategory>" DataSource="@listCategories" Enabled="@IsEnabled"
                                                                @bind-Value="@request!.Category" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" Placeholder="Select Category">
                                                    <DropDownListEvents TItem="DropdownEnumResponse<StudyCategory>" TValue="StudyCategory" ValueChange="@OnChangeItemAsync"></DropDownListEvents>
                                                    <DropDownListFieldSettings Text="Description" Value="Id" />
                                                </SfDropDownList>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    @if (request!.Category == StudyCategory.Ielts || request!.Category == StudyCategory.Gre || request!.Category == StudyCategory.Gmat)
                                    {
                                        <MudItem xs="12" Class="mt-4">
                                            <MudText>Test Center</MudText>
                                            <MudGrid>
                                                <MudItem xs="12">
                                                    <SfTextBox ID="txtTestCenter" @bind-Value="@request!.TestCenter" Placeholder="Input Test Center" Enabled="@IsEnabled"></SfTextBox>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                        <MudItem xs="12" Class="mt-4">
                                            <MudText>Test Location</MudText>
                                            <MudGrid>
                                                <MudItem xs="12">
                                                    <SfTextBox ID="txtTestLocation" @bind-Value="@request!.LocationTest" Placeholder="Input Test Location" Enabled="@IsEnabled"></SfTextBox>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                        <MudItem xs="12" Class="mt-4">
                                            <MudGrid>
                                                <MudItem xs="6">
                                                    <MudText>Score</MudText>
                                                    <MudGrid>
                                                        <MudItem xs="12">
                                                            <SfNumericTextBox ID="txtScore" Type="Syncfusion.Blazor.Inputs.InputType.Number" @bind-Value="@request!.Score" Placeholder="Input Score" Enabled="@IsEnabled"
                                                                              Min="@(request!.Category == StudyCategory.Gmat ? 205 : 0)"
                                                                              Max="@(request!.Category == StudyCategory.Gmat ? 800 : request!.Category == StudyCategory.Gre ? 900 : 10)"
                                                                              Format="N2">
                                                            @* Max="@(request!.Category == StudyCategory.Gre || request!.Category == StudyCategory.Gmat ? 900 : 10)" Format="N2"> *@
                                                            </SfNumericTextBox>
                                                        </MudItem>
                                                    </MudGrid>
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudText>Test Date</MudText>
                                                    <MudGrid>
                                                        <MudItem xs="12">
                                                            <SfDatePicker TValue="DateOnly" Format="dd.MM.yyyy" ID="txtDeadline" @bind-Value="@request!.TestDate" Enabled="@IsEnabled"></SfDatePicker>
                                                        </MudItem>
                                                    </MudGrid>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>

                                    }
                                    else if (request!.Category == StudyCategory.SponsorshipLetter || request!.Category == StudyCategory.VisaGuarantee)
                                    {
                                        <MudItem xs="12" Class="mt-4">
                                            <MudText>University Name</MudText>
                                            <MudGrid>
                                                <MudItem xs="12">
                                                    <SfTextBox ID="txtUniversityName" Placeholder="University Name" @bind-Value="request!.UniversityName" Enabled="@IsEnabled"></SfTextBox>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                        <MudItem xs="12" Class="mt-4">
                                            <MudText>Letter Addressed To (Department & Address)</MudText>
                                            <MudGrid>
                                                <MudItem xs="12">
                                                    <SfTextBox ID="txtAddressTo" Placeholder="Letter Addressed To (Department & Address)" @bind-Value="request!.AddressTo" Multiline="true" Enabled="@IsEnabled"></SfTextBox>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                        <MudItem xs="12" Class="mt-4">
                                            <MudText>Study Program Master of...</MudText>
                                            <MudGrid>
                                                <MudItem xs="12">
                                                    <SfTextBox ID="txtStudy" Placeholder="Study Program Master of..." @bind-Value="request!.Study" Enabled="@IsEnabled"></SfTextBox>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                        <MudItem xs="12" Class="mt-4">
                                            <MudText>Academic Year (Start-End)</MudText>
                                            <MudGrid>
                                                <MudItem xs="12">
                                                    <SfTextBox ID="txtAcademicYear" Placeholder="Study Period" @bind-Value="request!.AcademicYear" Enabled="@IsEnabled"></SfTextBox>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                        <MudItem xs="12" Class="mt-4">
                                            <MudText>Bring Family <span style="color:red;">*</span></MudText>
                                            <MudGrid>
                                                <MudItem xs="12">
                                                    <SfDropDownList ID="ddlTime"
                                                                    TValue="int"
                                                                    TItem="DropdownItemResponse"
                                                                    DataSource="@listBringFamily"
                                                                    @bind-Value="request!.IsBringFamily"
                                                                    AllowFiltering="true"
                                                                    FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                                                    Placeholder="Select Bring Family"
                                                                    Enabled="@IsEnabled">
                                                        <DropDownListFieldSettings Text="Description" Value="Id" />
                                                    </SfDropDownList>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                        <MudItem xs="12" Class="mt-4">
                                            <MudText>Country</MudText>
                                            <MudGrid>
                                                <MudItem xs="12">
                                                    <SfTextBox ID="txtCountry" Placeholder="Country" @bind-Value="request!.Country" Enabled="@IsEnabled"></SfTextBox>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                        <MudItem xs="12" Class="mt-4">
                                            <MudText>University Ranking</MudText>
                                            <MudGrid>
                                                <MudItem xs="12">
                                                    <SfTextBox ID="txtUniversityRank" Placeholder="9/QS/2024" @bind-Value="request!.UniversityRank" Enabled="@IsEnabled"></SfTextBox>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                        <MudItem xs="12" Class="mt-4">
                                            <MudText>University Application Due Date</MudText>
                                            <MudGrid>
                                                <MudItem xs="12">
                                                    <SfDatePicker ID="txtUniversityDueDate" Format="dd.MM.yyyy" @bind-Value="request!.UniversityDueDate" Enabled="@IsEnabled"></SfDatePicker>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                        <MudItem xs="12" Class="mt-4">
                                            <MudText>Comment</MudText>
                                            <MudGrid>
                                                <MudItem xs="12">
                                                    <SfTextArea ID="txtComment" Placeholder="Comment" @bind-Value="request!.Comment" RowCount=3 Width="100%" Disabled="@IsDisabled"></SfTextArea>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    }

                                    @if (listDocument!.Count() > 0)
                                    {
                                        <MudItem xs="12" Class="mt-4">
                                            <SfGrid DataSource="@listDocument" AllowPaging="true" Width="100%" AllowResizing="true">
                                                <GridPageSettings PageCount="5" PageSize="5" PageSizes="@(new string[] { "5", "8", "10", "15", "20", "All" })"></GridPageSettings>
                                                <GridEvents CommandClicked="OnCommandClicked" TValue="GetDocumentsDocument"></GridEvents>
                                                <GridColumns>
                                                    <GridColumn Field=@nameof(GetDocumentsDocument.FileName) HeaderText="Filename" TextAlign="TextAlign.Left" Width="80%"> </GridColumn>
                                                    <GridColumn HeaderText="Action" Width="20%" TextAlign="TextAlign.Center">
                                                        <GridCommandColumns>
                                                            <GridCommandColumn ID="btnDownload" Title="Download" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-download", CssClass="e-flat" })"> </GridCommandColumn>
                                                        </GridCommandColumns>
                                                    </GridColumn>
                                                </GridColumns>
                                            </SfGrid>
                                        </MudItem>
                                    }

                                    @*  @if (!string.IsNullOrEmpty(pathSupportingDoc) && pathSupportingDoc.Length > 10)
                                    {
                                        <MudItem xs="12" Style="min-height:250px;" Class="mt-4">
                                            <MudText>Document</MudText>
                                            <MudGrid>
                                                <MudItem xs="12">
                                                    <SfPdfViewerServer DocumentPath="@pathSupportingDoc" Width="100%" Height="350px" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    } *@

                                    @if (IsEnabled)
                                    {
                                        <MudItem xs="12" Class="mt-4">
                                            @* <MudText>Document (.pdf) (Max. 5 Mb) <span style="color:red;">*</span></MudText> *@
                                            <MudText>@(_category ?? "Study Preparation Document (.pdf)") <span style="color:red;">*</span></MudText>
                                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="font-style: italic; font-size: 0.8rem;">
                                                <b>(Maximum Size 5 Mb)</b>
                                            </MudText>
                                            <MudGrid Class="mt-0">
                                                <MudItem xs="12">
                                                    <SfUploader ID="uploaderSupportDoc"
                                                                AutoUpload="true"
                                                                SequentialUpload="false"
                                                                AllowMultiple="false"
                                                                MaxFileSize="@MaxFileSize"
                                                                AllowedExtensions=".pdf">
                                                        <UploaderEvents ValueChange="ValueChangeUploaderSupportDoc" OnRemove="OnRemoveUploaderSupportDoc"></UploaderEvents>
                                                    </SfUploader>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    }
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton Content="Cancel" CssClass="e-outline e-danger" IconCss="e-icons e-close" OnClick="OnClickNo"></SfButton>
            @if (IsEnabled == true)
            {
                <SfButton Content="Save" CssClass="e-success" IconCss="e-icons e-circle-check" OnClick="OnClickYes"></SfButton>
            }
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
    <DialogPositionData X="center" Y="center"></DialogPositionData>
    <DialogAnimationSettings Effect="DialogEffect.None"></DialogAnimationSettings>
</SfDialog>

@code {
    [Parameter]
    public bool IsEnabled { get; set; }

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public bool Visibility { get; set; }

    [Parameter]
    public long MaximumFileSizeInByte { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public EventCallback DialogOpen { get; set; }

    [Parameter]
    public EventCallback DialogClose { get; set; }

    [Parameter]
    public EventCallback OnClickNo { get; set; }

    [Parameter]
    public EventCallback OnClickYes { get; set; }

    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemoveUploaderSupportDoc { get; set; }

    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChangeUploaderSupportDoc { get; set; }

    [Parameter]
    public List<DropdownItemResponse>? listBringFamily { get; set; }

    [Parameter]
    public string? pathSupportingDoc { get; set; } = string.Empty;


    [Parameter]
    public List<DropdownEnumResponse<StudyCategory>>? listCategories { get; set; }

    [Parameter]
    public CreateApplicantStudyPreparationRequest? request { get; set; }

    [Parameter]
    public List<GetDocumentsDocument>? listDocument { get; set; }

    [Parameter]
    public EventCallback<CommandClickEventArgs<GetDocumentsDocument>> OnCommandClicked { get; set; }

    [Parameter]
    public long MaxFileSize { get; set; }

    private string? _category = "IELTS Certificate (.pdf)";

    public async void OnChangeItemAsync(ChangeEventArgs<StudyCategory, DropdownEnumResponse<StudyCategory>> args)
    {
        if (args.ItemData != null)
        {
            _category = args.ItemData.Id switch
            {
                StudyCategory.Ielts => "IELTS Certificate (.pdf)",
                StudyCategory.Gmat => "GMAT Certificate (.pdf)",
                StudyCategory.Gre => "GRE Certificate (.pdf)",
                StudyCategory.Essay => "Essay (.pdf)",
                StudyCategory.SponsorshipLetter => "University Registration Proof (.pdf)",
                StudyCategory.VisaGuarantee => "Scan the front page containing the passport holder's information (with family if bringing any) (.pdf)",
                _ => args.ItemData.Description
            };
        }
        else
        {
            _category = null; // Kembalikan ke default jika tidak ada yang dipilih
        }
    }

}
