@using Smlp.Base.Universities.Enums
@using Smlp.Bsui.Features.StudyPreparations.VisaGuarantee
@using Smlp.Domain.Entities.Masters
@using Smlp.Shared.Common.Responses
@using Smlp.Shared.Masters.Queries;
@using Smlp.Shared.StudyPreparations.VisaGuarantee.Commands.Create
@using Smlp.Shared.StudyPreparations.VisaGuarantee.Constants
@using Syncfusion.Blazor.PdfViewerServer

<SfDialog Target="#target" Width="820px" ShowCloseIcon="true" @bind-Visible=Visibility>
    <DialogTemplates>
        <Header>@Title @DisplayTextFor.VisaGuarantee</Header>
        <Content>
            <div class="row">
                <div class="col-md-12">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudCard>
                                <MudCardContent>
                                    <MudItem xs="12">
                                        <MudText>Applicant <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfDropDownList ID="ddlApllicant"
                                                                TValue="Guid"
                                                                TItem="ApplicantDropdown"
                                                                DataSource="@listApplicants"
                                                                Enabled="@IsEnabled"
                                                                @bind-Value="request!.ApplicantId"
                                                                AllowFiltering="true"
                                                                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                                                Placeholder="Select Applicant">
                                                    <DropDownListFieldSettings Text="Name" Value="Id" />
                                                </SfDropDownList>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>University Name</MudText>
                                        <MudGrid>

                                            <MudItem xs="12">
                                                <SfTextBox ID="txtUniversityName" Placeholder="University Name" @bind-Value="request!.UniversityName"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Sponsorship Letter Addressed To (Department & Address)</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextBox ID="txtAddressTo" Placeholder="Department & Address" @bind-Value="request!.AddressTo" Multiline="true"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Study Program Master of...</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextBox ID="txtStudy" Placeholder="Study Program Master of..." @bind-Value="request!.Study"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Academic Year (Start-End)</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextBox ID="txtAcademicYear" Placeholder="Study Period" @bind-Value="request!.AcademicYear"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Bring Family <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfDropDownList ID="ddlTime"
                                                            TValue="int"
                                                            TItem="DropdownItemResponse"
                                                            DataSource="@listBringFamily"
                                                            @bind-Value="request!.IsBringFamily"
                                                            AllowFiltering="true"
                                                            FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                                                Placeholder="Select Bring Family">
                                                    <DropDownListFieldSettings Text="Description" Value="Id" />
                                                </SfDropDownList>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Country</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextBox ID="txtCountry" Placeholder="Country" @bind-Value="request!.Country"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>University Rank</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfNumericTextBox ID="txtUniversityRank" Placeholder="University Rank" @bind-Value="request!.UniversityRank" ></SfNumericTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>University Applicant Due Date</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfDatePicker ID="txtUniversityDueDate" Format="dd.MM.yyyy" @bind-Value="request!.UniversityDueDate"></SfDatePicker>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Supporting Document (.pdf) (Max. 5 Mb) <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfUploader ID="uploaderSupportDoc"
                                                            AutoUpload="true"
                                                            SequentialUpload="false"
                                                            AllowMultiple="false"
                                                            MaxFileSize="@MaxFileSize"
                                                            AllowedExtensions=".pdf">
                                                    <UploaderEvents ValueChange="ValueChangeUploaderSupportDoc" OnRemove="OnRemoveUploaderSupportDoc"></UploaderEvents>
                                                </SfUploader>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton Content="Cancel" CssClass="e-outline e-danger" IconCss="e-icons e-close" OnClick="OnClickNo"></SfButton>
            @if (IsEnabled == true)
            {
                <SfButton Content="Save" CssClass="e-success" IconCss="e-icons e-circle-check" OnClick="OnClickYes"></SfButton>
            }
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
    <DialogPositionData X="center" Y="center"></DialogPositionData>
    <DialogAnimationSettings Effect="DialogEffect.None"></DialogAnimationSettings>
</SfDialog>

@code {
    [Parameter]
    public bool IsEnabled { get; set; }

    [Parameter]
    public bool Visibility { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public EventCallback DialogOpen { get; set; }

    [Parameter]
    public EventCallback DialogClose { get; set; }

    [Parameter]
    public EventCallback OnClickNo { get; set; }

    [Parameter]
    public EventCallback OnClickYes { get; set; }

    [Parameter]
    public List<ApplicantDropdown>? listApplicants { get; set; }

    [Parameter]
    public List<DropdownItemResponse>? listBringFamily { get; set; }

    [Parameter]
    public CreateVisaGuaranteeRequest? request { get; set; }

    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemoveUploaderSupportDoc { get; set; }

    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChangeUploaderSupportDoc { get; set; }

    [Parameter]
    public long MaxFileSize { get; set; }
}

