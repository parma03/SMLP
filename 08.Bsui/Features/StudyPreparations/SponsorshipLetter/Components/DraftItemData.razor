@* <MudGrid Spacing="2">
    <MudItem xs="12">
        <MudCard>
            <MudCardContent>
                <MudItem xs="12">
                    <SfTooltip ID="TooltipPlaceDate" Target="#txtHdrPlaceDate" Content="@_contentTooltipPlaceDate">
                        <MudText id="txtHdrPlaceDate">
                            Place & Date of Letter Issued <SfIcon Name="IconName.CircleInfo"></SfIcon>
                        </MudText>
                    </SfTooltip>
                    <MudGrid>
                        <MudItem xs="12">
                            <SfTextBox ID="txtPlaceDateLetter" Placeholder="Place & Date of Letter Issued" @bind-Value="_update!.PlaceDateOfLetter" Multiline="true" Enabled="@_isEnabled"></SfTextBox>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12" Class="mt-4">
                    <SfTooltip ID="TooltipNummberOfLetter" Target="#txtHdrNummberOfLetter" Content="@_contentTooltipNummberOfLetter">
                        <MudText id="txtHdrNummberOfLetter">
                            Number of Letter <SfIcon Name="IconName.CircleInfo"></SfIcon>
                        </MudText>
                    </SfTooltip>
                    <MudGrid>
                        <MudItem xs="12">
                            <SfTextBox ID="txtNumberOfLetter" Placeholder="ID Position & Position" @bind-Value="_update!.NumberOfLetter" Multiline="true" Enabled="@_isEnabled"></SfTextBox>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12" Class="mt-4">
                    <SfTooltip ID="TooltipInvoiceAddressPosition" Target="#txtHdrInvoiceAddressPosition" Content="@_contentTooltipInvoiceAddressPosition">
                        <MudText id="txtHdrInvoiceAddressPosition">
                            Invoice Addressed To (ID Position & Position Title) <SfIcon Name="IconName.CircleInfo"></SfIcon>
                        </MudText>
                    </SfTooltip>
                    <MudGrid>
                        <MudItem xs="12">
                            <SfTextBox ID="txtInvoiceAddressPosition" Placeholder="ID Position & Position" @bind-Value="_update!.InvoiceAddressPosition" Enabled="@_isEnabled"></SfTextBox>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12" Class="mt-4">
                    <SfTooltip ID="TooltipInvoiceAddressName" Target="#txtHdrInvoiceAddressName" Content="@_contentTooltipInvoiceAddressName">
                        <MudText id="txtHdrInvoiceAddressName">
                            Invoice Addressed To (Name) <SfIcon Name="IconName.CircleInfo"></SfIcon>
                        </MudText>
                    </SfTooltip>
                    <MudGrid>
                        <MudItem xs="12">
                            <SfTextBox ID="txtInvoiceAddressName" Placeholder="Name" @bind-Value="_update!.InvoiceAddressName" Enabled="@_isEnabled"></SfTextBox>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12" Class="mt-4">
                    <SfTooltip ID="TooltipInvoiceAddressCompany" Target="#txtHdrInvoiceAddressCompany" Content="@_contentTooltipInvoiceAddressCompany">
                        <MudText id="txtHdrInvoiceAddressCompany">
                            Invoice Addressed To (Company) <SfIcon Name="IconName.CircleInfo"></SfIcon>
                        </MudText>
                    </SfTooltip>
                    <MudGrid>
                        <MudItem xs="12">
                            <SfTextBox ID="txtInvoiceAddressCompany" Placeholder="Company Address" @bind-Value="_update!.InvoiceAddressCompany" Multiline="true" Enabled="@_isEnabled"></SfTextBox>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12" Class="mt-4">
                    <SfTooltip ID="TooltipMainPicPosition" Target="#txtHdrMainPicPosition" Content="@_contentTooltipMainPicPosition">
                        <MudText id="txtHdrMainPicPosition">
                            Main PIC ID Position & Position Title <SfIcon Name="IconName.CircleInfo"></SfIcon>
                        </MudText>
                    </SfTooltip>
                    <MudGrid>
                        <MudItem xs="12">
                            <SfTextBox ID="txtMainPicPosition" Placeholder="ID Position & Position" @bind-Value="_update!.MainPicPosition" Enabled="@_isEnabled"></SfTextBox>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12" Class="mt-4">
                    <SfTooltip ID="TooltipMainPicName" Target="#txtHdrMainPicName" Content="@_contentTooltipMainPicName">
                        <MudText id="txtHdrMainPicName">
                            Main PIC Name <SfIcon Name="IconName.CircleInfo"></SfIcon>
                        </MudText>
                    </SfTooltip>
                    <MudGrid>
                        <MudItem xs="12">
                            <SfTextBox ID="txtMainPicName" Placeholder="Name" @bind-Value="_update!.MainPicName" Enabled="@_isEnabled"></SfTextBox>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12" Class="mt-4">
                    <SfTooltip ID="TooltipMainPicEmail" Target="#txtHdrMainPicEmail" Content="@_contentTooltipMainPicEmail">
                        <MudText id="txtHdrMainPicEmail">
                            Main PIC Email Address <SfIcon Name="IconName.CircleInfo"></SfIcon>
                        </MudText>
                    </SfTooltip>
                    <MudGrid>
                        <MudItem xs="12">
                            <SfTextBox ID="txtMainPicEmail" Placeholder="Email Address" @bind-Value="_update!.MainPicEmail" Enabled="@_isEnabled"></SfTextBox>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12" Class="mt-4">
                    <SfTooltip ID="TooltipCarbonCopy" Target="#txtHdrCarbonCopy" Content="@_contentTooltipCarbonCopy">
                        <MudText id="txtHdrCarbonCopy">
                            Carbon Copy (CC) <SfIcon Name="IconName.CircleInfo"></SfIcon>
                        </MudText>
                    </SfTooltip>
                    <MudGrid>
                        <MudItem xs="12">
                            <SfTextBox ID="txtCarbonCopy" Placeholder="Corbon Copy" @bind-Value="_update!.CarbonCopy" Multiline="true" Enabled="@_isEnabled"></SfTextBox>
                        </MudItem>
                    </MudGrid>
                </MudItem>

            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
 *@
