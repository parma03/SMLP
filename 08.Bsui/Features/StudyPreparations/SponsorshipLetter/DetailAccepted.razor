@page "/StudyPreparation/SponsorshipLetter/DetailAccepted/{Id:guid}"
@using Smlp.Bsui.Features.StudyPreparations.SponsorshipLetter.Components
@using Smlp.Shared.StudyPreparations.SponsorshipLetter.Constants

<BrowserTabTitle>@DisplayTextFor.StudyPreparations</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" ActivePanelIndexChanged="@(e => OnTabChanged(e))">
    <MudTabPanel Text="@DisplayTextFor.DraftingSponsorshipLetter">
        <DraftSponsorshipLetter Id="@Id">

        </DraftSponsorshipLetter>
    </MudTabPanel>
    <MudTabPanel Text="@DisplayTextFor.FinalSponsorshipLetter">
        <FinalSponsorshipLetter Id="@Id">

        </FinalSponsorshipLetter>
    </MudTabPanel>
</MudTabs>

<style>
    .mud-tabs-panels {
        min-height: 500px;
    }
</style>
