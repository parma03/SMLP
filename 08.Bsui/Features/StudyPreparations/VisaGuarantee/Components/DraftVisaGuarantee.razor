@using Syncfusion.Blazor.Inputs;
@using Syncfusion.Blazor.PdfViewerServer;
@using Smlp.Shared.StudyPreparations.VisaGuarantee.Constants;
@using Syncfusion.Blazor.DocumentEditor

<style>
    .m-4 {
        margin-right : 4px;
    }

    #txtNumberOfLetter {
        height: 150px;
    }

    #txtInvoiceAddressCompany {
        height: 150px;
    }

    #txtCarbonCopy {
        height: 150px;
    }
    
</style>

<ErrorViewer Error="_error" />
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>
@if (_isLoading)
{
    <Loading IsVisible="_isLoading" />
}
else
{
    <MudGrid Spacing="2">
        <MudItem xs="12">
            <MudGrid Spacing="2">
                <MudItem xs="4">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudCard Style="height : 850px;">
                                <MudCardContent>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Category</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextBox ID="txtCategory" Placeholder="Category" Value="@DisplayTextFor.VisaGuarantee" Enabled="@_isEnabledItem"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>University Name</MudText>
                                        <MudGrid>

                                            <MudItem xs="12">
                                                <SfTextBox ID="txtUniversityName" Placeholder="University Name" @bind-Value="_dataItem!.UniversityName" Enabled="@_isEnabledItem"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Letter Addressed To (Department & Address)</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextBox ID="txtAddressTo" Placeholder="Letter Addressed To (Department & Address)" @bind-Value="_dataItem!.AddressTo" Multiline="true" Enabled="@_isEnabledItem"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Study Program Master of...</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextBox ID="txtStudy" Placeholder="Study Program Master of..." @bind-Value="_dataItem!.Study" Enabled="@_isEnabledItem"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Academic Year (Start-End)</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextBox ID="txtAcademicYear" Placeholder="Study Period" @bind-Value="_dataItem!.AcademicYear" Enabled="@_isEnabledItem"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Bring Family</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextBox ID="txtIsBringFamily" Placeholder="Bring Family" @bind-Value="@_bringFamily" Enabled="@_isEnabledItem"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Country</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextBox ID="txtCountry" Placeholder="Country" @bind-Value="_dataItem!.Country" Enabled="@_isEnabledItem"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>University Ranking</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextBox ID="txtUniversityRank" Placeholder="9/QS/2024" @bind-Value="_dataItem!.UniversityRank" Enabled="@_isEnabledItem"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>University Applicant Due Date</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfDatePicker ID="txtUniversityDueDate" Format="dd.MM.yyyy" @bind-Value="_dataItem!.UniversityDueDate" Enabled="@_isEnabledItem"></SfDatePicker>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Comment</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextArea ID="txtComment" @bind-Value="_dataItem!.Comment" RowCount=3 Width="100%" Disabled="true"></SfTextArea>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="8">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" Style="min-height:670px;">
                            <MudText>Supporting Document</MudText>
                            <MudGrid>
                                <MudItem xs="12">
                                    <SfPdfViewerServer DocumentPath="@_supportingDocument" Width="100%" Height="670px" />
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                        <MudItem xs="12" Class="mt-4">
                            <MudCard>
                                <MudCardContent>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Notes</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextBox ID="txtNotes" Placeholder="Notes" @bind-Value="_dataItem!.Notes" Multiline="true" Enabled="@_isEnabledItem"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        </MudItem>
        <MudItem xs="12" Class="mt-8">
            <MudGrid Spacing="2">
                <MudItem xs="12" Class="text-center">
                    <ErrorViewer Error="_errorDraft" />
                    <SfDocumentEditorContainer @ref="_containerDocument" Height="1069px" ShowPropertiesPane="@ShowProperties" RestrictEditing="@ReadOnly" EnableToolbar="@Toolbar" ToolbarItems="@_toolbarItems" DocumentEditorSettings="_settingDocument">
                        <DocumentEditorContainerEvents Created="OnCreated"></DocumentEditorContainerEvents>
                    </SfDocumentEditorContainer>
                </MudItem>
            </MudGrid>
        </MudItem>
        <MudItem xs="12">
            <MudGrid>
                <MudItem xs="2" Style="text-align: left;">
                    <SfButton OnClick="OnClickBack" Content="Back" IconCss="e-icons e-arrow-left" CssClass="e-danger"></SfButton>
                </MudItem>
                <MudItem xs="10" Style="text-align: right;">
                    @if (_documentDraftId == Guid.Empty)
                    {
                        <SfButton OnClick="OnClickGenerateAsync" Content="Generate" IconCss="e-icons e-circle-check" CssClass="e-primary"></SfButton>
                    }
                    else
                    {
                        if (_contentButton == "Update")
                        {
                            <SfButton OnClick="OnClickUpdateAsync" Content="Update" IconCss="e-icons e-edit" CssClass="e-info m-4" Disabled="@_disableButton"></SfButton>
                        }
                        else if (_contentButton == "Save")
                        {
                            <SfButton OnClick="OnClickSaveAsync" Content="Save" IconCss="e-icons e-save" CssClass="e-info m-4" Disabled="@_disableButton"></SfButton>
                        }
                        <SfButton OnClick="OnClickPofficeAsync" Content="Continue to P-Office" IconCss="e-icons e-check" CssClass="e-info" Disabled="true"></SfButton>
                        <SfButton OnClick="OnClickPsignAsync" Content="Continue to P-Sign" IconCss="e-icons e-check" CssClass="e-info" Disabled="true"></SfButton>
                        <SfButton OnClick="OnClickDownloadWordAsync" Content="Download as Word" IconCss="e-icons e-download" CssClass="e-info" Disabled="@_disableButtonDownload"></SfButton>
                        <SfButton OnClick="OnClickDownloadPdfAsync" Content="Download as PDF" IconCss="e-icons e-download" CssClass="e-info" Disabled="@_disableButtonDownload"></SfButton>
                        <SfButton OnClick="OnClickRejectAsync" Content="Reject" IconCss="e-icons e-circle-close" CssClass="e-danger" Disabled="@_disableButtonReject"></SfButton>
                    }
                </MudItem>

            </MudGrid>
        </MudItem>
    </MudGrid>
}

<DialogConfirmation Visibility="VisiblePopupConfirm"
                    Title="@DisplayTextFor.VisaGuarantee"
                    Content="@TitlePopupConfirm"
                    DialogOpen="DialogConfirmOpen"
                    DialogClose="DialogConfirmClose"
                    OnClickNo="ClickedNoConfirm"
                    OnClickYes="ClickedYesConfirm"></DialogConfirmation>
