@using Psmp.Base.Scholarships.Enums
@using Psmp.Base.Studies.Enums
@using Psmp.Shared.Common.Responses
@using Psmp.Shared.Masters.Queries
@using Psmp.Shared.Scholarships.ScholarshipPosting.Queries
@using Psmp.Shared.Selections.SelectionOverviews.Queries
@using Psmp.Bsui.Features.StudyPreparations.VisaGuarantee
@using Psmp.Shared.StudyPreparations.VisaGuarantee.Queries

<style>
    .e-chip-list {
        display: inline !important
    }
    .text-right {
    text-align: right;
}
</style>

<ErrorViewer Error="_error" />
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>
@if (_isLoading)
{
    <Loading IsVisible="_isLoading" />
}
else
{
    <MudGrid Spacing="2">
    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="12">
            <MudText Typo="Typo.body2" HtmlTag="h3">Visa Guarantee Filter</MudText>
        </MudItem>
    </MudGrid>
    <MudGrid Spacing="2" Class="mb-4">
        <MudItem xs="2">
            <MudText>Categories</MudText>
            <SfDropDownList ID="ddlSelectionCategory" TValue="int" TItem="DropdownItemResponse" DataSource="@_dropdownCategories" Placeholder="All Category" ShowClearButton="true">
                <DropDownListFieldSettings Text="Description" Value="Id" />
                <DropDownListEvents TItem="DropdownItemResponse" TValue="int" ValueChange="OnChangeCategory" />
            </SfDropDownList>
        </MudItem>
        <MudItem xs="2">
            <MudText>H/ SH/ AP&P</MudText>
            <SfDropDownList ID="ddlSelectionCompaynGroup" TValue="int" TItem="GetCompanyGroupQueryResponse" DataSource="@_dropdownCompanyGroups" Placeholder="All H/SH/AP&P" ShowClearButton="true">
                <DropDownListFieldSettings Text="Name" Value="Id" />
                <DropDownListEvents TItem="GetCompanyGroupQueryResponse" TValue="int" ValueChange="OnChangeCompanyGroupAsync" />
            </SfDropDownList>
        </MudItem>
        <MudItem xs="2">
            <MudText>Company</MudText>
            <SfDropDownList ID="ddlSelectionCompay" TValue="string" TItem="GetCompanyQueryResponse" DataSource="@_dropdownCompanies" Placeholder="All Company" ShowClearButton="true">
                <DropDownListFieldSettings Text="Name" Value="Code" />
                <DropDownListEvents TItem="GetCompanyQueryResponse" TValue="string" ValueChange="OnChangeCompanyAsync" />
            </SfDropDownList>
        </MudItem>
        <MudItem xs="2">
            <MudText>Directorate</MudText>
            <SfDropDownList ID="ddlSelectionDirectorate" TValue="int" TItem="GetDirectorateQueryResponse" DataSource="@_dropdownDirectorates" Placeholder="All Directorate" ShowClearButton="true">
                <DropDownListFieldSettings Text="Name" Value="Id" />
                <DropDownListEvents TItem="GetDirectorateQueryResponse" TValue="int" ValueChange="OnChangeDirectorateAsync" />
            </SfDropDownList>
        </MudItem>
        <MudItem xs="2">
            <MudText>Scholarship Code</MudText>
            <SfDropDownList ID="ddlSsholarshipCodes" TValue="Guid" TItem="GetScholarshipPostingDropdownResponse" DataSource="@_dropdownScholarshipCodes" Placeholder="All Code" ShowClearButton="true">
                <DropDownListFieldSettings Text="Code" Value="Id" />
                <DropDownListEvents TItem="GetScholarshipPostingDropdownResponse" TValue="Guid" ValueChange="OnChangeScholarshipCodeAsync" />
            </SfDropDownList>
        </MudItem>
        <MudItem xs="2">
            <MudText>Batch</MudText>
            <SfDropDownList ID="ddlScholarshipBatch" TValue="ScholarshipBatch" TItem="ScholarshipBatchResponse" Placeholder="All Batch"
                            AllowFiltering="false" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                            DataSource="@_dropdownBatchs" ShowClearButton="true">
                <DropDownListFieldSettings Text="Text" Value="Value" />
                <DropDownListEvents TItem="ScholarshipBatchResponse" TValue="ScholarshipBatch" ValueChange="OnChangeBatchAsync" />
            </SfDropDownList>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-2">
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudGrid Justify="Justify.Center">
                    <!-- Card pertama -->
						<MudItem xs="12" sm="4" md="4" Class="d-flex justify-start">
                        <CardStatistic Judul="Total Awardee" Count="@CountAll"></CardStatistic>
                    </MudItem>

                    <!-- Divider Vertikal -->
                    @* <MudItem xs="1" Class="d-flex justify-center">
                        <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                    </MudItem> *@

                    <!-- Card kedua -->
						<MudItem xs="12" sm="4" md="4" Class="d-flex justify-start">
                        <CardStatistic Judul="Total Request" Count="@CountRequest"></CardStatistic>
                    </MudItem>

                    <!-- Divider Vertikal -->
                    @* <MudItem xs="1" Class="d-flex justify-center">
                        <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                    </MudItem> *@

                    <!-- Card ketiga -->
						<MudItem xs="12" sm="4" md="4" Class="d-flex justify-start">
                            <CardStatistic Judul="Completed" Count="@CountCompleted" IsLast="true"></CardStatistic>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-2">
        <MudItem xs="12">
            <MudCard Class="pa-4" Elevation="2">
                <MudCardContent>
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="ms-0">List of Visa Guarantee Request</MudText>
                        <MudDivider Style="border-width: 2px; margin-bottom: 16px;" />
                        <MudItem xs="12">
                            <MudGrid>
                                <MudItem xs="1" Class="justify-end">
                                    <SfButton OnClick="OnClickDownloadResultAsync" Content="Download Result" IconCss="e-icons e-download" CssClass="e-info"></SfButton>
                                </MudItem>
                                <MudItem xs="4" Class="justify-end ml-2" Style="display:none;">
                                    <SfButton OnClick="OnClickAddAsync" Content="Add" IconCss="e-icons e-circle-add" CssClass="e-info"></SfButton>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                        <br />
                            <SfGrid DataSource="@_dataGrid" Toolbar="@(new List<string>() { "Search" })" AllowFiltering="true" AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true">
                            <GridEvents CommandClicked="OnCommandClicked" TValue="GetVisaGuaranteeQueryResponse"></GridEvents>
                            <GridPageSettings PageCount="10" PageSize="10" PageSizes="@SyncfusionGridValue.PageSize"></GridPageSettings>
                            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                            <GridColumns>
                                <GridColumn Field=@nameof(GetVisaGuaranteeQueryResponse.Name) HeaderText="Name" Width="250"></GridColumn>
                                <GridColumn Field=@nameof(GetVisaGuaranteeQueryResponse.CompanyName) HeaderText="Company" Width="150"></GridColumn>
                                <GridColumn Field=@nameof(GetVisaGuaranteeQueryResponse.EmployeeNumber) HeaderText="Employee Number" Width="150"></GridColumn>
                                <GridColumn Field=@nameof(GetVisaGuaranteeQueryResponse.Email) HeaderText="Email" Width="150"></GridColumn>
                                <GridColumn Field=@nameof(GetVisaGuaranteeQueryResponse.Created) HeaderText="Created" Format="dd.MM.yyyy" Width="150"></GridColumn>
                                <GridColumn Field=@nameof(GetVisaGuaranteeQueryResponse.Status) HeaderText="Status" HeaderTextAlign="TextAlign.Center" TextAlign="TextAlign.Center" Width="150">
                                    <Template Context="context">
                                        @{
                                            var Status = ((GetVisaGuaranteeQueryResponse)context).Status;
                                        }
                                        @if (Status == VisaGuaranteeStatus.Completed)
                                        {
                                            <SfChip>
                                                <ChipItems>
                                                    <ChipItem Text="Completed" CssClass="e-success"></ChipItem>
                                                </ChipItems>
                                            </SfChip>
                                        }
                                        else if (Status == VisaGuaranteeStatus.Draft)
                                        {
                                            <SfChip>
                                                <ChipItems>
                                                    <ChipItem Text="Draft" CssClass="e-primary"></ChipItem>
                                                </ChipItems>
                                            </SfChip>
                                        }
                                        else if (Status == VisaGuaranteeStatus.WaitingApproval)
                                        {
                                            <SfChip>
                                                <ChipItems>
                                                    <ChipItem Text="Waiting for Approval" CssClass="e-warning"></ChipItem>
                                                </ChipItems>
                                            </SfChip>
                                        }
                                        else if (Status == VisaGuaranteeStatus.Accepted)
                                        {
                                            <SfChip>
                                                <ChipItems>
                                                    <ChipItem Text="Accepted" CssClass="e-warning"></ChipItem>
                                                </ChipItems>
                                            </SfChip>
                                        }
                                        else if (Status == VisaGuaranteeStatus.ProcessSign)
                                        {
                                            <SfChip>
                                                <ChipItems>
                                                    <ChipItem Text="Process Sign" CssClass="e-info"></ChipItem>
                                                </ChipItems>
                                            </SfChip>
                                        }
                                        else if (Status == VisaGuaranteeStatus.ProcessToPOffice)
                                        {
                                            <SfChip>
                                                <ChipItems>
                                                    <ChipItem Text="Process P-Office" CssClass="e-info"></ChipItem>
                                                </ChipItems>
                                            </SfChip>
                                        }
                                        else if (Status == VisaGuaranteeStatus.Rejected)
                                        {
                                            <SfChip>
                                                <ChipItems>
                                                    <ChipItem Text="Rejected" CssClass="e-danger"></ChipItem>
                                                </ChipItems>
                                            </SfChip>
                                        }
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Action" TextAlign="TextAlign.Center" Width="150">
                                    <GridCommandColumns>
                                        <GridCommandColumn ButtonOption="@(new CommandButtonOptions() { IconCss="e-icons e-edit", CssClass="e-flat" })" Title="Edit"></GridCommandColumn>
                                    </GridCommandColumns>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </MudItem>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudGrid>
}
              
<Psmp.Bsui.Features.StudyPreparations.Component.DialogAddVisaGuarantee
    Visibility="VisiblePopup"
    Title="@TitlePopup"
    IsEnabled="@IsEnabled"
    DialogOpen="DialogOpen" 
    DialogClose="DialogClose"
    OnClickNo="ClickedNo"
    OnClickYes="ClickedYes"
    listApplicants="_listApplicant"
    listBringFamily="_listBringFamily"
    request="_createData"
    MaxFileSize="_maximumFileSizeInBytes"
    OnRemoveUploaderSupportDoc="OnRemoveUploaderSupportDoc"
    ValueChangeUploaderSupportDoc="ValueChangeUploaderSupportDoc">
</Psmp.Bsui.Features.StudyPreparations.Component.DialogAddVisaGuarantee>
