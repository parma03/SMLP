@page "/StudyPreparation/VisaGuarantee/DetailAccepted/{Id:guid}"
@using Psmp.Bsui.Features.StudyPreparations.VisaGuarantee.Components
@using Psmp.Shared.StudyPreparations.VisaGuarantee.Constants

<BrowserTabTitle>@DisplayTextFor.StudyPreparations</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" ActivePanelIndexChanged="@(e => OnTabChanged(e))">
    <MudTabPanel Text="@DisplayTextFor.DraftingVisaGuarantee">
        <DraftVisaGuarantee Id="@Id">

        </DraftVisaGuarantee>
    </MudTabPanel>
    <MudTabPanel Text="@DisplayTextFor.FinalVisaGuarantee">
        <FinalVisaGuarantee Id="@Id">

        </FinalVisaGuarantee>
    </MudTabPanel>
</MudTabs>

<style>
    .mud-tabs-panels {
        min-height: 500px;
    }
</style>
