@using Psmp.Client.Services.Hris
@using Psmp.Shared.Common.Responses
@using Psmp.Shared.Projects.ProjectMonitorings.Queries
@using Psmp.Shared.Selections.SelectionOverviews.Queries
@using Psmp.Bsui.Features.Projects.ProjectMentoring;
@using Psmp.Bsui.Features.Projects.Component
@inject IWebHostEnvironment _webHostEnvironment
@inject IOptions<HrisOptions> _hrisOptions

<style>
    .e-chip-list {
        display: inline !important
    }

    .e-upload .e-file-select-wrap, .e-bigger.e-small .e-upload .e-file-select-wrap {
        padding: 5px 0 5px 5px; /* Sesuaikan padding untuk tampilan yang lebih kompak */
    }

    .sf-uploader-compact .e-file-container {
        margin: 2px 0; /* Mengurangi margin antar file */
    }
</style>

<MudGrid Spacing="2">
    <MudGrid Spacing="2" Class="mb-2" Style="display:none;">
        <MudItem xs="12">
            <MudText Typo="Typo.body1" HtmlTag="h3">
                Hello <b>@_displayName</b>, welcome to project page.<br />
                Please submit your project plan, thank you
            </MudText>
        </MudItem>
    </MudGrid>
    <MudGrid Class="mb-2">
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudGrid AlignItems="center">
                    <!-- Card pertama -->
                    <MudItem xs="5" md="3" Class="d-flex justify-start">
                        <CardProjectStatistic Judul="Total Awardee" Count="@_countAll.ToString()"></CardProjectStatistic>
                    </MudItem>

                    <!-- Divider Vertikal -->
                    <MudItem xs="0" md="0" Class="d-flex justify-start">
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                        </MudHidden>
                    </MudItem>

                    <!-- Card kedua -->
                    <MudItem xs="5" md="3" Class="d-flex justify-start">
                        <CardProjectStatistic Icon="@Icons.Material.Rounded.Assignment" AvatarColor="Color.Warning" Judul="Study Period" Count="@($"{_countStudyPeriod}/{_countAll}")"></CardProjectStatistic>
                    </MudItem>

                    <!-- Divider Vertikal -->
                    <MudItem xs="0" md="0" Class="d-flex justify-start">
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                        </MudHidden>
                    </MudItem>

                    <!-- Card ketiga -->
                    <MudItem xs="5" md="3" Class="d-flex justify-start">
                        <CardProjectStatistic Icon="@Icons.Material.Rounded.AssignmentTurnedIn" AvatarColor="Color.Success" Judul="Study Preparation" Count="@($"{_countStudyPreparation}/{_countAll}")"></CardProjectStatistic>
                    </MudItem>

                    <!-- Divider Vertikal -->
                    <MudItem xs="0" md="0" Class="d-flex justify-start">
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                        </MudHidden>
                    </MudItem>

                    <!-- Card ketiga -->
                    <MudItem xs="5" md="2" Class="d-flex justify-start">
                        <CardProjectStatistic Icon="@Icons.Material.Rounded.AssignmentLate" AvatarColor="Color.Error" Judul="Universitas Admission" Count="@($"{_countUniversitasAdmission}/{_countAll}")"></CardProjectStatistic>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>
    <MudGrid Class="mb-2">
        <MudItem xs="12">
            <MudCard Class="pa-4" Elevation="2">
                <MudCardContent>
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="ms-0">List of Students</MudText>
                        <MudDivider Style="border-width: 2px; margin-bottom: 16px;" />
                        <SfGrid @ref="@GridProjectMonitoringMentor" DataSource="@_projectMonitoringMentor" Toolbar="@(new List<string>() { "Search" })" AllowFiltering="true" AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true">
                            <GridSelectionSettings CheckboxOnly="false" PersistSelection="true"></GridSelectionSettings>
                            <GridEvents CommandClicked="OnCommandClicked" TValue="GetProjectMonitoringMentorResponse"></GridEvents>
                            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                            <GridPageSettings PageCount="8" PageSize="8" PageSizes="@SyncfusionGridValue.PageSize"></GridPageSettings>
                            <GridColumns>
                                <GridColumn Field=@nameof(GetProjectMonitoringMentorResponse.Name) HeaderText="Name" Width="250"></GridColumn>
                                <GridColumn Field=@nameof(GetProjectMonitoringMentorResponse.EmployeeNumber) HeaderText="Employee Number" Width="150"></GridColumn>
                                <GridColumn Field=@nameof(GetProjectMonitoringMentorResponse.CompanyName) HeaderText="Company" Width="150"></GridColumn>
                                <GridColumn Field=@nameof(GetProjectMonitoringMentorResponse.Status) HeaderText="Status" HeaderTextAlign="TextAlign.Center" TextAlign="TextAlign.Center" Width="150"></GridColumn>
                                <GridColumn HeaderText="Action" TextAlign="TextAlign.Center" Width="150">
                                    <GridCommandColumns>
                                        <GridCommandColumn Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() { IconCss="e-icons e-eye", CssClass="e-flat" })" Title="View"></GridCommandColumn>
                                    </GridCommandColumns>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </MudItem>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudGrid>
