@page "/Project"

@using Psmp.Shared.Scholarships.Constants

<BrowserTabTitle>@DisplayTextFor.InnovationProject</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" ActivePanelIndexChanged="@(e => OnTabChanged(e))">
    @if (IsShowProjectProposal)
    {
        <MudTabPanel Text="@DisplayTextFor.ProjectProposal">
            <Psmp.Bsui.Features.Projects.ProjectProposal.Index>

            </Psmp.Bsui.Features.Projects.ProjectProposal.Index>
        </MudTabPanel>
    }
    @if (IsShowProjectMentoring)
    {
        <MudTabPanel Text="@DisplayTextFor.ProjectMentoring">
            <Psmp.Bsui.Features.Projects.ProjectMentoring.Index>

            </Psmp.Bsui.Features.Projects.ProjectMentoring.Index>
        </MudTabPanel>
    }
    @if (IsShowProjectCharterPlan)
    {
        <MudTabPanel Text="@DisplayTextFor.ProjectCharterPlan">
            <Psmp.Bsui.Features.Projects.ProjectCharterPlan.Index>

            </Psmp.Bsui.Features.Projects.ProjectCharterPlan.Index>
        </MudTabPanel>
    }
    @if (IsShowProjectCharterReal)
    {
        <MudTabPanel Text="@DisplayTextFor.ProjectCharterReal">
            <Psmp.Bsui.Features.Projects.ProjectCharterReal.Index>

            </Psmp.Bsui.Features.Projects.ProjectCharterReal.Index>
        </MudTabPanel>
    }
</MudTabs>

<style>
    .mud-tabs-panels {
        min-height: 500px;
    }
</style>
