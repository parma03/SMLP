@using Smlp.Base.Scholarships.Enums
@using Smlp.Shared.Common.Responses
@using Smlp.Shared.Masters.Queries
@using Smlp.Shared.Scholarships.ScholarshipPlan.Queries
@using Smlp.Shared.Selections.SelectionAdministrations.Commands.CreateSelectionAdministration
@using Smlp.Shared.Selections.SelectionTalentReviews.Commands.Create
@using Smlp.Shared.Selections.SelectionTalentReviews.Queries
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups

<SfDialog @bind-Visible=Visibility Width="60%" IsModal="true">
    <DialogTemplates>
        <Header>
            <MudText Typo="Typo.h5">@Title</MudText>
        </Header>
        <Content>
            <MudCard Elevation="0">
                <MudCardContent Class="px-4">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Scholarship Code</MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="txtCode"
                                                   Placeholder="Generate by system"
                                                   @bind-Value="DataScholarshipPlan.Code"
                                                   Enabled="false">
                                        </SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Holding/Sub Holding/AP Services & Portfolio </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="ddlCompanyGroup"
                                                   Placeholder="Generate by system"
                                                   Value="@(_companyGroups?.FirstOrDefault()?.Name ?? "No Company Group")"
                                                   Enabled="false">
                                        </SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Company Name </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="ddlCompany"
                                                   Placeholder="Generate by system"
                                                   Value="@(_companies?.FirstOrDefault()?.Name ?? "No Company")"
                                                   Enabled="false">
                                        </SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Directorate </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="ddlDirectorate"
                                                   Placeholder="Generate by system"
                                                   Value="@(_directorates?.FirstOrDefault()?.Name ?? "No Directorate")"
                                                   Enabled="false">
                                        </SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Function </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <MudItem xs="8">
                                            <SfTextBox ID="ddlFunction"
                                                       Placeholder="Generate by system"
                                                       Value="@(_fungsis?.FirstOrDefault()?.Name ?? "No Fungsi")"
                                                       Enabled="false">
                                            </SfTextBox>
                                        </MudItem>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Division</MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="ddlDivision"
                                                   Placeholder="Generate by system"
                                                   Value="@(_divisions?.FirstOrDefault()?.Name ?? "No Division")"
                                                   Enabled="false">
                                        </SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Business Issues </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextArea ID="txtBusinessIssues"
                                                    Placeholder="Generate by system"
                                                    RowCount="2"
                                                    ColumnCount="500"
