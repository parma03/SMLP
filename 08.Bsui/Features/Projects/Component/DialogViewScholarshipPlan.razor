                                                    Disabled="true">
                                        </SfTextArea>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Performance Issues</MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextArea ID="txtPerformanceIssue"
                                                    Placeholder="Generate by system"
                                                    RowCount="2"
                                                    ColumnCount="500"
                                                    @bind-Value="DataScholarshipPlan.PerformanceIssue"
