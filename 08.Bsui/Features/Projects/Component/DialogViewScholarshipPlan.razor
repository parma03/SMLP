                                        </SfTextArea>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Competency Issues</MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextArea ID="txtCompetencyIssue"
                                                    Placeholder="Generate by system"
                                                    RowCount="2"
                                                    ColumnCount="500"
                                                    @bind-Value="DataScholarshipPlan.CompetencyIssue"
                                                    Disabled="true">
                                        </SfTextArea>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Project Innovation</MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextArea ID="txtProjectInnovation"
                                                    Placeholder="Generate by system"
                                                    RowCount="2"
                                                    ColumnCount="500"
                                                    @bind-Value="DataScholarshipPlan.ProjectInovation"
                                                    Disabled="true">
                                        </SfTextArea>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Degree </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="ddlDegree"
                                                   Placeholder="Generate by system"
                                                   Value="@(_degrees?.FirstOrDefault()?.Name ?? "No Degree")"
                                                   Enabled="false">
                                        </SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Faculty </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextArea ID="txtFaculty"
                                                    Placeholder="Generate by system"
                                                    RowCount="2"
                                                    ColumnCount="500"
                                                    @bind-Value="DataScholarshipPlan.Faculty"
                                                    Disabled="true">
                                        </SfTextArea>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Major </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextArea ID="txtMajor"
                                                    Placeholder="Generate by system"
                                                    RowCount="2"
                                                    ColumnCount="500"
                                                    @bind-Value="DataScholarshipPlan.Major"
                                                    Disabled="true">
                                        </SfTextArea>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>University Reference </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="txtUniversityReference"
                                                   Placeholder="Generate by system"
                                                   @bind-Value="DataScholarshipPlan.UniversityReference"
                                                   Enabled="false">
                                        </SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>University Location </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="ddlUniversityLocation"
                                                   Placeholder="Generate by system"
                                                   Value="@GetUniversityLocationName(DataScholarshipPlan.UniversityLocation)"
                                                   Enabled="false">
                                        </SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Latest Education Background (Level & Major) </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="txtLatestEducation"
                                                   Placeholder="Generate by system"
                                                   @bind-Value="DataScholarshipPlan.LatestEducation"
                                                   Enabled="false">
                                        </SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Minimum Working Experience (Years & Field) </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="txtWorkingExperience"
                                                   Placeholder="Generate by system"
                                                   @bind-Value="DataScholarshipPlan.WorkingExperience"
                                                   Enabled="false">
                                        </SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Scope </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="ddlUniversityLocation"
                                                   Placeholder="Generate by system"
                                                   Value="@GetScope(DataScholarshipPlan.ScholarshipScope)"
                                                   Enabled="false">
                                        </SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Awardee Quota </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfNumericTextBox ID="txtAwardeeQuota"
                                                          Min="1" Max="99"
                                                          @bind-Value="DataScholarshipPlan.AwardeeQuota"
                                                          Enabled="false">
                                        </SfNumericTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Batch </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfNumericTextBox ID="txtBatch"
                                                          Min="1" Max="99"
                                                          @bind-Value="DataScholarshipPlan.Batch"
                                                          Enabled="false">
                                        </SfNumericTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Selection Category </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="ddlSelectionType"
                                                   Placeholder="Generate by system"
                                                   Value="@GetSelection(DataScholarshipPlan.SelectionType)"
                                                   Enabled="false">
                                        </SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Posting Year </MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfNumericTextBox ID="txtPostingYear"
                                                          Min="0" 
                                                          Max="2050"
                                                          Format="###.##"
                                                          FloatLabelType="@FloatLabelType.Always"
                                                          @bind-Value="DataScholarshipPlan.PostingYear"
                                                          Enabled="false">
                                        </SfNumericTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
            <MudCard Elevation="0">
                <MudCardContent Class="px-4">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" Class="mt-4">
                            <MudItem xs="12" Class="mb-6">
                                <MudText Typo="Typo.h6">Administrative Selection Criteria</MudText>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Minimum PRL Individu/ BS</MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfNumericTextBox ID="txtMinPrl"
                                                          Min="10"
                                                          Max="30"
                                                          @bind-Value="DataScholarshipPlan.Prl"
                                                          Enabled="false">
                                        </SfNumericTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Maximum Age</MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfNumericTextBox ID="txtMaxAge"
                                                          Min="18"
                                                          Max="60"
                                                          @bind-Value="DataScholarshipPlan.Age"
                                                          Enabled="false">
                                        </SfNumericTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Minimum Work Period</MudText>
                                    </MudItem>
                                    <MudItem xs="6">
                                        <SfNumericTextBox ID="txtMinWorkPeriod"
                                                          Min="0"
                                                          Max="40"
                                                          @bind-Value="DataScholarshipPlan.WorkPeriod"
                                                          Enabled="false">
                                        </SfNumericTextBox>
                                    </MudItem>
                                    <MudItem xs="2">
                                        <b>Years</b>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Average Performance Rating Last 3 Years</MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfNumericTextBox ID="txtPerformanceRating"
                                                          Format="n2"
                                                          Min="3"
                                                          Max="5.5f"
                                                          TValue="float"
                                                          @bind-Value="DataScholarshipPlan.PerformanceRating"
                                                          Enabled="false">
                                        </SfNumericTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Indiciplinary Record Last 3 Years (SAP Based)</MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="ddlIndiciplinaryStatus"
                                                   Placeholder="Generate by system"
                                                   Value="@GetIndiciplinary(DataScholarshipPlan.Indiciplinary)"
                                                   Enabled="false">
                                        </SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>MCU Status</MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="ddlMcuStatus"
                                                   Placeholder="Generate by system"
                                                   Value="@GetMcu(DataScholarshipPlan.Mcu)"
                                                   Enabled="false">
                                        </SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </Content>
        <FooterTemplate>
            <SfButton Content="Close" CssClass="e-filled e-danger" IconCss="e-icons e-close" OnClick="OnClickNo"></SfButton>
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
    <DialogAnimationSettings Effect="DialogEffect.Zoom"></DialogAnimationSettings>
</SfDialog>

@code {
    [Parameter]
    public bool Visibility { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public EventCallback DialogOpen { get; set; }

    [Parameter]
    public EventCallback DialogClose { get; set; }

    [Parameter]
    public EventCallback OnClickNo { get; set; }

    [Parameter]
    public EventCallback OnClickYes { get; set; }

    [Parameter]
    public CreateAdministrationApplicantRequest? request { get; set; }

    private SfTextBox? TextBoxNopek { get; set; }

    [Parameter]
    public EventCallback OnClickSearch { get; set; }

    [Parameter]
    public bool IsEnabled { get; set; }

    [Parameter]
    public bool IsShowError { get; set; } = false;

    // [Parameter]
    // public bool IsAllowEdit { get; set; } = false;

    [Parameter]
    public string ErrorMessage { get; set; } = string.Empty;

    [Parameter]
    public Guid IdScholarshipPlan { get; set; }

    [Parameter]
    public GetScholarshipPlanResponse DataScholarshipPlan { get; set; } = new();

    protected int _companyGroupId = 0;
    protected string _companyCode = "0000";
    protected int _directorateId = 0;
    protected int _fungsiId = 0;
    protected int _divisionId = 0;
    protected int _degreeId = 0;

    protected List<GetCompanyGroupQueryResponse> _companyGroups = new();
    protected List<GetCompanyByCodeQueryResponse> _companies = new();
    protected List<GetDirectorateQueryResponse> _directorates = new();
    protected List<GetFungsiResponse> _fungsis = new();
    protected List<GetDivisionQueryResponse> _divisions = new();
    protected List<GetDegreeQueryResponse> _degrees = new();
    protected List<DropdownItemResponse> _locations = new();

    protected override async Task OnParametersSetAsync()
    {
        if (IdScholarshipPlan != Guid.Empty)
        {
            var scholarshipPlan = await _scholarshipPlanService.GetScholarshipPlanByIdAsync(IdScholarshipPlan);
            if (scholarshipPlan.Error is not null)
            {
                _snackbar.AddError($"Data Scholarship Plan with id {IdScholarshipPlan} not found");
            }
            else
            {
                if (scholarshipPlan.Result is not null)
                {
                    DataScholarshipPlan.Code = scholarshipPlan.Result.Code;
                    DataScholarshipPlan.CompanyGroupId = scholarshipPlan.Result.CompanyGroupId;
                    _companyGroupId = DataScholarshipPlan.CompanyGroupId;
                    await LoadCompanyGroup();
                    DataScholarshipPlan.CompanyCode = scholarshipPlan.Result.CompanyCode;
                    _companyCode = DataScholarshipPlan.CompanyCode;
                    await LoadCompany();
                    DataScholarshipPlan.DirectorateId = scholarshipPlan.Result.DirectorateId;
                    _directorateId = DataScholarshipPlan.DirectorateId;
                    await LoadDirectorate();
                    DataScholarshipPlan.FungsiId = scholarshipPlan.Result.FungsiId;
                    _fungsiId = DataScholarshipPlan.FungsiId;
                    await LoadFungsi();
                    DataScholarshipPlan.DivisionId = scholarshipPlan.Result.DivisionId;
                    _divisionId = DataScholarshipPlan.DivisionId;
                    await LoadDivision();
                    DataScholarshipPlan.BusinessIssue = scholarshipPlan.Result.BusinessIssue;
                    DataScholarshipPlan.BusinessIssueReferences = scholarshipPlan.Result.BusinessIssueReferences;
                    DataScholarshipPlan.PerformanceIssue = scholarshipPlan.Result.PerformanceIssue;
                    DataScholarshipPlan.CompetencyIssue = scholarshipPlan.Result.CompetencyIssue;
                    DataScholarshipPlan.DegreeId = scholarshipPlan.Result.DegreeId;
                    _degreeId = DataScholarshipPlan.DegreeId;
                    await LoadDegree();
                    DataScholarshipPlan.Faculty = scholarshipPlan.Result.Faculty;
                    DataScholarshipPlan.Major = scholarshipPlan.Result.Major;
                    DataScholarshipPlan.UniversityReference = scholarshipPlan.Result.UniversityReference;
                    DataScholarshipPlan.UniversityLocation = scholarshipPlan.Result.UniversityLocation;
                    DataScholarshipPlan.LatestEducation = scholarshipPlan.Result.LatestEducation;
                    DataScholarshipPlan.WorkingExperience = scholarshipPlan.Result.WorkingExperience;
                    DataScholarshipPlan.ScholarshipScope = scholarshipPlan.Result.ScholarshipScope;
                    DataScholarshipPlan.AwardeeQuota = scholarshipPlan.Result.AwardeeQuota;
                    DataScholarshipPlan.Batch = scholarshipPlan.Result.Batch;
                    DataScholarshipPlan.SelectionType = scholarshipPlan.Result.SelectionType;
                    DataScholarshipPlan.PostingYear = scholarshipPlan.Result.PostingYear;
                    DataScholarshipPlan.Prl = scholarshipPlan.Result.Prl;
                    DataScholarshipPlan.Age = scholarshipPlan.Result.Age;
                    DataScholarshipPlan.WorkPeriod = scholarshipPlan.Result.WorkPeriod;
                    DataScholarshipPlan.PerformanceRating = scholarshipPlan.Result.PerformanceRating;
                    DataScholarshipPlan.Indiciplinary = scholarshipPlan.Result.Indiciplinary;
                    DataScholarshipPlan.Mcu = scholarshipPlan.Result.Mcu;
                    DataScholarshipPlan.ProjectInovation = scholarshipPlan.Result.ProjectInovation;
                }
            }
        }
    }

    private async Task LoadCompanyGroup()
    {
        var data = await _companyGroupService.GetCompanyGroupByIdAsync(_companyGroupId);
        if (data.Error is null && data.Result is not null)
        {
            _companyGroups = data.Result.Items.ToList();
        }
    }

    private async Task LoadCompany()
    {
        var data = await _companyService.GetCompanyByCodeAsync(_companyCode);
        if (data.Error is null && data.Result is not null)
        {
            _companies = new List<GetCompanyByCodeQueryResponse> { data.Result };
        }
    }

    private async Task LoadDirectorate()
    {
        var data = await _directorateService.GetDirectotaeByCompanyCodeAsync(_companyCode);
        if (data.Error is null && data.Result is not null)
        {
            _directorates = data.Result.Items.ToList();

            if (_directorateId > 0)
            {
                var specificDirectorate = _directorates.FirstOrDefault(d => d.Id == _directorateId);
                if (specificDirectorate != null)
                {
                    _directorates = new List<GetDirectorateQueryResponse> { specificDirectorate };
                }
            }
        }
    }

    private async Task LoadFungsi()
    {
        var data = await _fungsiService.GetFungsiByDirectorateIdAsync(_directorateId);
        if (data.Error is null && data.Result is not null)
        {
            _fungsis = data.Result.Items.ToList();

            if (_fungsiId > 0)
            {
                var specificFungsi = _fungsis.FirstOrDefault(d => d.Id == _fungsiId);
                if (specificFungsi != null)
                {
                    _fungsis = new List<GetFungsiResponse> { specificFungsi };
                }
            }
        }
    }

    private async Task LoadDivision()
    {
        var data = await _divisionService.GetDivisionByDirectorateIdAsync(_fungsiId);
        if (data.Error is null && data.Result is not null)
        {
            _divisions = data.Result.Items.ToList();

            if (_divisionId > 0)
            {
                var specificDivision = _divisions.FirstOrDefault(d => d.Id == _divisionId);
                if (specificDivision != null)
                {
                    _divisions = new List<GetDivisionQueryResponse> { specificDivision };
                }
            }
        }
    }

    private async Task LoadDegree()
    {
        var data = await _degreeService.GetDegreesAsync();
        if (data.Error is null && data.Result is not null)
        {
            _degrees = data.Result.Items.ToList();

            if (_degreeId > 0)
            {
                var specificDegree = _degrees.FirstOrDefault(d => d.Id == _degreeId);
                if (specificDegree != null)
                {
                    _degrees = new List<GetDegreeQueryResponse> { specificDegree };
                }
            }
        }
    }

    private string GetUniversityLocationName(ScholarshipLocation location)
    {
        return location switch
        {
            ScholarshipLocation.Abroad => "Abroad",
            ScholarshipLocation.Domestic => "Domestic",
            _ => "Unknown Location"
        };
    }

    private string GetScope(ScholarshipScope scope)
    {
        return scope switch
        {
            ScholarshipScope.InternalEntity => "Internal Entity",
            ScholarshipScope.PertaminaGroup => "Pertamina Group",
            _ => "Unknown Scope"
        };
    }

    private string GetSelection(Base.Selections.Enums.SelectionType selection)
    {
        return selection switch
        {
            Base.Selections.Enums.SelectionType.Close => "Close Registration",
            Base.Selections.Enums.SelectionType.Open => "Open Registration",
            _ => "Unknown Selection"
        };
    }

    private string GetIndiciplinary(IndiciplinaryStatus indiciplinary)
    {
        return indiciplinary switch
        {
            IndiciplinaryStatus.No => "No",
            IndiciplinaryStatus.Yes => "Yes",
            _ => "Unknown Indiciplinary"
        };
    }

    private string GetMcu(McuStatus indiciplinary)
    {
        return indiciplinary switch
        {
            McuStatus.No => "No MCU",
            McuStatus.P1 => "P 1",
            McuStatus.P2 => "P 2",
            McuStatus.P3 => "P 3",
            McuStatus.P4 => "P 4",
            McuStatus.P5 => "P 5",
            McuStatus.P6 => "P 6",
            McuStatus.P7 => "P 7",
            _ => "Unknown Indiciplinary"
        };
    }
}

