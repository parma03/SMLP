@using Smlp.Client.Services.Hris
@using Smlp.Bsui.Features.Projects.Component
@using Smlp.Shared.Common.Responses
@using Smlp.Shared.Projects.ProjectCharterPlans.Queries
@using Smlp.Shared.Projects.ProjectCharterRealisations.Queries
@using Smlp.Shared.Selections.SelectionOverviews.Queries
@using Smlp.Bsui.Features.Projects.ProjectCharterPlan;
@inject IWebHostEnvironment _webHostEnvironment
@inject IOptions<HrisOptions> _hrisOptions

<style>
    .e-chip-list {
        display: inline !important
    }

    .e-upload .e-file-select-wrap, .e-bigger.e-small .e-upload .e-file-select-wrap {
        padding: 5px 0 5px 5px; /* Sesuaikan padding untuk tampilan yang lebih kompak */
    }

    .sf-uploader-compact .e-file-container {
        margin: 2px 0; /* Mengurangi margin antar file */
    }
</style>

<MudGrid Spacing="2">
    <MudGrid Class="mb-2">
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudGrid AlignItems="center">
                    <!-- Card pertama -->
                    <MudItem xs="5" md="3" Class="d-flex justify-start">
                        <CardProjectStatistic Judul="Total Awardee" Count="@_countAll.ToString()"></CardProjectStatistic>
                    </MudItem>

                    <!-- Divider Vertikal -->
                    <MudItem xs="0" md="0" Class="d-flex justify-start">
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                        </MudHidden>
                    </MudItem>

                    <!-- Card kedua -->
                    <MudItem xs="5" md="3" Class="d-flex justify-start">
                        <CardProjectStatistic Icon="@Icons.Material.Rounded.Assignment" AvatarColor="Color.Warning" Judul="Waiting for Approval" Count="@($"{_countWaitingForApproval}/{_countAll}")"></CardProjectStatistic>
                    </MudItem>

                    <!-- Divider Vertikal -->
                    <MudItem xs="0" md="0" Class="d-flex justify-start">
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                        </MudHidden>
                    </MudItem>

                    <!-- Card ketiga -->
                    <MudItem xs="5" md="3" Class="d-flex justify-start">
                        <CardProjectStatistic Icon="@Icons.Material.Rounded.AssignmentTurnedIn" AvatarColor="Color.Success" Judul=" Approved" Count="@($"{_countApproved}/{_countAll}")"></CardProjectStatistic>
                    </MudItem>

                    <!-- Divider Vertikal -->
                    <MudItem xs="0" md="0" Class="d-flex justify-start">
                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                        </MudHidden>
                    </MudItem>

                    <!-- Card ketiga -->
                    <MudItem xs="5" md="2" Class="d-flex justify-start">
                        <CardProjectStatistic Icon="@Icons.Material.Rounded.AssignmentLate" AvatarColor="Color.Error" Judul="Rejected" Count="@($"{_countRejected}/{_countAll}")"></CardProjectStatistic>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>
    <MudGrid Class="mb-2">
        <MudItem xs="12">
            <MudCard Class="pa-4" Elevation="2">
                <MudCardContent>
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="ms-0">List of Awardee</MudText>
                        <MudDivider Style="border-width: 2px; margin-bottom: 16px;" />
                        @* <MudItem xs="12">
                            <MudGrid>
                                <MudItem xs="4" Class="justify-end">
                                    <SfButton OnClick="OnClickAddAsync" Content="Add" IconCss="e-icons e-circle-add" CssClass="e-info"></SfButton>
                                </MudItem>
                            </MudGrid>
                        </MudItem> 
                        <br />*@
                        <SfGrid @ref="@GridProjectCharterPlanResponse" DataSource="@_projectCharterPlanResponse" Toolbar="@(new List<string>() { "Search" })" AllowFiltering="true" AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true">
                            <GridSelectionSettings CheckboxOnly="false" PersistSelection="true"></GridSelectionSettings>
							<GridEvents CommandClicked="OnCommandClicked" TValue="GetProjectCharterPlanResponse"></GridEvents>
                            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                            <GridPageSettings PageCount="8" PageSize="8" PageSizes="@SyncfusionGridValue.PageSize"></GridPageSettings>
                            <GridColumns>
                                @* <GridColumn Type="ColumnType.CheckBox" Width="50"></GridColumn> *@
								<GridColumn Field=@nameof(GetProjectCharterPlanResponse.ApplicantName) HeaderText="Name" Width="250"></GridColumn>
								<GridColumn Field=@nameof(GetProjectCharterPlanResponse.ApplicantEmployeeNo) HeaderText="Employee Number" Width="150"></GridColumn>
								<GridColumn Field=@nameof(GetProjectCharterPlanResponse.ApplicantEmail) HeaderText="Email" Width="150"></GridColumn>
								<GridColumn Field=@nameof(GetProjectCharterPlanResponse.ApplicantCompany) HeaderText="Company" Width="150"></GridColumn>
								<GridColumn Field=@nameof(GetProjectCharterPlanResponse.ProjectTitle) HeaderText="Project Title" Width="250"></GridColumn>
								<GridColumn Field=@nameof(GetProjectCharterPlanResponse.Status) HeaderText="Status" HeaderTextAlign="TextAlign.Center" TextAlign="TextAlign.Center" Width="200">
									<Template>
										@{
											var data = (context as GetProjectCharterPlanResponse);
											if (data!.Status == Base.Project.Enums.ProjectCharterPlanStatus.Approved)
											{
												<SfChip>
													<ChipItems>
														<ChipItem Text="@data.Status.GetDescription().ToString()" CssClass="e-success"></ChipItem>
													</ChipItems>
												</SfChip>
											}
											else if (data!.Status == Base.Project.Enums.ProjectCharterPlanStatus.Rejected)
											{
												<SfChip>
													<ChipItems>
														<ChipItem Text="@data.Status.GetDescription().ToString()" CssClass="e-danger"></ChipItem>
													</ChipItems>
												</SfChip>
											}
											else if (data!.Status == Base.Project.Enums.ProjectCharterPlanStatus.WaitingApproval)
											{
												<SfChip>
													<ChipItems>
														<ChipItem Text="@data.Status.GetDescription().ToString()" CssClass="e-warning"></ChipItem>
													</ChipItems>
												</SfChip>
											}
										}
									</Template>
								</GridColumn>
                                <GridColumn HeaderText="Action" TextAlign="TextAlign.Center" Width="150">
                                    <GridCommandColumns>
                                        <GridCommandColumn Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() { IconCss="e-icons e-eye", CssClass="e-flat" })" Title="View"></GridCommandColumn>
                                    </GridCommandColumns>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </MudItem>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudGrid>
