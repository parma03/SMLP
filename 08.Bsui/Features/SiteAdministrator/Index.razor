@page "/SiteAdministrator"

<BrowserTabTitle>Administrator</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>
<PageHeader Title="Site Administrator" Icon="@Icons.Material.Filled.AdminPanelSettings" />

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Kelola Pengguna" Icon="@Icons.Material.Filled.ManageAccounts">
        <MudPaper Class="pa-4 rounded-lg" Elevation="0">
            <MudGrid Class="mb-3">
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_searchUser"
                                  Label="Cari pengguna..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect @bind-Value="_filterRole" Label="Filter Role" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("")">Semua Role</MudSelectItem>
                        <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                        <MudSelectItem Value="@("Kasir")">Kasir</MudSelectItem>
                        <MudSelectItem Value="@("Owner")">Owner</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="12" md="5" Class="d-flex align-end gap-2">
                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.PersonAdd"
                               Style="background:#6F4E37; color:white;"
                               OnClick="@OpenAddUserDialog">
                        Tambah Pengguna
                    </MudButton>
                </MudItem>
            </MudGrid>
            <MudTable Items="@_users" Dense="true" Hover="true" Striped="true" Elevation="0" Loading="@_loadingUsers">
                <HeaderContent>
                    <MudTh>Username</MudTh>
                    <MudTh>Nama Lengkap</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Aksi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Username</MudTd>
                    <MudTd>@context.FullName</MudTd>
                    <MudTd>@context.Email</MudTd>
                    <MudTd><MudChip Size="Size.Small" Color="Color.Primary">@context.Role</MudChip></MudTd>
                    <MudTd>
                        <MudChip Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                            @(context.IsActive ? "Aktif" : "Nonaktif")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" />
                        <MudIconButton Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Warning" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 text-center" Color="Color.Secondary">Belum ada pengguna terdaftar</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Pengaturan Aplikasi" Icon="@Icons.Material.Filled.Settings">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:#6F4E37; font-weight:700;">
                        ☕ Informasi Coffee Shop
                    </MudText>
                    <MudTextField Label="Nama Coffee Shop" Variant="Variant.Outlined" Class="mb-3"
                                  Value="@_shopName" />
                    <MudTextField Label="Alamat" Variant="Variant.Outlined" Class="mb-3"
                                  Value="@_shopAddress" Lines="2" />
                    <MudTextField Label="No. Telepon" Variant="Variant.Outlined" Class="mb-3"
                                  Value="@_shopPhone" />
                    <MudTextField Label="Email" Variant="Variant.Outlined" Class="mb-3"
                                  Value="@_shopEmail" />
                    <MudButton Variant="Variant.Filled" Style="background:#6F4E37; color:white;"
                               StartIcon="@Icons.Material.Filled.Save">
                        Simpan Pengaturan
                    </MudButton>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:#6F4E37; font-weight:700;">
                        📋 Informasi Sistem
                    </MudText>
                    <MudList Dense="true">
                        <MudListItem>
                            <MudText Typo="Typo.body2"><b>Aplikasi:</b> Sistem Manajemen Loyalitas Pelanggan</MudText>
                        </MudListItem>
                        <MudListItem>
                            <MudText Typo="Typo.body2"><b>Versi:</b> 1.0.0</MudText>
                        </MudListItem>
                        <MudListItem>
                            <MudText Typo="Typo.body2"><b>Framework:</b> .NET 8 + Blazor Server + MudBlazor</MudText>
                        </MudListItem>
                        <MudListItem>
                            <MudText Typo="Typo.body2"><b>Database:</b> SQL Server</MudText>
                        </MudListItem>
                    </MudList>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>
</MudTabs>
