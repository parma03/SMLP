@attribute [Authorize(Roles = "Admin")]
@page "/SiteAdministrator"

<BrowserTabTitle>Administrator</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>
<PageHeader Title="Site Administrator" Icon="@Icons.Material.Filled.AdminPanelSettings" />

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Kelola Pengguna" Icon="@Icons.Material.Filled.ManageAccounts">
        <MudPaper Class="pa-4 rounded-lg" Elevation="0">
            <MudGrid Class="mb-3">
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField Value="_searchUser"
                                  ValueChanged="@((string v) => OnSearchChanged(v))"
                                  Label="Cari pengguna..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  DebounceInterval="300" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect Value="_filterRole"
                               ValueChanged="@((string v) => OnFilterRoleChanged(v))"
                               Label="Filter Role" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("")">Semua Role</MudSelectItem>
                        <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                        <MudSelectItem Value="@("Kasir")">Kasir</MudSelectItem>
                        <MudSelectItem Value="@("Owner")">Owner</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="12" md="5" Class="d-flex align-end gap-2">
                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.PersonAdd"
                               Style="background:#6F4E37; color:white;"
                               OnClick="@OpenAddUserDialog">
                        Tambah Pengguna
                    </MudButton>
                </MudItem>
            </MudGrid>
            <MudTable Items="@_users" Dense="true" Hover="true" Striped="true" Elevation="0" Loading="@_loadingUsers">
                <HeaderContent>
                    <MudTh>Username</MudTh>
                    <MudTh>Nama Lengkap</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>No. HP</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Aksi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <div class="d-flex align-center">
                            <MudAvatar Size="Size.Small" Style="background:#6F4E37; color:white;" Class="mr-2">
                                @(context.DisplayName.FirstOrDefault())
                            </MudAvatar>
                            @context.Username
                        </div>
                    </MudTd>
                    <MudTd>@context.DisplayName</MudTd>
                    <MudTd>@context.EmailAddress</MudTd>
                    <MudTd>@context.PhoneNumber</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@GetRoleColor(context.Role)">
                            @GetRoleLabel(context.Role)
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@(context.IsActive? Color.Success: Color.Default)">
                            @(context.IsActive ? "Aktif" : "Nonaktif")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudTooltip Text="Edit Pengguna">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => OpenEditUserDialog(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Hapus Pengguna">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => DeleteUserAsync(context))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-4 text-center" Color="Color.Secondary">Belum ada pengguna terdaftar</MudText>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
                </PagerContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Pengaturan Aplikasi" Icon="@Icons.Material.Filled.Settings">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:#6F4E37; font-weight:700;">
                        ☕ Informasi Coffee Shop
                    </MudText>
                    <MudTextField @bind-Value="_shopName" Label="Nama Coffee Shop" Variant="Variant.Outlined" Class="mb-3" />
                    <MudTextField @bind-Value="_shopAddress" Label="Alamat" Variant="Variant.Outlined" Class="mb-3" Lines="2" />
                    <MudTextField @bind-Value="_shopPhone" Label="No. Telepon" Variant="Variant.Outlined" Class="mb-3" />
                    <MudTextField @bind-Value="_shopEmail" Label="Email" Variant="Variant.Outlined" Class="mb-3" />
                    <MudButton Variant="Variant.Filled" Style="background:#6F4E37; color:white;"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveAppSettingsAsync" Disabled="@_isSavingSettings">
                        @if (_isSavingSettings)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Simpan Pengaturan
                    </MudButton>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:#6F4E37; font-weight:700;">
                        📋 Informasi Sistem
                    </MudText>
                    <MudList T="string" Dense="true">
                        <MudListItem><MudText Typo="Typo.body2"><b>Aplikasi:</b> SMLP - Sistem Manajemen Loyalitas Pelanggan</MudText></MudListItem>
                        <MudListItem><MudText Typo="Typo.body2"><b>Versi:</b> 1.0.0</MudText></MudListItem>
                        <MudListItem><MudText Typo="Typo.body2"><b>Framework:</b> .NET 8 + Blazor Server + MudBlazor</MudText></MudListItem>
                        <MudListItem><MudText Typo="Typo.body2"><b>Database:</b> SQL Server</MudText></MudListItem>
                        <MudListItem><MudText Typo="Typo.body2"><b>Auth:</b> JWT Bearer Token</MudText></MudListItem>
                    </MudList>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="Manajemen Role" Icon="@Icons.Material.Filled.Security">
        <MudGrid>
            <MudItem xs="12" md="7">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-4" Style="color:#6F4E37; font-weight:700;">
                        🛡️ Matriks Hak Akses per Role
                    </MudText>
                    <MudTable Dense="true" Elevation="0" Items="@_rolePermissions">
                        <HeaderContent>
                            <MudTh>Fitur / Modul</MudTh>
                            <MudTh Style="text-align:center">Admin</MudTh>
                            <MudTh Style="text-align:center">Owner</MudTh>
                            <MudTh Style="text-align:center">Kasir</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudText Typo="Typo.body2" Style="font-weight:500;">@context.Feature</MudText>
                            </MudTd>
                            <MudTd Style="text-align:center">
                                <MudIcon Icon="@(context.Admin ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                         Color="@(context.Admin ? Color.Success : Color.Error)" Size="Size.Small" />
                            </MudTd>
                            <MudTd Style="text-align:center">
                                <MudIcon Icon="@(context.Owner ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                         Color="@(context.Owner ? Color.Success : Color.Error)" Size="Size.Small" />
                            </MudTd>
                            <MudTd Style="text-align:center">
                                <MudIcon Icon="@(context.Kasir ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                         Color="@(context.Kasir ? Color.Success : Color.Error)" Size="Size.Small" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-4 rounded-lg" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:#6F4E37; font-weight:700;">
                        📖 Deskripsi Role
                    </MudText>
                    <MudList T="string" Dense="true">
                        <MudListItem>
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">Admin</MudChip>
                                <MudText Typo="Typo.body2">Akses penuh ke seluruh sistem termasuk manajemen pengguna dan konfigurasi.</MudText>
                            </div>
                        </MudListItem>
                        <MudListItem>
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Owner</MudChip>
                                <MudText Typo="Typo.body2">Akses analytics, laporan, dan konfigurasi loyalitas. Tidak bisa kelola pengguna.</MudText>
                            </div>
                        </MudListItem>
                        <MudListItem>
                            <div class="d-flex align-center gap-2">
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">Kasir</MudChip>
                                <MudText Typo="Typo.body2">Akses transaksi, pelanggan, dan redeem reward. Tidak bisa akses laporan atau konfigurasi.</MudText>
                            </div>
                        </MudListItem>
                    </MudList>
                    <MudDivider Class="my-3" />
                    <MudAlert Severity="Severity.Info" Dense="true">
                        <MudText Typo="Typo.caption">
                            Role ditetapkan saat membuat atau mengedit pengguna di tab "Kelola Pengguna".
                        </MudText>
                    </MudAlert>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudTabPanel>
</MudTabs>

@* Dialog Tambah/Edit Pengguna *@
<MudDialog @bind-IsVisible="_showUserDialog" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color:#6F4E37;">
            <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" />
            @(_isEditMode ? "Edit Pengguna" : "Tambah Pengguna Baru")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_userForm.Username"
                              Label="Username"
                              Variant="Variant.Outlined"
                              Required="true"
                              AdornmentIcon="@Icons.Material.Filled.AccountCircle"
                              Adornment="Adornment.Start"
                              Class="mb-3" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_userForm.DisplayName"
                              Label="Nama Lengkap"
                              Variant="Variant.Outlined"
                              Required="true"
                              AdornmentIcon="@Icons.Material.Filled.Person"
                              Adornment="Adornment.Start"
                              Class="mb-3" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_userForm.Role" Label="Role" Variant="Variant.Outlined" Class="mb-3">
                    <MudSelectItem Value="@(UserRole.Admin)">👑 Admin</MudSelectItem>
                    <MudSelectItem Value="@(UserRole.Owner)">🏢 Owner</MudSelectItem>
                    <MudSelectItem Value="@(UserRole.Kasir)">🧑‍💼 Kasir</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_userForm.PhoneNumber"
                              Label="No. HP"
                              Variant="Variant.Outlined"
                              AdornmentIcon="@Icons.Material.Filled.Phone"
                              Adornment="Adornment.Start"
                              Class="mb-3" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_userForm.EmailAddress"
                              Label="Email"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Adornment="Adornment.Start"
                              Class="mb-3" />
            </MudItem>
            <MudItem xs="12">
                <MudSwitch @bind-Value="_userForm.IsActive" Label="Status Aktif" Color="Color.Success" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseUserDialog" Variant="Variant.Outlined">Batal</MudButton>
        <MudButton Variant="Variant.Filled"
                   Style="background:#6F4E37; color:white;"
                   OnClick="SaveUserAsync"
                   Disabled="@_isSavingUser">
            @if (_isSavingUser)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(_isEditMode ? "Simpan Perubahan" : "Tambah Pengguna")
        </MudButton>
    </DialogActions>
</MudDialog>
