@using Smlp.Shared.SiteAdministrators.Buddy.Queries
<style>
	.e-chip-list {
		display: inline !important
	}

	.panel {
		background: #ffffff
	}
</style>
<ErrorViewer Error="_error" />
<LoadingDialog IsVisible=@_isLoading Text="Loading..."></LoadingDialog>
@if (_isLoading)
{
	<Loading IsVisible="_isLoading" />
}
else
{
	<MudGrid>
		<MudItem xs="12">
			<MudCard>
				<MudCardContent>
					@if (_isLoadingData)
					{
						<LoadingLinear IsVisible="_isLoadingData" />
					}
					else
					{
						<MudGrid Class="mb-2">
							<MudItem xs="12">
								<MudCard Class="pa-4" Elevation="2">
									<MudCardContent>
										<MudItem xs="12">
											<MudText Typo="Typo.subtitle2" Class="ms-0">List of Buddy</MudText>
											<MudDivider Style="border-width: 2px; margin-bottom: 16px;" />
											<br />
											<SfGrid DataSource="@_data" Toolbar="@(new List<string>() { "Search" })" AllowFiltering="false" AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true">
												<GridPageSettings PageCount="5" PageSize="10" PageSizes="@(new string[] { "10", "15", "20", "All" })"></GridPageSettings>
												<GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
												<GridColumns>
													<GridColumn Field=@nameof(GetBuddyResponse.Name) HeaderText="Name" Width="150"></GridColumn>
													<GridColumn Field=@nameof(GetBuddyResponse.Email) HeaderText="Email" Width="150"></GridColumn>
													<GridColumn Field=@nameof(GetBuddyResponse.University) HeaderText="University" Width="150"></GridColumn>
													<GridColumn Field=@nameof(GetBuddyResponse.Country) HeaderText="Company" Width="150"></GridColumn>
												</GridColumns>
											</SfGrid>
										</MudItem>
									</MudCardContent>
								</MudCard>
							</MudItem>
						</MudGrid>
					}
				</MudCardContent>
			</MudCard>
		</MudItem>
	</MudGrid>
}
