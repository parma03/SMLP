<style>
    .e-chip-list {
        display: inline !important 
    }
    .panel{
        background:#ffffff
    }
</style>
<ErrorViewer Error="_error" />
<LoadingDialog IsVisible=@_isLoading Text="Loading..."></LoadingDialog>
@if (_isLoading)
{
    <Loading IsVisible="_isLoading" />
}
else
{
    <MudGrid>
        <MudItem xs="12">
            <MudCard>
                <MudCardContent>
                    @if (_isLoadingData)
                    {
                        <LoadingLinear IsVisible="_isLoadingData" />
                    }
                    else
                    {
                        <MudText>List of Subject Major</MudText>
                        <MudItem xs="12" Class="mt-4">
                            <MudGrid>
                                <MudItem xs="2" Class="mt-4 justify-end">
                                    <SfButton Content="Add" IconCss="e-icons e-circle-add" CssClass="e-info" OnClick="OnClickAdd"></SfButton>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                        <br />
                        <SfGrid DataSource="@_subjectmajor" Toolbar="@(new List<string>() { "Search" })" AllowPaging="true">
                            <GridColumns>
                                <GridColumn Type="ColumnType.CheckBox" Width="50"></GridColumn>
                                <GridColumn Field="Name" Width="200" HeaderText="Subject / Major"></GridColumn>
                                <GridColumn HeaderText="Action" Width="150" TextAlign="TextAlign.Center" HeaderTextAlign="TextAlign.Center" Visible="true">
                                    <GridCommandColumns>
                                        <GridCommandColumn Title="Edit" Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-edit", CssClass="e-flat" })"></GridCommandColumn>
                                        <GridCommandColumn Title="Delete" Type="CommandButtonType.Delete" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-delete", CssClass="e-flat" })"></GridCommandColumn>
                                    </GridCommandColumns>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                        <br />
                        <MudItem xs="12" Class="mt-8">
                            <MudText>File Upload (.xls, .xlsx) <span style="color:red;">*</span></MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="font-style: italic; font-size: 0.8rem;">
                                <b>(Maximum Size 5 Mb)</b>
                            </MudText>
                            <MudGrid Class="mt-0">
                                <!-- Item untuk SfUploader -->
                                <MudItem xs="12" sm="8">
                                    <SfUploader @ref="_uploadObj" ID="uploaderApplicants" AutoUpload="true" SequentialUpload="false" AllowMultiple="false"
                                                AllowedExtensions=".xls, .xlsx" MaxFileSize=@_maximumFileSizeInBytes>
                                        <UploaderEvents ValueChange="ValueChangeUploaderIeltsDoc" OnRemove="OnRemoveUploaderIeltsDoc"></UploaderEvents>
                                    </SfUploader>
                                </MudItem>

                                <!-- Tombol Upload -->
                                <MudItem xs="6" sm="2" Class="mt-1">
                                    <SfButton Content="Upload" CssClass="e-info" IconCss="e-icons e-upload-1"
                                              OnClick="OnClickUploadAsync"></SfButton>
                                </MudItem>

                                <!-- Tombol Download -->
                                <MudItem xs="6" sm="2" Class="mt-1">
                                    <SfButton Content="Download" CssClass="e-info" IconCss="e-icons e-download"
                                              OnClick="OnClickDownloadAsync"></SfButton>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

