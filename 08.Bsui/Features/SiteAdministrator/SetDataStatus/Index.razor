@inject IWebHostEnvironment _webHostEnvironment

<style>
	.e-chip-list {
		display: inline !important;
	}

	.panel {
		background: #ffffff;
	}

	@* .e-switch-wrapper.e-info .e-switch-inner.e-switch-active,
	.e-switch-wrapper.e-info .e-switch-on {
		background-color: #0f4c81 !important;
	}

	.e-switch-wrapper.e-info .e-switch-handle.e-switch-active {
		background-color: #ffffff !important;
	} *@

</style>
<ErrorViewer Error="_error" />

@if (_isLoading)
{
	<MudContainer Class="d-flex justify-center align-center" Style="min-height: 400px; margin-top: 50px;">
		<Loading IsVisible="_isLoading" />
	</MudContainer>
}
else
{
    <MudGrid>
        <MudItem xs="12">
            <MudCard>
                <MudCardContent>
                    <EditForm Model="@UpdateStatusRequest" OnValidSubmit="OnValidSubmit">
                        <DataAnnotationsValidator />
                    <MudGrid Spacing="3">
                            <MudItem xs="12">
                                <MudText>Set Data Status</MudText>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid Spacing="2" Class="d-flex align-center">
                                    <MudItem xs="3" Class="mr-2">
                                        <MudText Typo="Typo.subtitle2" Class="ms-0">Disabled From</MudText>
                                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="font-style: italic; font-size: 0.8rem;">
                                            <b>(The maximum date for awardee to make reimbursements)</b>
                                        </MudText>
                                        <SfDatePicker Value="UpdateStatusRequest.DisabledFrom"
                                                      TValue="DateOnly?"
                                                      Placeholder="From"
                                                      FullScreen="true"
                                                      ShowClearButton="true"
                                                      Format="dd">
                                            <DatePickerEvents TValue="DateOnly?" ValueChange="OnDisabledFromChange"></DatePickerEvents>
                                        </SfDatePicker>
                                    </MudItem>
                                    <MudItem xs="3" Class="mr-2">
                                        <MudText Typo="Typo.subtitle2" Class="ms-0">Disabled To</MudText>
                                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="font-style: italic; font-size: 0.8rem;">
                                            <b>(Maximum date for admin to submit SAP payment request)</b>
                                        </MudText>
                                        <SfDatePicker @bind-Value="UpdateStatusRequest.DisabledTo"
                                                      TValue="DateOnly?"
                                                      Placeholder="To"
                                                      FullScreen="true"
                                                      ShowClearButton="true"
                                                      Format="dd"
                                                      Min="@(MinDisabledToDateTime ?? DateTime.MinValue)"
                                                      Enabled="@(UpdateStatusRequest.DisabledFrom.HasValue)" />
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" Class="d-flex align-center">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           ButtonType="MudBlazor.ButtonType.Submit">
                                    Save
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </EditForm>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
	@* <MudGrid>
