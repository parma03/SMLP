@attribute [Authorize(Roles = "Admin,Owner")]
@page "/CustomerInsights"

<BrowserTabTitle>Customer Insights</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>
<PageHeader Title="Customer Insights" Icon="@Icons.Material.Filled.Psychology" />

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}

<MudAlert Severity="Severity.Info" Class="mb-4">
    📊 Analisis mendalam perilaku pelanggan — segmentasi RFM otomatis, prediksi churn, dan rekomendasi aksi CRM.
</MudAlert>

@* RFM KPI Row *@
<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-top:3px solid #2E7D32;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Total Pelanggan</MudText>
            <MudText Typo="Typo.h5" Style="color:#2E7D32; font-weight:700;">@(_insights?.TotalCustomers.ToString("N0") ?? "—")</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">terdaftar di sistem</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-top:3px solid #C8860A;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Avg. Total Belanja</MudText>
            <MudText Typo="Typo.h5" Style="color:#C8860A; font-weight:700;">Rp @(_insights?.AvgTransactionValue.ToString("N0") ?? "—")</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">rata-rata per pelanggan</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-top:3px solid #0277BD;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Retention Rate</MudText>
            <MudText Typo="Typo.h5" Style="color:#0277BD; font-weight:700;">@(_insights?.RetentionRate.ToString("F1") ?? "—")%</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">pelanggan kembali beli</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-top:3px solid #C62828;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Churn Risk</MudText>
            <MudText Typo="Typo.h5" Style="color:#C62828; font-weight:700;">@(_insights?.ChurnRiskCustomers?.Count ?? 0) pelanggan</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">tidak aktif > 45 hari</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@* RFM Segmentation + Donut Chart *@
<MudGrid Class="mb-4">
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 rounded-lg" Elevation="2">
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.subtitle1" Style="color:#6F4E37; font-weight:700;">
                    📐 Segmentasi RFM (Recency · Frequency · Monetary)
                </MudText>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="ExportSegmentAsync"
                           Disabled="_isExporting">
                    @(_isExporting ? "Mengekspor..." : "Export Excel")
                </MudButton>
            </div>
            @if (_insights?.RfmSegments?.Any() == true)
            {
                <MudTable Dense="true" Hover="true" Elevation="0" Items="@_insights.RfmSegments">
                    <HeaderContent>
                        <MudTh>Segmen</MudTh>
                        <MudTh Style="text-align:right">Jumlah</MudTh>
                        <MudTh Style="text-align:right">%</MudTh>
                        <MudTh>Aksi CRM</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="@GetMudColor(context.Color)">@context.Label</MudChip>
                        </MudTd>
                        <MudTd Style="text-align:right"><MudText Typo="Typo.subtitle2">@context.Count.ToString("N0")</MudText></MudTd>
                        <MudTd Style="text-align:right">
                            <MudText Typo="Typo.caption">
                                @(TotalSegmented > 0 ? ((double)context.Count / TotalSegmented * 100).ToString("F1") : "0.0")%
                            </MudText>
                        </MudTd>
                        <MudTd><MudText Typo="Typo.caption" Color="Color.Secondary">@context.ActionRecommendation</MudText></MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else if (!_isLoading)
            {
                <MudText Class="pa-4 text-center" Color="Color.Secondary">Belum ada data segmentasi</MudText>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 rounded-lg" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:#6F4E37; font-weight:700;">
                🍩 Distribusi Segmen Pelanggan
            </MudText>
            @if (_insights?.RfmSegments?.Any(s => s.Count > 0) == true && !_isLoading)
            {
                <MudChart ChartType="ChartType.Donut"
                          InputData="@DonutData"
                          InputLabels="@DonutLabels"
                          LegendPosition="Position.Bottom"
                          Width="100%"
                          Height="280px" />
            }
            else if (_isLoading)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="280px" />
            }
            else
            {
                <MudText Class="pa-4 text-center" Color="Color.Secondary">Belum ada data untuk chart</MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@* Churn Risk & Birthday CRM *@
<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-left:4px solid #C62828;">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:#C62828; font-weight:700;">
                ⚠️ Pelanggan Berisiko Churn
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                Pelanggan yang tidak bertransaksi lebih dari 45 hari
            </MudText>
            @if (_insights?.ChurnRiskCustomers?.Any() == true)
            {
                <MudTable Dense="true" Hover="true" Elevation="0" Items="@_insights.ChurnRiskCustomers">
                    <HeaderContent>
                        <MudTh>Pelanggan</MudTh>
                        <MudTh Style="text-align:right">Hari Absen</MudTh>
                        <MudTh>Tier</MudTh>
                        <MudTh Style="text-align:right">Poin</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div>
                                <MudText Typo="Typo.body2">@context.FullName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.PhoneNumber</MudText>
                            </div>
                        </MudTd>
                        <MudTd Style="text-align:right">
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">@context.DaysSinceLastPurchase hari</MudChip>
                        </MudTd>
                        <MudTd><MudText Typo="Typo.caption">@context.Tier</MudText></MudTd>
                        <MudTd Style="text-align:right; color:#C8860A;">⭐ @context.TotalPoints.ToString("N0")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-3 text-center" Color="Color.Success">🎉 Tidak ada pelanggan berisiko churn!</MudText>
                    </NoRecordsContent>
                </MudTable>
            }
            else
            {
                <MudText Class="pa-4 text-center" Color="Color.Success">🎉 Tidak ada pelanggan berisiko churn saat ini.</MudText>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-left:4px solid #E91E63;">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:#E91E63; font-weight:700;">
                🎂 Ulang Tahun dalam 14 Hari
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                Kirim ucapan & reward spesial birthday untuk mempererat loyalitas
            </MudText>
            @if (_insights?.BirthdaysThisMonth?.Any() == true)
            {
                <MudTable Dense="true" Hover="true" Elevation="0" Items="@_insights.BirthdaysThisMonth">
                    <HeaderContent>
                        <MudTh>Pelanggan</MudTh>
                        <MudTh>Tgl Lahir</MudTh>
                        <MudTh>Poin</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div>
                                <MudText Typo="Typo.body2">@context.FullName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.PhoneNumber</MudText>
                            </div>
                        </MudTd>
                        <MudTd>
                            <MudText Typo="Typo.body2">@context.BirthDate?.ToString("dd MMMM")</MudText>
                            @if (context.DaysUntilBirthday == 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">🎂 HARI INI!</MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.DaysUntilBirthday hari lagi</MudText>
                            }
                        </MudTd>
                        <MudTd>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Tier</MudText>
                            <MudText Typo="Typo.caption" Style="color:#C8860A;">⭐ @context.TotalPoints.ToString("N0")</MudText>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Class="pa-3 text-center" Color="Color.Secondary">Tidak ada pelanggan berulang tahun dalam 14 hari</MudText>
                    </NoRecordsContent>
                </MudTable>
            }
            else
            {
                <MudText Class="pa-4 text-center" Color="Color.Secondary">Tidak ada pelanggan berulang tahun dalam 14 hari ke depan</MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@* Top Spenders *@
@if (_insights?.TopSpenders?.Any() == true)
{
    <MudPaper Class="pa-4 rounded-lg mt-4" Elevation="2" role="region" aria-label="Top Pelanggan">
        <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:#6F4E37; font-weight:700;">
            👑 Top Pelanggan (by Total Belanja)
        </MudText>
        <MudTable Dense="true" Hover="true" Elevation="0" Items="@_insights.TopSpenders">
            <HeaderContent>
                <MudTh scope="col">#</MudTh>
                <MudTh scope="col">Pelanggan</MudTh>
                <MudTh scope="col">Tier</MudTh>
                <MudTh scope="col" Style="text-align:right">Total Belanja</MudTh>
                <MudTh scope="col" Style="text-align:right">Total Poin</MudTh>
                <MudTh scope="col" Style="text-align:right">Transaksi</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudText Style="@($"color:{(context.Rank <= 3 ? "#C8860A" : "#6F4E37")}; font-weight:700;")">
                        @(context.Rank == 1 ? "🥇" : context.Rank == 2 ? "🥈" : context.Rank == 3 ? "🥉" : $"#{context.Rank}")
                    </MudText>
                </MudTd>
                <MudTd>
                    <div>
                        <MudText Typo="Typo.body2" Style="font-weight:600;">@context.FullName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.MemberCode</MudText>
                    </div>
                </MudTd>
                <MudTd><MudText Typo="Typo.caption">@context.Tier</MudText></MudTd>
                <MudTd Style="text-align:right">
                    <MudText Style="color:#2E7D32; font-weight:700;">Rp @context.TotalSpend.ToString("N0")</MudText>
                </MudTd>
                <MudTd Style="text-align:right">
                    <MudText Style="color:#C8860A; font-weight:700;">⭐ @context.TotalPoints.ToString("N0")</MudText>
                </MudTd>
                <MudTd Style="text-align:right">
                    <MudText Typo="Typo.body2">@context.TransactionCount×</MudText>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@* ── Churn Prediction Score (Rule-Based) ── *@
@if (_insights?.ChurnRiskCustomers?.Any() == true)
{
    <MudPaper Class="pa-4 rounded-lg mt-4" Elevation="2" role="region" aria-label="Prediksi Churn">
        <MudText Typo="Typo.subtitle1" Class="mb-1" Style="color:#6F4E37; font-weight:700;">
            📉 Prediksi Risiko Churn (Rule-Based Score)
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
            Skor risiko dihitung berdasarkan jumlah hari absen, total poin, dan tier pelanggan.
            Semakin tinggi skor, semakin besar risiko pelanggan tidak kembali.
        </MudText>
        <MudTable Dense="true" Hover="true" Elevation="0" Items="@_insights.ChurnRiskCustomers">
            <HeaderContent>
                <MudTh scope="col">Pelanggan</MudTh>
                <MudTh scope="col" Style="text-align:right">Hari Absen</MudTh>
                <MudTh scope="col">Tier</MudTh>
                <MudTh scope="col" Style="text-align:right">Poin</MudTh>
                <MudTh scope="col">Skor Risiko Churn</MudTh>
                <MudTh scope="col">Tingkat Risiko</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{
                    var score = ComputeChurnScore(context);
                    var riskLevel = score >= 75 ? ("Sangat Tinggi", Color.Error, "#C62828") :
                                   score >= 55 ? ("Tinggi", Color.Warning, "#E65100") :
                                   score >= 35 ? ("Sedang", Color.Warning, "#F57F17") :
                                                 ("Rendah", Color.Success, "#2E7D32");
                }
                <MudTd>
                    <div>
                        <MudText Typo="Typo.body2">@context.FullName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.PhoneNumber</MudText>
                    </div>
                </MudTd>
                <MudTd Style="text-align:right">
                    <MudChip T="string" Size="Size.Small" Color="Color.Error">@context.DaysSinceLastPurchase hari</MudChip>
                </MudTd>
                <MudTd><MudText Typo="Typo.caption">@context.Tier</MudText></MudTd>
                <MudTd Style="text-align:right; color:#C8860A;">⭐ @context.TotalPoints.ToString("N0")</MudTd>
                <MudTd Style="min-width:140px;">
                    <div class="d-flex align-center gap-1">
                        <MudProgressLinear Value="@score" Color="@riskLevel.Item2"
                                           Style="flex:1; height:8px; border-radius:4px;"
                                           aria-label="@($"Skor risiko churn: {score}%")" />
                        <MudText Typo="Typo.caption" Style="@($"color:{riskLevel.Item3}; font-weight:700; width:32px;")">
                            @score%
                        </MudText>
                    </div>
                </MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@riskLevel.Item2"
                             aria-label="@($"Tingkat risiko: {riskLevel.Item1}")">
                        @riskLevel.Item1
                    </MudChip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@* ── Recommendation Engine ── *@
<RecommendationEngine Insights="@_insights" />
