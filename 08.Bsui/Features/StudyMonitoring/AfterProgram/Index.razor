@using Psmp.Base.Scholarships.Enums
@using Psmp.Base.Studies.Enums
@using Psmp.Bsui.Features.StudyMonitoring.Component
@using Psmp.Shared.Common.Responses
@using Psmp.Shared.StudyMonitorings.Constants
@using Psmp.Shared.Masters.Queries
@using Psmp.Shared.Scholarships.ScholarshipPosting.Queries
@using Psmp.Shared.Selections.SelectionOverviews.Queries
@using Psmp.Bsui.Features.StudyMonitoring.AfterProgram;
@using Psmp.Shared.StudyMonitorings.AfterProgram.Queries

<style>
    .e-chip-list {
        display: inline !important
    }

    .e-upload .e-file-select-wrap, .e-bigger.e-small .e-upload .e-file-select-wrap {
        padding: 5px 0 5px 5px; /* Sesuaikan padding untuk tampilan yang lebih kompak */
    }

    .sf-uploader-compact .e-file-container {
        margin: 2px 0; /* Mengurangi margin antar file */
    }

    .e-removeDeletecommand .e-unboundcell .e-unboundcelldiv button.e-Deletebutton {
        display: none;
    }
</style>

<ErrorViewer Error="_error" />
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>
@if (_isLoading)
{
    <Loading IsVisible="_isLoading" />
}
else
{
    <MudGrid Spacing="2">
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12">
                <MudText Typo="Typo.body2" HtmlTag="h3">After Program Filter</MudText>
            </MudItem>
        </MudGrid>
        <MudGrid Spacing="2" Class="mb-4">
            <MudItem xs="2">
                <MudText>Categories</MudText>
                <SfDropDownList ID="ddlSelectionCategory" TValue="int" TItem="DropdownItemResponse" DataSource="@_dropdownCategories" Placeholder="All Category" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Description" Value="Id" />
                    <DropDownListEvents TItem="DropdownItemResponse" TValue="int" ValueChange="OnChangeCategory" />
                </SfDropDownList>
            </MudItem>
            <MudItem xs="2">
                <MudText>H/ SH/ AP&P</MudText>
                <SfDropDownList ID="ddlSelectionCompaynGroup" TValue="int" TItem="GetCompanyGroupQueryResponse" DataSource="@_dropdownCompanyGroups" Placeholder="All H/SH/AP&P" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Name" Value="Id" />
                    <DropDownListEvents TItem="GetCompanyGroupQueryResponse" TValue="int" ValueChange="OnChangeCompanyGroupAsync" />
                </SfDropDownList>
            </MudItem>
            <MudItem xs="2">
                <MudText>Company</MudText>
                <SfDropDownList ID="ddlSelectionCompay" TValue="string" TItem="GetCompanyQueryResponse" DataSource="@_dropdownCompanies" Placeholder="All Company" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Name" Value="Code" />
                    <DropDownListEvents TItem="GetCompanyQueryResponse" TValue="string" ValueChange="OnChangeCompanyAsync" />
                </SfDropDownList>
            </MudItem>
            <MudItem xs="2">
                <MudText>Directorate</MudText>
                <SfDropDownList ID="ddlSelectionDirectorate" TValue="int" TItem="GetDirectorateQueryResponse" DataSource="@_dropdownDirectorates" Placeholder="All Directorate" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Name" Value="Id" />
                    <DropDownListEvents TItem="GetDirectorateQueryResponse" TValue="int" ValueChange="OnChangeDirectorateAsync" />
                </SfDropDownList>
            </MudItem>
            <MudItem xs="2">
                <MudText>Scholarship Code</MudText>
                <SfDropDownList ID="ddlSsholarshipCodes" TValue="Guid" TItem="GetScholarshipPostingDropdownResponse" DataSource="@_dropdownScholarshipCodes" Placeholder="All Code" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Code" Value="Id" />
                    <DropDownListEvents TItem="GetScholarshipPostingDropdownResponse" TValue="Guid" ValueChange="OnChangeScholarshipCodeAsync" />
                </SfDropDownList>
            </MudItem>
            <MudItem xs="2">
                <MudText>Batch</MudText>
                <SfDropDownList ID="ddlScholarshipBatch" TValue="ScholarshipBatch" TItem="ScholarshipBatchResponse" Placeholder="All Batch"
                                AllowFiltering="false" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                DataSource="@_dropdownBatchs" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Text" Value="Value" />
                    <DropDownListEvents TItem="ScholarshipBatchResponse" TValue="ScholarshipBatch" ValueChange="OnChangeBatchAsync" />
                </SfDropDownList>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mb-2">
            <MudItem xs="12">
                <MudCard Class="pa-4" Elevation="2">
                    <MudGrid Justify="Justify.Center">
                        <!-- Card pertama -->
                        <MudItem xs="12" sm="4" md="4" Class="d-flex justify-start">
                            <CardStatistic Judul="Total Awardee" Count="@_countAll"></CardStatistic>
                        </MudItem>

                        <!-- Divider Vertikal -->
                        @* <MudItem xs="1" Class="d-flex justify-center">
                            <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                        </MudItem> *@

                        <!-- Card kedua -->
						<MudItem xs="12" sm="4" md="4" Class="d-flex justify-start">
                            <CardStatistic Icon="@Icons.Material.Rounded.EventAvailable" Judul="Done" TypeCount="text" CountText="@_countDone"></CardStatistic>
                        </MudItem>

                        <!-- Divider Vertikal -->
                        @* <MudItem xs="1" Class="d-flex justify-center">
                            <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                        </MudItem> *@

                        <!-- Card ketiga -->
						<MudItem xs="12" sm="4" md="4" Class="d-flex justify-start">
                            <CardStatistic Icon="@Icons.Material.Rounded.EventBusy" Judul="Not Start" TypeCount="text" CountText="@_countNotStart" IsLast="true"></CardStatistic>
                        </MudItem>
                    </MudGrid>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mb-2">
            <MudItem xs="12">
                <MudCard Class="pa-4" Elevation="2">
                    <MudCardContent>
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Class="ms-0">List of Awardee</MudText>
                            <MudDivider Style="border-width: 2px; margin-bottom: 16px;" />
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4" Class="justify-end">
                                        <SfButton OnClick="OnClickAddAsync" Content="Add" IconCss="e-icons e-circle-add" CssClass="e-info"></SfButton>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <br />
                            <SfGrid DataSource="@_dataGrid" Toolbar="@(new List<string>() { "Search" })" AllowFiltering="true" AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true">
                                <GridEvents RowDataBound="RowBound" CommandClicked="OnCommandClicked" TValue="GetAfterProgramQueryResponse"></GridEvents>
                                <GridPageSettings PageCount="10" PageSize="10" PageSizes="@SyncfusionGridValue.PageSize"></GridPageSettings>
                                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                                <GridColumns>
                                    <GridColumn Field=@nameof(GetAfterProgramQueryResponse.Name) HeaderText="Name" Width="250"></GridColumn>
                                    <GridColumn Field=@nameof(GetAfterProgramQueryResponse.CompanyName) HeaderText="Company" Width="150"></GridColumn>
                                    <GridColumn Field=@nameof(GetAfterProgramQueryResponse.EmployeeNumber) HeaderText="Employee Number" Width="150"></GridColumn>
                                    <GridColumn Field=@nameof(GetAfterProgramQueryResponse.Email) HeaderText="Email" Width="150"></GridColumn>
                                    <GridColumn Field=@nameof(GetAfterProgramQueryResponse.PresentationSchedule) HeaderText="Presentasion Schedule" Format="dd.MM.yyyy" HeaderTextAlign="TextAlign.Center" TextAlign="TextAlign.Center" Width="150"></GridColumn>
                                    <GridColumn Field=@nameof(GetAfterProgramQueryResponse.PresentationScheduleTime) HeaderText="Presentasion Time" HeaderTextAlign="TextAlign.Center" TextAlign="TextAlign.Center" Width="150">
                                        <Template>
                                            @{
                                                var time = (context as GetAfterProgramQueryResponse)?.PresentationScheduleTime;
                                            }
                                            @time?.ToString("HH:mm")
                                        </Template>
                                    </GridColumn>
                                    <GridColumn HeaderText="File" TextAlign="TextAlign.Center" Width="150">
                                        <GridCommandColumns>
                                            <GridCommandColumn Title="File" Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-download", CssClass="e-flat", Content="DownloadFile" })"></GridCommandColumn>
                                        </GridCommandColumns>
                                    </GridColumn>
                                    <GridColumn Field=@nameof(GetAfterProgramQueryResponse.Status) HeaderText="Status" HeaderTextAlign="TextAlign.Center" TextAlign="TextAlign.Center" Width="150">
                                        <Template Context="context">
                                            @{
                                                var Status = ((GetAfterProgramQueryResponse)context).Status;
                                            }
                                            @if (Status == PresentationStatus.Done)
                                            {
                                                <SfChip>
                                                    <ChipItems>
                                                        <ChipItem Text="Done" CssClass="e-success"></ChipItem>
                                                    </ChipItems>
                                                </SfChip>
                                            }
                                            else if (Status == PresentationStatus.NotStarted)
                                            {
                                                <SfChip>
                                                    <ChipItems>
                                                        <ChipItem Text="Not Started"></ChipItem>
                                                    </ChipItems>
                                                </SfChip>                                                
                                            }
                                        </Template>
                                    </GridColumn>
                                    <GridColumn HeaderText="Action" TextAlign="TextAlign.Center" Width="150">
                                        <GridCommandColumns>
                                            <GridCommandColumn Title="View" Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-eye", CssClass="e-flat" })"></GridCommandColumn>
                                            <GridCommandColumn Title="Edit" Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-edit", CssClass="e-flat" })"></GridCommandColumn>
                                            <GridCommandColumn Title="Delete" Type="CommandButtonType.Delete" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-delete", CssClass="e-flat" })"></GridCommandColumn>
                                        </GridCommandColumns>
                                    </GridColumn>
                                </GridColumns>
                            </SfGrid>
                        </MudItem>

                        <MudItem xs="12" Class="mt-8">
                            <MudText>File Upload (.xls, .xlsx) <span style="color:red;">*</span></MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="font-style: italic; font-size: 0.8rem;">
                                <b>(Maximum Size 5 Mb)</b>
                            </MudText>
                            <MudGrid Class="mt-0">
                                <MudItem xs="8" class="d-flex align-center">
                                    <SfUploader @ref="_uploadExcel" ID="uploaderExcel" AutoUpload="true" SequentialUpload="false" AllowMultiple="false"
                                                AllowedExtensions=".xls, .xlsx" MaxFileSize=@_maximumFileSizeInBytes>
                                        <UploaderEvents ValueChange="ValueChangeUploaderExcel" OnRemove="OnRemoveUploaderExcel"></UploaderEvents>
                                    </SfUploader>
                                </MudItem>
                                <MudItem xs="4">
                                    <MudGrid>
                                        <SfButton Content="Upload" CssClass="e-info d-flex justify-start mt-4 mr-2" IconCss="e-icons e-upload-1"
                                                  OnClick="OnClickUploadAsync"></SfButton>
                                        <SfButton Content="Download" CssClass="e-info justify-end mt-4 mr-2" IconCss="e-icons e-download"
                                                  OnClick="OnClickDownloadAsync"></SfButton>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudGrid>
}

                                              
<DialogAddAfterProgram
    Visibility="VisiblePopup"
    Title="@TitlePopup"
    DisplayName="@_displayName"
    DialogOpen="DialogOpen" 
    DialogClose="DialogClose"
    OnClickNo="ClickedNo" 
    OnClickYes="ClickedYes"
    IsEnabled="@IsEnabled"
    IsEnabledAdmission="@IsEnabledAdmission"
    listAdmissions="_dropdownAdmission"
    listStatus="_dropdownEnumStatus"
    request="CreateData">
</DialogAddAfterProgram>

<DialogConfirmation 
    Title="@DisplayTextFor.AfterProgram"
    Visibility="VisiblePopupConfirm"
    Content="@TitlePopupConfirm"
    DialogOpen="DialogConfirmOpen"
    DialogClose="DialogConfirmClose"
    OnClickNo="ClickedNoConfirm"
    OnClickYes="ClickedYesConfirm">
</DialogConfirmation>
