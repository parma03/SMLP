@page "/StudyMonitoring"
@page "/StudyMonitoring/{TabIndex:int}"

@using Psmp.Shared.StudyMonitorings.Constants

<BrowserTabTitle>@DisplayTextFor.StudyMonitoring</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" ActivePanelIndex="@_activeTabIndex" ActivePanelIndexChanged="@(e => OnTabChanged(e))">
    @if (IsShowStudyPeriode)
    {
        <MudTabPanel Text="@DisplayTextFor.StudyPeriod">
            <Psmp.Bsui.Features.StudyMonitoring.StudyPeriod.Index>

            </Psmp.Bsui.Features.StudyMonitoring.StudyPeriod.Index>
        </MudTabPanel>
    }
    @if (IsShowGraduate)
    {
        <MudTabPanel Text="@DisplayTextFor.Graduate">
            <Psmp.Bsui.Features.StudyMonitoring.Graduate.Index>

            </Psmp.Bsui.Features.StudyMonitoring.Graduate.Index>
        </MudTabPanel>
    }
    @if (IsShowAfterProgram)
    {
        <MudTabPanel Text="@DisplayTextFor.AfterProgram">
            <Psmp.Bsui.Features.StudyMonitoring.AfterProgram.Index>

            </Psmp.Bsui.Features.StudyMonitoring.AfterProgram.Index>
        </MudTabPanel>
    }
</MudTabs>

<style>
    .mud-tabs-panels {
        min-height: 500px;
    }
</style>
