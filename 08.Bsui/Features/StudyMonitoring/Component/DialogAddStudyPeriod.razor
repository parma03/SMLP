@using Smlp.Domain.Entities.Masters
@using Smlp.Shared.Common.Responses
@using Smlp.Shared.Masters.Queries;
@using Smlp.Shared.StudyMonitorings.StudyPeriod.Commands.Create
@using Smlp.Shared.StudyMonitorings.Constants
@using Smlp.Shared.Universities.Admission.Queries
@using Syncfusion.Blazor.PdfViewerServer

<SfDialog Target="#target" Width="820px" ShowCloseIcon="true" @bind-Visible=Visibility>
    <DialogTemplates>
        <Header>@Title @DisplayTextFor.StudyPeriod</Header>
        <Content>
            <div class="row">
                <div class="col-md-12">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudCard>
                                <MudCardContent>
                                    <MudItem xs="12">
                                        <MudText>Admission <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfDropDownList ID="ddlAdmission"
                                                                TValue="Guid"
                                                                TItem="GetAdmissionQueryResponse"
                                                                DataSource="@listAdmissions"
                                                                Enabled="@IsEnabled"
                                                                @bind-Value="request!.AdmissionId"
                                                                AllowFiltering="true"
                                                                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                                                Placeholder="Select Admission">
                                                    <DropDownListFieldSettings Text="Name" Value="Id" />
                                                </SfDropDownList>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Semester <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfDropDownList ID="ddlSemester"
                                                                TValue="int"
                                                                TItem="DropdownItemResponse"
                                                                DataSource="@listSemester"
                                                                @bind-Value="request!.Semester"
                                                                AllowFiltering="true"
                                                                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                                                Placeholder="Select Semester">
                                                    <DropDownListFieldSettings Text="Description" Value="Id" />
                                                </SfDropDownList>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>GPA Score</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfNumericTextBox ID="txtGPAScore" Placeholder="GPA Score" @bind-Value="request!.GpaScore" Decimals="2"></SfNumericTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Passport (.pdf) <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfUploader ID="uploaderPassport"
                                                            AutoUpload="true"
                                                            SequentialUpload="false"
                                                            AllowMultiple="false"
                                                            AllowedExtensions=".pdf">
                                                    <UploaderEvents ValueChange="ValueChangeUploaderPassport" OnRemove="OnRemoveUploaderPassport"></UploaderEvents>
                                                </SfUploader>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Visa (.pdf) <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfUploader ID="uploaderVisa"
                                                            AutoUpload="true"
                                                            SequentialUpload="false"
                                                            AllowMultiple="false"
                                                            AllowedExtensions=".pdf">
                                                    <UploaderEvents ValueChange="ValueChangeUploaderVisa" OnRemove="OnRemoveUploaderVisa"></UploaderEvents>
                                                </SfUploader>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Transcript File (.pdf) <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfUploader ID="uploaderTranscriptFile"
                                                            AutoUpload="true"
                                                            SequentialUpload="false"
                                                            AllowMultiple="false"
                                                            AllowedExtensions=".pdf">
                                                    <UploaderEvents ValueChange="ValueChangeUploaderTranscriptFile" OnRemove="OnRemoveUploaderTranscriptFile"></UploaderEvents>
                                                </SfUploader>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton Content="Cancel" CssClass="e-outline e-danger" IconCss="e-icons e-close" OnClick="OnClickNo"></SfButton>
            @if (IsEnabled == true)
            {
                <SfButton Content="Save" CssClass="e-success" IconCss="e-icons e-circle-check" OnClick="OnClickYes"></SfButton>
            }
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
    <DialogPositionData X="center" Y="center"></DialogPositionData>
    <DialogAnimationSettings Effect="DialogEffect.None"></DialogAnimationSettings>
</SfDialog>

@code {
    [Parameter]
    public bool IsEnabled { get; set; }

    [Parameter]
    public bool Visibility { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public EventCallback DialogOpen { get; set; }

    [Parameter]
    public EventCallback DialogClose { get; set; }

    [Parameter]
    public EventCallback OnClickNo { get; set; }

    [Parameter]
    public EventCallback OnClickYes { get; set; }
    
    [Parameter]
    public List<DropdownItemResponse>? listSemester { get; set; }

    [Parameter]
    public List<GetAdmissionQueryResponse>? listAdmissions { get; set; }

    [Parameter]
    public CreateStudyPeriodRequest? request { get; set; }

    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemoveUploaderPassport { get; set; }

    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChangeUploaderPassport { get; set; }

    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemoveUploaderVisa { get; set; }

    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChangeUploaderVisa { get; set; }

    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemoveUploaderTranscriptFile { get; set; }

    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChangeUploaderTranscriptFile { get; set; }
}

