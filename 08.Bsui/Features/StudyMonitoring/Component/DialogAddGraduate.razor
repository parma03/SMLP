@using Psmp.Domain.Entities.Masters
@using Psmp.Shared.Common.Responses
@using Psmp.Shared.Masters.Queries;
@using Psmp.Shared.StudyMonitorings.Graduate.Commands.Create
@using Psmp.Shared.StudyMonitorings.Constants
@using Psmp.Shared.Universities.Admission.Queries
@using Syncfusion.Blazor.PdfViewerServer

<SfDialog Target="#target" Width="820px" ShowCloseIcon="true" @bind-Visible=Visibility>
    <DialogTemplates>
        <Header>@Title @DisplayTextFor.StudyPeriod</Header>
        <Content>
            <div class="row">
                <div class="col-md-12">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudCard>
                                <MudCardContent>
                                    <MudItem xs="12">
                                        <MudText>Admission <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfDropDownList ID="ddlAdmission"
                                                                TValue="Guid"
                                                                TItem="GetAdmissionQueryResponse"
                                                                DataSource="@listAdmissions"
                                                                Enabled="@IsEnabled"
                                                                @bind-Value="request!.AdmissionId"
                                                                AllowFiltering="true"
                                                                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                                                Placeholder="Select Admission">
                                                    <DropDownListFieldSettings Text="Name" Value="Id" />
                                                </SfDropDownList>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>GPA Score</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfNumericTextBox ID="txtGpaFinalScore" Placeholder="GPA Final Score" @bind-Value="request!.GpaFinalScore" Decimals="2"></SfNumericTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>LastExam (.pdf) <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfUploader ID="uploaderLastExam"
                                                            AutoUpload="true"
                                                            SequentialUpload="false"
                                                            AllowMultiple="false"
                                                            AllowedExtensions=".pdf">
                                                    <UploaderEvents ValueChange="ValueChangeUploaderLastExam" OnRemove="OnRemoveUploaderLastExam"></UploaderEvents>
                                                </SfUploader>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Graduation (.pdf) <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfUploader ID="uploaderGraduation"
                                                            AutoUpload="true"
                                                            SequentialUpload="false"
                                                            AllowMultiple="false"
                                                            AllowedExtensions=".pdf">
                                                    <UploaderEvents ValueChange="ValueChangeUploaderGraduation" OnRemove="OnRemoveUploaderGraduation"></UploaderEvents>
                                                </SfUploader>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Transcript File (.pdf) <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfUploader ID="uploaderTranscript"
                                                            AutoUpload="true"
                                                            SequentialUpload="false"
                                                            AllowMultiple="false"
                                                            AllowedExtensions=".pdf">
                                                    <UploaderEvents ValueChange="ValueChangeUploaderTranscript" OnRemove="OnRemoveUploaderTranscript"></UploaderEvents>
                                                </SfUploader>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Completion (.pdf) <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfUploader ID="uploaderCompletion"
                                                            AutoUpload="true"
                                                            SequentialUpload="false"
                                                            AllowMultiple="false"
                                                            AllowedExtensions=".pdf">
                                                    <UploaderEvents ValueChange="ValueChangeUploaderCompletion" OnRemove="OnRemoveUploaderCompletion"></UploaderEvents>
                                                </SfUploader>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>CourseFinal (.pdf) <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfUploader ID="uploaderCourseFinal"
                                                            AutoUpload="true"
                                                            SequentialUpload="false"
                                                            AllowMultiple="false"
                                                            AllowedExtensions=".pdf">
                                                    <UploaderEvents ValueChange="ValueChangeUploaderCourseFinal" OnRemove="OnRemoveUploaderCourseFinal"></UploaderEvents>
                                                </SfUploader>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton Content="Cancel" CssClass="e-outline e-danger" IconCss="e-icons e-close" OnClick="OnClickNo"></SfButton>
            @if (IsEnabled == true)
            {
                <SfButton Content="Save" CssClass="e-success" IconCss="e-icons e-circle-check" OnClick="OnClickYes"></SfButton>
            }
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
    <DialogPositionData X="center" Y="center"></DialogPositionData>
    <DialogAnimationSettings Effect="DialogEffect.None"></DialogAnimationSettings>
</SfDialog>

@code {
    [Parameter]
    public bool IsEnabled { get; set; }

    [Parameter]
    public bool Visibility { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public EventCallback DialogOpen { get; set; }

    [Parameter]
    public EventCallback DialogClose { get; set; }

    [Parameter]
    public EventCallback OnClickNo { get; set; }

    [Parameter]
    public EventCallback OnClickYes { get; set; }

    [Parameter]
    public CreateGraduateRequest? request { get; set; }

    [Parameter]
    public List<GetAdmissionQueryResponse>? listAdmissions { get; set; }

    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemoveUploaderLastExam { get; set; }

    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChangeUploaderLastExam { get; set; }

    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemoveUploaderGraduation { get; set; }

    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChangeUploaderGraduation { get; set; }

    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemoveUploaderTranscript { get; set; }

    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChangeUploaderTranscript { get; set; }

    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemoveUploaderCompletion { get; set; }

    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChangeUploaderCompletion { get; set; }

    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemoveUploaderCourseFinal { get; set; }

    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChangeUploaderCourseFinal { get; set; }
}

