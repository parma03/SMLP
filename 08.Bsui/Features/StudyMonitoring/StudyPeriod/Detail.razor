@page "/StudyMonitoring/StudyPeriod/{Id:guid}"

@using Psmp.Shared.StudyMonitorings.Constants
@using Psmp.Shared.StudyMonitorings.StudyPeriod.Queries

<BrowserTabTitle>@DisplayTextFor.StudyMonitoring</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>
<ErrorViewer Error="_error" />
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>
@if (_isLoading)
{
    <Loading IsVisible="_isLoading" />
}
else
{
    <MudCard>
        <MudCardContent>
            <MudGrid Spacing="2" Style="padding : 25px;">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1" HtmlTag="h1">Semester</MudText>
                        <MudDivider Style="border-width: 2px; margin-bottom: 16px;" />
                    </MudItem>
                </MudGrid>
                <MudGrid Spacing="2" Class="mb-4">
                    <MudItem xs="4">
                        <MudText>Name</MudText>
                        <SfTextBox @bind-Value="_data!.Name" Enabled="false"></SfTextBox>
                    </MudItem>
                    <MudItem xs="4">
                        <MudText>Company</MudText>
                        <SfTextBox @bind-Value="_data!.CompanyName" Enabled="false"></SfTextBox>
                    </MudItem>
                    <MudItem xs="4">
                        <MudText>University</MudText>
                        <SfTextBox @bind-Value="_data!.University" Enabled="false"></SfTextBox>
                    </MudItem>
                </MudGrid>
                <MudGrid Class="mb-4">
                    <MudItem xs="12">
                        <MudCard Class="pa-4" Elevation="2">
                            <MudGrid Justify="Justify.Center">
                                <MudItem xs="12" sm="4" md="4" Class="d-flex justify-start">
                                    <CardStatistic Icon="@Icons.Material.Rounded.TrendingUp" Judul="Highest GPA" TypeCount="float" CountFloat="@_highest"></CardStatistic>
                                </MudItem>

                                <!-- Divider Vertikal -->
                                @* <MudItem xs="1" Class="d-flex justify-center">
                                    <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                                </MudItem> *@

								<MudItem xs="12" sm="4" md="4" Class="d-flex justify-start">
                                    <CardStatistic Icon="@Icons.Material.Rounded.TrendingDown" Judul="Lowest GPA" TypeCount="float" CountFloat="@_lowest"></CardStatistic>
                                </MudItem>

                                <!-- Divider Vertikal -->
                                @* <MudItem xs="1" Class="d-flex justify-center">
                                    <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                                </MudItem> *@

								<MudItem xs="12" sm="4" md="4" Class="d-flex justify-start">
                                    <CardStatistic Icon="@Icons.Material.Rounded.BarChart" Judul="GPA Average" TypeCount="float" CountFloat="@_average" IsLast="true"></CardStatistic>
                                </MudItem>
                            </MudGrid>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <MudGrid Class="mb-2">
                    <MudItem xs="12">
                        <MudCard Class="pa-4" Elevation="2">
                            <MudCardContent>
                                <MudItem xs="12">
                                    <MudText Typo="Typo.subtitle2" Class="ms-0">List of Semester</MudText>
                                    <MudDivider Style="border-width: 2px; margin-bottom: 16px;" />
                                    <SfGrid DataSource="@_dataGrid" Toolbar="@(new List<string>() { "Search" })" AllowFiltering="true" AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true">
                                        <GridEvents CommandClicked="OnCommandClicked" TValue="GetStudyPeriodByAdmissionIdQueryResponse"></GridEvents>
                                        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                                        <GridColumns>
                                            <GridColumn Field=@nameof(GetStudyPeriodByAdmissionIdQueryResponse.Semester) HeaderText="Semester" Width="150"></GridColumn>
                                            <GridColumn Field=@nameof(GetStudyPeriodByAdmissionIdQueryResponse.GpaScore) HeaderText="GPA Score" Width="150"></GridColumn>
                                            <GridColumn Field=@nameof(GetStudyPeriodByAdmissionIdQueryResponse.TranscriptFileName) HeaderText="Transcript File" Width="150"></GridColumn>
                                            <GridColumn HeaderText="Action" TextAlign="TextAlign.Center" Width="150">
                                                <GridCommandColumns>
                                                    <GridCommandColumn Title="View" Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-eye", CssClass="e-flat" })"></GridCommandColumn>
                                                </GridCommandColumns>
                                            </GridColumn>
                                        </GridColumns>
                                    </SfGrid>
                                </MudItem>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>
                <MudGrid>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="12">
                                <SfButton OnClick="OnClickBack" Content="Back" IconCss="e-icons e-arrow-left" CssClass="e-danger"></SfButton>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                </MudGrid>
            </MudGrid>
        </MudCardContent>
    </MudCard>
    
}
