@page "/StudyMonitoring/StudyPeriod/{AdmissionId:guid}/{Id:guid}"

@using Smlp.Shared.StudyMonitorings.Constants
@using Syncfusion.Blazor.PdfViewerServer

<BrowserTabTitle>@DisplayTextFor.StudyMonitoring</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>
<ErrorViewer Error="_error" />
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>
@if (_isLoading)
{
    <Loading IsVisible="_isLoading" />
}
else
{
    <MudCard>
        <MudCardContent>
            <MudGrid Spacing="2" Style="padding : 25px;">
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1" HtmlTag="h1">Detail Semester</MudText>
                        <MudDivider Style="border-width: 2px; margin-bottom: 16px;" />
                    </MudItem>
                </MudGrid>
                <MudGrid Spacing="2" Class="mb-4">
                    <MudItem xs="4">
                        <MudText>Semester</MudText>
                        <SfNumericTextBox @bind-Value="_data!.Semester" Enabled="false"></SfNumericTextBox>
                    </MudItem>
                    <MudItem xs="4">
                        <MudText>GPA Score</MudText>
                        <SfNumericTextBox @bind-Value="_data!.GpaScore" Enabled="false"></SfNumericTextBox>
                    </MudItem>
                </MudGrid>
                <MudGrid Spacing="2" Class="mb-4">
                    @* <MudItem xs="12" Class="mb-2" Style="min-height:250px;">
                        <MudText>Passport</MudText>
                        <SfPdfViewerServer DocumentPath="@_documentPassport" Width="100%" Height="300px" />
                    </MudItem>
                    <MudItem xs="12" Class="mb-2" Style="min-height:250px;">
                        <MudText>Visa</MudText>
                        <SfPdfViewerServer DocumentPath="@_documentVisa" Width="100%" Height="300px" />
                    </MudItem> *@
                    <MudItem xs="12" Class="mb-2" Style="min-height:750px;">
                        <MudText Class="mb-2">Transcript File</MudText>
                        <SfPdfViewerServer DocumentPath="@_documentTranscriptFile" Width="100%" Height="750px" />
                    </MudItem>
                </MudGrid>
                <MudGrid>
                    <MudItem xs="12">
                        <MudGrid>
                            <MudItem xs="12">
                                <SfButton OnClick="OnClickBack" Content="Back" IconCss="e-icons e-arrow-left" CssClass="e-danger"></SfButton>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                </MudGrid>
            </MudGrid>
        </MudCardContent>
    </MudCard>
}
