@using Smlp.Shared.Selections.SelectionPsychotests.Commands.Create
@using Smlp.Shared.Selections.SelectionPsychotests.Queries
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups

<SfDialog Target="#target" Width="720px" ShowCloseIcon="true" @bind-Visible=Visibility>
    <DialogTemplates>
        <Header>@Title</Header>
        <Content>
            <div class="row">
                <div class="col-md-12">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudCard>
                                <MudCardContent>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Test Schedule</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfDateRangePicker ID="dTestDatePsychotest" TValue="DateTimeOffset?" Format="dd.MM.yyyy" StartDate="@response!.ScheduleStartDate" EndDate="@response!.ScheduleEndDate" Placeholder="Choose a Date">
                                                    <DateRangePickerEvents TValue="DateTimeOffset?" ValueChange="OnChangeValueScheduleDate"></DateRangePickerEvents>
                                                </SfDateRangePicker>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Session per day</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfNumericTextBox ID="txtDailySessionPsychotest" Placeholder="Input Daily Session" Format="n0" Max="2" @bind-Value="response!.Session" Enabled="false"></SfNumericTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="6">
                                                <MudGrid>
                                                    <MudItem xs="8">
                                                        <MudText>Session 1 Start</MudText>
                                                    </MudItem>
                                                    <MudItem xs="4">
                                                        <SfTimePicker TValue="TimeOnly" Step=60 Format="HH:mm" ShowClearButton="true" FullScreen="true" @bind-Value="response!.Session1Start"></SfTimePicker>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudItem>
                                            <MudItem xs="6">
                                                <MudGrid>
                                                    <MudItem xs="3">
                                                    </MudItem>
                                                    <MudItem xs="5">
                                                        <MudText>Session 1 End</MudText>
                                                    </MudItem>
                                                    <MudItem xs="4">
                                                        <SfTimePicker TValue="TimeOnly" Step=60 Format="HH:mm" ShowClearButton="true" FullScreen="true" @bind-Value="response!.Session1End"></SfTimePicker>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="6">
                                                <MudGrid>
                                                    <MudItem xs="8">
                                                        <MudText>Session 2 Start</MudText>
                                                    </MudItem>
                                                    <MudItem xs="4">
                                                        <SfTimePicker TValue="TimeOnly" Step=60 Format="HH:mm" ShowClearButton="true" FullScreen="true" @bind-Value="response!.Session2Start"></SfTimePicker>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudItem>
                                            <MudItem xs="6">
                                                <MudGrid>
                                                    <MudItem xs="3">
                                                    </MudItem>
                                                    <MudItem xs="5">
                                                        <MudText>Session 2 End</MudText>
                                                    </MudItem>
                                                    <MudItem xs="4">
                                                        <SfTimePicker TValue="TimeOnly" Step=60 Format="HH:mm" ShowClearButton="true" FullScreen="true" @bind-Value="response!.Session2End"></SfTimePicker>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Applicants per Session</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfNumericTextBox ID="txtDailyApplicantsPsychotest" Placeholder="Input Daily Applicants" Format="n0" @bind-Value="response!.Applicants"></SfNumericTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton Content="Cancel" CssClass="e-outline e-danger" IconCss="e-icons e-close" OnClick="OnClickNo"></SfButton>
            <SfButton Content="Save" CssClass="e-success" IconCss="e-icons e-circle-check" OnClick="OnClickYes"></SfButton>
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
    <DialogPositionData X="center" Y="top"></DialogPositionData>
    <DialogAnimationSettings Effect="DialogEffect.None"></DialogAnimationSettings>
</SfDialog>
@code {
    [Parameter]
    public bool Visibility { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public EventCallback DialogOpen { get; set; }

    [Parameter]
    public EventCallback DialogClose { get; set; }

    [Parameter]
    public EventCallback OnClickNo { get; set; }

    [Parameter]
    public EventCallback OnClickYes { get; set; }

    [Parameter]
    public GetSelectionPsychotestScheduleListResponse? response { get; set; }
    [Parameter]
    public EventCallback<RangePickerEventArgs<DateTimeOffset?>> OnChangeValueScheduleDate { get; set; }
}
