@using Psmp.Shared.Selections.SelectionTalentReviews.Commands.Create
@using Psmp.Shared.Selections.SelectionTalentReviews.Queries
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups

<SfDialog Target="#target" Width="820px" ShowCloseIcon="true" @bind-Visible=Visibility>
    <DialogTemplates>
        <Header>@Title</Header>
        <Content>
            <div class="row">
                <div class="col-md-12">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudCard>
                                <MudCardContent>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Scholarship Code</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.ScholarshipCode" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Holding/Sub Holding/AP Service & Portfolio</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.CompanyGroupName" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Company Name</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.CompanyName" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Directorate/Function</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.DirectorateName" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Division</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.DivisionName" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Business Issues</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.BusinessIssue" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Reference of Business Issues</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.ReferenceOfBusinessIssue" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Performance Issues</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.PerformanceIssue" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Competency Issues</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.CompetencyIssue" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Degree</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.Degree" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Faculty</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.Faculty" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Major</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.Major" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>University Reference</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.UniversityReference" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Universitu Location (Abord/Domestic)</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.UniversityLocation" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Latest Education Background (Level & Major)</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.EducationBackground" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Minimum Working Experience (Year & Field)</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.MinimumWorkingExperience" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Scope (Internal Entity / Pertamina Group)</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.Scope" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Awardee Quota</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.AwardeQuota" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Batch</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.Batch" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Selection Category</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.SelectionCategory" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Posting Year</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.PostingYear" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <h4><b><MudText>Administrative Selection Criteria</MudText></b></h4>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Minimum PRL Individu/BS</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.MinimumPRL" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Maximum Age</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.MaximumAge" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Minimum Work Period (Year)</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.MinimumWorkingPeriod" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Average Performance Rating Last 3 Years</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.AveragePerformanceRating" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Indiciplinary Record Last 3 Years (SAP Based)</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.MinimumPRL" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>MCU Status</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.MCUStatus" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Innovation Project</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox @bind-Value="response!.InnovationProject" Enabled="true"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudGrid>
                                            <MudItem xs="4">
                                                <MudText>Mentor (Minimum Manager)</MudText>
                                            </MudItem>
                                            <MudItem xs="8">
                                                <SfTextBox Placeholder="Nopek/Name" @bind-Value="response!.MentorId" Enabled="true"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton Content="Cancel" CssClass="e-outline e-danger" IconCss="e-icons e-close" OnClick="OnClickNo"></SfButton>
            <SfButton Content="Save" CssClass="e-success" IconCss="e-icons e-circle-check" OnClick="OnClickYes"></SfButton>
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
    <DialogPositionData X="center" Y="top"></DialogPositionData>
    <DialogAnimationSettings Effect="DialogEffect.None"></DialogAnimationSettings>
</SfDialog>
@code {
    [Parameter]
    public bool Visibility { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public EventCallback DialogOpen { get; set; }

    [Parameter]
    public EventCallback DialogClose { get; set; }

    [Parameter]
    public EventCallback OnClickNo { get; set; }

    [Parameter]
    public EventCallback OnClickYes { get; set; }

    [Parameter]
    public GetSelectionTalentReviewByIdQueryResponse? response { get; set; }
}
