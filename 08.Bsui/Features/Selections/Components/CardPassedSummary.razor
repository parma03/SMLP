<style>
    @@media (max-width: 768px) {
        .responsive-text {
            font-size: 1rem; /* Ukuran font lebih kecil */
        }
    }

    @@media (max-width: 480px) {
        .responsive-text {
            font-size: 0.875rem; /* Ukuran font lebih kecil lagi */
        }
    }
</style>

<MudCard Elevation="0">
    <MudCardHeader>
        <CardHeaderAvatar>
            <MudAvatar Color="Color.Success">
                <MudIcon Icon="@Icons.Material.Filled.Check"></MudIcon>
            </MudAvatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText>Pass</MudText>
            <MudText Typo="Typo.h5">@Summary</MudText>
        </CardHeaderContent>
    </MudCardHeader>
</MudCard>


@code {
    [Parameter]
    public string Summary { get; set; } = default!;
}
