@using Smlp.Shared.Selections.SelectionTOEFLs.Queries
@using Syncfusion.Blazor.Charts
<MudCard>
    <MudCardContent>
        <div class="control-section" align='center'>
            <SfChart Title="Highest vs Lowest TOEFL Test" Width="@Width" Theme="Theme.Fluent">
                <ChartEvents OnLegendItemRender="LegendEvent"></ChartEvents>
                <ChartArea><ChartAreaBorder Width="0"></ChartAreaBorder></ChartArea>
                <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category" Interval="1" LabelIntersectAction="@Label" LabelRotation="@Rotation">
                    <ChartAxisMajorGridLines Width="0"></ChartAxisMajorGridLines>
                    <ChartAxisMajorTickLines Width="0"></ChartAxisMajorTickLines>
                </ChartPrimaryXAxis>
                <ChartPrimaryYAxis Title="" Maximum="30" Interval="10">
                    <ChartAxisMajorTickLines Width="0"></ChartAxisMajorTickLines>
                    <ChartAxisLineStyle Width="0"></ChartAxisLineStyle>
                </ChartPrimaryYAxis>
                <ChartSeriesCollection>
                    <ChartSeries TooltipMappingName="MappingName" DataSource="@getSelectionTOEFLHihgestChartResponse" PointColorMapping="HighestColor" XName="Label" YName="HighestScore" Name="Highest" ColumnSpacing="0.1" Type="ChartSeriesType.Column">
                        <ChartMarker>
                            <ChartDataLabel Visible="false" Position="Syncfusion.Blazor.Charts.LabelPosition.Top">
                                <ChartDataLabelFont FontWeight="600" Color="#ffffff"></ChartDataLabelFont>
                            </ChartDataLabel>
                        </ChartMarker>
                    </ChartSeries>
                    <ChartSeries TooltipMappingName="MappingName" DataSource="@getSelectionTOEFLHihgestChartResponse" PointColorMapping="LowestColor" XName="Label" YName="LowestScore" Name="Lowest" ColumnSpacing="0.1" Type="ChartSeriesType.Column">
                        <ChartMarker>
                            <ChartDataLabel Visible="false" Position="Syncfusion.Blazor.Charts.LabelPosition.Top">
                                <ChartDataLabelFont FontWeight="600" Color="#ffffff"></ChartDataLabelFont>
                            </ChartDataLabel>
                        </ChartMarker>
                    </ChartSeries>
                </ChartSeriesCollection>
                <ChartLegendSettings Visible="true" EnableHighlight="true"></ChartLegendSettings>
                <ChartTooltipSettings Header="<b>${point.tooltip}</b>" Enable="true" Shared="true"></ChartTooltipSettings>
            </SfChart>
        </div>
        </MudCardContent>
        </MudCard>

@code{
    [Parameter]
    public List<GetSelectionTOEFLHihgestChartResponse>? getSelectionTOEFLHihgestChartResponse { get; set; }
    public string Width { get; set; } = "90%";
    public double Rotation { get; set; } = 0;
    public LabelIntersectAction Label { get; set; } = LabelIntersectAction.Trim;
    public void LegendEvent(LegendRenderEventArgs args)
    {
        if (args.Text == "Highest")
        {
            args.Fill = "#0dd6d6";
        }
        else
        {
            args.Fill = "#0092e0";
        }
     
    }
}
