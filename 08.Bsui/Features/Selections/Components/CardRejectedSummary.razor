<MudCard>
    <MudCardHeader>
        <CardHeaderAvatar>
            <MudAvatar Color="Color.Error">
                <MudIcon Icon="@Icons.Material.Filled.Close"></MudIcon>
            </MudAvatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText>Rejecte</MudText>
            <MudText Typo="Typo.h5">@Summary</MudText>
            </CardHeaderContent>
        </MudCardHeader>
    </MudCard>

    @code {
    [Parameter]
    public string Summary { get; set; } = default!;
}
