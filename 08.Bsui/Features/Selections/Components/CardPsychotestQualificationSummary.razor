@using Smlp.Shared.Selections.SelectionPsychotests.Queries
@using Syncfusion.Blazor.Charts
<MudCard>
    <MudCardContent>
        <div  class="control-section" align='center'>
    <div class="control-section">
        <SfAccumulationChart EnableBorderOnMouseMove="false" Title="Psychotest Qualification" EnableAnimation="true" Theme="Theme.Fluent">
                    <AccumulationChartTooltipSettings Header="" Format="<b>${point.x}</b><br>Psychotest Qualification: <b>${point.y}%</b>" Enable="true"></AccumulationChartTooltipSettings>
            <AccumulationChartLegendSettings Visible="true"></AccumulationChartLegendSettings>
            <AccumulationChartSeriesCollection>
                        <AccumulationChartSeries DataSource="@getSelectionPsychotestQualificationChartResponse" PointColorMapping="Color" XName="Label" YName="Value" Radius="@Radius" Name="Label" StartAngle="@StartAngle"
                                         InnerRadius="0%" ExplodeIndex="0" Explode="true" ExplodeOffset="@ExplodeRadius">
                    <AccumulationDataLabelSettings Visible="true" Name="DataLabelMappingName" Position="AccumulationLabelPosition.Inside">
                        <AccumulationChartDataLabelFont Size=@Size FontWeight="600"></AccumulationChartDataLabelFont>
                        <AccumulationChartConnector Length=@ConnectorLength Type="ConnectorType.Curve"></AccumulationChartConnector>
                    </AccumulationDataLabelSettings>
                </AccumulationChartSeries>
            </AccumulationChartSeriesCollection>
        </SfAccumulationChart>
    </div>
</div>
    </MudCardContent>
</MudCard>
@code {
    [Parameter]
    public List<GetSelectionPsychotestQualificationChartResponse>? getSelectionPsychotestQualificationChartResponse { get; set; }
    public string ExplodeRadius = "10%";
    public string Radius { get; set; } = "60%";
    public string ConnectorLength { get; set; } = "20px";
    public int StartAngle = 30;
    public string Size { get; set; } = "12px";

}
