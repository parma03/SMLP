@page "/Selection/CreateSK/Edit/{Id:guid}"
@page "/Selection/CreateSK/Edit/{Batch:int}/{Year:int}"
@using Smlp.Bsui.Features.Selections.CreateSK.Components

<ErrorViewer Error="_error" />
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Drafting SK">
        <DraftingSK Id="@Id" Batch="@Batch" Year="@Year"></DraftingSK>
    </MudTabPanel>
    <MudTabPanel Text="Drafting SP Mentor">
        <DraftingSP Id="@Id" Batch="@Batch" Year="@Year"></DraftingSP>
    </MudTabPanel>
</MudTabs>
