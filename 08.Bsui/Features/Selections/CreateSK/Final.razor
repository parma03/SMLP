@page "/Selection/CreateSK/Final/{Id:guid}"
@page "/Selection/CreateSK/Final/{Batch:int}/{Year:int}"
@using Smlp.Bsui.Features.Selections.CreateSK.Components
@using System.Security.Claims

<ErrorViewer Error="_error" />
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Final SK">
        <DraftingSKFinal Id="@Id" Batch="@Batch" Year="@Year" Type="Final"></DraftingSKFinal>
    </MudTabPanel>
    <MudTabPanel Text="Final SP Mentor">
        <DraftingSPFinal Id="@Id" Batch="@Batch" Year="@Year" Type="Final"></DraftingSPFinal>
    </MudTabPanel>
</MudTabs>

@code {
    [CascadingParameter]
    protected Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected ClaimsPrincipal _user = default!;
    protected ErrorResponse? _error;
    protected bool _isLoadingDialog = false;

    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public int Batch { get; set; }

    [Parameter]
    public int Year { get; set; }
}
