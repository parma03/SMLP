@page "/Selection/BeritaAcara/{Type}/{Batch:int}/{Year:int}"
@using Psmp.Bsui.Features.Selections.BeritaAcara.Components

<ErrorViewer Error="_error" />
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>

@if (Type == "Add")
{
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
        <MudTabPanel Text="Drafting Berita Acara">
            <DraftingBeritaAcara Type="@Type" Batch="@Batch" Year="@Year"></DraftingBeritaAcara>
        </MudTabPanel>
    </MudTabs>
}
else if (Type == "Final")
{
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
        <MudTabPanel Text="Final Berita Acara">
            <FinalBeritaAcara Type="@Type" Batch="@Batch" Year="@Year"></FinalBeritaAcara>
        </MudTabPanel>
    </MudTabs>
}
else
{
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
        <MudTabPanel Text="Drafting Berita Acara">
            <DraftingBeritaAcara Type="@Type" Batch="@Batch" Year="@Year"></DraftingBeritaAcara>
        </MudTabPanel>
        <MudTabPanel Text="Final Berita Acara">
            <FinalBeritaAcara Type="@Type" Batch="@Batch" Year="@Year"></FinalBeritaAcara>
        </MudTabPanel>
    </MudTabs>
}
