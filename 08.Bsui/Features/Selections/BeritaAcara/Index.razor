@using Psmp.Base.Scholarships.Enums
@using Psmp.Bsui.Features.Scholarships.Components
@using Psmp.Bsui.Features.Selections.Components
@using Psmp.Bsui.Features.Selections.BeritaAcara.Components
@using Psmp.Shared.Selections.BeritaAcara.Queries
<ErrorViewer Error="_error" />
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>

@if (_isLoading)
{
    <Loading IsVisible="_isLoading" />
}
else
{
     <MudGrid Spacing="2">
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12">
                <MudText Typo="Typo.body2" HtmlTag="h3">Berita Acara Filter</MudText>
            </MudItem>
        </MudGrid>
		<MudGrid Spacing="2" Class="mb-4">
			<MudItem xs="2">
				<MudText>Categories</MudText>
				<SfDropDownList ID="ddlSelectionCategory" TValue="int" TItem="DropdownItemResponse" DataSource="@_dropdownCategories" Placeholder="All Category">
					<DropDownListFieldSettings Text="Description" Value="Id" />
					<DropDownListEvents TItem="DropdownItemResponse" TValue="int" ValueChange="OnChangeCategory" />
				</SfDropDownList>
			</MudItem>
			<MudItem xs="2">
				<MudText>H/ SH/ AP&P</MudText>
				<SfDropDownList ID="ddlSelectionCompaynGroup" TValue="int?" TItem="DropdownItemResponse" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_dropdownCompanyGroups" Placeholder="All H/SH/AP&P">
					<DropDownListFieldSettings Text="Description" Value="Id" />
					<DropDownListEvents TItem="DropdownItemResponse" TValue="int?" ValueChange="OnChangeCompanyGroupAsync" />
				</SfDropDownList>
			</MudItem>
			<MudItem xs="2">
				<MudText>Company</MudText>
				<SfDropDownList ID="ddlSelectionCompay" TValue="string?" TItem="DropdownItemStringResponse" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_dropdownComapies" Placeholder="All Company">
					<DropDownListFieldSettings Text="Description" Value="Id" />
					<DropDownListEvents TItem="DropdownItemStringResponse" TValue="string?" ValueChange="OnChangeCompanyAsync" />
				</SfDropDownList>
			</MudItem>
			<MudItem xs="2">
				<MudText>Code</MudText>
				<SfDropDownList ID="ddlSsholarshipCodes" TValue="Guid?" TItem="DropdownItemGuidResponse" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_dropdownCodes" Placeholder="All Code">
					<DropDownListFieldSettings Text="Description" Value="Id" />
					<DropDownListEvents TItem="DropdownItemGuidResponse" TValue="Guid?" ValueChange="OnChangeCodeAsync" />
				</SfDropDownList>
			</MudItem>
			<MudItem xs="2">
				<MudText>Batch</MudText>
				<SfDropDownList ID="ddlScholarshipBatch" TValue="int?" TItem="DropdownItemResponse" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" Placeholder="All Batch"
								DataSource="@_dropdownBatchs">
					<DropDownListFieldSettings Text="Description" Value="Id" />
					<DropDownListEvents TItem="DropdownItemResponse" TValue="int?" ValueChange="OnChangeBatchAsync" />
				</SfDropDownList>
			</MudItem>
			<MudItem xs="2">
				<MudText>Year</MudText>
				<SfDropDownList ID="ddlSelectionYear" TValue="int?" TItem="DropdownItemResponse" DataSource="@_dropdownYear" Placeholder="All Year" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
					<DropDownListFieldSettings Text="Description" Value="Id" />
					<DropDownListEvents TItem="DropdownItemResponse" TValue="int?" ValueChange="OnChangeYear" />
				</SfDropDownList>
			</MudItem>
		</MudGrid>
		<MudGrid Spacing="2" Class="mb-4">
			<MudItem xs="12">
				<MudText Typo="Typo.body2" HtmlTag="h3">Applicant Filter</MudText>
			</MudItem>
			<MudItem xs="3">
				<MudText>H/ SH/ AP&P</MudText>
				<SfDropDownList ID="ddlSelectionCompaynGroupApplicantFilter" TValue="int?" TItem="DropdownItemResponse" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_dropdownCompanyGroupsApplicantFilter" Placeholder="All H/SH/AP&P">
					<DropDownListFieldSettings Text="Description" Value="Id" />
					<DropDownListEvents TItem="DropdownItemResponse" TValue="int?" ValueChange="OnChangeCompanyGroupApplicantFilterAsync" />
				</SfDropDownList>
			</MudItem>
			<MudItem xs="3">
				<MudText>Company</MudText>
				<SfDropDownList ID="ddlSelectionCompayApplicantFilter" TValue="string?" TItem="DropdownItemStringResponse" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_dropdownComapiesApplicantFilter" Placeholder="All Company">
					<DropDownListFieldSettings Text="Description" Value="Id" />
					<DropDownListEvents TItem="DropdownItemStringResponse" TValue="string?" ValueChange="OnChangeCompanyApplicantFilterAsync" />
				</SfDropDownList>
			</MudItem>
		</MudGrid>

        <MudGrid Class="mb-1">
            <MudItem xs="12">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudGrid AlignItems="center">
                        <!-- Card pertama -->
                        <MudItem xs="3" Class="d-flex justify-center">
                            <CardCompleted Summary=@_completeSummary></CardCompleted>
                        </MudItem>

                        <!-- Divider Vertikal -->
                        <MudItem xs="1" Class="d-flex justify-center">
                            <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                        </MudItem>

                        <!-- Card kedua -->
                        <MudItem xs="3" Class="d-flex justify-center">
                            <CardWaitingForApprovalSummary Summary=@_waitingSummary></CardWaitingForApprovalSummary>
                        </MudItem>

                        <!-- Divider Vertikal -->
                        <MudItem xs="1" Class="d-flex justify-center">
                            <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                        </MudItem>

                        <!-- Card ketiga -->
                        <MudItem xs="3" Class="d-flex justify-center">
                            <CardRejected Summary=@_rejectedSummary></CardRejected>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mb-2">
            <MudItem xs="12">
                <MudCard>
                    <MudCardContent>
                        @if (_isLoadingData)
                        {
                            <LoadingLinear IsVisible="_isLoadingData" />
                        }
                        else
                        {
                            <MudItem xs="12">
                                <CardTitle Title="List of Berita Acara" />
                            </MudItem>
                            <MudItem xs="12" Class="mt-4">
                                <MudGrid Class="d-flex flex-wrap justify-start align-center">
                                    <MudItem Class="ml-1 pa-2 ma-0">
                                        <SfButton OnClick="OnClickAddBeritaAcaraAsync" Content="Create Draft of Berita Acara" IconCss="e-icons e-circle-add" CssClass="" Style="background: linear-gradient(to right, #4279db, #1c4185); color: white;"></SfButton>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <br />
                            <SfGrid DataSource="@_selectionBeritaAcara" Toolbar="@(new List<string>() { "Search" })" AllowFiltering="true" AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true">
                                <GridPageSettings PageCount="5" PageSize="10" PageSizes="@(new string[] { "10", "15", "20", "All" })"></GridPageSettings>
                                <GridEvents CommandClicked="OnCommandClickedBeritaAcara" TValue="GetSelectionBeritaAcaraByBatchQueryResponse"></GridEvents>
                                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                                <GridColumns>
                                    <GridColumn Field=@nameof(GetSelectionBeritaAcaraByBatchQueryResponse.Id) IsPrimaryKey="true" Visible="false"></GridColumn>
                                    <GridColumn Field=@nameof(GetSelectionBeritaAcaraByBatchQueryResponse.Code) Width="200" HeaderText="Code"></GridColumn>
                                    <GridColumn Field=@nameof(GetSelectionBeritaAcaraByBatchQueryResponse.SelectionType) Width="100" HeaderText="Type"></GridColumn>
                                    <GridColumn Field=@nameof(GetSelectionBeritaAcaraByBatchQueryResponse.Title) Width="200" HeaderText="Title"></GridColumn>
                                    <GridColumn Field=@nameof(GetSelectionBeritaAcaraByBatchQueryResponse.CompanyGroup) Width="200" HeaderText="H/SH/APS&P"></GridColumn>
                                    <GridColumn Width="150" HeaderText="Status" TextAlign="TextAlign.Center">
                                        <Template>
                                            @{
                                                var data = (context as GetSelectionBeritaAcaraByBatchQueryResponse);
                                                if (data!.Status == BeritaAcaraStatus.Completed)
                                                {
                                                    <SfChip CssClass="justify-center">
                                                        <ChipItems>
                                                            <ChipItem Text="@data.Status.GetDescription()" CssClass="e-success"></ChipItem>
                                                        </ChipItems>
                                                    </SfChip>
                                                }
                                                else if (data!.Status == BeritaAcaraStatus.Rejected)
                                                {
                                                    <SfChip CssClass="justify-center">
                                                        <ChipItems>
                                                            <ChipItem Text="@data.Status.GetDescription()" CssClass="e-danger"></ChipItem>
                                                        </ChipItems>
                                                    </SfChip>
                                                }
                                                else
                                                {
                                                    <SfChip CssClass="justify-center">
                                                        <ChipItems>
                                                            <ChipItem Text="@data.Status.ToString().SplitWords()" CssClass="e-info"></ChipItem>
                                                        </ChipItems>
                                                    </SfChip>
                                                }
                                            }
                                        </Template>
                                    </GridColumn>
                                    <GridColumn HeaderText="Action" Width="150" TextAlign="TextAlign.Center" HeaderTextAlign="TextAlign.Center" Visible="true">
                                        <GridCommandColumns>
                                            <GridCommandColumn Title="Edit" Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-eye", CssClass="e-flat" })"></GridCommandColumn>
                                        </GridCommandColumns>
                                    </GridColumn>
                                </GridColumns>
                            </SfGrid>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mb-2">
            <MudItem xs="12">
                <MudCard>
                    <MudCardContent>
                        @if (_isLoadingData)
                        {
                            <LoadingLinear IsVisible="_isLoadingData" />
                        }
                        else
                        {
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudGrid Spacing="2" Class="mb-1">
                                        <MudItem xs="12" md="6">
                                            <MudGrid Class="d-flex align-center justify-start">
                                                <MudItem>
                                                    <MudText Typo="Typo.h6" Class="ms-0">List of Applicant</MudText>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudGrid Class="d-flex flex-wrap align-center justify-start justify-md-end">
                                                <MudItem>
                                                    <SfProgressButton ID="zoomOutButton" Content="Export to Excel" @onclick="ExportExcel" EnableProgress="true" CssClass="fw-bold" IconCss="e-icons e-download" Style="background: linear-gradient(to right, #4279db, #1c4185); color: white;">
                                                        <ProgressButtonSpinSettings Position="SpinPosition.Center"></ProgressButtonSpinSettings>
                                                        <ProgressButtonAnimationSettings Effect="Syncfusion.Blazor.SplitButtons.AnimationEffect.ZoomOut"></ProgressButtonAnimationSettings>
                                                    </SfProgressButton>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    </MudGrid>
                                    <SfGrid @ref="Grid" DataSource="@_selectionApplicantBeritaAcara" Toolbar="@(new List<string>() { "Search" })" AllowExcelExport="true" AllowFiltering="true" AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true">
                                        <GridPageSettings PageCount="5" PageSize="10" PageSizes="@(new string[] { "10", "15", "20", "All" })"></GridPageSettings>
                                        <GridEvents ExcelQueryCellInfoEvent="ExcelQueryCellInfoHandler" OnToolbarClick="ToolbarClickHandler" CommandClicked="OnCommandClicked" TValue="GetSelectionApplicantBeritaAcaraQueryResponse"></GridEvents>
                                        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                                        <GridColumns>
                                            <GridColumn Field=@nameof(GetSelectionApplicantBeritaAcaraQueryResponse.Id) IsPrimaryKey="true" Visible="false"></GridColumn>
                                            <GridColumn Field=@nameof(GetSelectionApplicantBeritaAcaraQueryResponse.EmployeeNumber) Width="200" HeaderText="Employee Number"></GridColumn>
                                            <GridColumn Field=@nameof(GetSelectionApplicantBeritaAcaraQueryResponse.Name) Width="250"></GridColumn>
                                            <GridColumn Field=@nameof(GetSelectionApplicantBeritaAcaraQueryResponse.Position) Width="250"></GridColumn>
                                            <GridColumn Field=@nameof(GetSelectionApplicantBeritaAcaraQueryResponse.Code) Width="200"></GridColumn>
                                            <GridColumn Field=@nameof(GetSelectionApplicantBeritaAcaraQueryResponse.Faculty) Width="200"></GridColumn>
                                            <GridColumn Field=@nameof(GetSelectionApplicantBeritaAcaraQueryResponse.BussinesIssue) Width="200" HeaderText="Bussines Issue"></GridColumn>
                                            <GridColumn Field=@nameof(GetSelectionApplicantBeritaAcaraQueryResponse.CompanyName) Width="150" HeaderText="Company"></GridColumn>
                                            <GridColumn Field=@nameof(GetSelectionApplicantBeritaAcaraQueryResponse.Mentor) Width="150" HeaderText="Mentor 1"></GridColumn>
                                            <GridColumn Field=@nameof(GetSelectionApplicantBeritaAcaraQueryResponse.MentorName2) Width="150" HeaderText="Mentor 2"></GridColumn>
                                            <GridColumn Field=@nameof(GetSelectionApplicantBeritaAcaraQueryResponse.TOEFLScore) HeaderText="TOEFL" Width="150"></GridColumn>
                                            <GridColumn Field=@nameof(GetSelectionApplicantBeritaAcaraQueryResponse.QualificationStatus) HeaderText="Psychotest" Width="150"></GridColumn>
                                            <GridColumn Field=@nameof(GetSelectionApplicantBeritaAcaraQueryResponse.Status) Width="150" HeaderText="Status" TextAlign="TextAlign.Center">
                                                <Template>
                                                    @{
                                                        var data = (context as GetSelectionApplicantBeritaAcaraQueryResponse);
                                                        if (data!.Status == ApplicantStatus.Passed)
                                                        {
                                                            <SfChip CssClass="justify-center">
                                                                <ChipItems>
                                                                    <ChipItem Text="Pass" CssClass="e-success"></ChipItem>
                                                                </ChipItems>
                                                            </SfChip>
                                                        }
                                                        else if (data!.Status == ApplicantStatus.Failed || data!.Status == ApplicantStatus.Rejected)
                                                        {
                                                            <SfChip CssClass="justify-center">
                                                                <ChipItems>
                                                                    <ChipItem Text="@data.Status.GetDescription()" CssClass="e-danger"></ChipItem>
                                                                </ChipItems>
                                                            </SfChip>
                                                        }
                                                        else if (data!.Status == ApplicantStatus.Awaiting)
                                                        {
                                                            <SfChip CssClass="justify-center">
                                                                <ChipItems>
                                                                    <ChipItem Text="@data.Status.ToString()" CssClass="e-warning"></ChipItem>
                                                                </ChipItems>
                                                            </SfChip>
                                                        }
                                                        else
                                                        {
                                                            <SfChip CssClass="justify-center">
                                                                <ChipItems>
                                                                    <ChipItem Text="@data.Status.ToString().SplitWords()" CssClass="e-info"></ChipItem>
                                                                </ChipItems>
                                                            </SfChip>
                                                        }
                                                    }
                                                </Template>
                                            </GridColumn>
                                            <GridColumn HeaderText="Action" Width="150" TextAlign="TextAlign.Center" HeaderTextAlign="TextAlign.Center" Visible="true">
                                                <GridCommandColumns>
                                                    <GridCommandColumn Title="Edit" Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-edit", CssClass="e-flat" })"></GridCommandColumn>
                                                </GridCommandColumns>
                                            </GridColumn>
                                        </GridColumns>
                                    </SfGrid>
                                </MudItem>
                            </MudGrid>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudGrid>
}
