@using Psmp.Shared.Selections.SelectionTOEFLs.Commands.Create
@using Psmp.Shared.Selections.SelectionTOEFLs.Queries
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups

<style>
    .e-dialog {
        z-index: 10000 !important;
    }
</style>

<SfDialog Target="#target" AllowDragging="true" Width="60%" @bind-Visible=Visibility ShowCloseIcon="true">
    <DialogTemplates>
        <Header>
            <MudText Typo="Typo.h5">@Title</MudText>
        </Header>
        <Content>
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="4">
                            <MudText>Schedule Test <span style="color:red;">*</span></MudText>
                        </MudItem>
                        <MudItem xs="8">
                            <SfDateRangePicker ID="dTestDateToefl" Format="dd.MM.yyyy" TValue="DateTimeOffset?" StartDate="request!.ScheduleStart" EndDate="request!.ScheduleEnd" Placeholder="Choose a Date" Min="@DateTime.UtcNow">
                                <DateRangePickerEvents TValue="DateTimeOffset?" ValueChange="OnChangeValueScheduleDate"></DateRangePickerEvents>
                            </SfDateRangePicker>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="4">
                            <MudText>Session per Day</MudText>
                        </MudItem>
                        <MudItem xs="8">
                            <SfNumericTextBox ID="txtDailySessionToefl" Placeholder="Input Daily Session" Format="n0" Max="2" @bind-Value="@sessionValue" Enabled="false"></SfNumericTextBox>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="6">
                            <MudGrid>
                                <MudItem xs="8">
                                    <MudText>Session 1 Start <span style="color:red;">*</span></MudText>
                                </MudItem>
                                <MudItem xs="4">
                                    @* <SfTimePicker TValue="TimeOnly" Step=60 Format="HH:mm" ShowClearButton="true" FullScreen="true" @bind-Value="request!.Session1Start"></SfTimePicker> *@
                                    <SfTimePicker TValue="TimeOnly" Step=60 Format="HH:mm" ShowClearButton="true" FullScreen="true"
                                                  @bind-Value="request!.Session1Start" ValueChange="OnSession1StartChange">
                                    </SfTimePicker>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                        <MudItem xs="6">
                            <MudGrid>
                                <MudItem xs="3">
                                </MudItem>
                                <MudItem xs="5">
                                    <MudText>Session 1 End <span style="color:red;">*</span></MudText>
                                </MudItem>
                                <MudItem xs="4">
                                    @* <SfTimePicker TValue="TimeOnly" Step=60 Format="HH:mm" ShowClearButton="true" FullScreen="true" @bind-Value="request!.Session1End"></SfTimePicker> *@
                                    <SfTimePicker TValue="TimeOnly" Step=60 Format="HH:mm" ShowClearButton="true" FullScreen="true"
                                                  @bind-Value="request!.Session1End"
                                                  ValueChange="OnSession1EndChange"
                                                  Min="@ConvertTimeOnlyToDateTime(request!.Session1Start)">
                                    </SfTimePicker>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="6">
                            <MudGrid>
                                <MudItem xs="8">
                                    <MudText>Session 2 Start <span style="color:red;">*</span></MudText>
                                </MudItem>
                                <MudItem xs="4">
                                    <SfTimePicker TValue="TimeOnly" Step=60 Format="HH:mm" ShowClearButton="true" FullScreen="true"
                                                  @bind-Value="request!.Session2Start"
                                                  Min="@ConvertTimeOnlyToDateTime(request!.Session1End)">
                                    </SfTimePicker>
                                    @* <SfTimePicker TValue="TimeOnly" Step=60 Format="HH:mm" ShowClearButton="true" FullScreen="true" @bind-Value="request!.Session2Start"></SfTimePicker> *@
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                        <MudItem xs="6">
                            <MudGrid>
                                <MudItem xs="3">
                                </MudItem>
                                <MudItem xs="5">
                                    <MudText>Session 2 End <span style="color:red;">*</span></MudText>
                                </MudItem>
                                <MudItem xs="4">
                                    @* <SfTimePicker TValue="TimeOnly" Step=60 Format="HH:mm" ShowClearButton="true" FullScreen="true" @bind-Value="request!.Session2End"></SfTimePicker> *@
                                    <SfTimePicker TValue="TimeOnly" Step=60 Format="HH:mm" ShowClearButton="true" FullScreen="true"
                                                  @bind-Value="request!.Session2End"
                                                  Min="@ConvertTimeOnlyToDateTime(request!.Session2Start)">
                                    </SfTimePicker>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="4">
                            <MudText>Applicants per Session <span style="color:red;">*</span></MudText>
                        </MudItem>
                        <MudItem xs="8">
                            <SfNumericTextBox ID="txtDailyApplicantsToefl" Placeholder="Input Daily Applicants" Format="n0" @bind-Value="request!.Applicants"></SfNumericTextBox>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        </Content>
        <FooterTemplate>
            <SfButton Content="Cancel" CssClass="e-outline e-danger" IconCss="e-icons e-close" OnClick="OnClickNo"></SfButton>
            <SfButton Content="Save" CssClass="e-success" IconCss="e-icons e-circle-check" OnClick="OnClickYes"></SfButton>
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
    <DialogAnimationSettings Effect="DialogEffect.Zoom"></DialogAnimationSettings>
</SfDialog>

@code {
    [Parameter]
    public bool Visibility { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public EventCallback DialogOpen { get; set; }

    [Parameter]
    public EventCallback DialogClose { get; set; }

    [Parameter]
    public EventCallback OnClickNo { get; set; }

    [Parameter]
    public EventCallback OnClickYes { get; set; }

    [Parameter]
    public CreateSelectionTOEFLScheduleRequest? request { get; set; }

    [Parameter]
    public EventCallback<RangePickerEventArgs<DateTimeOffset?>> OnChangeValueScheduleDate { get; set; }

    private int sessionValue { get; set; } = 2;

    private void OnSession1StartChange(TimeOnly newStartTime)
    {
        if (request!.Session1End < newStartTime)
        {
            request!.Session1End = newStartTime;
        }
    }

    private void OnSession1EndChange(TimeOnly newEndTime)
    {
        // Jika Session2Start lebih kecil dari Session1End, atur ulang ke Session1End
        if (request!.Session2Start < newEndTime)
        {
            request!.Session2Start = newEndTime;
        }
    }

    private DateTime ConvertTimeOnlyToDateTime(TimeOnly time)
    {
        return DateTime.Today.Add(time.ToTimeSpan());
    }

}


<style>
    .e-chip-list {
        display: inline !important
    }

    .e-dlg-header, .e-dlg-header * {
        font-size: x-large;
        font-weight: bold;
    }
</style>
