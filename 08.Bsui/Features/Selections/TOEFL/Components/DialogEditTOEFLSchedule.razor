@using Psmp.Shared.Documents.Queries.GetDocuments
@using Psmp.Shared.Selections.SelectionTOEFLs.Commands.Create
@using Psmp.Shared.Selections.SelectionTOEFLs.Commands.Update
@using Psmp.Shared.Selections.SelectionTOEFLs.Queries
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups

<style>
    .e-dialog {
        z-index: 10000 !important;
    }
</style>

<SfDialog Target="#target" AllowDragging="true" Width="60%" @bind-Visible=Visibility ShowCloseIcon="true">
    <DialogTemplates>
        <Header>
            <MudText Typo="Typo.h5">@Title</MudText>
        </Header>
        <Content>
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudGrid>
                        <DialogEditTOEFLSchedule />
                        <MudItem xs="4">
                            <MudText>Name</MudText>
                        </MudItem>
                        <MudItem xs="8">
                            <SfTextBox ID="txtName" Placeholder="Input Name" @bind-Value="request!.Name" Enabled="false"></SfTextBox>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="4">
                            <MudText>Company</MudText>
                        </MudItem>
                        <MudItem xs="8">
                            <SfDropDownList ID="ddlCompanyAddTOEFL" TValue="string" TItem="GetCompanyQueryResponse" DataSource="@listCompany" @bind-Value="request!.CompanyCode" Enabled="false"
                                            AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" Placeholder="Select Company">
                                <DropDownListFieldSettings Text="Name" Value="Code" />
                            </SfDropDownList>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="4">
                            <MudText>Employee Number</MudText>
                        </MudItem>
                        <MudItem xs="8">
                            <SfTextBox ID="txtEmployeeNo" Placeholder="Input Employee Number" @bind-Value="request!.EmployeeNumber" Enabled="false"></SfTextBox>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="4">
                            <MudText>Email</MudText>
                        </MudItem>
                        <MudItem xs="8">
                            <SfTextBox ID="txtEmail" Placeholder="Input Email" @bind-Value="request!.Email" Enabled="false"></SfTextBox>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="4">
                            <MudText>TOEFL Score <span style="color:red;">*</span>
                                <br />
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="font-style: italic; font-size: 0.8rem;" Class="mb-2">
                                    <b>(Minimum Score: @toeflScorePosting)</b>
                                </MudText>
                            </MudText>
                        </MudItem>
                        <MudItem xs="8">
                            <SfNumericTextBox ID="txtToeflScore" Placeholder="Input TOEFL Score" Format="n0" Value="request!.Score" ValueChanged="@((float val) => OnScoreChanged(val))" Enabled="@IsEnabled"></SfNumericTextBox>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="4">
                            <MudText>Test Date <span style="color:red;">*</span></MudText>
                        </MudItem>
                        <MudItem xs="8">
                            <SfDatePicker TValue="DateOnly?" Format="dd.MM.yyyy" Placeholder="Choose a Date" FullScreen="true" ShowClearButton="true" @bind-Value="TestDateValue" Enabled="@IsEnabled">
                                <DatePickerEvents TValue="DateOnly?" ValueChange="OnTestDateChanged"></DatePickerEvents>
                            </SfDatePicker>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="4">
                            <MudText>Expired Date <span style="color:red;">*</span></MudText>
                        </MudItem>
                        <MudItem xs="8">
                            <SfDatePicker TValue="DateOnly?" Format="dd.MM.yyyy" Placeholder="Choose a Date" FullScreen="true" ShowClearButton="true" @bind-Value="request!.Expired" Enabled="@IsEnabled" Min="@(request?.TestDate.HasValue == true ? request.TestDate.Value.ToDateTime(TimeOnly.MinValue) : DateTime.MinValue)"></SfDatePicker>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="4">
                            <MudText>Status <span style="color:red;">*</span></MudText>
                        </MudItem>
                        <MudItem xs="8">
							<SfDropDownList TItem="GetSelectionTOEFLStatusListResponse" TValue="ApplicantStatus" Width="300px" Placeholder="Select Status" DataSource="@listStatus" @bind-Value="@(request!.Status)" FloatLabelType="FloatLabelType.Always" Enabled="false">
                                <DropDownListFieldSettings Value="Value" Text="Text"></DropDownListFieldSettings>
                            </SfDropDownList>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                @if (@IsEnabledSKStatus)
                {
                    <MudItem xs="12">
                        @* <MudText>TOEFL Certificate (.pdf) (Max. 5 Mb) <span style="color:red;">*</span></MudText> *@
                        <MudText>TOEFL Certificate (.pdf) <span style="color:red;">*</span></MudText>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="font-style: italic; font-size: 0.8rem;" Class="mb-2">
                            <b>(Maximum Size 5 Mb)</b>
                        </MudText>
                        <MudGrid>
                            <MudItem xs="12">
                                <SfUploader ID="uploaderToeflCertificate" AutoUpload="true" SequentialUpload="false" AllowMultiple="false" Enabled="@IsEnabledSKStatus" MaxFileSize="@maximumFileSizeInBytes"
                                            AllowedExtensions=".pdf">
                                    <UploaderEvents ValueChange="ValueChangeToeflCertificate" OnRemove="OnRemoveToeflCertificate"></UploaderEvents>
                                </SfUploader>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                }
                <br />

                @if (listDocument!.Count() > 0)
                {
                    <MudItem xs="12">
                        <SfGrid DataSource="@listDocument"
                                AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true">
                            <GridPageSettings PageCount="8" PageSize="8" PageSizes="@(new string[] { "8", "10", "15", "20", "All" })"></GridPageSettings>
                            <GridEvents CommandClicked="OnCommandClicked" TValue="GetDocumentsDocument"></GridEvents>
                            <GridColumns>
                                <GridColumn Field=@nameof(GetDocumentsDocument.FileName) HeaderText="Filename" HeaderTextAlign="TextAlign.Center" TextAlign="TextAlign.Left"> </GridColumn>
                                <GridColumn HeaderText="Action" Width="80" TextAlign="TextAlign.Center">
                                    <GridCommandColumns>
                                        <GridCommandColumn ID="btnDownload" Title="Download" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-download", CssClass="e-flat" })"> </GridCommandColumn>
                                        @if (IsEnabledSKStatus)
                                        {
                                            <GridCommandColumn ID="btnDelete" Title="Delete" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-delete", CssClass="e-flat" })"> </GridCommandColumn>
                                        }
                                    </GridCommandColumns>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </MudItem>
                }
            </MudGrid>
        </Content>
        <FooterTemplate>
            <SfButton Content="Cancel" CssClass="e-outline e-danger" IconCss="e-icons e-close" OnClick="OnClickNo"></SfButton>
            @if (IsEnabledSKStatus == true)
            {
                <SfButton Content="Save" CssClass="e-success" IconCss="e-icons e-circle-check" OnClick="OnClickYes"></SfButton>
            }
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
    <DialogAnimationSettings Effect="DialogEffect.Zoom"></DialogAnimationSettings>
</SfDialog>

@code {
	[Parameter]
	public bool Visibility { get; set; }

	[Parameter]
	public string? Title { get; set; }

	[Parameter]
	public EventCallback DialogOpen { get; set; }

	[Parameter]
	public EventCallback DialogClose { get; set; }

	[Parameter]
	public EventCallback OnClickNo { get; set; }

	[Parameter]
	public EventCallback OnClickYes { get; set; }

	[Parameter]
	public List<GetCompanyQueryResponse>? listCompany { get; set; }

	[Parameter]
	public UpdateSelectionTOEFLRequest? request { get; set; }

	[Parameter]
	public IEnumerable<GetSelectionTOEFLStatusListResponse>? statusListResponses { get; set; }

	[Parameter]
	public EventCallback<RemovingEventArgs> OnRemoveToeflCertificate { get; set; }

	[Parameter]
	public EventCallback<UploadChangeEventArgs> ValueChangeToeflCertificate { get; set; }

	[Parameter]
	public EventCallback<CommandClickEventArgs<GetDocumentsDocument>> OnCommandClicked { get; set; }

	[Parameter]
	public List<GetDocumentsDocument>? listDocument { get; set; }

	[Parameter]
	public bool IsEnabled { get; set; }

	[Parameter]
	public bool IsEnabledSKStatus { get; set; }

	[Parameter]
	public long maximumFileSizeInBytes { get; set; }

	[Parameter]
	public float toeflScorePosting { get; set; }

	public List<GetSelectionTOEFLStatusListResponse> listStatus = new();
	private float ScoreValue
	{
		get => request?.Score ?? 0;
		set
		{
			if (request == null) return;
			request.Score = value;
		}
	}

	private void OnScoreChanged(float newScore)
	{
		if (request == null) return;
		listStatus = statusListResponses!.ToList();
		request.Score = newScore;
        request.Status = newScore >= toeflScorePosting
            ? ApplicantStatus.Passed
            : ApplicantStatus.Failed;

        StateHasChanged();
    }

    private DateOnly? TestDateValue
    {
        get => request?.TestDate;
        set
        {
            if (request == null) return;
            request.TestDate = value;
        }
    }

    private void OnTestDateChanged(Syncfusion.Blazor.Calendars.ChangedEventArgs<DateOnly?> args)
    {
        if (request == null || !args.Value.HasValue) return;

        request.Expired = args.Value.Value.AddYears(2);

        StateHasChanged();
    }
}
<style>
    .e-dlg-header, .e-dlg-header * {
        font-size: x-large;
        font-weight: bold;
    }

    .e-dialog .e-dlg-content {
        padding: 0 20px;
        border-radius: 8px;
    }
</style>
