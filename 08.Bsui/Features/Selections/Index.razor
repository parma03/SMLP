@page "/Selection"
@page "/Selection/{Category}"
<BrowserTabTitle>@DisplayTextFor.CompanySelection</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>
@if (Category == "Close")
{
    <AuthorizeView>
        <Authorized>
            @if (context.User.HasPermission(Permissions.Psmp_SelectionDecree_Approve))
            {
                <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                    <MudTabPanel Text="@DisplayTextFor.Overview">
                        <Psmp.Bsui.Features.Selections.Overview.Index Type="0"></Psmp.Bsui.Features.Selections.Overview.Index>
                    </MudTabPanel>
                    <MudTabPanel Text="@DisplayTextFor.TalentReviewMeetingI">
                        <Psmp.Bsui.Features.Selections.TalentReview1st.Index Type="0"></Psmp.Bsui.Features.Selections.TalentReview1st.Index>
                    </MudTabPanel>
                </MudTabs>
            }
            else
            {
                <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                    <MudTabPanel Text="@DisplayTextFor.Overview">
                        <Psmp.Bsui.Features.Selections.Overview.Index Type="0"></Psmp.Bsui.Features.Selections.Overview.Index>
                    </MudTabPanel>
                    <MudTabPanel Text="@DisplayTextFor.TalentReviewMeetingI">
                        <Psmp.Bsui.Features.Selections.TalentReview1st.Index Type="0"></Psmp.Bsui.Features.Selections.TalentReview1st.Index>
                    </MudTabPanel>
                    <MudTabPanel Text="@DisplayTextFor.TOEFL">
                        <Psmp.Bsui.Features.Selections.TOEFL.Index Type="0"></Psmp.Bsui.Features.Selections.TOEFL.Index>
                    </MudTabPanel>
                    <MudTabPanel Text="@DisplayTextFor.Psychotest">
                        <Psmp.Bsui.Features.Selections.Psychotest.Index Type="0"></Psmp.Bsui.Features.Selections.Psychotest.Index>
                    </MudTabPanel>
                    <MudTabPanel Text="@DisplayTextFor.TalentReviewMeetingII">
                        <Psmp.Bsui.Features.Selections.TalentReview.Index Type="0"></Psmp.Bsui.Features.Selections.TalentReview.Index>
                    </MudTabPanel>
                    <MudTabPanel Text="@DisplayTextFor.BeritaAcara">
                        <Psmp.Bsui.Features.Selections.BeritaAcara.Index Type="0"></Psmp.Bsui.Features.Selections.BeritaAcara.Index>
                    </MudTabPanel>
                    <MudTabPanel Text="@DisplayTextFor.CreateSK">
                        <Psmp.Bsui.Features.Selections.CreateSK.Index Type="0"></Psmp.Bsui.Features.Selections.CreateSK.Index>
                    </MudTabPanel>
                </MudTabs>
            }
        </Authorized>
    </AuthorizeView>
}
else
{
    <AuthorizeView>
        <Authorized>
            @if (context.User.HasPermission(Permissions.Psmp_SelectionDecree_Approve))
            {
                <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                    <MudTabPanel Text="@DisplayTextFor.Overview">
                        <Psmp.Bsui.Features.Selections.Overview.Index Type="1"></Psmp.Bsui.Features.Selections.Overview.Index>
                    </MudTabPanel>
                    <MudTabPanel Text="@DisplayTextFor.CreateSK">
                        <Psmp.Bsui.Features.Selections.CreateSK.Index Type="1"></Psmp.Bsui.Features.Selections.CreateSK.Index>
                    </MudTabPanel>
                </MudTabs>
            }
            else
            {
                <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                    <MudTabPanel Text="@DisplayTextFor.Overview">
                        <Psmp.Bsui.Features.Selections.Overview.Index Type="1"></Psmp.Bsui.Features.Selections.Overview.Index>
                    </MudTabPanel>
                    <MudTabPanel Text="@DisplayTextFor.AdministrationSelection">
                        <Psmp.Bsui.Features.Selections.Administration.Index Type="1"></Psmp.Bsui.Features.Selections.Administration.Index>
                    </MudTabPanel>
                    <MudTabPanel Text="@DisplayTextFor.TOEFL">
                        <Psmp.Bsui.Features.Selections.TOEFL.Index Type="1"></Psmp.Bsui.Features.Selections.TOEFL.Index>
                    </MudTabPanel>
                    <MudTabPanel Text="@DisplayTextFor.Psychotest">
                        <Psmp.Bsui.Features.Selections.Psychotest.Index Type="1"></Psmp.Bsui.Features.Selections.Psychotest.Index>
                    </MudTabPanel>
                    <MudTabPanel Text="@DisplayTextFor.TalentReviewMeeting">
                        <Psmp.Bsui.Features.Selections.TalentReview.Index Type="1"></Psmp.Bsui.Features.Selections.TalentReview.Index>
                    </MudTabPanel>
                    <MudTabPanel Text="@DisplayTextFor.BeritaAcara">
                        <Psmp.Bsui.Features.Selections.BeritaAcara.Index Type="1"></Psmp.Bsui.Features.Selections.BeritaAcara.Index>
                    </MudTabPanel>
                    <MudTabPanel Text="@DisplayTextFor.CreateSK">
                        <Psmp.Bsui.Features.Selections.CreateSK.Index Type="1"></Psmp.Bsui.Features.Selections.CreateSK.Index>
                    </MudTabPanel>
                </MudTabs>
            }
        </Authorized>
    </AuthorizeView>
}

<style>
    .mud-tabs-panels {
        min-height: 500px;
    }
</style>
