@using Psmp.Shared.Documents.Queries.GetDocuments
@using Psmp.Shared.Selections.SelectionPsychotests.Commands.Create
@using Psmp.Shared.Selections.SelectionPsychotests.Queries
@using Psmp.Shared.Selections.SelectionTOEFLs.Commands.Create
@using Psmp.Shared.Selections.SelectionTOEFLs.Queries
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups

<SfDialog Width="60%" @bind-Visible=Visibility IsModal="true">
    <DialogTemplates>
        <Header>
            <MudText Typo="Typo.h5">@Title</MudText>
        </Header>
        <Content>
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudCard>
                        <MudCardContent>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Name</MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="txtName" Placeholder="Input Name" @bind-Value="response!.Name" Enabled="false"></SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Company</MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfDropDownList ID="ddlCompanyAddPsychotest" TValue="string" TItem="GetCompanyQueryResponse" DataSource="@listCompany" @bind-Value="response!.CompanyCode"
                                                        Enabled="false" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" Placeholder="Select Company">
                                            <DropDownListFieldSettings Text="Name" Value="Code" />
                                        </SfDropDownList>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Employee Number</MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="txtEmployeeNo" Placeholder="Input Employee Number" @bind-Value="response!.EmployeeNumber" Enabled="false"></SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Email</MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfTextBox ID="txtEmail" Placeholder="Input Email" @bind-Value="response!.Email" Enabled="false"></SfTextBox>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Qualification Status</MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfDropDownList TItem="GetSelectionPsychotestQualificationStatusResponse" TValue="SelectionQualificationStatus" DataSource="@qualificationStatusListResponses" @bind-Value="QualificationStatusValue"
                                                        Width="300px" Placeholder="Select Status" FloatLabelType="FloatLabelType.Never" Enabled="@IsEnabled">
                                            <DropDownListFieldSettings Value="Value" Text="Text"></DropDownListFieldSettings>
                                        </SfDropDownList>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Test Date <span style="color:red;">*</span></MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfDatePicker TValue="DateOnly?" Format="dd.MM.yyyy" Placeholder="Choose a Date" FullScreen="true" ShowClearButton="true" @bind-Value="TestDateValue" Enabled="@IsEnabled">
                                            <DatePickerEvents TValue="DateOnly?" ValueChange="OnTestDateChanged"></DatePickerEvents>
                                        </SfDatePicker>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Expired Date <span style="color:red;">*</span></MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfDatePicker TValue="DateOnly?" Format="dd.MM.yyyy" Placeholder="Choose a Date" FullScreen="true" ShowClearButton="true" @bind-Value="response!.Expired" Enabled="@IsEnabled" Min="@(response?.TestDate.HasValue == true ? response.TestDate.Value.ToDateTime(TimeOnly.MinValue) : DateTime.MinValue)"></SfDatePicker>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4">
                                        <MudText>Status <span style="color:red;">*</span></MudText>
                                    </MudItem>
                                    <MudItem xs="8">
                                        <SfDropDownList TItem="GetSelectionPsychotestStatusResponse" TValue="ApplicantStatus" DataSource="@statusListResponses" @bind-Value="@(response!.Status)"
                                                        Width="300px" Placeholder="Select Status" FloatLabelType="FloatLabelType.Never" Enabled="false">
                                            <DropDownListFieldSettings Value="Value" Text="Text"></DropDownListFieldSettings>
                                        </SfDropDownList>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            @if (@IsEnabledSKStatus)
                            {
                                <MudItem xs="12">

                                    @* <MudText>Psychotest Certificate (.pdf) (Max. 5 Mb) <span style="color:red;">*</span></MudText> *@
                                    <MudText>Psychotest Certificate (.pdf) <span style="color:red;">*</span></MudText>
                                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="font-style: italic; font-size: 0.8rem;">
                                        <b>(Maximum Size 5 Mb)</b>
                                    </MudText>
                                    <MudGrid Class="mt-2">
                                        <MudItem xs="12">
                                            <SfUploader ID="uploaderPsychotestCertificate" AutoUpload="true" SequentialUpload="false" AllowMultiple="false" Enabled="@IsEnabledSKStatus" MaxFileSize="@maximumFileSizeInBytes"
                                                        AllowedExtensions=".pdf">
                                                <UploaderEvents ValueChange="ValueChangePsychotestCertificate" OnRemove="OnRemovePsychotestCertificate"></UploaderEvents>
                                            </SfUploader>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            }
                            <br />

                            @if (listDocument!.Count() > 0)
                            {
                                <MudItem xs="12">
                                    <SfGrid DataSource="@listDocument"
                                            AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true">
                                        <GridPageSettings PageCount="8" PageSize="8" PageSizes="@(new string[] { "8", "10", "15", "20", "All" })"></GridPageSettings>
                                        <GridEvents CommandClicked="OnCommandClicked" TValue="GetDocumentsDocument"></GridEvents>
                                        <GridColumns>
                                            <GridColumn Field=@nameof(GetDocumentsDocument.FileName) HeaderText="Filename" TextAlign="TextAlign.Left" Width="80%"> </GridColumn>
                                            <GridColumn HeaderText="Action" Width="20%" TextAlign="TextAlign.Center">
                                                <GridCommandColumns>
                                                    <GridCommandColumn ID="btnDownload" Title="Download" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-download", CssClass="e-flat" })"> </GridCommandColumn>
                                                    @if (IsEnabledSKStatus)
                                                    {
                                                        <GridCommandColumn ID="btnDelete" Title="Delete" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-delete", CssClass="e-flat" })"> </GridCommandColumn>
                                                    }
                                                </GridCommandColumns>
                                            </GridColumn>
                                        </GridColumns>
                                    </SfGrid>
                                </MudItem>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </Content>
        <FooterTemplate>
            <SfButton Content="Cancel" CssClass="e-outline e-danger" IconCss="e-icons e-close" OnClick="OnClickNo"></SfButton>
            @if (IsEnabledSKStatus == true)
            {
                <SfButton Content="Save" CssClass="e-success" IconCss="e-icons e-circle-check" OnClick="OnClickYes"></SfButton>
            }

        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
    <DialogAnimationSettings Effect="DialogEffect.Zoom"></DialogAnimationSettings>
</SfDialog>

@code {
    [Parameter]
    public bool Visibility { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public EventCallback DialogOpen { get; set; }

    [Parameter]
    public EventCallback DialogClose { get; set; }

    [Parameter]
    public EventCallback OnClickNo { get; set; }

    [Parameter]
    public EventCallback OnClickYes { get; set; }

    [Parameter]
    public List<GetCompanyQueryResponse>? listCompany { get; set; }

    [Parameter]
    public GetSelectionPsychotestQueryResponse? response { get; set; }

    [Parameter]
    public IEnumerable<GetSelectionPsychotestStatusResponse>? statusListResponses { get; set; }

    [Parameter]
    public IEnumerable<GetSelectionPsychotestQualificationStatusResponse>? qualificationStatusListResponses { get; set; }

    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemovePsychotestCertificate { get; set; }

    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChangePsychotestCertificate { get; set; }

    [Parameter]
    public EventCallback<CommandClickEventArgs<GetDocumentsDocument>> OnCommandClicked { get; set; }

    [Parameter]
    public List<GetDocumentsDocument>? listDocument { get; set; }

    [Parameter]
    public bool IsEnabled { get; set; }

    [Parameter]
    public bool IsEnabledSKStatus { get; set; }

    [Parameter]
    public long maximumFileSizeInBytes { get; set; }

    private SelectionQualificationStatus QualificationStatusValue
    {
        get => response?.QualificationStatus ?? SelectionQualificationStatus.NotQualified;
        set
        {
            if (response == null) return;

            response.QualificationStatus = value;

            response.Status = value == SelectionQualificationStatus.Qualified
                ? ApplicantStatus.Passed
                : ApplicantStatus.Failed;
        }
    }

    private DateOnly? TestDateValue
    {
        get => response?.TestDate;
        set
        {
            if (response == null) return;
            response.TestDate = value;
        }
    }

    private void OnTestDateChanged(Syncfusion.Blazor.Calendars.ChangedEventArgs<DateOnly?> args)
    {
        if (response == null || !args.Value.HasValue) return;

        response.Expired = args.Value.Value.AddYears(2);

        StateHasChanged();
    }
}

<style>
    .e-chip-list {
        display: inline !important
    }

    .e-dlg-header, .e-dlg-header * {
        font-size: x-large;
        font-weight: bold;
    }
</style>
