@attribute [Authorize]
@page "/Customers"

<BrowserTabTitle>Manajemen Pelanggan</BrowserTabTitle>
<PageHeader Title="Manajemen Pelanggan" Icon="@Icons.Material.Filled.People" />

<MudPaper Class="pa-4 rounded-lg" Elevation="1">
    <MudGrid Class="mb-3">
        <MudItem xs="12" sm="6" md="4">
            <MudTextField @bind-Value="_searchText"
                          Label="Cari pelanggan..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          DebounceInterval="300" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect @bind-Value="_filterTier" Label="Filter Tier" Variant="Variant.Outlined">
                <MudSelectItem Value="@("")">Semua Tier</MudSelectItem>
                <MudSelectItem Value="@("Bronze")">🥉 Bronze</MudSelectItem>
                <MudSelectItem Value="@("Silver")">🥈 Silver</MudSelectItem>
                <MudSelectItem Value="@("Gold")">🥇 Gold</MudSelectItem>
                <MudSelectItem Value="@("Platinum")">💎 Platinum</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect @bind-Value="_filterSegment" Label="Filter Segmen" Variant="Variant.Outlined">
                <MudSelectItem Value="@("")">Semua Segmen</MudSelectItem>
                <MudSelectItem Value="@("New")">Baru</MudSelectItem>
                <MudSelectItem Value="@("Active")">Aktif</MudSelectItem>
                <MudSelectItem Value="@("Loyal")">Setia</MudSelectItem>
                <MudSelectItem Value="@("AtRisk")">Berisiko</MudSelectItem>
                <MudSelectItem Value="@("Inactive")">Tidak Aktif</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       Style="background:#6F4E37; color:white; width:100%;"
                       Href="/CustomerCreate">
                Tambah Pelanggan
            </MudButton>
        </MudItem>
    </MudGrid>

    <MudTable Items="@_customers" Dense="true" Hover="true" Striped="true" Loading="@_loading"
              LoadingProgressColor="Color.Primary" Elevation="0">
        <HeaderContent>
            <MudTh>Kode Member</MudTh>
            <MudTh>Nama Pelanggan</MudTh>
            <MudTh>No. HP</MudTh>
            <MudTh>Tier</MudTh>
            <MudTh>Segmen</MudTh>
            <MudTh Style="text-align:right">Total Poin</MudTh>
            <MudTh>Transaksi Terakhir</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudChip Size="Size.Small" Style="background:#6F4E37; color:white; font-family:monospace;">
                    @context.MemberCode
                </MudChip>
            </MudTd>
            <MudTd>
                <div class="d-flex align-center">
                    <MudAvatar Size="Size.Small" Style="background:#C8860A; color:white;" Class="mr-2">
                        @(context.FullName.FirstOrDefault())
                    </MudAvatar>
                    @context.FullName
                </div>
            </MudTd>
            <MudTd>@context.PhoneNumber</MudTd>
            <MudTd>
                <MudChip Size="Size.Small" Color="@GetTierColor(context.Tier)">@context.Tier</MudChip>
            </MudTd>
            <MudTd>
                <MudChip Size="Size.Small" Color="@GetSegmentColor(context.Segment)">@context.Segment</MudChip>
            </MudTd>
            <MudTd Style="text-align:right">
                <MudText Typo="Typo.body2" Style="color:#C8860A; font-weight:700;">
                    ⭐ @context.TotalPoints.ToString("N0")
                </MudText>
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.caption">@(context.LastTransactionDate?.ToString("dd MMM yyyy") ?? "-")</MudText>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary"
                               Href="@($"/CustomerDetail/{context.Id}")" />
                <MudIconButton Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Color="Color.Secondary"
                               Href="@($"/TransactionCreate?customerId={context.Id}")" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4 text-center" Color="Color.Secondary">
                Tidak ada data pelanggan ditemukan
            </MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
        </PagerContent>
    </MudTable>
</MudPaper>
