@attribute [Authorize]
@page "/Customers"

<BrowserTabTitle>Manajemen Pelanggan</BrowserTabTitle>
<PageHeader Title="Manajemen Pelanggan" Icon="@Icons.Material.Filled.People" />

<MudPaper Class="pa-4 rounded-lg" Elevation="1">
    <MudGrid Class="mb-3">
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Value="_searchText"
                          ValueChanged="@((string v) => OnSearchChanged(v))"
                          Label="Cari nama / nomor HP / kode member..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          DebounceInterval="400" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="CustomerTier?" Value="_filterTier"
                       ValueChanged="@((CustomerTier? v) => OnFilterTierChanged(v))"
                       Label="Filter Tier" Variant="Variant.Outlined">
                <MudSelectItem T="CustomerTier?" Value="@(null)">Semua Tier</MudSelectItem>
                <MudSelectItem T="CustomerTier?" Value="@((CustomerTier?)CustomerTier.Bronze)">🥉 Bronze</MudSelectItem>
                <MudSelectItem T="CustomerTier?" Value="@((CustomerTier?)CustomerTier.Silver)">🥈 Silver</MudSelectItem>
                <MudSelectItem T="CustomerTier?" Value="@((CustomerTier?)CustomerTier.Gold)">🥇 Gold</MudSelectItem>
                <MudSelectItem T="CustomerTier?" Value="@((CustomerTier?)CustomerTier.Platinum)">💎 Platinum</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="CustomerSegment?" Value="_filterSegment"
                       ValueChanged="@((CustomerSegment? v) => OnFilterSegmentChanged(v))"
                       Label="Filter Segmen" Variant="Variant.Outlined">
                <MudSelectItem T="CustomerSegment?" Value="@(null)">Semua Segmen</MudSelectItem>
                <MudSelectItem T="CustomerSegment?" Value="@((CustomerSegment?)CustomerSegment.New)">Baru</MudSelectItem>
                <MudSelectItem T="CustomerSegment?" Value="@((CustomerSegment?)CustomerSegment.Active)">Aktif</MudSelectItem>
                <MudSelectItem T="CustomerSegment?" Value="@((CustomerSegment?)CustomerSegment.Loyal)">Setia</MudSelectItem>
                <MudSelectItem T="CustomerSegment?" Value="@((CustomerSegment?)CustomerSegment.AtRisk)">Berisiko</MudSelectItem>
                <MudSelectItem T="CustomerSegment?" Value="@((CustomerSegment?)CustomerSegment.Inactive)">Tidak Aktif</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       Style="background:#6F4E37; color:white; width:100%;"
                       Href="@CommonRouteFor.CustomerCreate">
                Tambah Pelanggan
            </MudButton>
        </MudItem>
    </MudGrid>

    <MudTable Items="@_customers" Dense="true" Hover="true" Striped="true" Loading="@_loading"
              LoadingProgressColor="Color.Primary" Elevation="0">
        <HeaderContent>
            <MudTh>Kode Member</MudTh>
            <MudTh>Nama Pelanggan</MudTh>
            <MudTh>No. HP</MudTh>
            <MudTh>Tier</MudTh>
            <MudTh>Segmen</MudTh>
            <MudTh Style="text-align:right">Total Poin</MudTh>
            <MudTh Style="text-align:right">Total Belanja</MudTh>
            <MudTh>Transaksi Terakhir</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Style="background:#6F4E37; color:white; font-family:monospace;">
                    @context.MemberCode
                </MudChip>
            </MudTd>
            <MudTd>
                <div class="d-flex align-center">
                    <MudAvatar Size="Size.Small" Style="background:#C8860A; color:white;" Class="mr-2">
                        @(context.FullName.FirstOrDefault())
                    </MudAvatar>
                    @context.FullName
                </div>
            </MudTd>
            <MudTd>@context.PhoneNumber</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@GetTierColor(context.Tier)">@GetTierLabel(context.Tier)</MudChip>
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@GetSegmentColor(context.Segment)">@GetSegmentLabel(context.Segment)</MudChip>
            </MudTd>
            <MudTd Style="text-align:right">
                <MudText Typo="Typo.body2" Style="color:#C8860A; font-weight:700;">
                    ⭐ @context.TotalPoints.ToString("N0")
                </MudText>
            </MudTd>
            <MudTd Style="text-align:right">
                <MudText Typo="Typo.body2" Style="color:#2E7D32; font-weight:600;">
                    Rp @context.TotalSpend.ToString("N0")
                </MudText>
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.caption">@(context.LastTransactionDate?.ToString("dd MMM yyyy") ?? "-")</MudText>
            </MudTd>
            <MudTd>
                <MudTooltip Text="Detail Pelanggan">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary"
                                   Href="@CommonRouteFor.CustomerDetail(context.Id)" />
                </MudTooltip>
                <MudTooltip Text="Input Transaksi">
                    <MudIconButton Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Color="Color.Secondary"
                                   Href="@($"{CommonRouteFor.TransactionCreate}?customerId={context.Id}")" />
                </MudTooltip>
                <MudTooltip Text="Edit Pelanggan">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default"
                                   Href="@CommonRouteFor.CustomerEdit(context.Id)" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4 text-center" Color="Color.Secondary">
                Tidak ada data pelanggan ditemukan
            </MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
        </PagerContent>
    </MudTable>
</MudPaper>
