@page "/UnivRegistration"

@using Psmp.Shared.Scholarships.Constants

<BrowserTabTitle>@DisplayTextFor.UnivRegistration</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" ActivePanelIndexChanged="@(e => OnTabChanged(e))">
    @if (IsShowUniversityRecommendation)
    {
        <MudTabPanel Text="@DisplayTextFor.UniversityRecommendation">
            <Psmp.Bsui.Features.UnivRegistration.UniversityRecommendation.Index>

            </Psmp.Bsui.Features.UnivRegistration.UniversityRecommendation.Index>
        </MudTabPanel>
    }
    @if (IsShowUniversityAdmission)
    {
        <MudTabPanel Text="@DisplayTextFor.UniversityAdmission">
            <Psmp.Bsui.Features.UnivRegistration.UniversityAdmission.Index>

            </Psmp.Bsui.Features.UnivRegistration.UniversityAdmission.Index>
        </MudTabPanel>
    }
</MudTabs>

<style>
    .mud-tabs-panels {
        min-height: 500px;
    }
</style>
