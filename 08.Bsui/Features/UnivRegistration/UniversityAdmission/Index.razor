@using Smlp.Shared.Common.Responses
@using Smlp.Shared.Selections.SelectionOverviews.Queries
@using Smlp.Bsui.Features.UnivRegistration.UniversityAdmission
@using Smlp.Bsui.Features

<style>
    .e-chip-list {
        display: inline !important
    }

    .text-right {
        text-align: right;
    }
</style>

<MudGrid Spacing="2">
    <MudGrid Spacing="2" Class="mb-2">
        <MudItem xs="12">
            <MudText Typo="Typo.body2" HtmlTag="h3">Scholarship Plan Filter</MudText>
        </MudItem>
    </MudGrid>
    <MudGrid Spacing="2" Class="mb-4">
        <MudItem xs="2">
            <MudText>Categories</MudText>
            <SfDropDownList ID="ddlSelectionCategory" TValue="int" TItem="DropdownItemResponse" DataSource="@_dropdownCategories" Placeholder="All Category">
                <DropDownListFieldSettings Text="Description" Value="Id" />
                <DropDownListEvents TItem="DropdownItemResponse" TValue="int" />
            </SfDropDownList>
        </MudItem>
        <MudItem xs="2">
            <MudText>H/ SH/ AP&P</MudText>
            <SfDropDownList ID="ddlSelectionHPS" TValue="int" TItem="DropdownItemResponse" DataSource="@_dropdownHps" Placeholder="All H/SH/AP&P">
                <DropDownListFieldSettings Text="Description" Value="Id" />
                <DropDownListEvents TItem="DropdownItemResponse" TValue="int" />
            </SfDropDownList>
        </MudItem>
        <MudItem xs="2">
            <MudText>Company</MudText>
            <SfDropDownList ID="ddlSelectionCompany" TValue="int" TItem="DropdownItemResponse" DataSource="@_dropdownCompany" Placeholder="All Company Name">
                <DropDownListFieldSettings Text="Description" Value="Id" />
                <DropDownListEvents TItem="DropdownItemResponse" TValue="int" />
            </SfDropDownList>
        </MudItem>
        <MudItem xs="2">
            <MudText>Directorate/Function</MudText>
            <SfDropDownList ID="ddlSelectionDirectorate" TValue="int" TItem="DropdownItemResponse" DataSource="@_dropdownDirectorate" Placeholder="All Directorate">
                <DropDownListFieldSettings Text="Description" Value="Id" />
                <DropDownListEvents TItem="DropdownItemResponse" TValue="int" />
            </SfDropDownList>
        </MudItem>
        <MudItem xs="2">
            <MudText>Scholarship Code</MudText>
            <SfDropDownList ID="ddlSelectionScholarship" TValue="int" TItem="DropdownItemResponse" DataSource="@_dropdownScholarshipCode" Placeholder="All">
                <DropDownListFieldSettings Text="Description" Value="Id" />
                <DropDownListEvents TItem="DropdownItemResponse" TValue="int" />
            </SfDropDownList>
        </MudItem>
        <MudItem xs="2">
            <MudText>Batch</MudText>
            <SfDropDownList ID="ddlSelectionBatch" TValue="int" TItem="DropdownItemResponse" DataSource="@_dropdownBatch" Placeholder="All Batch">
                <DropDownListFieldSettings Text="Description" Value="Id" />
                <DropDownListEvents TItem="DropdownItemResponse" TValue="int" />
            </SfDropDownList>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-2">
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudGrid Justify="Justify.Center">
                    <!-- Card pertama -->
                    <MudItem xs="12" sm="6" md="3" Class="d-flex justify-start">
                        <CardStatistic Judul="@_judul1" Count="@_count1"></CardStatistic>
                    </MudItem>

                    <!-- Divider Vertikal -->
                    @* <MudItem xs="1" Class="d-flex justify-center">
                        <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                    </MudItem> *@

                    <!-- Card kedua -->
					<MudItem xs="12" sm="6" md="3" Class="d-flex justify-start">
                        <CardStatistic Judul="@_judul2" Count="@_count2"></CardStatistic>
                    </MudItem>

                    <!-- Divider Vertikal -->
                    @* <MudItem xs="1" Class="d-flex justify-center">
                        <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                    </MudItem> *@

                    <!-- Card ketiga -->
					<MudItem xs="12" sm="6" md="3" Class="d-flex justify-start">
                        <CardStatistic Judul="@_judul3" Countdec="@_count3"></CardStatistic>
                    </MudItem>

                    <!-- Divider Vertikal -->
                    @* <MudItem xs="1" Class="d-flex justify-center">
                        <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                    </MudItem> *@

                    <!-- Card ketiga -->
					<MudItem xs="12" sm="6" md="3" Class="d-flex justify-start">
                        <CardStatistic Judul="@_judul4" Countdec="@_count3" IsLast="true"></CardStatistic>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-2">
        <MudItem xs="12">
            <MudCard Class="pa-4" Elevation="2">
                <MudCardContent>
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle2" Class="ms-0">List of Sponshorship Letter Request</MudText>
                        <MudDivider Style="border-width: 2px; margin-bottom: 16px;" />
                        <MudItem xs="12">
                            <MudGrid>
                                <MudItem xs="4" Class="justify-end">
                                    <SfButton OnClick="OnClickAddAsync" Content="Download Result" IconCss="e-icons e-download" CssClass="e-info"></SfButton>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                        <br />
                        <SfGrid DataSource="@_gridData" Toolbar="@(new List<string>() { "Search" })" AllowPaging="true">
                            @* <GridSelectionSettings CheckboxOnly="false" PersistSelection="true"></GridSelectionSettings> *@
                            <GridColumns>
                                @* <GridColumn Type="ColumnType.CheckBox" Width="50"></GridColumn> *@
                                <GridColumn Field=@nameof(DataStudyPreparation.Index) HeaderText="No" Width="50"></GridColumn>
                                <GridColumn Field=@nameof(DataStudyPreparation.Name) HeaderText="Name" Width="250"></GridColumn>
                                <GridColumn Field=@nameof(DataStudyPreparation.Company) HeaderText="Company" Width="150"></GridColumn>
                                <GridColumn Field=@nameof(DataStudyPreparation.EmployeeNumber) HeaderText="Employee Number" Width="150"></GridColumn>
                                <GridColumn Field=@nameof(DataStudyPreparation.Email) HeaderText="Email" Width="150"></GridColumn>
                                <GridColumn Field=@nameof(DataStudyPreparation.University) HeaderText="University" Width="150"></GridColumn>
                                <GridColumn Field=@nameof(DataStudyPreparation.Status) HeaderText="Essay Status" HeaderTextAlign="TextAlign.Center" TextAlign="TextAlign.Center" Width="150">
                                    <Template Context="context">
                                        @{
                                            var Status = ((DataStudyPreparation)context).Status; // Ambil nilai EssayStatus dari context
                                        }
                                        @if (Status == "Complete")
                                        {
                                            <SfChip>
                                                <ChipItems>
                                                    <ChipItem Text="Completed" CssClass="e-success"></ChipItem>
                                                </ChipItems>
                                            </SfChip>
                                        }
                                        else if (Status == "Approved")
                                        {
                                            <SfChip>
                                                <ChipItems>
                                                    <ChipItem Text="Approved" CssClass="e-danger"></ChipItem>
                                                </ChipItems>
                                            </SfChip>
                                        }
                                    </Template>
                                </GridColumn>
                                <GridColumn HeaderText="Action" TextAlign="TextAlign.Center" Width="150">
                                    <GridCommandColumns>
                                        <GridCommandColumn ButtonOption="@(new CommandButtonOptions() { IconCss="e-icons e-edit", CssClass="e-flat" })" Title="Edit"></GridCommandColumn>
                                        <GridCommandColumn ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-delete", CssClass="e-flat" })" Title="Delete"></GridCommandColumn>
                                    </GridCommandColumns>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </MudItem>

                    <MudItem xs="12" Class="mt-8">
                        <MudText>File Upload (.xls, .xlsx) <span style="color:red;">*</span></MudText>
                        <MudGrid>
                            <MudItem xs="8" class="d-flex align-center">
                                <SfUploader @ref="_uploadObj" ID="uploaderApplicants" AutoUpload="true" SequentialUpload="false" AllowMultiple="false"
                                            AllowedExtensions=".xls, .xlsx" MaxFileSize=@_maximumFileSizeInBytes>
                                    <UploaderEvents ValueChange="ValueChangeUploaderApplicants" OnRemove="OnRemoveUploaderApplicants"></UploaderEvents>
                                </SfUploader>
                            </MudItem>
                            <MudItem xs="4">
                                <MudGrid>
                                    <SfButton Content="Upload" CssClass="e-info d-flex justify-start mt-6 mr-2" IconCss="e-icons e-upload-1"
                                              OnClick="OnClickUploadAsync"></SfButton>
                                    <SfButton Content="Download" CssClass="e-info justify-end mt-6 mr-2" IconCss="e-icons e-download"
                                              OnClick="OnClickDownloadAsync"></SfButton>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudGrid>
