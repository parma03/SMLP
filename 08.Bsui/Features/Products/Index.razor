@attribute [Authorize(Roles = "Admin,Owner")]
@page "/Products"

<BrowserTabTitle>Manajemen Produk</BrowserTabTitle>
<PageHeader Title="Manajemen Produk" Icon="@Icons.Material.Filled.Inventory2" />

<MudPaper Class="pa-4 rounded-lg" Elevation="1">
    <MudGrid Class="mb-3">
        <MudItem xs="12" sm="6" md="4">
            <MudTextField Value="_searchText"
                          ValueChanged="@((string v) => OnSearchChanged(v))"
                          Label="Cari nama produk..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          DebounceInterval="400" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="bool?" Value="_filterIsActive"
                       ValueChanged="@((bool? v) => OnFilterActiveChanged(v))"
                       Label="Status" Variant="Variant.Outlined">
                <MudSelectItem T="bool?" Value="@(null)">Semua Status</MudSelectItem>
                <MudSelectItem T="bool?" Value="@(true)">✅ Aktif</MudSelectItem>
                <MudSelectItem T="bool?" Value="@(false)">❌ Tidak Aktif</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.AddBox"
                       Style="background:#6F4E37; color:white; width:100%;"
                       Href="@CommonRouteFor.ProductCreate">
                Tambah Produk
            </MudButton>
        </MudItem>
        <MudItem xs="12" Class="d-flex justify-end gap-2">
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.FileDownload"
                       Color="Color.Success"
                       OnClick="ExportToCsvAsync"
                       Disabled="@(_totalCount == 0)">
                Export CSV
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.GridOn"
                       Color="Color.Primary"
                       OnClick="ExportToExcelAsync"
                       Disabled="@(_totalCount == 0)">
                Export Excel
            </MudButton>
        </MudItem>
    </MudGrid>

    <MudTable @ref="_table" ServerData="ServerReload" Dense="true" Hover="true" Striped="true"
              LoadingProgressColor="Color.Primary" Elevation="0">
        <HeaderContent>
            <MudTh>Nama Produk</MudTh>
            <MudTh>Deskripsi</MudTh>
            <MudTh>Kategori</MudTh>
            <MudTh Style="text-align:right">Harga</MudTh>
            <MudTh Style="text-align:right">Stok</MudTh>
            <MudTh Style="text-align:center">Status</MudTh>
            <MudTh>Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <div class="d-flex align-center gap-2">
                    <MudAvatar Size="Size.Small" Style="background:#6F4E37; color:white;">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                    </MudAvatar>
                    <MudText Typo="Typo.body2" Style="font-weight:600;">@context.Name</MudText>
                </div>
            </MudTd>
            <MudTd>
                <MudText Typo="Typo.caption" Style="color:#666;">
                    @(string.IsNullOrEmpty(context.Description) ? "-" : (context.Description.Length > 50 ? context.Description[..50] + "..." : context.Description))
                </MudText>
            </MudTd>
            <MudTd>
                @if (!string.IsNullOrEmpty(context.CategoryName))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">@context.CategoryName</MudChip>
                }
                else
                {
                    <MudText Typo="Typo.caption" Style="color:#999;">—</MudText>
                }
            </MudTd>
            <MudTd Style="text-align:right">
                <MudText Typo="Typo.body2" Style="color:#2E7D32; font-weight:700;">
                    Rp @context.Price.ToString("N0")
                </MudText>
            </MudTd>
            <MudTd Style="text-align:right">
                @if (context.Stock <= 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error">Habis</MudChip>
                }
                else if (context.Stock <= 5)
                {
                    <MudText Typo="Typo.body2" Style="color:#E65100; font-weight:600;">@context.Stock</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Style="font-weight:500;">@context.Stock</MudText>
                }
            </MudTd>
            <MudTd Style="text-align:center">
                @if (context.IsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Aktif</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Cancel">Nonaktif</MudChip>
                }
            </MudTd>
            <MudTd>
                @if (!string.IsNullOrEmpty(context.ImageUrl))
                {
                    <MudTooltip Text="Preview Gambar">
                        <MudIconButton Icon="@Icons.Material.Filled.Image" Size="Size.Small" Color="Color.Secondary"
                                       OnClick="@(() => OpenImagePreviewAsync(context))" />
                    </MudTooltip>
                }
                else
                {
                    <MudTooltip Text="Belum ada gambar">
                        <MudIconButton Icon="@Icons.Material.Filled.BrokenImage" Size="Size.Small" Color="Color.Default" Disabled="true" />
                    </MudTooltip>
                }
                <MudTooltip Text="Edit Produk">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                   Href="@CommonRouteFor.ProductEdit(context.Id)" />
                </MudTooltip>
                <MudTooltip Text="Hapus Produk">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => OnDeleteAsync(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4 text-center" Color="Color.Secondary">
                Tidak ada data produk ditemukan
            </MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
        </PagerContent>
    </MudTable>
</MudPaper>
