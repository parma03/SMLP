@attribute [Authorize(Roles = "Admin,Owner")]
@page "/Products/{Id:guid}/Edit"

<BrowserTabTitle>Edit Produk</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>
<PageHeader Title="Edit Produk" Icon="@Icons.Material.Filled.Edit" />

@if (_isLoadingData)
{
    <MudGrid>
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-6 rounded-lg" Elevation="2">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" Class="mb-4" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" Class="mb-4" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" Class="mb-4" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}
else if (_notFound)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">
        Produk tidak ditemukan.
        <MudLink Href="@CommonRouteFor.Products" Class="ml-2">Kembali ke daftar produk</MudLink>
    </MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-6 rounded-lg" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-4" Style="color:#6F4E37; font-weight:700;">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="mr-1" />
                    Data Produk
                </MudText>

                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Name"
                                      Label="Nama Produk"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="Nama produk wajib diisi"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Inventory2"
                                      Class="mb-3" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Description"
                                      Label="Deskripsi (Opsional)"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      Placeholder="Deskripsi singkat produk..."
                                      Class="mb-3" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField @bind-Value="_model.Price"
                                         Label="Harga (Rp)"
                                         Variant="Variant.Outlined"
                                         Format="N0"
                                         Min="0"
                                         Adornment="Adornment.Start"
                                         AdornmentText="Rp"
                                         Class="mb-3" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSwitch @bind-Value="_model.IsActive"
                                   Label="@(_model.IsActive ? "Produk Aktif" : "Produk Nonaktif")"
                                   Color="Color.Success"
                                   Class="mb-3 mt-2" />
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                <BottomButtonPanel>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               Href="@CommonRouteFor.Products">
                        Batal
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Style="background:#6F4E37; color:white;"
                               StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@_isLoading"
                               OnClick="@UpdateProductAsync">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                            <MudText Class="ms-2">Menyimpan...</MudText>
                        }
                        else
                        {
                            <MudText>Simpan Perubahan</MudText>
                        }
                    </MudButton>
                </BottomButtonPanel>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border-left:4px solid #C8860A;">
                <MudText Typo="Typo.subtitle2" Class="mb-3" Style="color:#6F4E37; font-weight:700;">
                    📋 Info Produk
                </MudText>
                <MudList T="string" Dense="true">
                    <MudListItem Icon="@Icons.Material.Filled.Fingerprint">
                        <MudText Typo="Typo.caption" Style="color:#999;">ID</MudText>
                        <MudText Typo="Typo.body2" Style="font-family:monospace; font-size:11px;">@Id</MudText>
                    </MudListItem>
                </MudList>
            </MudPaper>
        </MudItem>
    </MudGrid>
}
