@page "/UniversityRegistration"
@page "/UniversityRegistration/{TabIndex:int}"

@using Smlp.Shared.Scholarships.Constants

<BrowserTabTitle>@DisplayTextFor.UniversityRegistration</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6"  ActivePanelIndex="@_activeTabIndex" ActivePanelIndexChanged="@(e => OnTabChanged(e))">
    @if (IsShowUniversityRecommendation)
    {
        <MudTabPanel Text="@DisplayTextFor.UniversityRecommendation">
            <Smlp.Bsui.Features.Universities.Recommendation.Index>

            </Smlp.Bsui.Features.Universities.Recommendation.Index>
        </MudTabPanel>
    }
    @if (IsShowUniversityAdmission)
    {
        <MudTabPanel Text="@DisplayTextFor.UniversityAdmission">
            <Smlp.Bsui.Features.Universities.Admission.Index>

            </Smlp.Bsui.Features.Universities.Admission.Index>
        </MudTabPanel>
    }
</MudTabs>

<style>
    .mud-tabs-panels {
        min-height: 500px;
    }
</style>
