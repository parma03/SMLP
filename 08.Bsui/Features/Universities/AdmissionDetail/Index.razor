@page "/UniversityRegistration/UniversityAdmissionDetail/{Id:guid}"

@using Psmp.Shared.Scholarships.Constants
@using Psmp.Bsui.Features.Universities.AdmissionDetail.Components

<BrowserTabTitle>@DisplayTextFor.UniversityRegistration</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" ActivePanelIndexChanged="@(e => OnTabChanged(e))">
    <MudTabPanel Text="@DisplayTextFor.UniversityAdmissionLoASuperiorLetter">
        <LoASuperiorLetter Id="@Id">

        </LoASuperiorLetter>
    </MudTabPanel>
    <MudTabPanel Text="@DisplayTextFor.UniversityAdmissionDraftWarrant">
        <DraftWarrant Id="@Id">

        </DraftWarrant>
    </MudTabPanel>
    <MudTabPanel Text="@DisplayTextFor.UniversityAdmissionDraftAgreement">
        <DraftAgreement Id="@Id">

        </DraftAgreement>
    </MudTabPanel>
    <MudTabPanel Text="@DisplayTextFor.UniversityAdmissionFinalLetter">
        <FinalLetter Id="@Id">

        </FinalLetter>
    </MudTabPanel>
</MudTabs>

<style>
    .mud-tabs-panels {
        min-height: 500px;
    }
</style>
