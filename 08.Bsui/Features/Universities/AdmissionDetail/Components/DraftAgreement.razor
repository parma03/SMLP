@using Syncfusion.Blazor.DocumentEditor

<style>
    #editor {
        display: block;
    }

    .e-de-prop-pane .e-de-overlay {
        height: 100%;
        opacity: 1;
        pointer-events: inherit;
        -ms-touch-action: inherit;
        touch-action: inherit;
        width: 100%;
    }

    #txtSuperiorLetter {
        height: 150px;
    }

    #txtNumberOfLetter {
        height: 150px;
    }

    .m-4 {
        margin-right: 4px;
    }
</style>

<ErrorViewer Error="_error" />
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>
@if (_isLoading)
{
    <Loading IsVisible="_isLoading" />
}
else
{
    <MudGrid Spacing="2">
        <MudItem xs="12" Class="mt-4">
            <h3>Surat Perjanjian Tugas Belajar</h3>
        </MudItem>
        <hr />
        <MudItem xs="12">
            <MudGrid Spacing="2">
                @* <MudItem xs="4"> 
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudCard>
                                <MudCardContent>
                                    <MudItem xs="12">
                                        <SfTooltip ID="TooltipSuperior" Target="#txtHdrSuperior" Content="@_contentTooltipSuperior">
                                            <MudText id="txtHdrSuperior">
                                                Superior Letter (Position, Date & Subject) <SfIcon Name="IconName.CircleInfo"></SfIcon>
                                            </MudText>
                                        </SfTooltip>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextBox ID="txtSuperiorLetter" Placeholder="Position, Date & Subject" @bind-Value="_data!.SuperiorLetter" Multiline="true" Enabled="@_isEnabled"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <SfTooltip ID="TooltipStudyStartDate" Target="#txtHdrStudyStartDate" Content="@_contentTooltipStudyStartDate">
                                            <MudText id="txtHdrStudyStartDate">
                                                Study Start Date <SfIcon Name="IconName.CircleInfo"></SfIcon>
                                            </MudText>
                                        </SfTooltip>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfDatePicker ID="txtStudyStart" Placeholder="Start Date" Format="dd/MM/yyyy" @bind-Value="_data!.StudyStart" Enabled="@_isEnabled"></SfDatePicker>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <SfTooltip ID="TooltipStudyEndDate" Target="#txtHdrStudyEndDate" Content="@_contentTooltipStudyEndDate">
                                            <MudText id="txtHdrStudyEndDate">
                                                Study End Date <SfIcon Name="IconName.CircleInfo"></SfIcon>
                                            </MudText>
                                        </SfTooltip>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfDatePicker ID="txtStudyEnd" Placeholder="End Date" Format="dd/MM/yyyy" @bind-Value="_data!.StudyEnd" Enabled="@_isEnabled"></SfDatePicker>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <SfTooltip ID="TooltipNummberOfLetter" Target="#txtHdrNummberOfLetter" Content="@_contentTooltipNummberOfLetter">
                                            <MudText id="txtHdrNummberOfLetter">
                                                Number of Letter <SfIcon Name="IconName.CircleInfo"></SfIcon>
                                            </MudText>
                                        </SfTooltip>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextBox ID="txtNumberOfLetter" Placeholder="ID Position & Position" @bind-Value="_data!.NumberOfLetter" Multiline="true" Enabled="@_isEnabled"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
            </MudItem> *@
                <MudItem xs="12" Class="text-center">
                    <ErrorViewer Error="_errorDraft" />
                    <SfDocumentEditorContainer @ref="_containerDocument" Height="950px" ShowPropertiesPane="@ShowProperties" RestrictEditing="@ReadOnly" EnableToolbar="@Toolbar" ToolbarItems="@_toolbarItems" DocumentEditorSettings="_settingDocument">
                        <DocumentEditorContainerEvents Created="OnCreated"></DocumentEditorContainerEvents>
                    </SfDocumentEditorContainer>
                </MudItem>
            </MudGrid>
        </MudItem>
        <MudItem xs="12">
            <MudGrid>
                <MudItem xs="2" Style="text-align: left;">
                    <SfButton OnClick="OnClickBack" Content="Back" IconCss="e-icons e-arrow-left" CssClass="e-danger"></SfButton>
                </MudItem>
                <MudItem xs="10" Style="text-align: right;">
                    @if (_documentDraftId == Guid.Empty)
                    {
                        <SfButton OnClick="OnClickGenerateAsync" Content="Generate" IconCss="e-icons e-circle-check" CssClass="e-primary"></SfButton>
                    }
                    else
                    {
                        if (_contentButton == "Update")
                        {
                            <SfButton OnClick="OnClickUpdateAsync" Content="Update" IconCss="e-icons e-edit" CssClass="e-info m-4" Disabled="@_disableButton"></SfButton>
                        }
                        else if (_contentButton == "Save")
                        {
                            <SfButton OnClick="OnClickSaveAsync" Content="Save" IconCss="e-icons e-save" CssClass="e-info m-4" Disabled="@_disableButton"></SfButton>
                        }
                        <SfButton OnClick="OnClickPofficeAsync" Content="Continue to P-Office" IconCss="e-icons e-check" CssClass="e-info" Disabled="@_disableButtonDocument"></SfButton>
                        <SfButton OnClick="OnClickPsignAsync" Content="Continue to P-Sign" IconCss="e-icons e-check" CssClass="e-info" Disabled="@_disableButtonDocument"></SfButton>
                        <SfButton OnClick="OnClickDownloadWordAsync" Content="Download as Word" IconCss="e-icons e-download" CssClass="e-info" Disabled="@_disableButtonDownload"></SfButton>
                        <SfButton OnClick="OnClickDownloadPdfAsync" Content="Download as PDF" IconCss="e-icons e-download" CssClass="e-info" Disabled="@_disableButtonDownload"></SfButton>
                        <SfButton OnClick="OnClickRejectAsync" Content="Reject" IconCss="e-icons e-circle-close" CssClass="e-danger" Disabled="@_disableButtonReject"></SfButton>
                    }
                </MudItem>

            </MudGrid>
        </MudItem>
    </MudGrid>
}

<DialogConfirmation Visibility="@_isVisibleConfirmation"
                    Title="@_titleConfirmation"
                    Content="@_contentConfirmation"
                    DialogOpen="DialogConfirmationOpen"
                    DialogClose="DialogConfirmationClose"
                    OnClickNo="ClickedNoConfirmation"
                    OnClickYes="ClickedYesConfirmation"></DialogConfirmation>
