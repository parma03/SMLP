@using Smlp.Base.Scholarships.Enums
@using Smlp.Bsui.Features.Universities.Components
@using Smlp.Shared.Common.Responses
@using Smlp.Shared.Masters.Queries
@using Smlp.Shared.Scholarships.ScholarshipPosting.Queries
@using Smlp.Shared.Selections.SelectionOverviews.Queries
@using Smlp.Bsui.Features.Universities.Admission
@using Smlp.Shared.Universities.Admission.Queries
@using Smlp.Shared.Universities.AdmissionSuperiorLetter.Queries
@using Smlp.Bsui.Common.Components
@using Base.Universities.Enums

<style>
    .e-chip-list {
        display: inline !important
    }

    .text-right {
        text-align: right;
    }

    .e-upload .e-file-select-wrap, .e-bigger.e-small .e-upload .e-file-select-wrap {
        padding: 5px 0 5px 5px; /* Sesuaikan padding untuk tampilan yang lebih kompak */
    }

    .sf-uploader-compact .e-file-container {
        margin: 2px 0; /* Mengurangi margin antar file */
    }
</style>

<ErrorViewer Error="_error" />
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>
@if (_isLoading)
{
    <Loading IsVisible="_isLoading" />
}
else
{
    <MudGrid Spacing="2">
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12">
                <MudText Typo="Typo.body2" HtmlTag="h3">University Admission Filter</MudText>
            </MudItem>
        </MudGrid>
        <MudGrid Spacing="2" Class="mb-4">
            <MudItem xs="2">
                <MudText>Categories</MudText>
                <SfDropDownList ID="ddlSelectionCategory" TValue="UniversityCategory" TItem="DropdownEnumResponse<UniversityCategory>" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_dropdownEnumCategories" Placeholder="All Category" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Description" Value="Id" />
                    <DropDownListEvents TItem="DropdownEnumResponse<UniversityCategory>" TValue="UniversityCategory" ValueChange="OnChangeCategory" />
                </SfDropDownList>
            </MudItem>
            <MudItem xs="2">
                <MudText>H/ SH/ AP&P</MudText>
                <SfDropDownList ID="ddlSelectionCompaynGroup" TValue="int" TItem="GetCompanyGroupQueryResponse" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_dropdownCompanyGroups" Placeholder="All H/SH/AP&P" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Name" Value="Id" />
                    <DropDownListEvents TItem="GetCompanyGroupQueryResponse" TValue="int" ValueChange="OnChangeCompanyGroupAsync" />
                </SfDropDownList>
            </MudItem>
            <MudItem xs="2">
                <MudText>Company</MudText>
                <SfDropDownList ID="ddlSelectionCompay" TValue="string" TItem="GetCompanyQueryResponse" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_dropdownCompanies" Placeholder="All Company" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Name" Value="Code" />
                    <DropDownListEvents TItem="GetCompanyQueryResponse" TValue="string" ValueChange="OnChangeCompanyAsync" />
                </SfDropDownList>
            </MudItem>
             <MudItem xs="2">
                <MudText>Directorate</MudText>
                <SfDropDownList ID="ddlSelectionDirectorate" TValue="int" TItem="GetDirectorateQueryResponse" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_dropdownDirectorates" Placeholder="All Directorate" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Name" Value="Id" />
                    <DropDownListEvents TItem="GetDirectorateQueryResponse" TValue="int" ValueChange="OnChangeDirectorateAsync" />
                </SfDropDownList>
            </MudItem>
            <MudItem xs="2">
                <MudText>Scholarship Code</MudText>
                <SfDropDownList ID="ddlSsholarshipCodes" TValue="Guid" TItem="GetScholarshipPostingDropdownResponse" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_dropdownScholarshipCodes" Placeholder="All Code" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Code" Value="Id" />
                    <DropDownListEvents TItem="GetScholarshipPostingDropdownResponse" TValue="Guid" ValueChange="OnChangeScholarshipCodeAsync" />
                </SfDropDownList>
            </MudItem>
            <MudItem xs="2">
                <MudText>Batch</MudText>
                <SfDropDownList ID="ddlScholarshipBatch" TValue="ScholarshipBatch" TItem="DropdownEnumResponse<ScholarshipBatch>" Placeholder="All Batch"
                                AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                DataSource="@_dropdownEnumBatchs" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Description" Value="Id" />
                    <DropDownListEvents TItem="DropdownEnumResponse<ScholarshipBatch>" TValue="ScholarshipBatch" ValueChange="OnChangeBatchAsync" />
                </SfDropDownList>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mb-2">
            <MudItem xs="12">
                <MudPaper Class="pa-4" Elevation="2">
                    <MudGrid Justify="Justify.Center">
                        <!-- Card pertama -->
                        <MudItem xs="12" sm="6" md="3" Class="d-flex justify-start">
                            <CardStatistic Judul="Total Awardee" Count="@CountAll"></CardStatistic>
                        </MudItem>

                        <!-- Divider Vertikal -->
                        @* <MudItem xs="1" Class="d-flex justify-center">
                            <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                        </MudItem> *@

                        <!-- Card kedua -->
						<MudItem xs="12" sm="6" md="3" Class="d-flex justify-start">
                            <CardStatistic Judul="Completed" Count="@CountCompleted"></CardStatistic>
                        </MudItem>

                        <!-- Divider Vertikal -->
                        @* <MudItem xs="1" Class="d-flex justify-center">
                            <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                        </MudItem> *@

                        <!-- Card ketiga -->
						<MudItem xs="12" sm="6" md="3" Class="d-flex justify-start">
                            <CardStatistic Judul="Submitted" Count="@CountSubmitted"></CardStatistic>
                        </MudItem>

                        <!-- Divider Vertikal -->
                        @* <MudItem xs="1" Class="d-flex justify-center">
                            <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                        </MudItem> *@

                        <!-- Card ketiga -->
						<MudItem xs="12" sm="6" md="3" Class="d-flex justify-start">
                            <CardStatistic Judul="Waiting for Approval" Count="@CountWaitingForApproval" IsLast="true"></CardStatistic>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mb-2">
            <MudItem xs="12">
                <MudCard Class="pa-4" Elevation="2">
                    <MudCardContent>
                        <MudItem xs="12">
                            <MudGrid Spacing="2" Class="mb-1">
                                <MudItem xs="12" md="6">
                                    <MudGrid Class="d-flex align-center justify-start">
                                        <MudItem>
                                            <MudText Typo="Typo.h6" Class="ms-0">List of University Admission Request</MudText>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudGrid Class="d-flex flex-wrap align-center justify-start justify-md-end">
                                        <MudItem>
                                            <SfButton OnClick="OnClickAddAsync" IsPrimary="true" Content="Add" IconCss="e-icons e-circle-add" CssClass="mr-2" Style="display : none;"></SfButton>
                                            <SfProgressButton ID="zoomOutButton" Content="Export to Excel" @onclick="ExportExcel" EnableProgress="true" CssClass="fw-bold" IconCss="e-icons e-download" Style="background: linear-gradient(to right, #4279db, #1c4185); color: white;">
                                                <ProgressButtonSpinSettings Position="SpinPosition.Center"></ProgressButtonSpinSettings>
                                                <ProgressButtonAnimationSettings Effect="Syncfusion.Blazor.SplitButtons.AnimationEffect.ZoomOut"></ProgressButtonAnimationSettings>
                                            </SfProgressButton>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                            <SfGrid DataSource="@_dataGrid" Toolbar="@(new List<string>() { "Search" })" AllowExcelExport="true" AllowFiltering="true" AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true">
                                <GridEvents ExcelQueryCellInfoEvent="ExcelQueryCellInfoHandler" OnToolbarClick="ToolbarClickHandler" CommandClicked="OnCommandClicked" TValue="GetAdmissionQueryResponse"></GridEvents>
                                <GridPageSettings PageCount="10" PageSize="10" PageSizes="@SyncfusionGridValue.PageSize"></GridPageSettings>
                                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                                <GridColumns>
                                    <GridColumn Field=@nameof(GetAdmissionQueryResponse.Name) HeaderText="Name" Width="250"></GridColumn>
                                    <GridColumn Field=@nameof(GetAdmissionQueryResponse.CompanyName) HeaderText="Company" Width="150"></GridColumn>
                                    <GridColumn Field=@nameof(GetAdmissionQueryResponse.EmployeeNumber) HeaderText="Employee Number" Width="150"></GridColumn>
                                    <GridColumn Field=@nameof(GetAdmissionQueryResponse.Email) HeaderText="Email" Width="150"></GridColumn>
                                    <GridColumn Field=@nameof(GetAdmissionQueryResponse.University) HeaderText="University" Width="150"></GridColumn>
                                    <GridColumn Field=@nameof(GetAdmissionQueryResponse.Status) HeaderText="Status" HeaderTextAlign="TextAlign.Center" TextAlign="TextAlign.Center" Width="150">
                                        <Template Context="context">
                                            @{
                                                var Status = ((GetAdmissionQueryResponse)context).Status;
                                            }
                                            
                                            @if (Status == AdmissionStatus.Completed)
                                            {
                                                <SfChip>
                                                    <ChipItems>
                                                        <ChipItem Text="Completed" CssClass="e-success"></ChipItem>
                                                    </ChipItems>
                                                </SfChip>
                                            }
                                            else if (Status == AdmissionStatus.WaitingApproval)
                                            {
                                                <SfChip>
                                                    <ChipItems>
                                                        <ChipItem Text="Waiting for Approval" CssClass="e-warning"></ChipItem>
                                                    </ChipItems>
                                                </SfChip>
                                            }
                                            else if (Status == AdmissionStatus.Approved)
                                            {
                                                <SfChip>
                                                    <ChipItems>
                                                        <ChipItem Text="Approved" CssClass="e-warning"></ChipItem>
                                                    </ChipItems>
                                                </SfChip>
                                            }
                                            else if (Status == AdmissionStatus.Submitted)
                                            {
                                                <SfChip>
                                                    <ChipItems>
                                                        <ChipItem Text="Submitted"></ChipItem>
                                                    </ChipItems>
                                                </SfChip>
                                            }
                                            else if (Status == AdmissionStatus.Rejected)
                                            {
                                                <SfChip>
                                                    <ChipItems>
                                                        <ChipItem Text="Rejected" CssClass="e-danger"></ChipItem>
                                                    </ChipItems>
                                                </SfChip>
                                            }
                                        </Template>
                                    </GridColumn>
                                    <GridColumn HeaderText="Action" TextAlign="TextAlign.Center" Width="150">
                                        <GridCommandColumns>
                                            <GridCommandColumn Title="Edit" Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() { IconCss="e-icons e-edit", CssClass="e-flat" })"></GridCommandColumn>
                                        </GridCommandColumns>
                                    </GridColumn>
                                </GridColumns>
                            </SfGrid>
                        </MudItem>

                        <MudItem xs="12" Class="mt-8">
                            <MudText>File Upload (.xls, .xlsx) <span style="color:red;">*</span></MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="font-style: italic; font-size: 0.8rem;">
                                <b>(Maximum Size 5 Mb)</b>
                            </MudText>
                            <MudGrid Class="mt-0">
                                <MudItem xs="8" class="d-flex align-center">
                                    <SfUploader @ref="_uploadExcel" ID="uploaderExcel" AutoUpload="true" SequentialUpload="false" AllowMultiple="false"
                                                AllowedExtensions=".xls, .xlsx" MaxFileSize=@_maximumFileSizeInBytes>
                                        <UploaderEvents ValueChange="ValueChangeUploaderExcel" OnRemove="OnRemoveUploaderExcel"></UploaderEvents>
                                    </SfUploader>
                                </MudItem>
                                <MudItem xs="4">
                                    <MudGrid>
                                        <SfButton Content="Upload" CssClass="e-info d-flex justify-start mt-4 mr-2" IconCss="e-icons e-upload-1"
                                                  OnClick="OnClickUploadExcelAsync"></SfButton>
                                        <SfButton Content="Download" CssClass="e-info justify-end mt-4 mr-2" IconCss="e-icons e-download"
                                                  OnClick="OnClickDownloadExcelAsync"></SfButton>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudGrid>
}

                                        
<DialogAddAdmissionSuperiorLetter 
    Visibility="VisiblePopup"
    Title="@TitlePopup"
    IsEnabled="@IsEnabled"
    DialogOpen="DialogOpen" 
    DialogClose="DialogClose"
    OnClickNo="ClickedNo"
    OnClickYes="ClickedYes"
    listApplicants="_listApplicant"
    listUniversities="_dropdownUnivesity"
    listStudyTimes="_dropdownStudyTime"
    request="_createAdmissionSuperiorLetterRequest"
    IsEnableDocumentLoA="@IsEnableDocumentLoA"
    DocumentPathLoA="@DocumentPathLoA"
    OnRemoveUploaderLoA="OnRemoveUploaderLoA"
    ValueChangeUploaderLoA="ValueChangeUploaderLoA"
    IsEnableDocumentSuperiorApproval="@IsEnableDocumentSuperiorApproval"
    DocumentPathSuperiorApproval="@DocumentPathSuperiorApproval"
    OnRemoveUploaderSuperiorApproval="OnRemoveUploaderSuperiorApproval"
    ValueChangeUploaderSuperiorApproval="ValueChangeUploaderSuperiorApproval"
></DialogAddAdmissionSuperiorLetter>
