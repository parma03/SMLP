@using Smlp.Base.Universities.Enums
@using Smlp.Bsui.Features.Universities.Admission
@using Smlp.Domain.Entities.Masters
@using Smlp.Shared.Common.Responses
@using Smlp.Shared.Masters.Queries;
@using Smlp.Shared.Universities.AdmissionSuperiorLetter.Commands.Create
@using Smlp.Shared.Universities.AdmissionSuperiorLetter.Constants
@using Smlp.Shared.Universities.UniversityRecommendation.Queries
@using Syncfusion.Blazor.PdfViewerServer

<SfDialog Target="#target" Width="820px" ShowCloseIcon="true" @bind-Visible=Visibility>
    <DialogTemplates>
        <Header>@Title @DisplayTextFor.UniversityAdmissionSuperiorLetter</Header>
        <Content>
            <div class="row">
                <div class="col-md-12">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudCard>
                                <MudCardContent>
                                    <MudItem xs="12">
                                        <MudText>Applicant <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfDropDownList ID="ddlApllicant"
                                                                TValue="Guid"
                                                                TItem="ApplicantDropdown"
                                                                DataSource="@listApplicants"
                                                                Enabled="@IsEnabled"
                                                                @bind-Value="request!.ApplicantId"
                                                                AllowFiltering="true"
                                                                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                                                Placeholder="Select Applicant">
                                                    <DropDownListFieldSettings Text="Name" Value="Id" />
                                                </SfDropDownList>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>University <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfDropDownList ID="ddlSubject" 
                                                                TValue="Guid" 
                                                                TItem="GetUniversityRecommendationQueryResponse"
                                                                DataSource="@listUniversities" 
                                                                Enabled="@IsEnabled" 
                                                                @bind-Value="request!.UniversityRecommendationId"
                                                                AllowFiltering="true" 
                                                                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" 
                                                                Placeholder="Select Universitas">
                                                    <DropDownListFieldSettings Text="University" Value="Id" />
                                                    <DropDownListEvents TItem="GetUniversityRecommendationQueryResponse" TValue="Guid" ValueChange="OnChangeUniversityAsync" />
                                                </SfDropDownList>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Country</MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfTextBox ID="txtCountry" Placeholder="Input Country" @bind-Value="request!.Country" Enabled="false"></SfTextBox>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Full/Part Time <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfDropDownList ID="ddlTime" 
                                                            TValue="int" 
                                                            TItem="DropdownItemResponse" 
                                                            DataSource="@listStudyTimes" 
                                                            Enabled="@IsEnabled"
                                                            @bind-Value="request!.IsFulltime"
                                                            AllowFiltering="true" 
                                                            FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" 
                                                            Placeholder="Select Full/Part Time">
                                                    <DropDownListFieldSettings Text="Description" Value="Id" />
                                                </SfDropDownList>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudGrid>
                                            <MudItem xs="6">
                                                <MudText>Start Date <span style="color:red;">*</span></MudText>
                                                <MudGrid>
                                                    <MudItem xs="12">
                                                        <SfDatePicker TValue="DateOnly" Format="dd.MM.yyyy" ID="txtStartDate" @bind-Value="request!.StudyStart" Enabled="@IsEnabled"></SfDatePicker>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudItem>
                                            <MudItem xs="6">
                                                <MudText>EndDate <span style="color:red;">*</span></MudText>
                                                <MudGrid>
                                                    <MudItem xs="12">
                                                        <SfDatePicker TValue="DateOnly" Format="dd.MM.yyyy" ID="txtEndDate" @bind-Value="request!.StudyEnd" Enabled="@IsEnabled"></SfDatePicker>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Letter of Acceptance (.pdf) <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfUploader ID="uploaderLoA" 
                                                            AutoUpload="true" 
                                                            SequentialUpload="false" 
                                                            AllowMultiple="false"
                                                            AllowedExtensions=".pdf">
                                                    <UploaderEvents ValueChange="ValueChangeUploaderLoA" OnRemove="OnRemoveUploaderLoA"></UploaderEvents>
                                                </SfUploader>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" Class="mt-4">
                                        <MudText>Superior (Min. VP) Approval Letter (.pdf) <span style="color:red;">*</span></MudText>
                                        <MudGrid>
                                            <MudItem xs="12">
                                                <SfUploader ID="uploaderSuperiorApproval"
                                                            AutoUpload="true"
                                                            SequentialUpload="false"
                                                            AllowMultiple="false"
                                                            AllowedExtensions=".pdf">
                                                    <UploaderEvents ValueChange="ValueChangeUploaderSuperiorApproval" OnRemove="OnRemoveUploaderSuperiorApproval"></UploaderEvents>
                                                </SfUploader>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <SfButton Content="Cancel" CssClass="e-outline e-danger" IconCss="e-icons e-close" OnClick="OnClickNo"></SfButton>
            @if (IsEnabled == true)
            {
                <SfButton Content="Save" CssClass="e-success" IconCss="e-icons e-circle-check" OnClick="OnClickYes"></SfButton>
            }
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
    <DialogPositionData X="center" Y="center"></DialogPositionData>
    <DialogAnimationSettings Effect="DialogEffect.None"></DialogAnimationSettings>
</SfDialog>

@code {
    [Parameter]
    public bool IsEnabled { get; set; }

    [Parameter]
    public bool Visibility { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public EventCallback DialogOpen { get; set; }

    [Parameter]
    public EventCallback DialogClose { get; set; }

    [Parameter]
    public EventCallback OnClickNo { get; set; }

    [Parameter]
    public EventCallback OnClickYes { get; set; }

    [Parameter]
    public List<ApplicantDropdown>? listApplicants { get; set; }

    [Parameter]
    public List<GetUniversityRecommendationQueryResponse>? listUniversities { get; set; }

    [Parameter]
    public List<DropdownItemResponse>? listStudyTimes { get; set; }

    [Parameter]
    public CreateAdmissionSuperiorLetterRequest? request { get; set; }

    [Parameter]
    public bool IsEnableDocumentLoA { get; set; }

    [Parameter]
    public string? DocumentPathLoA { get; set; }

    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemoveUploaderLoA { get; set; }

    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChangeUploaderLoA { get; set; }

    [Parameter]
    public bool IsEnableDocumentSuperiorApproval { get; set; }

    [Parameter]
    public string? DocumentPathSuperiorApproval { get; set; }

    [Parameter]
    public EventCallback<RemovingEventArgs> OnRemoveUploaderSuperiorApproval { get; set; }

    [Parameter]
    public EventCallback<UploadChangeEventArgs> ValueChangeUploaderSuperiorApproval { get; set; }

    protected async Task OnChangeUniversityAsync(ChangeEventArgs<Guid, GetUniversityRecommendationQueryResponse> args)
    {
        if(args.ItemData is not null)
        {
            request!.Country = args.ItemData.Country;
        }

        await Task.CompletedTask;
    }
}
