@using Psmp.Base.Universities.Enums
@using Psmp.Bsui.Features.Universities.Components
@using Psmp.Shared.Common.Responses
@using Psmp.Shared.Selections.SelectionOverviews.Queries
@using Psmp.Bsui.Features.Universities.Recommendation
@using Psmp.Shared.Masters.Queries;
@using Psmp.Shared.Universities.UniversityRecommendation.Queries
@using Psmp.Shared.Universities.UniversityRecommendation.Constants

<style>
    .e-chip-list {
        display: inline !important
    }

    .e-upload .e-file-select-wrap, .e-bigger.e-small .e-upload .e-file-select-wrap {
        padding: 5px 0 5px 5px; /* Sesuaikan padding untuk tampilan yang lebih kompak */
    }

    .sf-uploader-compact .e-file-container {
        margin: 2px 0; /* Mengurangi margin antar file */
    }
</style>

<ErrorViewer Error="_error" />
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>
@if (_isLoading)
{
    <Loading IsVisible="_isLoading" />
}
else
{
    <MudGrid Spacing="2">
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12">
                <MudText Typo="Typo.body2" HtmlTag="h3">University Recommendation Filter</MudText>
            </MudItem>
        </MudGrid>
        <MudGrid Spacing="2" Class="mb-4">
            <MudItem xs="2">
                <MudText>Categories</MudText>
                <SfDropDownList ID="ddlSelectionCategory" TValue="UniversityCategory" TItem="DropdownEnumResponse<UniversityCategory>" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_dropdownEnumCategories" Placeholder="All Category" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Description" Value="Id" />
                    <DropDownListEvents TItem="DropdownEnumResponse<UniversityCategory>" TValue="UniversityCategory" ValueChange="OnChangeCategoryAsync" />
                </SfDropDownList>
            </MudItem>
            <MudItem xs="2">
                <MudText>Subject</MudText>
                <SfDropDownList ID="ddlSelectionSubject" TValue="int" TItem="GetScholarshipSubjectQueryResponse" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_subjects" @bind-Value="_subject" Placeholder="All Subject" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Name" Value="Id" />
                    <DropDownListEvents TItem="GetScholarshipSubjectQueryResponse" TValue="int" ValueChange="OnChangeSubjectAsync" />
                </SfDropDownList>
            </MudItem>
            <MudItem xs="2">
                <MudText>Year</MudText>
                <SfDropDownList ID="ddlSelectionYear" TValue="int" TItem="DropdownItemResponse" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_dropdownYear" Placeholder="All Year" ShowClearButton="true">
                    <DropDownListFieldSettings Text="Description" Value="Id" />
                    <DropDownListEvents TItem="DropdownItemResponse" TValue="int" ValueChange="OnChangeYearAsync" />
                </SfDropDownList>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mb-2">
            <MudItem xs="12">
                <MudCard Class="pa-4" Elevation="2">
                    <MudCardContent>
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Class="mb-4">
                                <MudText Style="font-size: 15px;" Class="mb-1">
                                    <b>For more university recommendation information, please visit :</b>
                                </MudText>
                                @{
                                    string link1 = "https://www.timeshighereducation.com/world-university-rankings/2024/world-ranking#!/length/50/sort_by/rank/sort_order/asc/cols/scores";
                                    string link2 = "https://www.topuniversities.com/world-university-rankings?tab=indicators&sort_by=rank&order_by=asc/";
                                    string link3 = "https://www.shanghairanking.com/rankings/arwu/2024";
                                    string link4 = "https://www.banpt.or.id/direktori/institusi/pencarian_institusi.php";

                                    // string TruncateLink(string link, int length) =>
                                    // link.Length > length ? link.Substring(0, length) + "..." : link;
                                }
                                <MudText>
                                    1. <MudLink Href="@link1" Target="_blank" Color="Color.Info" Style="font-size: 15px;">The World Rank University</MudLink><br>
                                    2. <MudLink Href="@link2" Target="_blank" Color="Color.Info" Style="font-size: 15px;">QS World Rank University</MudLink><br>
                                    3. <MudLink Href="@link3" Target="_blank" Color="Color.Info" Style="font-size: 15px;">ARWU World Rank University</MudLink><br>
                                    4. <MudLink Href="@link4" Target="_blank" Color="Color.Info" Style="font-size: 15px;">National Accreditation University</MudLink>
                                </MudText>
                            </MudAlert>
                            <MudGrid Spacing="2" Class="mb-1">
                                <MudItem xs="12" md="6">
                                    <MudGrid Class="d-flex align-center justify-start">
                                        <MudItem>
                                            <MudText Typo="Typo.h6" Class="ms-0">List of University</MudText>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudGrid Class="d-flex flex-wrap align-center justify-start justify-md-end">
                                        <MudItem>
                                            <SfButton OnClick="OnClickAddAsync" IsPrimary="true" Content="Add" IconCss="e-icons e-circle-add" CssClass="mr-2"></SfButton>
                                            <SfProgressButton ID="zoomOutButton" Content="Export to Excel" @onclick="ExportExcel" EnableProgress="true" CssClass="fw-bold" IconCss="e-icons e-download" Style="background: linear-gradient(to right, #4279db, #1c4185); color: white;">
                                                <ProgressButtonSpinSettings Position="SpinPosition.Center"></ProgressButtonSpinSettings>
                                                <ProgressButtonAnimationSettings Effect="Syncfusion.Blazor.SplitButtons.AnimationEffect.ZoomOut"></ProgressButtonAnimationSettings>
                                            </SfProgressButton>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                            <SfGrid @ref="Grid" DataSource="@_universityRecommendations" Toolbar="@(new List<string>() { "Search" })" AllowExcelExport="true" AllowFiltering="true" AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true">
                                <GridPageSettings PageCount="5" PageSize="10" PageSizes="@(new string[] { "10", "15", "20", "All" })"></GridPageSettings>
                                <GridEvents ExcelQueryCellInfoEvent="ExcelQueryCellInfoHandler" OnToolbarClick="ToolbarClickHandler" RowDataBound="RowBound" CommandClicked="OnCommandClicked" TValue="GetUniversityRecommendationQueryResponse"></GridEvents>
                                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                                <GridColumns>
                                    <GridColumn Field=@nameof(GetUniversityRecommendationQueryResponse.Id) IsPrimaryKey="true" Visible="false"></GridColumn>
                                    <GridColumn Field=@nameof(GetUniversityRecommendationQueryResponse.University) HeaderText="University" Width="250"></GridColumn>
                                    <GridColumn Field=@nameof(GetUniversityRecommendationQueryResponse.Country) HeaderText="Country" Width="150"></GridColumn>
                                    <GridColumn Field=@nameof(GetUniversityRecommendationQueryResponse.OfficialWebsite) HeaderText="Official Website" Width="150">
                                        <Template Context="context">
                                            @{
                                                var offical = ((GetUniversityRecommendationQueryResponse)context).OfficialWebsite;
                                            }

                                            <MudLink Href="@offical" Target="_blank">@offical</MudLink>
                                        </Template>
                                    </GridColumn>
                                    @* <GridColumn Field=@nameof(GetUniversityRecommendationQueryResponse.RegistrationLink) HeaderText="Registration Link" Width="150">
                                        <Template Context="context">
                                            @{
                                                var regis = ((GetUniversityRecommendationQueryResponse)context).RegistrationLink;
                                            }

                                            <MudLink Href="@regis" Target="_blank">@regis</MudLink>
                                        </Template>
                                    </GridColumn> *@
                                    @* <GridColumn Field=@nameof(GetUniversityRecommendationQueryResponse.Dateline) HeaderText="Deadline" Format="d" Type="ColumnType.Date" Width="100"></GridColumn> *@
                                    <GridColumn HeaderText="Action" TextAlign="TextAlign.Center" Width="150">
                                        <GridCommandColumns>
                                            <GridCommandColumn Title="View" Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-eye", CssClass="e-flat" })"></GridCommandColumn>
                                            <GridCommandColumn Title="Edit" Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-edit", CssClass="e-flat" })"></GridCommandColumn>
                                            <GridCommandColumn Title="Delete" Type="CommandButtonType.Delete" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-delete", CssClass="e-flat" })"></GridCommandColumn>
                                        </GridCommandColumns>
                                    </GridColumn>
                                </GridColumns>
                            </SfGrid>
                        </MudItem>

                        <MudItem xs="12" Class="mt-8">
                            <MudText>File Upload (.xls, .xlsx) <span style="color:red;">*</span></MudText>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="font-style: italic; font-size: 0.8rem;">
                                <b>(Maximum Size 5 Mb)</b>
                            </MudText>
                            <MudGrid Class="mt-0">
                                <MudItem xs="8" class="d-flex align-center">
                                    <SfUploader @ref="_uploadObj" ID="uploaderExcel" AutoUpload="true" SequentialUpload="false" AllowMultiple="false"
                                                AllowedExtensions=".xls, .xlsx" MaxFileSize=@_maximumFileSizeInBytes>
                                        <UploaderEvents ValueChange="ValueChangeUploaderExcel" OnRemove="OnRemoveUploaderExcel"></UploaderEvents>
                                    </SfUploader>
                                </MudItem>
                                <MudItem xs="4">
                                    <MudGrid>
                                        <SfButton Content="Upload" CssClass="e-info d-flex justify-start mt-4 mr-2" IconCss="e-icons e-upload-1"
                                                  OnClick="OnClickUploadExcelAsync"></SfButton>
                                        <SfButton Content="Download" CssClass="e-info justify-end mt-4 mr-2" IconCss="e-icons e-download"
                                                  OnClick="OnClickDownloadExcelAsync"></SfButton>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudGrid>
}


<DialogAddRecommendation 
    Visibility="VisiblePopup"
    Title="@TitlePopup"
    DialogOpen="DialogOpen" 
    DialogClose="DialogClose"
    OnClickNo="ClickedNo" 
    OnClickYes="ClickedYes"
    request="_createUniversityRecommendationRequest"
    IsEnabled="@IsEnabled"
    listCategories="_dropdownEnumCategories"
    listSubject="_subjects"
></DialogAddRecommendation>

<DialogConfirmation 
    Visibility="VisiblePopupDelete"
    Title="@DisplayTextFor.UniversityRecommendation"
    Content="<p style='padding:20px;'>Are you sure want to delete this data?</p>"
    DialogOpen="DialogDeleteOpen" 
    DialogClose="DialogDeleteClose"
    OnClickNo="ClickedNoDelete" 
    OnClickYes="ClickedYesDelete"
></DialogConfirmation>


<style>
    .e-removeDeletecommand .e-unboundcell .e-unboundcelldiv button.e-Deletebutton {
        display: none;
    }
</style>
