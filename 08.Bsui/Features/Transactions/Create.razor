@attribute [Authorize(Roles = "Admin,Owner,Kasir")]
@page "/Transactions/Create"

<BrowserTabTitle>Input Transaksi</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>
<PageHeader Title="Input Transaksi Baru" Icon="@Icons.Material.Filled.AddCircle" />

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}

<MudGrid>
    @* Left Panel - Customer & Payment Info *@
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4 rounded-lg mb-4" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:#6F4E37; font-weight:700;">
                <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-1" />
                Data Pelanggan
            </MudText>

            <div class="d-flex gap-2 mb-3">
                <MudTextField @bind-Value="_memberSearch"
                              Label="Cari No. HP / Kode Member"
                              Variant="Variant.Outlined"
                              Placeholder="Contoh: 0812345678 atau MBR-001"
                              OnKeyUp="OnMemberSearchKeyUp"
                              FullWidth="true" />
                <MudButton Variant="Variant.Filled"
                           Style="background:#6F4E37; color:white; min-width:80px;"
                           OnClick="SearchCustomerAsync"
                           Disabled="@_isSearching">
                    @if (_isSearching)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Search" />
                    }
                </MudButton>
            </div>

            @if (_selectedCustomer is not null)
            {
                <MudPaper Class="pa-3 rounded" Elevation="0" Style="background:#FFF3E0; border:1px solid #FFB74D;">
                    <div class="d-flex justify-space-between align-start">
                        <div class="d-flex align-center">
                            <MudAvatar Style="background:#C8860A; color:white;" Class="mr-3">
                                @(_selectedCustomer.FullName.FirstOrDefault())
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.subtitle2">@_selectedCustomer.FullName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@_selectedCustomer.PhoneNumber</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@_selectedCustomer.MemberCode</MudText>
                                <div class="d-flex align-center mt-1">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="mr-1">@_selectedCustomer.Tier</MudChip>
                                    <MudText Typo="Typo.caption" Style="color:#C8860A;">
                                        ⭐ @_selectedCustomer.TotalPoints.ToString("N0") poin
                                    </MudText>
                                </div>
                            </div>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default"
                                       OnClick="ClearCustomer" />
                    </div>
                </MudPaper>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Masukkan No. HP atau kode member, lalu tekan Enter atau klik 🔍 untuk mencari pelanggan.
                </MudAlert>
            }
        </MudPaper>

        <MudPaper Class="pa-4 rounded-lg" Elevation="2">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:#6F4E37; font-weight:700;">
                <MudIcon Icon="@Icons.Material.Filled.Payment" Class="mr-1" />
                Pembayaran (Diluar Sistem)
            </MudText>
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                Pembayaran dilakukan langsung di kasir. Sistem hanya mencatat untuk loyalitas.
            </MudAlert>
            <MudSelect @bind-Value="_paymentMethod" Label="Metode Pembayaran" Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem Value="@(PaymentMethod.Tunai)">💵 Tunai</MudSelectItem>
                <MudSelectItem Value="@(PaymentMethod.Qris)">📱 QRIS</MudSelectItem>
                <MudSelectItem Value="@(PaymentMethod.TransferBank)">🏦 Transfer Bank</MudSelectItem>
                <MudSelectItem Value="@(PaymentMethod.EWallet)">💳 E-Wallet (GoPay, OVO, Dana)</MudSelectItem>
                <MudSelectItem Value="@(PaymentMethod.Debit)">💳 Kartu Debit</MudSelectItem>
                <MudSelectItem Value="@(PaymentMethod.Kredit)">💳 Kartu Kredit</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_notes"
                          Label="Catatan"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Placeholder="Catatan opsional..." />
        </MudPaper>
    </MudItem>

    @* Right Panel - Items & Summary *@
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4 rounded-lg mb-4" Elevation="2">
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.subtitle1" Style="color:#6F4E37; font-weight:700;">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-1" />
                    Item Pembelian
                </MudText>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add"
                           Color="Color.Primary"
                           OnClick="@AddItem">
                    Tambah Item
                </MudButton>
            </div>

            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th style="width:40%">Produk / Menu</th>
                        <th style="text-align:right; width:22%">Harga (Rp)</th>
                        <th style="text-align:center; width:12%">Qty</th>
                        <th style="text-align:right; width:18%">Subtotal</th>
                        <th style="width:8%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td>
                                <MudAutocomplete T="string"
                                                 @bind-Value="item.ProductName"
                                                 SearchFunc="@(async (search, ct) => await SearchProductsAsync(search, item, ct))"
                                                 Dense="true"
                                                 Variant="Variant.Text"
                                                 Placeholder="Cari / ketik nama produk..."
                                                 ResetValueOnEmptyText="false"
                                                 CoerceText="true"
                                                 MinCharacters="0"
                                                 AdornmentIcon="@Icons.Material.Filled.Search"
                                                 AdornmentColor="Color.Primary" />
                            </td>
                            <td>
                                <MudNumericField @bind-Value="item.UnitPrice" Variant="Variant.Text" Dense="true"
                                                 Format="N0" Min="0" HideSpinButtons="true" />
                            </td>
                            <td style="text-align:center">
                                <MudNumericField @bind-Value="item.Quantity" Variant="Variant.Text" Dense="true"
                                                 Min="1" Max="99" />
                            </td>
                            <td style="text-align:right">
                                <MudText Style="color:#2E7D32; font-weight:600;">
                                    Rp @((item.UnitPrice * item.Quantity).ToString("N0"))
                                </MudText>
                            </td>
                            <td>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => RemoveItem(item))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            @if (!_items.Any())
            {
                <MudText Class="pa-3 text-center" Color="Color.Secondary">
                    Belum ada item. Klik "Tambah Item" untuk mulai.
                </MudText>
            }
        </MudPaper>

        @* Transaction Summary *@
        <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="border: 2px solid #6F4E37;">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:#6F4E37; font-weight:700;">
                <MudIcon Icon="@Icons.Material.Filled.Summarize" Class="mr-1" />
                Ringkasan Transaksi
            </MudText>

            <div class="d-flex justify-space-between mb-1">
                <MudText>Subtotal (@_items.Count item)</MudText>
                <MudText Style="font-weight:600;">Rp @Subtotal.ToString("N0")</MudText>
            </div>

            @* Discount Section *@
            <MudPaper Class="pa-3 rounded mb-2" Elevation="0" Style="background:#FFF3E0; border:1px solid #FFCCBC;">
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.caption" Style="font-weight:600; color:#E64A19;">
                        🏷️ DISKON
                    </MudText>
                    <MudToggleGroup T="bool" @bind-Value="_usePercentDiscount" Size="Size.Small">
                        <MudToggleItem Value="true" Text="%" />
                        <MudToggleItem Value="false" Text="Rp" />
                    </MudToggleGroup>
                </div>
                @if (_usePercentDiscount)
                {
                    <MudNumericField @bind-Value="_discountPercent"
                                     Label="Diskon (%)"
                                     Variant="Variant.Outlined"
                                     Min="0" Max="100"
                                     Adornment="Adornment.End" AdornmentText="%"
                                     Dense="true" />
                }
                else
                {
                    <MudNumericField @bind-Value="_discountAmount"
                                     Label="Diskon (Rp)"
                                     Variant="Variant.Outlined"
                                     Min="0"
                                     Format="N0"
                                     Dense="true" />
                }
                @if (DiscountValue > 0)
                {
                    <div class="d-flex justify-space-between mt-1">
                        <MudText Typo="Typo.caption" Color="Color.Error">Potongan</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Error" Style="font-weight:700;">- Rp @DiscountValue.ToString("N0")</MudText>
                    </div>
                }
            </MudPaper>

            <MudDivider Class="my-2" />
            <div class="d-flex justify-space-between mb-2">
                <MudText Typo="Typo.h6" Style="color:#6F4E37; font-weight:700;">Total</MudText>
                <MudText Typo="Typo.h6" Style="color:#6F4E37; font-weight:700;">Rp @GrandTotal.ToString("N0")</MudText>
            </div>

            <MudPaper Class="pa-3 rounded mb-3" Elevation="0" Style="background:#FFF8E1; border:1px solid #FFE082;">
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Stars" Style="color:#C8860A;" Class="mr-2" />
                    <div>
                        <MudText Typo="Typo.body2">Poin yang akan diperoleh pelanggan</MudText>
                        <MudText Typo="Typo.h6" Style="color:#C8860A; font-weight:700;">
                            ⭐ @EstimatedPoints poin
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Rp 10.000 = 1 poin (estimasi, final sesuai aturan poin aktif)
                        </MudText>
                    </div>
                </div>
            </MudPaper>

            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Href="@CommonRouteFor.Transactions">
                    Batal
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Style="background:#6F4E37; color:white; flex:1;"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="@SaveTransaction"
                           Disabled="@(_selectedCustomer is null || !_items.Any(i => !string.IsNullOrWhiteSpace(i.ProductName)) || _isLoading)">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Simpan Transaksi & Tambah Poin
                </MudButton>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>
