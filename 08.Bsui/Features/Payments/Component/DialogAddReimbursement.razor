<SfDialog IsModal="true" Target="#targetReimbursement" Width="820px" ShowCloseIcon="true" @bind-Visible=Visibility>
	<DialogTemplates>
		<Header>@Title</Header>
		<Content>
			<div class="row">
				<div class="col-md-12">
					<MudGrid Spacing="2">
						<MudItem xs="12">
							<MudCard Elevation="0">
								<MudCardContent>
									<MudItem xs="12">
										<MudGrid>
											<MudItem xs="4">
												<MudText>Employee Number</MudText>
											</MudItem>
											<MudItem xs="8">
												<SfTextBox ID="txtEmployeeNumber" Placeholder="EmployeeNumber" @bind-Value="EmployeeNumber" Enabled="false"></SfTextBox>
											</MudItem>
										</MudGrid>
									</MudItem>

									<MudItem xs="12">
										<MudGrid AlignItems="center">
											<MudItem xs="4">
												<MudText>Name</MudText>
											</MudItem>
											<MudItem xs="5">
												<SfTextBox ID="txName" Placeholder="Name" @bind-Value="Name" Enabled="false"></SfTextBox>
											</MudItem>
											<MudItem xs="3" Class="d-flex justify-end">
												<MudButton Variant="Variant.Filled"
														   Color="Color.Primary"
														   OnClick="OnCheckProfileClicked"
														   Class="no-uppercase">
													Check Profile
												</MudButton>
											</MudItem>
										</MudGrid>
									</MudItem>

									<!-- REQUEST DATE -->
									<MudItem xs="12">
										<MudGrid>
											<MudItem xs="4">
												<MudText>Request Date</MudText>
											</MudItem>
											<MudItem xs="8">
												<SfDatePicker TValue="DateOnly ?"
															  Format="dd.MM.yyyy"
															  Placeholder="Choose a Date"
															  FullScreen="true"
															  ShowClearButton="true"
															  @bind-Value="Data!.RequestDate"
															  Enabled="false" />
											</MudItem>
										</MudGrid>
									</MudItem>

									<MudItem xs="12">
										<MudGrid>
											<MudItem xs="4">
												<MudText>Request ID</MudText>
											</MudItem>
											<MudItem xs="8">
												<SfTextBox ID="txtRequestID" Placeholder="Request ID" @bind-Value="Data!.RequestId" Enabled="false"></SfTextBox>
											</MudItem>
										</MudGrid>
									</MudItem>

									<MudItem xs="12">
										<MudGrid>
											<MudItem xs="4">
												<MudText>Category <span style="color:red;">*</span></MudText>
											</MudItem>
											<MudItem xs="8">
												<SfDropDownList ID="ddlCategory" TValue="int" TItem="DropdownItemResponse" Enabled="false" DataSource="@Category" @bind-Value="Data!.CategoryId"
																Placeholder="Select category">
													<DropDownListEvents TItem="DropdownItemResponse" TValue="int" ValueChange="@OnChangeItemAsync"></DropDownListEvents>
													<DropDownListFieldSettings Text="Description" Value="Id" />
												</SfDropDownList>
											</MudItem>
										</MudGrid>
									</MudItem>

									<!-- AMOUNT -->
									<MudItem xs="12">
										<MudGrid>
											<MudItem xs="4">
												<MudText>Amount <span style="color:red;">*</span></MudText>
											</MudItem>

											<MudItem xs="3">
												<SfDropDownList ID="ddlCurency" TValue="int" TItem="DropdownItemResponse" Enabled="false" DataSource="@Curency" @bind-Value="Data!.CurrencyType"
																Placeholder="Select Currency">
													<DropDownListFieldSettings Text="Description" Value="Id" />
												</SfDropDownList>
											</MudItem>
											<MudItem xs="5">
												<SfNumericTextBox ID="txtAmount" Placeholder="Amount" Format="n2" @bind-Value="Data!.Amount" Enabled="false" Min="0"></SfNumericTextBox>
											</MudItem>
										</MudGrid>
									</MudItem>

									@if (_condition || Data!.CategoryId == 14)
									{
										<MudItem xs="12">
											<MudGrid>
												<MudItem xs="4">
													<MudText>IBAN/SWIFT Code</MudText>
												</MudItem>
												<MudItem xs="8">
													<SfTextBox ID="txtIBAN" Placeholder="IBAN/SWIFT Code" @bind-Value="Data!.IBANCode" Enabled="false"></SfTextBox>
												</MudItem>
											</MudGrid>
										</MudItem>
										<MudItem xs="12">
											<MudGrid>
												<MudItem xs="4">
													<MudText>University Bank Name</MudText>
												</MudItem>
												<MudItem xs="8">
													<SfTextBox ID="txtIBAN" Placeholder="University Bank Name" @bind-Value="Data!.UniversityBank" Enabled="false"></SfTextBox>
												</MudItem>
											</MudGrid>
										</MudItem>
										<MudItem xs="12">
											<MudGrid>
												<MudItem xs="4">
													<MudText>University Bank Account</MudText>
												</MudItem>
												<MudItem xs="8">
													<SfTextBox ID="txtUniversityBankAccount" Placeholder="University Bank Account" @bind-Value="Data!.UniversityBankAccount" Enabled="false"></SfTextBox>
												</MudItem>
											</MudGrid>
										</MudItem>
										<MudItem xs="12">
											<MudGrid>
												<MudItem xs="4">
													<MudText>Due Date</MudText>
												</MudItem>
												<MudItem xs="8">
													<SfDatePicker TValue="DateOnly ?" Format="dd.MM.yyyy" Placeholder="Choose a Date" FullScreen="true" ShowClearButton="true" @bind-Value="Data!.DueDate" Enabled="false" Min="@DateTime.UtcNow"></SfDatePicker>
												</MudItem>
											</MudGrid>
										</MudItem>
									}

									<!-- NOTES -->
									<MudItem xs="12" class="mb-2">
										<MudGrid>
											<MudItem xs="4">
												<MudText>Notes <span style="color:red;">*</span></MudText>
											</MudItem>
											<MudItem xs="8">
												<SfTextArea ID="txtNotes" RowCount="3" ColumnCount="1000" Placeholder="Input Notes" @bind-Value="Data!.Notes" Disabled="true"></SfTextArea>
											</MudItem>
										</MudGrid>
									</MudItem>

									<!-- UPLOADER (no event handlers) -->
									<MudItem xs="12" Class="mb-2">
										<MudText>@(_category ?? "Payment Invoice Document (.pdf)") <span style="color: red;">*</span></MudText>
										<MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="font-style: italic; font-size: 0.8rem;">
											<b>(Maximum Size 5 Mb)</b>
										</MudText>
										<MudGrid Class="mt-1">
											<MudItem xs="12">
												<SfUploader ID="uploaderReimbursement" AutoUpload="true" SequentialUpload="false" AllowMultiple="false" Enabled="false"
															AllowedExtensions=".pdf">
												</SfUploader>
											</MudItem>
										</MudGrid>
									</MudItem>
									<br />
									@if (listDocument!.Count() > 0)
									{
										<MudItem xs="12" Class="mb-2">
											<SfGrid DataSource="@listDocument" AllowPaging="true" Width="100%" AllowResizing="true">
												<GridPageSettings PageCount="8" PageSize="8" PageSizes="@SyncfusionGridValue.PageSize"></GridPageSettings>
												<GridEvents CommandClicked="OnCommandClicked" TValue="GetDocumentsDocument"></GridEvents>
												<GridColumns>
													<GridColumn Field=@nameof(GetDocumentsDocument.FileName) HeaderText="Filename" TextAlign="TextAlign.Left" Width="80%"> </GridColumn>
													<GridColumn HeaderText="Action" Width="20%" TextAlign="TextAlign.Center">
														<GridCommandColumns>
															<GridCommandColumn ID="btnDownload" Title="Download" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-download", CssClass = "e-flat" })"> </GridCommandColumn>
															@* <GridCommandColumn ID="btnDelete" Title="Delete" ButtonOption="@(new CommandButtonOptions() {IconCss="e-icons e-delete", CssClass="e-flat" })"> </GridCommandColumn> *@
														</GridCommandColumns>
													</GridColumn>
												</GridColumns>
											</SfGrid>
										</MudItem>
									}

									<MudDivider Class="my-4" />

									<MudItem xs="12" Class="mb-2">
										<MudGrid>
											<MudItem xs="12">
												<Stepper StepperData="@StepperData" CurrentPaymentStatus="@Data?.PaymentStatus" />
											</MudItem>
										</MudGrid>
									</MudItem>
								</MudCardContent>
							</MudCard>
						</MudItem>
					</MudGrid>
					<MudGrid Spacing="2">
						<MudItem xs="12" Class="mb-4">
							@{
								var position = "";
								@if (ListPaymentComment is not null)
								{
									<main class="msger-chat" style="height:200px;overflow: auto;">

										@foreach (var message in ListPaymentComment)
										{
											position = message.User == UserLogin ? "right-msg" : "left-msg";
											<div class="msg @position">
												<div class="msg-bubble">
													@* <div class="msg-info d-flex align-items-center gap-0">
                                                        <div class="msg-info-name fw-bold">@message.User</div>
                                                        @if (message.Status.HasValue)
                                                        {
                                                            <MudChip T="string"
                                                                     Size="Size.Small"
                                                                     Color="@GetStatusColor(message.Status.Value)"
                                                                     Variant="Variant.Filled"
                                                                     StartIcon="@GetStatusIcon(message.Status.Value)">
                                                                @message.Status.Value.GetDisplayName()
                                                            </MudChip>
                                                        }
                                                        <div class="msg-info-time ms-auto">
                                                            @message.Date.ToString("dd.MM.yyyy HH:mm:ss")
                                                        </div>
                                                    </div> *@
													<div class="msg-info d-flex align-items-center gap-2">
														<div class="msg-info-name fw-bold">@message.User</div>
														@{
															var (statusText, cleanComment) = ExtractStatusFromComment(message.Comment);
															if (!string.IsNullOrEmpty(statusText))
															{
																<MudChip T="string"
																		 Size="Size.Small"
																		 Color="@GetStatusColorFromText(statusText)"
																		 Variant="Variant.Filled"
																		 Icon="@GetStatusIconFromText(statusText)">
																	@FormatStatusText(statusText)
																</MudChip>
															}
														}
														@* <div class="msg-info-time ms-auto">
                                                        @message.Date.ToString("dd.MM.yyyy HH:mm:ss")
                                                    </div> *@
													</div>

													<div class="msg-text mt-2 mb-1">
														@{
															var (_, displayComment) = ExtractStatusFromComment(message.Comment);
															@displayComment
														}
													</div>

													<div class="msg-info-time" style="font-size: 0.75em; color: @(position == "right-msg" ? "#fff" : "#666"); text-align: right;">
														@message.Date.ToString("dd.MM.yyyy HH:mm:ss tt")
													</div>
												</div>
											</div>
										}
									</main>
								}
							}
							<div class="msger-inputarea">
								<input type="text" class="msger-input" @bind-value="_message" placeholder="Enter your message...">
								<button @onclick="SubmitComment" class="msger-send-btn">Send</button>
							</div>
						</MudItem>
					</MudGrid>
				</div>
			</div>
		</Content>
		@* <FooterTemplate>
            <SfButton Content="Reject" CssClass="e-danger" IconCss="e-icons e-close" OnClick="() => OnApprovalClick(PaymentStatus.Rejected)"></SfButton>
            <SfButton Content="Pending" CssClass="e-grey" IconCss="e-icons e-clock" OnClick="() => OnApprovalClick(PaymentStatus.Pending)"></SfButton>
            <SfButton Content="Need Revision" CssClass="e-warning" IconCss="e-icons e-warning icon-white" OnClick="() => OnApprovalClick(PaymentStatus.NeedRevision)"></SfButton>
            <SfButton Content="Approve" CssClass="e-info" IconCss="e-icons e-check" OnClick="() => OnApprovalClick(PaymentStatus.Approved)"></SfButton>
		</FooterTemplate> *@
		<FooterTemplate>
            @{
                var status = Data?.PaymentStatus ?? PaymentStatus.NewRequest;
                var showAllButtons = status == PaymentStatus.WaitingApproval;
				var showReject = showAllButtons || status == PaymentStatus.Pending;
				var showNeedRevision = showAllButtons || status == PaymentStatus.Pending;
				var showApprove = (showAllButtons || status == PaymentStatus.Pending) && !IsApproveDisabled;
				var showPending = showAllButtons;
			}

			@if (showReject)
			{
				<SfButton Content="Reject" CssClass="e-danger" IconCss="e-icons e-close" OnClick="() => OnApprovalClick(PaymentStatus.Rejected)"></SfButton>
			}

			@if (showPending)
			{
				<SfButton Content="Pending" CssClass="e-grey" IconCss="e-icons e-clock" OnClick="() => OnApprovalClick(PaymentStatus.Pending)"></SfButton>
			}

			@if (showNeedRevision)
			{
				<SfButton Content="Need Revision" CssClass="e-warning" IconCss="e-icons e-warning icon-white" OnClick="() => OnApprovalClick(PaymentStatus.NeedRevision)"></SfButton>
			}

			@if (showApprove)
			{
				@if (Data?.CategoryId == 14)
				{
					<SfButton Content="Create BA" CssClass="e-info" IconCss="e-icons e-check" OnClick="() => OnDraftBAClick()"></SfButton>
				}
				else
				{
					<SfButton Content="Approve" CssClass="e-info" IconCss="e-icons e-check" OnClick="() => OnApprovalClick(PaymentStatus.Approved)"></SfButton>
				}
			}
        </FooterTemplate>
	</DialogTemplates>
	<DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
	<DialogPositionData X="center" Y="center"></DialogPositionData>
	<DialogAnimationSettings Effect="DialogEffect.None"></DialogAnimationSettings>
</SfDialog>
<DialogValidation SecondDialogClick="HandleApprovalConfirmationAsync"
				  SecondVisibility="VisibilityValidation"
				  SecondDialogClickClose="CloseSubmitedDialog"
				  Title="@dialogTitle"
				  SubTitle="@dialogSubTitle"
				  CondStatus="@_condSTatus"
				  Comment="@dialogComment">
</DialogValidation>

@code {
