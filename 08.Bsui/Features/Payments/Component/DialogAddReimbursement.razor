	private async Task OnSubmit()
	{
		VisibilityValidation = true;
		await InvokeAsync(StateHasChanged);
	}

	private async Task CloseSubmitedDialog()
	{
		VisibilityValidation = false;
	}

	private async Task OnApprovalClick(PaymentStatus status)
	{

		dialogTitle = status.GetDisplayName();

		var subtitleStatus = status switch
		{
			PaymentStatus.Approved => "approve",
			PaymentStatus.Rejected => "reject",
			PaymentStatus.Pending => "set to pending on",
			PaymentStatus.NeedRevision => "request a revision on",
			_ => ""
		};

		// biar status untuk approve jadi request Preperation
		if (status == PaymentStatus.Approved)
			_condSTatus = PaymentStatus.RequestPreparation;
		else _condSTatus = status;

		dialogSubTitle = $"Are you sure you want to {subtitleStatus} this request? ";
		VisibilityValidation = true;
		await InvokeAsync(StateHasChanged);
	}
	private string FormatStatusText(string statusText)
	{
		if (string.IsNullOrEmpty(statusText))
			return statusText;

		if (statusText.ToUpper().Contains("PREPARATION"))
		{
			return "Approved";
		}

		// Ubah ke lowercase dan kapitalisasi huruf pertama setiap kata
		var words = statusText.ToLower().Split(' ');
		for (int i = 0; i < words.Length; i++)
		{
			if (!string.IsNullOrEmpty(words[i]))
			{
				words[i] = char.ToUpper(words[i][0]) + words[i].Substring(1);
			}
		}
		return string.Join(" ", words);
	}
