				16 => "Invoice, Proof of transfer (if by transfer) & Official confirmation of payment from the organizer (.pdf)", // TOEFL Preparation
				17 => "Invoice, Proof of transfer (if by transfer) & Official confirmation of payment from the organizer (.pdf)", // GRE Preparation
