    }

    private async Task SubmitComment()
    {
        var request = new PaymentCommentRequest()
		{
			PaymentId = (Guid)Data.IdReimbursement,
			Comment = _message,
			User = UserLogin,
			Status = _condSTatus
		};

        var response = await _paymentService.CreatePaymentCommentAsync(request);
        if (response.Error is null)
        {
            _message = default!;
            await LoadComment();
        }
