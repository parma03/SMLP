@using static Psmp.Bsui.Features.Payments.Index

<MudGrid xs="12" Spacing="2" Class="mb-4">
    <MudItem xs="4">
        <MudText>H/ SH/ AP&P</MudText>
                <SfDropDownList 
                    ID="ddlSelectionHPS"
                    TValue="int?"
                    TItem="DropdownItemResponse"
                    AllowFiltering="true"
                    FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                        DataSource="@PaymentFilters.DropdownHps"
                    Placeholder="Select H/SH/AP&P"
                        @bind-Value="PaymentFilters.CompanyGroupId">
                    <DropDownListFieldSettings Text="Description" Value="Id" />
                <DropDownListEvents TItem="DropdownItemResponse" TValue="int?" 
                                ValueChange="OnCompanyGroupChanged" />
                    <DropDownListTemplates TItem="DropdownItemResponse">
                        <ItemTemplate>
                            @context.Description
                        </ItemTemplate>
                        <ValueTemplate>
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <span>@((context as DropdownItemResponse).Description)</span>
                                <div @onmousedown:stopPropagation="true"
                                        @onmouseup:stopPropagation="true"
                                        @onclick:stopPropagation="true">
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close"
                                                    aria-label="clear filter"
                                           OnClick="@(() => Clear(PaymentFilterType.CompanyGroup))" />
                                </div>
                            </MudStack>
                        </ValueTemplate>
                    </DropDownListTemplates>
                </SfDropDownList>
	    </MudItem>
    <MudItem xs="4">
        <MudText>Company</MudText>
            <SfDropDownList 
                ID="ddlSelectionCompany"
                TValue="string"
                TItem="DropdownItemStringResponse"
                AllowFiltering="true" 
                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                        DataSource="@PaymentFilters.DropdownCompany"
                Placeholder="Select Company Name"
                        @bind-Value="PaymentFilters.CompanyCode">
                <DropDownListFieldSettings Text="Description" Value="Id" />
                <DropDownListEvents TItem="DropdownItemStringResponse" TValue="string" 
                                ValueChange="OnCompanyChanged" />
            <DropDownListTemplates TItem="DropdownItemStringResponse">
                    <ItemTemplate>
                        @context.Description
                    </ItemTemplate>
                    <ValueTemplate>
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <span>@((context as DropdownItemStringResponse).Description)</span>
                            <div @onmousedown:stopPropagation="true"
                                 @onmouseup:stopPropagation="true"
                                 @onclick:stopPropagation="true">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close"
                                               aria-label="clear filter"
                                           OnClick="@(() => Clear(PaymentFilterType.Company))" />
                            </div>
                        </MudStack>
                    </ValueTemplate>
                </DropDownListTemplates>
            </SfDropDownList>
    </MudItem>
    <MudItem xs="4">
        <MudText>Directorate/Function</MudText>
        <SfDropDownList 
            ID="ddlSelectionDirectorate"
            TValue="int?" 
            TItem="DropdownItemResponse" 
            AllowFiltering="true" 
            FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" 
                        DataSource="@PaymentFilters.DropdownDirectorate" Placeholder="Select Directorate" @bind-Value="PaymentFilters.DirectorateId">
            <DropDownListFieldSettings Text="Description" Value="Id" />
            <DropDownListEvents TItem="DropdownItemResponse" TValue="int?" ValueChange="OnDirectorateChanged" />
            <DropDownListTemplates TItem="DropdownItemResponse">
                <ItemTemplate>
                    @context.Description
                </ItemTemplate>
                <ValueTemplate>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <span>@((context as DropdownItemResponse).Description)</span>
                        <div @onmousedown:stopPropagation="true"
                             @onmouseup:stopPropagation="true"
                             @onclick:stopPropagation="true">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close"
                                           aria-label="clear filter"
                                           OnClick="@(() => Clear(PaymentFilterType.Directorate))" />
                        </div>
                    </MudStack>
                </ValueTemplate>
            </DropDownListTemplates>
        </SfDropDownList>
    </MudItem>
</MudGrid>



@code {
    [Parameter]
    public required PaymentFilterState PaymentFilters { get; set; }

    private async Task OnCompanyGroupChanged(ChangeEventArgs<int?, DropdownItemResponse> args)
    {
        PaymentFilters.CompanyGroupId = args?.Value;
        PaymentFilters.ResetCompany();
        
        await PaymentFilters.NotifyChangedAsync(PaymentFilterType.CompanyGroup);
    }

    private async Task OnCompanyChanged(ChangeEventArgs<string, DropdownItemStringResponse> args)
    {
        PaymentFilters.CompanyCode = args.Value;
        PaymentFilters.ResetDirectorate();

        await PaymentFilters.NotifyChangedAsync(PaymentFilterType.Company);
    }

    private async Task OnDirectorateChanged(ChangeEventArgs<int?, DropdownItemResponse> args)
    {
        PaymentFilters.DirectorateId = args?.Value;

        await PaymentFilters.NotifyChangedAsync(PaymentFilterType.Directorate);
    }

    private async Task Clear(PaymentFilterType filter)
    {
        switch (filter)
        {
            case PaymentFilterType.CompanyGroup: PaymentFilters.ResetCompanyGroup(); break;
            case PaymentFilterType.Company: PaymentFilters.ResetCompany(); break;
            case PaymentFilterType.Directorate: PaymentFilters.ResetDirectorate(); break;
        }

        await PaymentFilters.NotifyChangedAsync(filter);
    }

}
