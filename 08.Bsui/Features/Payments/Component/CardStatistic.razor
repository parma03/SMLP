@using Psmp.Base.Payments.Enums
@using Psmp.Bsui.Features.Applicants.Payments.Components
@using Psmp.Shared.Payments.Queries

<style>
	@@media (max-width: 768px) {
		.responsive-text {
			font-size: 1rem;
		}
	}

	@@media (max-width: 480px) {
		.responsive-text {
			font-size: 0.875rem;
		}
	}

	.currency-wrap {
		white-space: normal !important;
		word-break: break-word !important;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		line-height: 1.4;
	}

	.currency-small {
		font-size: clamp(0.75rem, 2vw, 1.25rem);
	}
</style>

<MudGrid>
	<MudItem xs="12" Class="d-flex align-center">
		<MudCard Elevation="0" Class="flex-grow-1">
			<MudCardHeader>
				<CardHeaderAvatar>
					@if (Judul?.Contains("Paid") == true)
					{
						<MudAvatar Color="Color.Tertiary">
							<MudIcon Icon="@IconMoney"></MudIcon>
						</MudAvatar>
					}
					@if (!string.IsNullOrEmpty(ImageSrc))
					{
						<MudAvatar Color="@AvatarColor">
							<img src="@ImageSrc" alt="Icon" style="width:70%;" />
						</MudAvatar>
					}
					else
					{
						<MudAvatar Color="@AvatarColor">
							<MudIcon Icon="@Icon"></MudIcon>
						</MudAvatar>
					}
				</CardHeaderAvatar>
				<CardHeaderContent>
					@if (!string.IsNullOrWhiteSpace(Judul))
					{
						<MudText>@Judul</MudText>
					}
					@if (!string.IsNullOrWhiteSpace(Status))
					{
						<MudText Typo="Typo.h5">@Status</MudText>
					}
					@if (!string.IsNullOrWhiteSpace(Sub))
					{
						<MudGrid>
							<MudItem xs="12" md="10" Class="mt-2">
								@if (ResponseUsd != null)
								{
									<MudTooltip Text="@ResponseUsd.Document?.FileName" Color="Color.Info">
										<MudText Typo="Typo.h5">@Sub</MudText>
									</MudTooltip>
								}
								else if (ResponseIdr != null)
								{
									<MudTooltip Text="@ResponseIdr.Document?.FileName" Color="Color.Info">
										<MudText Typo="Typo.h5">@Sub</MudText>
									</MudTooltip>
								}
								else if (ResponseOther != null)
								{
									<MudTooltip Text="@ResponseOther.Document?.FileName" Color="Color.Info">
										<MudText Typo="Typo.h5">@Sub</MudText>
									</MudTooltip>
								}
								else
								{
									<MudTooltip Text="No Document" Color="Color.Info">
										<MudText Typo="Typo.h5">@Sub</MudText>
									</MudTooltip>
								}
							</MudItem>
							<MudItem xs="12" md="2">
								<MudIconButton Icon="@Icons.Material.Filled.Download" OnClick="OnClickDownload" Color="Color.Primary" Title="Download Document" />
							</MudItem>
						</MudGrid>
					}
					@if (Count > 0)
					{
						<MudText Typo="Typo.h5">@Count</MudText>
					}
					@if (CountCurrency.HasValue)
					{
						var isLargeAmount = CountCurrency >= 1000000000;
						var currencyClass = isLargeAmount ? "responsive-text currency-wrap currency-small" : "responsive-text currency-wrap";

						if (CurrencyType is null)
						{
                            <MudText Typo="Typo.h6" Class="@currencyClass">@($"${CountCurrency?.ToString("N2", new System.Globalization.CultureInfo("id-ID"))}")</MudText>
						}
						else
						{
							<MudText Typo="Typo.h6" Class="@currencyClass">@($"Rp{CountCurrency?.ToString("N2", new System.Globalization.CultureInfo("id-ID"))}")</MudText>
						}
					}
				</CardHeaderContent>
			</MudCardHeader>
		</MudCard>

		@if (!IsLast)
		{
			<MudHidden Breakpoint="Breakpoint.SmAndDown">
				<MudDivider Vertical="true" Class="mx-2" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
			</MudHidden>
		}
	</MudItem>
</MudGrid>

@code {
	[Parameter]
	public string? SubTitle { get; set; } = default!;

	[Parameter]
	public EventCallback OnClickDownload { get; set; }
}
