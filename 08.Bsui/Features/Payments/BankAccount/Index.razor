@using Smlp.Shared.Common.Responses
@using Smlp.Shared.Payments.Queries
@using Smlp.Bsui.Features.Payments.Component

<style>
	.e-chip-list {
		display: inline !important
	}
</style>

<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>
<ErrorViewer Error="@_error" />

@if (_isLoading)
{
    <MudContainer Class="d-flex justify-center align-center" Style="min-height: 400px; margin-top: 50px;">
        <Loading IsVisible="_isLoading" />
    </MudContainer>
}
else
{
    <MudGrid Spacing="2">
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12">
                <MudText Typo="Typo.body2" HtmlTag="h3">Bank Account Filter</MudText>
            </MudItem>
        </MudGrid>
        <PaymentFilterGroup PaymentFilters="@PaymentFilters" />
        <MudGrid Class="mb-2">
            <MudItem xs="12">
                <MudCard Class="pa-4" Elevation="2">
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12">
                                <MudGrid Spacing="2" Class="mb-1">
                                    <MudItem xs="12" md="8">
                                        <MudGrid Class="d-flex align-center justify-start">
                                            <MudItem>
                                                <MudText Typo="Typo.h6" Class="ms-0">List Bank Account</MudText>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" md="4">
                                        <MudGrid Class="d-flex flex-wrap align-center justify-start justify-md-end gap-2">
                                            <MudItem>
                                                <SfProgressButton ID="bulkVerifyButton"
                                                                  Content="@(_hasVerifiedSelected ? "Set Unverified" : "Set Verified")"
                                                                  @onclick="ToggleSelectedAccounts"
                                                                  EnableProgress="true"
                                                                  CssClass="fw-bold"
                                                                  IconCss="@(_hasVerifiedSelected ? "e-icons e-close" : "e-icons e-check")"
                                                                  Disabled="@(!_selectedBankAccounts.Any())"
                                                                  Style="@(_hasVerifiedSelected ? "background: linear-gradient(to right, #dc3545, #bd2130); color: white;" : "background: linear-gradient(to right, #28a745, #1e7e34); color: white;")">
                                                    <ProgressButtonSpinSettings Position="SpinPosition.Center"></ProgressButtonSpinSettings>
                                                    <ProgressButtonAnimationSettings Effect="Syncfusion.Blazor.SplitButtons.AnimationEffect.ZoomOut"></ProgressButtonAnimationSettings>
                                                </SfProgressButton>
                                            </MudItem>
                                            <MudItem>
                                                <SfProgressButton ID="zoomOutButton" Content="Export to Excel" @onclick="ExportExcel" EnableProgress="true" CssClass="fw-bold" IconCss="e-icons e-download" Style="background: linear-gradient(to right, #4279db, #1c4185); color: white;">
                                                    <ProgressButtonSpinSettings Position="SpinPosition.Center"></ProgressButtonSpinSettings>
                                                    <ProgressButtonAnimationSettings Effect="Syncfusion.Blazor.SplitButtons.AnimationEffect.ZoomOut"></ProgressButtonAnimationSettings>
                                                </SfProgressButton>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudGrid>
                                <SfGrid @ref="Grid" DataSource="@_applicantListApplicantBankAccount" Toolbar="@(new List<string>() { "Search" })" AllowExcelExport="true" AllowFiltering="true" AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true" AllowSelection="true">
                                    <GridPageSettings PageCount="5" PageSize="10" PageSizes="@(new string[] { "10", "15", "20", "All" })"></GridPageSettings>
                                    <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" Mode="Syncfusion.Blazor.Grids.SelectionMode.Row"></GridSelectionSettings>
                                    <GridEvents ExcelQueryCellInfoEvent="ExcelQueryCellInfoHandler" OnToolbarClick="ToolbarClickHandler" CommandClicked="OnCommandClicked" RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" TValue="GetListApplicantBankAccountResponse"></GridEvents>
                                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                                    <GridColumns>
                                        <GridColumn Type="ColumnType.CheckBox" Width="50"></GridColumn>
                                        <GridColumn Field=@nameof(GetListApplicantBankAccountResponse.EmployeeNumber) HeaderText="Employee Number" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetListApplicantBankAccountResponse.Name) HeaderText="Name" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetListApplicantBankAccountResponse.Email) HeaderText="Email" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetListApplicantBankAccountResponse.BankName) HeaderText="Bank Name" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetListApplicantBankAccountResponse.AccountHolder) HeaderText="Account Holder" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetListApplicantBankAccountResponse.AccountNumber) HeaderText="Account Number" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetListApplicantBankAccountResponse.Currency) HeaderText="Currency" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetListApplicantBankAccountResponse.BankCountry) HeaderText="Bank Country" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetListApplicantBankAccountResponse.BankCity) HeaderText="Bank City" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetListApplicantBankAccountResponse.BankBranch) HeaderText="Bank Branch" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetListApplicantBankAccountResponse.IsVerified) HeaderText="SAP Status" Width="150" TextAlign="TextAlign.Center">
                                            <Template>
                                                @{
                                                    var data = (context as GetListApplicantBankAccountResponse);
                                                    // if (data?.IsVerified == true)
                                                    // {
                                                    //     <span class="chip-success">In SAP</span>
                                                    // }
                                                    // else
                                                    // {
                                                    //     <span class="chip-error">Not In SAP</span>
                                                    // }
													if (data?.IsVerified == true)
													{
														<SfChip>
															<ChipItems>
																<ChipItem Text="In SAP" CssClass="e-success"></ChipItem>
															</ChipItems>
														</SfChip>
													}
													else
													{
														<SfChip>
															<ChipItems>
																<ChipItem Text="Not In SAP" CssClass="e-danger"></ChipItem>
															</ChipItems>
														</SfChip>
													}
                                                }
                                            </Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="Action" TextAlign="TextAlign.Center" Width="150">
                                            <GridCommandColumns>
                                                <GridCommandColumn Title="View" Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-eye", CssClass = "e-flat" })"></GridCommandColumn>
                                                <GridCommandColumn Title="Download" Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-download", CssClass = "e-flat" })"></GridCommandColumn>
                                                <GridCommandColumn Title="Verivied" Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-refresh", CssClass = "e-flat e-info" })"></GridCommandColumn>
                                            </GridCommandColumns>
                                        </GridColumn>
                                    </GridColumns>
                                </SfGrid>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudGrid>
}

<DialogViewDetailBankAcc 
    Visibility="VisiblePopup"
    DialogOpen="DialogOpen"
    DialogClose="DialogClose"
    OnClickNo="ClickedNo"
    OnClickYes="ClickedYes"
    Response="_viewResponse">
</DialogViewDetailBankAcc>

<MudMessageBox @ref="_confirmMessageBox" Title="@_confirmTitle">
	<MessageContent>
		@((MarkupString)_confirmMessage)
	</MessageContent>
	<YesButton>
		<MudButton Variant="Variant.Filled" Color="Color.Primary">Continue</MudButton>
	</YesButton>
	<CancelButton>
		<MudButton Class="mr-2" Variant="Variant.Filled" Color="Color.Error">Cancel</MudButton>
	</CancelButton>
</MudMessageBox>
