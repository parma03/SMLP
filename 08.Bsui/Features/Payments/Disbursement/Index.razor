@using Smlp.Base.Payments.Enums;
@using Smlp.Shared.Applicants.Constants
@using Smlp.Shared.Common.Responses
@using Smlp.Shared.Payments.Queries
@using Smlp.Bsui.Features.Payments.Component

<style>
    .e-chip-list {
        display: inline !important
    }

    .e-upload .e-file-select-wrap, .e-bigger.e-small .e-upload .e-file-select-wrap {
        padding: 5px 0 5px 5px; /* Sesuaikan padding untuk tampilan yang lebih kompak */
    }

    .sf-uploader-compact .e-file-container {
        margin: 2px 0; /* Mengurangi margin antar file */
    }

    .no-minheight-tabs .mud-tabs-panels {
        min-height: unset !important;
        height: auto !important;
        padding-bottom: 0 !important;
    }

	.e-chip.sf-warning-mud {
		background: var(--mud-palette-warning);
		color: var(--mud-palette-warning-text);
		pointer-events: none;
	}

	.e-chip.sf-default-mud {
		background: var(--mud-palette-secondary);
		color: var(--mud-palette-secondary-text);
		pointer-events: none;
	}
</style>
<LoadingDialog IsVisible=@_isLoadingDialog Text="Loading..."></LoadingDialog>
<ErrorViewer Error="@_error" />

@if (_isLoading)
{
    <MudContainer Class="d-flex justify-center align-center" Style="min-height: 400px; margin-top: 50px;">
        <Loading IsVisible="_isLoading" />
    </MudContainer>
}
else
{
    <MudGrid Spacing="2">
        @if (ApplicantId != null)
        {
            <MudGrid Class="mb-2">
                <MudItem xs="12">
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudGrid AlignItems="center">
                            <MudItem xs="12">
                                <MudText Typo="Typo.h5">@_usernameApplicant</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12">
                <MudText Typo="Typo.body2" HtmlTag="h3">Disbursement Filter</MudText>
            </MudItem>
        </MudGrid>
        @* <MudGrid Spacing="2" Class="mb-4">
                   <MudItem xs="2">
        <MudText>Categories</MudText>
        <SfDropDownList ID="ddlSelectionCategory" TValue="int" TItem="DropdownItemResponse" DataSource="@_dropdownCategories" Placeholder="Select Category" @bind-Value="_category">
        <DropDownListFieldSettings Text="Description" Value="Id" />
        <DropDownListEvents TItem="DropdownItemResponse" TValue="int" ValueChange="OnChangeCategory" />
        </SfDropDownList>
        </MudItem>
            <MudItem xs="2">
                <MudText>H/ SH/ AP&P</MudText>
                <SfDropDownList ID="ddlSelectionHPS" TValue="int" TItem="DropdownItemResponse" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_dropdownHps" Placeholder="Select H/SH/AP&P" @bind-Value="_companyGroupId">
                    <DropDownListFieldSettings Text="Description" Value="Id" />
                    <DropDownListEvents TItem="DropdownItemResponse" TValue="int" ValueChange="OnChangeCompanyGroupAsync" />
                </SfDropDownList>
            </MudItem>
            <MudItem xs="2">
                <MudText>Company</MudText>
                <SfDropDownList ID="ddlSelectionCompany" TValue="string" TItem="DropdownItemStringResponse" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_dropdownCompany" Placeholder="Select Company Name" @bind-Value="_companyCode">
                    <DropDownListFieldSettings Text="Description" Value="Id" />
                    <DropDownListEvents TItem="DropdownItemStringResponse" TValue="string" ValueChange="OnChangeCompanyAsync" />
                </SfDropDownList>
            </MudItem>
            <MudItem xs="2">
                <MudText>Directorate/Function</MudText>
                <SfDropDownList ID="ddlSelectionDirectorate" TValue="int" TItem="DropdownItemResponse" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" DataSource="@_dropdownDirectorate" Placeholder="Select Directorate" @bind-Value="_directorateId">
                    <DropDownListFieldSettings Text="Description" Value="Id" />
                    <DropDownListEvents TItem="DropdownItemResponse" TValue="int" ValueChange="OnChangeDirectorateAsync" />
                </SfDropDownList>
            </MudItem>
        </MudGrid> *@

        <PaymentFilterGroup PaymentFilters="@PaymentFilters" />
        
        <MudGrid Class="mb-2">
            <MudItem xs="12">
                <MudTabs @bind-ActivePanelIndex="ActiveTabIndex" Rounded="true" Centered="false" Elevation="0">
                    <MudTabPanel Text="Progress">
                        <MudGrid Class="mt-2">
                            <MudItem xs="12">
                                <MudCard Class="pa-4" Elevation="2">
                                    <MudGrid Justify="Justify.Center">
                                        <!-- Card pertama -->
                                        <MudItem xs="12" sm="6" md="6" Class="d-flex justify-start">
                                            <Smlp.Bsui.Features.Payments.Component.CardStatistic ImageSrc="img/dollars.png" AvatarColor="Color.Info" Judul="@($"{"Preparation"} ({_count1})")" CountCurrency="@_countcurrency1"></Smlp.Bsui.Features.Payments.Component.CardStatistic>
                                        </MudItem>

                                        <!-- Divider Vertikal -->
                                        @* <MudItem xs="12" sm="1" md="1" Class="d-flex justify-center">
                                            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                                                <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                                            </MudHidden>
                                        </MudItem> *@

                                        <!-- Card kedua -->
                                        <MudItem xs="12" sm="6" md="6" Class="d-flex justify-start">
											<Smlp.Bsui.Features.Payments.Component.CardStatistic ImageSrc="img/idr7.png" AvatarColor="Color.Info" Judul="@($"{"Preparation"} ({_count2})")" CountCurrency="@_countcurrency2" CurrencyType="@("Rp")" IsLast="true"></Smlp.Bsui.Features.Payments.Component.CardStatistic>
                                        </MudItem>
                                    </MudGrid>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                    <MudTabPanel Text="Completed">
                        <MudGrid Class="mt-2">
                            <MudItem xs="12">
                                <MudCard Class="pa-4" Elevation="2">
                                    <MudGrid Justify="Justify.Center">
                                        <!-- Card pertama -->
                                        <MudItem xs="12" sm="6" md="6" Class="d-flex justify-start">
                                            <Smlp.Bsui.Features.Payments.Component.CardStatistic ImageSrc="img/dollars.png" AvatarColor="Color.Success" Judul="@($"{"Completed"} ({_count5})")" CountCurrency="@_countcurrency5"></Smlp.Bsui.Features.Payments.Component.CardStatistic>
                                        </MudItem>

                                        <!-- Divider Vertikal -->
                                        @* <MudItem xs="12" sm="1" md="1" Class="d-flex justify-center">
                                            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                                                <MudDivider Vertical="true" Class="mud-divider-height-full" Style="height: 90px; border-width: 2px; opacity: 0.5;" />
                                            </MudHidden>
                                        </MudItem> *@

                                        <!-- Card kedua -->
                                        <MudItem xs="12" sm="6" md="6" Class="d-flex justify-start">
											<Smlp.Bsui.Features.Payments.Component.CardStatistic ImageSrc="img/idr7.png" AvatarColor="Color.Success" Judul="@($"{"Completed"} ({_count6})")" CountCurrency="@_countcurrency6" CurrencyType="@("Rp")" IsLast="true"></Smlp.Bsui.Features.Payments.Component.CardStatistic>
                                        </MudItem>
                                    </MudGrid>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                </MudTabs>
            </MudItem>
        </MudGrid>

        <MudGrid Class="mb-2">
            <MudItem xs="12">
                <MudCard Class="pa-4" Elevation="2">
                    <MudCardContent>
                        <MudGrid>
                            <MudItem xs="12">
                                <MudGrid Spacing="2" Class="mb-1">
                                    <MudItem xs="12" md="4">
                                        <MudGrid Class="d-flex align-center justify-start">
                                            <MudItem>
                                                <MudPaper Class="d-flex justify-start flex-grow-1 gap-1" Elevation="0">
                                                    <MudText Typo="Typo.h6" Class="ms-0">Disbursement History</MudText>
                                                    <Tooltips />
                                                </MudPaper>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                    <MudItem xs="12" md="8">
                                        <MudGrid Class="d-flex flex-wrap align-center justify-start justify-md-end">
                                            @if (Action == null)
                                            {
                                                <MudItem>
                                                    <SfProgressButton ID="zoomOutButton" Content="Create Disbursement" @onclick="CreateDisbursementClick" EnableProgress="true" CssClass="fw-bold" IconCss="e-icons e-circle-add" Style="background: linear-gradient(to right, #4279db, #1c4185); color: white;">
                                                        <ProgressButtonSpinSettings Position="SpinPosition.Center"></ProgressButtonSpinSettings>
                                                        <ProgressButtonAnimationSettings Effect="Syncfusion.Blazor.SplitButtons.AnimationEffect.ZoomOut"></ProgressButtonAnimationSettings>
                                                    </SfProgressButton>
                                                </MudItem>
                                            }
                                            <MudItem>
                                                <SfProgressButton ID="zoomOutButton" Content="Export to Excel" @onclick="ExportExcel" EnableProgress="true" CssClass="fw-bold" IconCss="e-icons e-download" Style="background: linear-gradient(to right, #4279db, #1c4185); color: white;">
                                                    <ProgressButtonSpinSettings Position="SpinPosition.Center"></ProgressButtonSpinSettings>
                                                    <ProgressButtonAnimationSettings Effect="Syncfusion.Blazor.SplitButtons.AnimationEffect.ZoomOut"></ProgressButtonAnimationSettings>
                                                </SfProgressButton>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudGrid>
								<SfGrid @ref="Grid" DataSource="@_filteredDisbursements" Toolbar="@(new List<string>() { "Search" })" AllowExcelExport="true" AllowFiltering="true" AllowPaging="true" AllowSorting="true" AllowResizing="true" AllowTextWrap="true">
                                    <GridPageSettings PageCount="8" PageSize="8" PageSizes="@SyncfusionGridValue.PageSize"></GridPageSettings>
                                    <GridEvents CommandClicked="OnCommandClicked" TValue="GetApplicantDisbursementResponse"></GridEvents>
                                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                                    <GridColumns>
										<GridColumn Field=@nameof(GetApplicantDisbursementResponse.RequestDate) HeaderText="Month" Width="150">
                                            <Template>
                                                @{
													var data = (context as GetApplicantDisbursementResponse);
													var date = data?.RequestDate;
                                                    var bulan = date?.ToString("MMMM", new System.Globalization.CultureInfo("id-ID"));
                                                }
                                                @bulan
                                            </Template>
                                        </GridColumn>
										<GridColumn Field=@nameof(GetApplicantDisbursementResponse.RequestDate) HeaderText="Year" Width="150">
											<Template>
												@{
													var data = (context as GetApplicantDisbursementResponse);
													var date = data?.RequestDate;
													var bulan = date?.ToString("yyyy", new System.Globalization.CultureInfo("id-ID"));
												}
												@bulan
											</Template>
										</GridColumn>
                                    <GridColumn Field=@nameof(GetApplicantDisbursementResponse.RequestId) HeaderText="Request Id" Width="150"></GridColumn>
                                    <GridColumn Field=@nameof(GetApplicantDisbursementResponse.RequestDate) HeaderText="Payment Date" Format="dd.MM.yyyy" Width="150"></GridColumn>
                                    <GridColumn Field=@nameof(GetApplicantDisbursementResponse.Item) HeaderText="Category" Width="150"></GridColumn>
                                    <GridColumn Field=@nameof(GetApplicantDisbursementResponse.DisplayName) HeaderText="Applicant Name" Width="150"></GridColumn>
                                    <GridColumn Field=@nameof(GetApplicantDisbursementResponse.EmployeeNumber) HeaderText="Employee Number" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetApplicantDisbursementResponse.Company) HeaderText="Company" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetApplicantDisbursementResponse.CurrencyType) HeaderText="Currency" Width="150">
                                            <Template>
                                                @{
                                                    var data = (context as GetApplicantDisbursementResponse);
                                                    @data!.CurrencyType.GetDescription().ToString()
                                                }
                                            </Template>
                                        </GridColumn>
                                        <GridColumn Field=@nameof(GetApplicantDisbursementResponse.Amount) HeaderText="Amount" Width="150">
                                            <Template>
                                                @{
                                                    var data = (context as GetApplicantDisbursementResponse);
                                                }
                                                <div style="text-align:right;">
                                                    @($"{data!.Amount.ToString("N2", new System.Globalization.CultureInfo("id-ID"))}")
                                                </div>
                                            </Template>
                                        </GridColumn>
                                        <GridColumn Field=@nameof(GetApplicantDisbursementResponse.WageType) HeaderText="Wage Type" Width="150"></GridColumn>
                                        <GridColumn Field=@nameof(GetApplicantDisbursementResponse.PaymentFrequency) HeaderText="Payment Frequency" Width="200"></GridColumn>
                                        <GridColumn Field=@nameof(GetApplicantDisbursementResponse.PaymentStatus) HeaderText="Payment Status" Width="200">
                                            <Template>
                                                @{
                                                    var data = (context as GetApplicantDisbursementResponse);
                                                    if (data!.PaymentStatus == PaymentStatus.Approved)
                                                    {
                                                        <div style="display:flex; justify-content:center;">
                                                            <SfChip>
                                                                <ChipItems>
                                                                    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-success"></ChipItem>
                                                                </ChipItems>
                                                            </SfChip>
                                                        </div>
                                                    }
                                                    else if (data!.PaymentStatus == PaymentStatus.Rejected)
                                                    {
                                                        <div style="display:flex; justify-content:center;">
                                                            <SfChip>
                                                                <ChipItems>
                                                                    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-danger"></ChipItem>
                                                                </ChipItems>
                                                            </SfChip>
                                                        </div>
                                                    }
                                                    else if (data!.PaymentStatus == PaymentStatus.WaitingApproval)
                                                    {
                                                        <div style="display:flex; justify-content:center;">
                                                            <SfChip>
                                                                <ChipItems>
                                                                    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-warning"></ChipItem>
                                                                </ChipItems>
                                                            </SfChip>
                                                        </div>
                                                    }
                                                    else if (data!.PaymentStatus == PaymentStatus.RequestPreparation)
                                                    {
                                                        <div style="display:flex; justify-content:center;">
                                                            <SfChip>
                                                                <ChipItems>
                                                                    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-info"></ChipItem>
                                                                </ChipItems>
                                                            </SfChip>
                                                        </div>
                                                    }
                                                    else if (data!.PaymentStatus == PaymentStatus.RequestToBmc)
                                                    {
                                                        <div style="display:flex; justify-content:center;">
                                                            <SfChip>
                                                                <ChipItems>
                                                                    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-default"></ChipItem>
                                                                </ChipItems>
                                                            </SfChip>
                                                        </div>
                                                    }
                                                    else if (data!.PaymentStatus == PaymentStatus.Posted)
                                                    {
                                                        <div style="display:flex; justify-content:center;">
                                                            <SfChip>
                                                                <ChipItems>
                                                                    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-success"></ChipItem>
                                                                </ChipItems>
                                                            </SfChip>
                                                        </div>
                                                    }
                                                    else if (data!.PaymentStatus == PaymentStatus.NeedRevision)
                                                    {
                                                        <div style="display:flex; justify-content:center;">
                                                            <SfChip>
                                                                <ChipItems>
																    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="sf-warning-mud"></ChipItem>
                                                                </ChipItems>
                                                            </SfChip>
                                                        </div>
                                                    }
                                                    else if (data!.PaymentStatus == PaymentStatus.Pending)
                                                    {
                                                        <div style="display:flex; justify-content:center;">
                                                            <SfChip>
                                                                <ChipItems>
																	<ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="sf-default-mud"></ChipItem>
                                                                </ChipItems>
                                                            </SfChip>
                                                        </div>
                                                    }
                                                    else if (data!.PaymentStatus == PaymentStatus.Saved)
                                                    {
                                                        <div style="display:flex; justify-content:center;">
                                                            <SfChip>
                                                                <ChipItems>
                                                                    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-success"></ChipItem>
                                                                </ChipItems>
                                                            </SfChip>
                                                        </div>
                                                    }
                                                    else if (data!.PaymentStatus == PaymentStatus.Completed)
                                                    {
                                                        <div style="display:flex; justify-content:center;">
                                                            <SfChip>
                                                                <ChipItems>
                                                                    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-success"></ChipItem>
                                                                </ChipItems>
                                                            </SfChip>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div style="display:flex; justify-content:center;">
                                                            <SfChip>
                                                                <ChipItems>
                                                                    <ChipItem Text="@data.PaymentStatus.GetDescription().ToString()" CssClass="e-secondary"></ChipItem>
                                                                </ChipItems>
                                                            </SfChip>
                                                        </div>
                                                    }
                                                }
                                            </Template>
                                        </GridColumn>
										<GridColumn HeaderText="Action" TextAlign="TextAlign.Center" Width="150">
											<Template>
												@{
													var item = (context as GetApplicantDisbursementResponse);
												}
												@if (Action == null)
												{
													<SfButton IconCss="e-icons e-eye" CssClass="e-flat" OnClick="@(() => OnActionClick(item, "View"))"></SfButton>

													@if (item!.PaymentStatus == PaymentStatus.RequestPreparation)
													{
														<SfButton IconCss="e-icons e-delete" CssClass="e-flat" OnClick="@(() => OnActionClick(item, "Delete"))"></SfButton>
													}
												}
												else
												{
													<SfButton IconCss="e-icons e-eye" CssClass="e-flat" OnClick="@(() => OnActionClick(item, "View"))"></SfButton>
													<SfButton IconCss="e-icons e-edit" CssClass="e-flat" OnClick="@(() => OnActionClick(item, "Edit"))"></SfButton>
												}
											</Template>
										</GridColumn>
                                        @* <GridColumn HeaderText="Action" TextAlign="TextAlign.Center" Width="150">
                                            <GridCommandColumns>
                                                @if (Action == null)
                                                {
                                                    <GridCommandColumn Title="View" Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-eye", CssClass = "e-flat" })"></GridCommandColumn>
                                                    <GridCommandColumn Title="Delete" Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-delete", CssClass = "e-flat" })"></GridCommandColumn>
                                                }
                                                else
                                                {
                                                    <GridCommandColumn Title="View" Type="CommandButtonType.None" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-eye", CssClass = "e-flat" })"></GridCommandColumn>
                                                    <GridCommandColumn Title="Edit" Type="CommandButtonType.Edit" ButtonOption="@(new CommandButtonOptions() { IconCss = "e-icons e-edit", CssClass = "e-flat" })"></GridCommandColumn>
                                                }
                                            </GridCommandColumns>
                                        </GridColumn> *@
                                    </GridColumns>
                                </SfGrid>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
        @if (ApplicantId != null)
        {
        <MudGrid>
            <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="12" md="3">
                            <MudGrid Class="d-flex align-center justify-start">
                                <MudItem>
                                    <SfButton OnClick="OnClickBack" Content="Back Overview" IconCss="e-icons e-arrow-left" CssClass="e-danger"></SfButton>
                                </MudItem>
                            </MudGrid>
                    </MudItem>
                </MudGrid>
            </MudItem>
          </MudGrid>  
        }
    </MudGrid>

}

<DialogAddDibursement Visibility="VisiblePopup"
                      Title="@TitlePopup"
                      DialogOpen="DialogOpenForm" 
                      DialogClose="DialogCloseForm"
                      OnClickNo="ClickedNo" 
                      OnClickYes="ClickedYes"
                      OnDataCleared="OnDataClearedHandler"
                      Curency="_dropdownItemCurrencyType"
                      ItemListData="@_items"
                      Name="@_username"
                      EmployeeNumber="@_employeeId"
                      ItemId="@_itemId"
                      RequestData="_requestData"
                      Frequency="@_frequensi"
                      OnCommandClicked="OnCommandClickedDocument"
                      OnRemoveDisbursement="OnRemoveUploaderDibursement"
                      ValueChangeDisbursement="ValueChangeUploaderDisbursement"
                      listDocument="@_getListDocuments"
                      ItemDropdownList="_itemsDropDown"
                      IsEnabled="IsEnabled"
                      IsViewMode="@IsViewMode">
</DialogAddDibursement>

<Smlp.Bsui.Common.Components.DialogConfirmation
    Visibility="VisibleDeletePopup"
    Title="Delete Confirmation"
    Content="Are you sure want to delete this data?"
    UseLeftMargin="true"
    DialogOpen="DialogOpenDelete"
    DialogClose="DialogCloseDelete"
    OnClickNo="ClickedNo"
    OnClickYes="ClickedYesDelete" />
