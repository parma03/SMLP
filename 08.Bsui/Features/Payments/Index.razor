@page "/Payment"
@page "/Payment/{ApplicantId:guid}"

@using Smlp.Shared.Payments.Contants;
@using Smlp.Bsui.Features.Applicants.Payments.Components

@* <BrowserTabTitle>@DisplayTextFor.Payment</BrowserTabTitle>
<PageHeader Title="@DisplayTextFor.Payment" /> *@
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" @key="ApplicantId?.ToString()" ActivePanelIndexChanged="@(_ => PaymentFilters.ResetCompanyGroup())">
    
    @if(ApplicantId == null)
    {
        <MudTabPanel Text="@DisplayTextFor.Overview">
            <Smlp.Bsui.Features.Payments.Overview.Index></Smlp.Bsui.Features.Payments.Overview.Index>
        </MudTabPanel>
        <CascadingValue Value="PaymentFilters">
            <MudTabPanel Text="@DisplayTextFor.Reimbursement">
                <Smlp.Bsui.Features.Payments.Reimbursements.Index></Smlp.Bsui.Features.Payments.Reimbursements.Index>
            </MudTabPanel>
            <MudTabPanel Text="@DisplayTextFor.Disbursement">
                <Smlp.Bsui.Features.Payments.Disbursement.Index></Smlp.Bsui.Features.Payments.Disbursement.Index>
            </MudTabPanel>
            <MudTabPanel Text="@DisplayTextFor.BankAccount">
                <Smlp.Bsui.Features.Payments.BankAccount.Index></Smlp.Bsui.Features.Payments.BankAccount.Index>
            </MudTabPanel>
        </CascadingValue>
    }
    else
    {
        <CascadingValue Value="PaymentFilters">
            <MudTabPanel Text="@DisplayTextFor.Reimbursement">
                <Smlp.Bsui.Features.Payments.Reimbursements.Index ApplicantId="@ApplicantId"></Smlp.Bsui.Features.Payments.Reimbursements.Index>
            </MudTabPanel>
            <MudTabPanel Text="@DisplayTextFor.Disbursement">
                <Smlp.Bsui.Features.Payments.Disbursement.Index ApplicantId="@ApplicantId"></Smlp.Bsui.Features.Payments.Disbursement.Index>
            </MudTabPanel>
        </CascadingValue>
    }

</MudTabs>
