@page "/About"

@using Smlp.Bsui.Services.AppInfo
@using Smlp.Bsui.Services.FrontEnd
@using Smlp.Shared.Common.Constants

@inject IOptions<AppInfoOptions> _appInfoOptions
@inject IOptions<FrontEndOptions> _frontEndOptions
@inject IWebHostEnvironment _webHostEnvironment

<BrowserTabTitle>@CommonDisplayTextFor.About</BrowserTabTitle>
<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>
<PageHeader Title="@CommonDisplayTextFor.About" />

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 rounded-lg" Elevation="1">
            <div class="d-flex align-center mb-4">
                <MudIcon Icon="@Icons.Material.Filled.LocalCafe" Style="font-size:3rem; color:#6F4E37;" Class="mr-3" />
                <div>
                    <MudText Typo="Typo.h5" Style="color:#6F4E37; font-weight:700;">@_appInfoOptions.Value.FullName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_appInfoOptions.Value.Description</MudText>
                </div>
            </div>
            <MudDivider Class="mb-3" />
            <MudList Dense="true" T="string">
                <MudListItem Icon="@Icons.Material.Filled.Info" T="string">
                    <MudText Typo="Typo.body2"><b>Versi:</b> @_appInfoOptions.Value.Version</MudText>
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Code" T="string">
                    <MudText Typo="Typo.body2"><b>Platform:</b> .NET 8 + Blazor Server</MudText>
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Palette" T="string">
                    <MudText Typo="Typo.body2"><b>UI Framework:</b> MudBlazor</MudText>
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Storage" T="string">
                    <MudText Typo="Typo.body2"><b>Database:</b> SQL Server</MudText>
                </MudListItem>
            </MudList>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 rounded-lg" Elevation="1">
            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="color:#6F4E37; font-weight:700;">
                🎯 Fitur Utama
            </MudText>
            <MudList Dense="true" T="string">
                <MudListItem Icon="@Icons.Material.Filled.People" T="string">CRM & Manajemen Pelanggan</MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Stars" T="string">Program Poin & Loyalitas</MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.CardGiftcard" T="string">Katalog Reward & Redeem</MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Analytics" T="string">Dashboard Analytics & Laporan</MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Psychology" T="string">Customer Insights & RFM Analysis</MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.Receipt" T="string">Manajemen Transaksi</MudListItem>
            </MudList>
        </MudPaper>
    </MudItem>
</MudGrid>
