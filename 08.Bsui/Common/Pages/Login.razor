@page "/Login"

<style type="text/css">
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html, body {
        background-image: url("./img/bg_login.png");
        background-color: #3E2723;
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
        width: 100%;
    }

    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        padding: 0 24px;
    }

    .login-card {
        background: rgba(255, 255, 255, 0.97);
        border-radius: 16px;
        padding: 48px 40px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.35);
        text-align: center;
    }

    .login-title {
        color: #3E2723;
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .login-subtitle {
        color: #795548;
        font-size: 14px;
        margin-bottom: 32px;
    }

    @@media (max-width: 480px) {
        .login-card {
            padding: 32px 24px;
        }
    }
</style>

<div class="login-container">
    <div class="login-card">
        <div class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.LocalCafe" Style="font-size:4rem; color:#6F4E37;" />
        </div>
        <div class="login-title">SMLP</div>
        <div class="login-subtitle">Sistem Manajemen Loyalitas Pelanggan</div>

        <MudTextField @bind-Value="_username"
                      Label="Username"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Person"
                      Class="mb-3"
                      FullWidth="true"
                      @onkeypress="OnKeyPressAsync"
                      Disabled="@_processing" />

        <MudTextField @bind-Value="_password"
                      Label="Password"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="TogglePasswordVisibility"
                      InputType="@_passwordInputType"
                      Class="mb-4"
                      FullWidth="true"
                      @onkeypress="OnKeyPressAsync"
                      Disabled="@_processing" />

        <MudButton Variant="Variant.Filled"
                   FullWidth="true"
                   Size="Size.Large"
                   Style="background:#6F4E37; color:white; border-radius:8px; font-size:16px; font-weight:600;"
                   Disabled="@_processing"
                   OnClick="OnClickLoginAsync">
            @if (_processing)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Memproses...</MudText>
            }
            else
            {
                <MudText>Masuk</MudText>
            }
        </MudButton>

        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3" Dense="true">@_errorMessage</MudAlert>
        }

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-4">
            © @DateTime.Now.Year Sistem Manajemen Loyalitas Pelanggan
        </MudText>
    </div>
</div>
