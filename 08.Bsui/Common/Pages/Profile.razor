@page "/Profile"
@attribute [Authorize]


<MudBreadcrumbs Items="_breadcrumbItems"></MudBreadcrumbs>
<BrowserTabTitle>@CommonDisplayTextFor.Profile</BrowserTabTitle>
<PageHeader Title="Profil Pengguna" />

<MudGrid Spacing="2">
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 rounded-lg" Elevation="1">
            <div class="d-flex align-center mb-4">
                <MudAvatar Style="background:#6F4E37; color:white; width:64px; height:64px; font-size:1.8rem;" Class="mr-3">
                    @(_displayName?.FirstOrDefault())
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h6" Style="color:#3E2723; font-weight:700;">@_displayName</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@_role</MudChip>
                </div>
            </div>
            <MudDivider Class="mb-3" />
            <MudField Label="Username" Class="mb-3">@_username</MudField>
            <MudField Label="Email" Class="mb-3">@_email</MudField>
            <MudField Label="Role">@_role</MudField>
        </MudPaper>
    </MudItem>
</MudGrid>
