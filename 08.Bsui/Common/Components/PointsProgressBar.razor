@using Smlp.Base.Customer.Enums

@* Shows progress toward next tier *@
<div>
    <div class="d-flex justify-space-between mb-1">
        <MudText Typo="Typo.caption" Color="Color.Secondary">Menuju @NextTier</MudText>
        <MudText Typo="Typo.caption" Style="@ProgressTextStyle">@LifetimePoints / @TargetPoints poin</MudText>
    </div>
    <MudProgressLinear Value="@ProgressPercent"
                       Color="@BarColor"
                       Rounded="true"
                       Size="Size.Small"
                       Style="height:8px;" />
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
        @PointsNeeded poin lagi untuk naik ke @NextTier
    </MudText>
</div>

@code {
    [Parameter] public int LifetimePoints { get; set; }
    [Parameter] public CustomerTier CurrentTier { get; set; }

    private string NextTier => CurrentTier switch
    {
        CustomerTier.Bronze   => "Silver",
        CustomerTier.Silver   => "Gold",
        CustomerTier.Gold     => "Platinum",
        CustomerTier.Platinum => "Platinum (Maks)",
        _ => "Silver"
    };

    private int TargetPoints => CurrentTier switch
    {
        CustomerTier.Bronze   => 500,
        CustomerTier.Silver   => 2000,
        CustomerTier.Gold     => 10000,
        CustomerTier.Platinum => 10000,
        _ => 500
    };

    private int BasePoints => CurrentTier switch
    {
        CustomerTier.Bronze   => 0,
        CustomerTier.Silver   => 500,
        CustomerTier.Gold     => 2000,
        CustomerTier.Platinum => 10000,
        _ => 0
    };

    private double ProgressPercent
    {
        get
        {
            if (CurrentTier == CustomerTier.Platinum) return 100;
            var range = TargetPoints - BasePoints;
            var progress = LifetimePoints - BasePoints;
            return Math.Min(100, (double)progress / range * 100);
        }
    }

    private int PointsNeeded => CurrentTier == CustomerTier.Platinum ? 0 : Math.Max(0, TargetPoints - LifetimePoints);

    private Color BarColor => CurrentTier switch
    {
        CustomerTier.Bronze   => Color.Warning,
        CustomerTier.Silver   => Color.Default,
        CustomerTier.Gold     => Color.Secondary,
        CustomerTier.Platinum => Color.Primary,
        _ => Color.Primary
    };

    private string ProgressTextStyle => $"color:{(ProgressPercent >= 80 ? "#2E7D32" : "#6F4E37")}; font-weight:600;";
}
