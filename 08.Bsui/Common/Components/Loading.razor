@if (IsVisible)
{
    <div class="loading" role="status" aria-live="polite" aria-label="@(string.IsNullOrWhiteSpace(Description) ? "Memuat data dari server..." : Description)">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" Class="mb-3" aria-hidden="true" />
        @if (string.IsNullOrWhiteSpace(Description))
        {
            <MudText Typo="Typo.body1">Memuat data dari server...</MudText>
        }
        else
        {
            <MudText Typo="Typo.body1">@Description</MudText>
        }
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public string Description { get; set; } = default!;
}
