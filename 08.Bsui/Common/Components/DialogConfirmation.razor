@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups

<SfDialog Width="420px" ShowCloseIcon="true" IsModal="true" Visible="@Visibility" ZIndex="10000">
    <DialogTemplates>
        <Header>@Title</Header>
        <Content>
            <div class="@(UseLeftMargin ? "ml-5" : string.Empty)">
                @((MarkupString)Content)
            </div>
        </Content>
        <FooterTemplate>
            <SfButton Content="No" CssClass="e-outline e-danger" IconCss="e-icons e-circle-close" OnClick="OnClickNo"></SfButton>

            @if (!IsProgressButton)
            {
                <SfButton Content="Yes" CssClass="e-success" IconCss="e-icons e-circle-check" OnClick="OnClickYes"></SfButton>
            }
            else
            {
                <SfProgressButton Content="Yes" CssClass="e-success" IconCss="e-icons e-circle-check" EnableProgress="true" Duration="@Duration"
                                  OnClick="OnClickYes">
                    <ProgressButtonSpinSettings Position="SpinPosition.Center"></ProgressButtonSpinSettings>
                    <ProgressButtonAnimationSettings Effect="Syncfusion.Blazor.SplitButtons.AnimationEffect.ZoomOut"></ProgressButtonAnimationSettings>
                </SfProgressButton>
            }
        </FooterTemplate>
    </DialogTemplates>
    <DialogEvents OnOpen="@DialogOpen" Closed="@DialogClose"></DialogEvents>
    <DialogPositionData X="@PositionX" Y="@PositionY"></DialogPositionData>
    <DialogAnimationSettings Effect="DialogEffect.Zoom"></DialogAnimationSettings>
</SfDialog>
