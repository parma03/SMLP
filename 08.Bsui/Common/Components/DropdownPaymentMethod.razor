@using Smlp.Base.Transaction.Enums
@using Smlp.Base.Transaction.List

<MudSelect T="PaymentMethod?" Label="@Label" Value="Value" ValueChanged="OnValueChanged" Variant="Variant.Outlined" Clearable="true">
    <MudSelectItem T="PaymentMethod?" Value="null">-- Semua Metode --</MudSelectItem>
    @foreach (var method in PaymentMethodList.GetPaymentMethods())
    {
        <MudSelectItem T="PaymentMethod?" Value="@((PaymentMethod?)method)">@method.GetDescription()</MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public PaymentMethod? Value { get; set; }

    [Parameter]
    public EventCallback<PaymentMethod?> ValueChanged { get; set; }

    private async Task OnValueChanged(PaymentMethod? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
