<style>
    .no-uppercase {
        text-transform: none;
        white-space: nowrap;
    }
</style>

<SfDialog IsModal="true" Width="520px" Target="#target" ShowCloseIcon="true" @bind-Visible="SecondVisibility">
    <DialogTemplates>
        <Header>
            <div class="d-flex flex-column align-items-center mt-8">
                <MudAvatar Size="Size.Large" Class="bg-yellow mb-4 approve-avatar" Color="@GetMeta(CondStatus).Color" Variant="Variant.Filled" Style="width:72px; height:72px; margin-left:13rem !important;">
                    <MudIcon Icon="@GetMeta(CondStatus).Icon" Style="font-size: 2.5rem; color:white !important; fill: white !important;; display:block;" />
                </MudAvatar>
            </div>
        </Header>
        <Content>
            <div class="d-flex flex-column align-items-center mb-2">
                <MudText Typo="Typo.h6" Align="Align.Center">
                    @Title
                </MudText>
                <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-4">
                    @SubTitle
                </MudText>
            </div>
            <div class="text-start mb-3 ml-5">
                <MudText Typo="Typo.body2" Class="mb-2 fw-bold">Reason for @Title <span style="color: red;">*</span></MudText>
                <SfTextArea Placeholder="Type your message here...." @bind-Value="Comment" CssClass="e-outline mr-5" RowCount="3" ColumnCount="172" FloatLabelType="FloatLabelType.Never" Input="OnCommentInput" />
            </div>
        </Content>
        <FooterTemplate>
            <SfButton Content="Cancel" CssClass="@GetMeta(CondStatus).CancelCss" IconCss="e-icons e-close" OnClick="SecondDialogClickClose" />
            <SfButton Content="@GetMeta(CondStatus).SubmitContent" CssClass="@GetMeta(CondStatus).SubmitCss" IconCss="@GetMeta(CondStatus).SubmitIconCss" OnClick="SubmitWithValidation" Disabled="@_isSubmitDisabled" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>
