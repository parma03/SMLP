<div class="mb-4">
    <div class="d-flex align-center">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <MudIcon Icon="@Icon" Style="color:#6F4E37; margin-right:8px; font-size:1.8rem;" />
        }
        <MudText Typo="Typo.h5" Style="color:#3E2723; font-weight:700;">@Title</MudText>
    </div>
    <div class="d-flex align-baseline mt-1 horizontal_line">
        @if (!string.IsNullOrWhiteSpace(SubTitleKey))
        {
            <MudText Typo="Typo.subtitle1" Class="mr-2 mud-secondary-text">
                <strong>@SubTitleKey</strong>
            </MudText>
        }
        @if (!string.IsNullOrWhiteSpace(SubTitleValue))
        {
            <MudText Typo="Typo.subtitle1">@SubTitleValue</MudText>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = default!;

    [Parameter]
    public string SubTitleKey { get; set; } = default!;

    [Parameter]
    public string SubTitleValue { get; set; } = default!;

    [Parameter]
    public string Icon { get; set; } = default!;
}
