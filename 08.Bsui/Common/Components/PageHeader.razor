<div class="smlp-page-header mb-5">
    <div class="d-flex align-center flex-wrap" style="gap:10px;">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <div class="smlp-page-header-icon d-flex align-center justify-center">
                <MudIcon Icon="@Icon" Style="color:#6F4E37; font-size:1.4rem;" />
            </div>
        }
        <MudText Typo="Typo.h5" Style="color:#2E2019; font-weight:800;">@Title</MudText>
    </div>
    @if (!string.IsNullOrWhiteSpace(SubTitleKey) || !string.IsNullOrWhiteSpace(SubTitleValue))
    {
        <div class="d-flex align-baseline flex-wrap mt-2" style="gap:6px; padding-top:10px; border-top:1px solid rgba(111,78,55,0.12);">
            @if (!string.IsNullOrWhiteSpace(SubTitleKey))
            {
                <MudText Typo="Typo.subtitle2" Class="mr-1" Style="color:#6B5B4F;">
                    <strong>@SubTitleKey</strong>
                </MudText>
            }
            @if (!string.IsNullOrWhiteSpace(SubTitleValue))
            {
                <MudText Typo="Typo.body2" Style="color:#8A7A6B;">@SubTitleValue</MudText>
            }
        </div>
    }
</div>

<style>
    .smlp-page-header-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(111,78,55,0.10);
        flex-shrink: 0;
    }

    @@media (max-width: 600px) {
        .smlp-page-header .mud-typography-h5 {
            font-size: 1.15rem !important;
        }
    }
</style>

@code {
    [Parameter]
    public string Title { get; set; } = default!;

    [Parameter]
    public string SubTitleKey { get; set; } = default!;

    [Parameter]
    public string SubTitleValue { get; set; } = default!;

    [Parameter]
    public string Icon { get; set; } = default!;
}
