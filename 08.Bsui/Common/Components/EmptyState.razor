@using MudBlazor

<div class="empty-state" role="status" aria-label="@($"Kosong: {Title}")">
    <div class="empty-state-icon-badge d-flex align-center justify-center mb-4">
        <MudIcon Icon="@Icon" Style="font-size:40px; opacity:0.55; color:#6F4E37;" aria-hidden="true" />
    </div>
    <MudText Typo="Typo.h6" Style="color:#2E2019; font-weight:700;" Class="mb-1">@Title</MudText>
    @if (!string.IsNullOrEmpty(Description))
    {
        <MudText Typo="Typo.body2" Style="color:#8A7A6B; text-align:center; max-width:340px;" Class="mb-4">@Description</MudText>
    }
    @if (ActionContent is not null)
    {
        @ActionContent
    }
</div>

<style>
    .empty-state-icon-badge {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(111,78,55,0.10) 0%, rgba(111,78,55,0.04) 70%);
    }
</style>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Inbox;
    [Parameter] public string Title { get; set; } = "Tidak ada data";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public RenderFragment? ActionContent { get; set; }
}
