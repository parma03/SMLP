@using MudBlazor

<div class="empty-state">
    <MudIcon Icon="@Icon" Style="font-size:64px; opacity:0.35; color:#9e9e9e;" Class="mb-4" />
    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mb-2">@Title</MudText>
    @if (!string.IsNullOrEmpty(Description))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Style="text-align:center; max-width:320px;">@Description</MudText>
    }
    @if (ActionContent is not null)
    {
        @ActionContent
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Inbox;
    [Parameter] public string Title { get; set; } = "Tidak ada data";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public RenderFragment? ActionContent { get; set; }
}
