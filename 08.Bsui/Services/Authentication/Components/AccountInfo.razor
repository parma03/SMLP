<AuthorizeView>
    <NotAuthorized>
        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Login" Color="Color.Inherit"
                   Href="/Login">Login</MudButton>
    </NotAuthorized>
    <Authorized>
        <MudMenu Dense="true" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Person"
                 EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Label="@context.User.Identity?.Name">
            <MudMenuItem Icon="@Icons.Material.Filled.Person" OnClick="NavigateToProfile">Profil Saya</MudMenuItem>
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync">Keluar</MudMenuItem>
        </MudMenu>
    </Authorized>
</AuthorizeView>
