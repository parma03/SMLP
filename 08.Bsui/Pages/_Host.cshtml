@page "/"

@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Options
@using Smlp.Bsui.Services.AppInfo
@using Smlp.Bsui.Services.FrontEnd
@using Smlp.Shared.Common.Constants

@namespace Smlp.Bsui.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@inject IOptions<AppInfoOptions> _appInfoOptions
@inject IOptions<FrontEndOptions> _frontEndOptions

@{
    var ipAddress = string.Empty;

    var xIpAddress = HttpContext.Request.Headers[HttpHeaderName.IpAddress].FirstOrDefault();

    if (!string.IsNullOrWhiteSpace(xIpAddress))
    {
        ipAddress = xIpAddress;
    }
    else
    {
        var remoteIpAddress = HttpContext.Connection.RemoteIpAddress;
        ipAddress = remoteIpAddress is not null ? remoteIpAddress.ToString() : DefaultTextFor.SystemBackgroundJob;
    }

    var initialApplicationState = new InitialApplicationState
    {
        IpAddress = ipAddress
    };
}

<!DOCTYPE html>
<html lang="id">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@_appInfoOptions.Value.FullName</title>
        <base href="~/" />
        <link rel="shortcut icon" href='@Url.Content("~/favicon.ico")'>
        <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
        <link href="css/site.css" rel="stylesheet" />
        <link href="Smlp.Bsui.styles.css" rel="stylesheet" />
        <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
    </head>
    <body>
        <component type="typeof(App)" param-InitialApplicationState="initialApplicationState" render-mode="ServerPrerendered" />
        <div id="blazor-error-ui">
            <div class="error-content">
                Silakan klik <span onclick="window.location.reload();" style="display:inline-flex; align-items:center; padding:4px 12px; border-radius:16px; font-weight:600; font-size:0.875rem; color:#fff; cursor:pointer; background:linear-gradient(135deg,#6F4E37,#3E2723); margin:0 4px; user-select:none;"> DI SINI </span>
                untuk memuat ulang halaman atau kembali ke <span onclick="window.location.href='/'" style="display:inline-flex; align-items:center; padding:4px 12px; border-radius:16px; font-weight:600; font-size:0.875rem; color:#fff; cursor:pointer; background:linear-gradient(135deg,#2bb673,#1f8f56); margin:0 4px; user-select:none;"> BERANDA </span>
                Jika masalah berlanjut, hubungi administrator.<a class="dismiss" style="color:#000;"></a>
            </div>
        </div>
        <script src="_framework/blazor.server.js" autostart="false"></script>
        <script>
            Blazor.start({
                configureSignalR: function (builder)
                {
                    builder.withUrl("@Html.Raw(_frontEndOptions.Value.BasePath)/_blazor", {
                        skipNegotiation: true,
                        transport: 1
                    });
                }
            });
        </script>
        <script src="_content/MudBlazor/MudBlazor.min.js"></script>
        <script src="js/downloadFile.js"></script>
    </body>
</html>
