@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@using Smlp.Bsui.Common.Constants
@using Smlp.Bsui.Common.Extensions

<nav aria-label="Navigasi utama aplikasi">
<MudNavMenu>
    <AuthorizeView>
        <Authorized>
            @* ========== DASHBOARD ========== *@
            <MudNavLink Icon="@Icons.Material.Filled.Dashboard"
                        Match="NavLinkMatch.All"
                        Href="@CommonRouteFor.Dashboard"
                        aria-label="Buka halaman Dashboard">
                Dashboard
            </MudNavLink>

            @* ========== CRM - PELANGGAN (Admin, Owner, Kasir) ========== *@
            <AuthorizeView Roles="Admin,Owner,Kasir">
                <Authorized>
                    <MudNavGroup Icon="@Icons.Material.Filled.People"
                                 ExpandIcon="@Icons.Material.Filled.ExpandMore"
                                 Title="Manajemen Pelanggan"
                                 Expanded="false"
                                 aria-label="Grup menu Manajemen Pelanggan">
                        <MudNavLink Icon="@Icons.Material.Filled.PersonSearch"
                                    Match="NavLinkMatch.All"
                                    Href="@CommonRouteFor.Customers"
                                    aria-label="Daftar Pelanggan">
                            Daftar Pelanggan
                        </MudNavLink>
                        <MudNavLink Icon="@Icons.Material.Filled.PersonAdd"
                                    Match="NavLinkMatch.All"
                                    Href="@CommonRouteFor.CustomerCreate"
                                    aria-label="Tambah Pelanggan baru">
                            Tambah Pelanggan
                        </MudNavLink>
                    </MudNavGroup>
                </Authorized>
            </AuthorizeView>

            @* ========== TRANSAKSI (Admin, Owner, Kasir) ========== *@
            <AuthorizeView Roles="Admin,Owner,Kasir">
                <Authorized>
                    <MudNavGroup Icon="@Icons.Material.Filled.Receipt"
                                 ExpandIcon="@Icons.Material.Filled.ExpandMore"
                                 Title="Transaksi"
                                 Expanded="false"
                                 aria-label="Grup menu Transaksi">
                        <MudNavLink Icon="@Icons.Material.Filled.ReceiptLong"
                                    Match="NavLinkMatch.All"
                                    Href="@CommonRouteFor.Transactions"
                                    aria-label="Riwayat semua transaksi">
                            Riwayat Transaksi
                        </MudNavLink>
                        <MudNavLink Icon="@Icons.Material.Filled.AddCircle"
                                    Match="NavLinkMatch.All"
                                    Href="@CommonRouteFor.TransactionCreate"
                                    aria-label="Input transaksi baru">
                            Input Transaksi
                        </MudNavLink>
                        @* Penyesuaian Poin hanya untuk Admin dan Owner *@
                        <AuthorizeView Roles="Admin,Owner">
                            <Authorized>
                                <MudNavLink Icon="@Icons.Material.Filled.Tune"
                                            Match="NavLinkMatch.All"
                                            Href="@CommonRouteFor.PointAdjustments"
                                            aria-label="Penyesuaian poin pelanggan">
                                    Penyesuaian Poin
                                </MudNavLink>
                            </Authorized>
                        </AuthorizeView>
                    </MudNavGroup>
                </Authorized>
            </AuthorizeView>

            @* ========== REWARD (Admin, Owner, Kasir) ========== *@
            <AuthorizeView Roles="Admin,Owner,Kasir">
                <Authorized>
                    <MudNavGroup Icon="@Icons.Material.Filled.CardGiftcard"
                                 ExpandIcon="@Icons.Material.Filled.ExpandMore"
                                 Title="Reward & Redeem"
                                 Expanded="false"
                                 aria-label="Grup menu Reward dan Redeem">
                        <MudNavLink Icon="@Icons.Material.Filled.Loyalty"
                                    Match="NavLinkMatch.All"
                                    Href="@CommonRouteFor.Rewards"
                                    aria-label="Katalog reward yang tersedia">
                            Katalog Reward
                        </MudNavLink>
                        <MudNavLink Icon="@Icons.Material.Filled.Redeem"
                                    Match="NavLinkMatch.All"
                                    Href="@CommonRouteFor.RedeemHistories"
                                    aria-label="Riwayat penukaran reward">
                            Riwayat Penukaran
                        </MudNavLink>
                        <MudNavLink Icon="@Icons.Material.Filled.History"
                                    Match="NavLinkMatch.All"
                                    Href="/LoyaltyHistory"
                                    aria-label="Riwayat poin loyalitas">
                            Riwayat Loyalitas
                        </MudNavLink>
                    </MudNavGroup>
                </Authorized>
            </AuthorizeView>

            @* ========== ANALYTICS (Admin, Owner only) ========== *@
            <AuthorizeView Roles="Admin,Owner">
                <Authorized>
                    <MudNavGroup Icon="@Icons.Material.Filled.Analytics"
                                 ExpandIcon="@Icons.Material.Filled.ExpandMore"
                                 Title="Analytics & Laporan"
                                 Expanded="false"
                                 aria-label="Grup menu Analytics dan Laporan">
                        <MudNavLink Icon="@Icons.Material.Filled.Insights"
                                    Match="NavLinkMatch.All"
                                    Href="@CommonRouteFor.Analytics"
                                    aria-label="Dashboard Analytics dan grafik revenue">
                            Dashboard Analytics
                        </MudNavLink>
                        <MudNavLink Icon="@Icons.Material.Filled.Psychology"
                                    Match="NavLinkMatch.All"
                                    Href="@CommonRouteFor.CustomerInsights"
                                    aria-label="Customer Insights: segmentasi RFM dan prediksi churn">
                            Customer Insights
                        </MudNavLink>
                        <MudNavLink Icon="@Icons.Material.Filled.Stars"
                                    Match="NavLinkMatch.All"
                                    Href="@CommonRouteFor.LoyaltyAnalysis"
                                    aria-label="Analisis program loyalitas dan ekonomi poin">
                            Loyalty Analysis
                        </MudNavLink>
                        <MudNavLink Icon="@Icons.Material.Filled.Assessment"
                                    Match="NavLinkMatch.All"
                                    Href="@CommonRouteFor.Reports"
                                    aria-label="Ekspor laporan ke Excel">
                            Laporan
                        </MudNavLink>
                    </MudNavGroup>
                </Authorized>
            </AuthorizeView>

            @* ========== MASTER DATA (Admin, Owner) ========== *@
            <AuthorizeView Roles="Admin,Owner">
                <Authorized>
                    <MudNavGroup Icon="@Icons.Material.Filled.Settings"
                                 ExpandIcon="@Icons.Material.Filled.ExpandMore"
                                 Title="Master Data"
                                 Expanded="false"
                                 aria-label="Grup menu Master Data">
                        <MudNavLink Icon="@Icons.Material.Filled.Inventory2"
                                    Match="NavLinkMatch.All"
                                    Href="@CommonRouteFor.Products"
                                    aria-label="Katalog Produk">
                            Katalog Produk
                        </MudNavLink>
                        <MudNavLink Icon="@Icons.Material.Filled.Rule"
                                    Match="NavLinkMatch.All"
                                    Href="@CommonRouteFor.PointRules"
                                    aria-label="Konfigurasi aturan poin">
                            Aturan Poin
                        </MudNavLink>
                        <MudNavLink Icon="@Icons.Material.Filled.WorkspacePremium"
                                    Match="NavLinkMatch.All"
                                    Href="@CommonRouteFor.TierRules"
                                    aria-label="Konfigurasi aturan tier pelanggan">
                            Aturan Tier
                        </MudNavLink>
                    </MudNavGroup>
                </Authorized>
            </AuthorizeView>

            @* ========== ADMINISTRATOR (Admin only) ========== *@
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <MudDivider Class="my-2" Style="background-color:rgba(255,255,255,0.15);"
                                role="separator" aria-hidden="true" />
                    <MudNavLink Icon="@Icons.Material.Filled.AdminPanelSettings"
                                Match="NavLinkMatch.All"
                                Href="@CommonRouteFor.SiteAdministrator"
                                aria-label="Panel Administrator sistem">
                        Administrator
                    </MudNavLink>
                    <MudNavLink Icon="@Icons.Material.Filled.ManageSearch"
                                Match="NavLinkMatch.All"
                                Href="@CommonRouteFor.Audits"
                                aria-label="Log audit aktivitas sistem">
                        Audit Log
                    </MudNavLink>
                    <MudNavLink Icon="@Icons.Material.Filled.Schedule"
                                Match="NavLinkMatch.All"
                                Href="/Scheduler"
                                aria-label="Jadwal background job sistem">
                        Scheduler
                    </MudNavLink>
                </Authorized>
            </AuthorizeView>

            @* ========== OWNER PANEL (Owner only) ========== *@
            <AuthorizeView Roles="Owner">
                <Authorized>
                    <MudDivider Class="my-2" Style="background-color:rgba(255,255,255,0.15);"
                                role="separator" aria-hidden="true" />
                    <MudNavLink Icon="@Icons.Material.Filled.ManageSearch"
                                Match="NavLinkMatch.All"
                                Href="@CommonRouteFor.Audits"
                                aria-label="Log audit aktivitas sistem">
                        Audit Log
                    </MudNavLink>
                    <MudNavLink Icon="@Icons.Material.Filled.Schedule"
                                Match="NavLinkMatch.All"
                                Href="/Scheduler"
                                aria-label="Jadwal background job sistem">
                        Scheduler
                    </MudNavLink>
                </Authorized>
            </AuthorizeView>

        </Authorized>
    </AuthorizeView>

    <MudDivider Class="my-2" Style="background-color:rgba(255,255,255,0.15);"
                role="separator" aria-hidden="true" />
    <MudNavLink Icon="@Icons.Material.Filled.Info"
                Match="NavLinkMatch.All"
                Href="@CommonRouteFor.About"
                aria-label="Tentang aplikasi SMLP">
        Tentang Aplikasi
    </MudNavLink>
</MudNavMenu>
</nav>
