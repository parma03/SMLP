@using Microsoft.AspNetCore.Components.Authorization
@using Smlp.Bsui.Common.Pages
@using Smlp.Bsui.Common.Pages.Errors
@using Smlp.Bsui.Services.AppInfo
@using Smlp.Bsui.Services.Authentication
@using Smlp.Bsui.Services.Authentication.Components
@using Smlp.Bsui.Services.Geolocation
@using Smlp.Bsui.Services.Geolocation.Abstractions
@using Smlp.Bsui.Services.Geolocation.Components
@using Smlp.Bsui.Services.HealthCheck.Components
@using Smlp.Bsui.Services.Telemetry
@using Smlp.Bsui.Services.Telemetry.ApplicationInsights.Components
@using Smlp.Bsui.Services.UserSession

@inherits LayoutComponentBase

@inject IOptions<AppInfoOptions> _appInfoOptions
@inject IOptions<AuthenticationOptions> _authenticationOptions
@inject IOptions<GeolocationOptions> _geolocationOptions
@inject IOptions<TelemetryOptions> _telemetryOptions

@inject AuthenticationStateProvider _authenticationStateProvider
@inject IGeolocationService _geolocationService
@inject UserInfo _userInfo
@inject IBrowserViewportService _browserViewportService

@if (_usingApplicationInsights)
{
    <PageViewTelemetryTracker />
}

@* Skip navigation for keyboard users *@
<a href="#main-content" class="skip-nav-link">Lewati ke konten utama</a>

<MudThemeProvider Theme="@ThemeFor.MainLayout" />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="1" role="banner" aria-label="Header aplikasi SMLP" Class="smlp-appbar">
                @if (_authorized)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())"
                                   aria-label="@(_drawerOpen ? "Tutup menu navigasi" : "Buka menu navigasi")"
                                   aria-expanded="@_drawerOpen.ToString().ToLower()"
                                   aria-controls="main-nav-drawer" />
                }
                <MudIcon Icon="@Icons.Material.Filled.LocalCafe" Color="Color.Inherit" Class="ml-2 mr-1" />
                <MudText Typo="Typo.h6" Class="ml-1 font-weight-bold">@_appInfoOptions.Value.ShortName</MudText>
                <MudText Typo="Typo.caption" Class="ml-2 mt-1 d-none d-sm-flex" Style="opacity:0.8">@_appInfoOptions.Value.Description</MudText>
                <MudSpacer />
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <HealthCheckInfo />
                </MudHidden>
                <NotificationCenter />
                @if (_usingAuthentication)
                {
                    <AccountInfo />
                }
            </MudAppBar>
            @if (_authorized)
            {
                <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2"
                           Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
                           id="main-nav-drawer" role="navigation" aria-label="Sidebar navigasi">
                    <MudDrawerHeader Class="pa-0">
                        <div class="drawer-header d-flex align-center pa-3">
                            <div class="drawer-logo-badge d-flex align-center justify-center">
                                <MudIcon Icon="@Icons.Material.Filled.LocalCafe" Style="color:#FFE9CC; font-size:1.6rem;" />
                            </div>
                            <div class="ml-3" style="min-width:0;">
                                <MudText Typo="Typo.subtitle1" Class="text-truncate" Style="color:#FFF8E1; font-weight:700; line-height:1.2;">@_appInfoOptions.Value.FullName</MudText>
                                <MudText Typo="Typo.caption" Style="color:#E8B98E;">Loyalty Management System</MudText>
                            </div>
                        </div>
                        <MudDivider Style="background-color:rgba(255,255,255,0.08);" />
                    </MudDrawerHeader>
                    <NavMenu />
                </MudDrawer>
            }
            <MudMainContent>
                <SessionExpirationAlert />
                <div class="main-content" id="main-content" role="main" tabindex="-1">
                    @if (_authorized)
                    {
                        if (_usingGeolocation)
                        {
                            if (_geolocationResult is null)
                            {
                                <Loading Description="Memuat lokasi Anda..." />
                            }
                            else
                            {
                                if (!_geolocationResult.IsSuccess)
                                {
                                    <GeolocationError ErrorMessage="@_geolocationResult.ErrorMessage" />
                                }
                                else
                                {
                                    _readyToRenderBody = !_firstTimeRender;
                                }
                            }
                        }
                        else
                        {
                            _readyToRenderBody = !_firstTimeRender;
                        }

                        if (_readyToRenderBody)
                        {
                            @Body
                        }
                    }
                    else
                    {
                        <Forbidden />
                    }
                </div>
            </MudMainContent>
        </MudLayout>
        <MudScrollToTop TopOffset="200">
            <MudFab Color="Color.Secondary" Icon="@Icons.Material.Filled.ArrowCircleUp" />
        </MudScrollToTop>
    </Authorized>
    <NotAuthorized>
        <Login />
    </NotAuthorized>
</AuthorizeView>

<style>
    @@media only screen and (max-width: 768px) {
        .element_large {
            display: none;
        }
    }

    .main-content {
        position: relative;
        height: 100%;
        min-height: calc(100vh - 64px);
        padding: 20px 28px 28px 28px;
        background-color: #F6F1EA;
        background-image: radial-gradient(circle at 10% 20%, rgba(111,78,55,0.05) 0%, transparent 50%),
                          radial-gradient(circle at 90% 80%, rgba(200,134,10,0.05) 0%, transparent 50%);
    }

    @@media (max-width: 600px) {
        .main-content {
            padding: 14px 14px 20px 14px;
        }
    }

    .smlp-appbar.mud-appbar {
        background: linear-gradient(120deg, #3E2723 0%, #5D4130 55%, #6F4E37 100%) !important;
        box-shadow: 0 2px 12px rgba(46,32,25,0.22) !important;
    }

    .mud-drawer-content {
        background: linear-gradient(190deg, #3E2723 0%, #4A3425 60%, #4E342E 100%) !important;
    }

    .drawer-logo-badge {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: rgba(255,255,255,0.08);
        flex-shrink: 0;
    }

    .mud-nav-link {
        color: #F3E9DD !important;
        border-radius: 10px;
        margin: 2px 10px;
        transition: background-color 160ms ease, transform 160ms ease;
    }

    .mud-nav-link:hover {
        background-color: rgba(255, 248, 225, 0.10) !important;
        transform: translateX(2px);
    }

    .mud-nav-link.active {
        background-color: rgba(200, 134, 10, 0.28) !important;
        color: #FFE9B8 !important;
        font-weight: 600;
    }

    .mud-nav-group-title {
        color: #E8B98E !important;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .loading {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
    }

    .drawer-header {
        padding: 12px 8px;
    }
</style>
